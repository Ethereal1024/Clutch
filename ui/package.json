{
  "name": "clutch-ui",
  "version": "0.2.0",
  "private": true,
  "description": "Clutch desktop GUI — Electron shell for the clutch-server backend",
  "author": "Clutch Developers <dev@clutch.invalid>",
  "homepage": "https://github.com/Ethereal1024/Clutch",
  "desktopName": "clutch.desktop",
  "main": "main.js",
  "scripts": {
    "build:host": "node build-host.js",
    "build": "node build-host.js && node build-renderer.js",
    "dev": "bash dev.sh",
    "predev": "npm run build",
    "start": "electron .",
    "prestart": "npm run build",
    "predist": "npm run build && bash ../scripts/check-transport-defaults.sh",
    "dist": "electron-builder --linux deb",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis",
    "postinstall": "node -e \"const fs=require('fs');const f='node_modules/electron/path.txt';if(fs.existsSync(f)){fs.writeFileSync(f,fs.readFileSync(f,'utf-8').trim())}\"",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "proxy-agent": "^8.0.2",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3"
  }
}
