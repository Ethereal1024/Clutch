#!/bin/sh
# STOPGAP -- temporary, delete together with the ssh-workspace component landing.
#
# In this session the workspace root belongs to another machine, so the agent
# tools read_file/grep/write_file/edit_file are refused (agent/tools/prompt.py:
# "clutch-workspace serves the filesystem of the machine this workspace root
# lives on, and this root is another machine" + the possessive). The component
# itself is fine: it is installed on THIS machine and its CLI is a thin client
# for the per-workspace daemon it lazily starts. So until ssh-workspace exists
# this wrapper is how the session reaches the same executor, with the same tool
# names, the same arguments and the same output. See SSH_WORKSPACE_PLAN.md.
#
#   scripts/ws-stopgap read_file --path agent/tools/prompt.py --offset 100 --limit 20
#   scripts/ws-stopgap --json grep --pattern TODO --include *.py
#   scripts/ws-stopgap write_file --path notes.md --content -
#
# NOT part of the product: no host code calls it.
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
dir="$root/clutch-workspace"
if [ ! -d "$dir/clutch_workspace" ]; then
    dir=$(ls -d "${HOME:?}/.clutch/components/clutch-workspace"/*/ 2>/dev/null | tail -n 1)
    dir=${dir%/}
fi
if [ ! -d "$dir/clutch_workspace" ]; then
    echo "ERROR: no clutch-workspace checkout or install to drive" >&2
    exit 66
fi
CLUTCH_WORKSPACE_DISCOVERY_DIR=${CLUTCH_WORKSPACE_DISCOVERY_DIR:-$HOME/.clutch-workspace}
export CLUTCH_WORKSPACE_DISCOVERY_DIR
PYTHONPATH="$dir"
export PYTHONPATH
cd "$root"
exec python3 -m clutch_workspace --workspace "$root" "$@"
