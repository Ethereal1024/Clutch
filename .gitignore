.venv/
__pycache__/
*.pyc
.env
node_modules/
reports/
build/
dist/
*.spec
*.clc
# the app icon lives in ui/build/ (electron-builder's default buildResources);
# un-ignore the source files so they are versioned
!ui/build/
!ui/build/icon.svg
!ui/build/icon.png
!ui/build/icon.ico

# one-time .clc migration tool — RECOVERY.md's escape hatch for old files on
# this machine; keep it local, do not ship it in the repo
scripts/convert-clc-to-cpr.py

# local debug/scratch workspaces (mermaid render repro, jsdom repro) — keep out
.mermaid-test/
mj-repro/

# internal planning docs (video script, optimization plans) — keep out of the repo
docs/

# third-party writing skills (humanizer-zh etc.) — local tooling, not part of the submission
.claude/skills/

# local release-ops scratch scripts (machine-local: hardcoded run ids, PAT access);
# readme.txt is the plain-text submission deliverable, kept out of the repo on purpose
/poll_ci.py
/readme.txt
/verify_release.py
/verify_win_artifact.py
/watch_ci.sh

# dev-only skills used to live here (/agent/skills/<name>/), gitignored; the
# library has moved into the clutch-skills module, which ignores its own
# local-only skills (see clutch-skills/.gitignore)

# local scratch scripts/logs from ad-hoc testing sessions
/scratch-*.py
/scratch_*.py
/scratch_*.log
