{"type": "tool_result", "timestamp": 1789897754.5079463, "id": "bfa4785824c1", "tool_call_id": "call_e458b8d3c3b748adb778348f", "content": "241: _TH32CS_SNAPPROCESS = 0x2\n242: _INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value\n243: \n244: \n245: class _JobBasicLimits(ctypes.Structure):\n246:     \"\"\"JOBOBJECT_BASIC_LIMIT_INFORMATION (only LimitFlags is ever set).\"\"\"\n247: \n248:     _fields_ = [\n249:         (\"PerProcessUserTimeLimit\", ctypes.c_longlong),\n250:         (\"PerJobUserTimeLimit\", ctypes.c_longlong),\n251:         (\"LimitFlags\", ctypes.c_uint32),\n252:         (\"MinimumWorkingSetSize\", ctypes.c_size_t),\n253:         (\"MaximumWorkingSetSize\", ctypes.c_size_t),\n254:         (\"ActiveProcessLimit\", ctypes.c_uint32),\n255:         (\"Affinity\", ctypes.c_size_t),\n256:         (\"PriorityClass\", ctypes.c_uint32),\n257:         (\"SchedulingClass\", ctypes.c_uint32),\n258:     ]\n259: \n260: \n261: class _JobIoCounters(ctypes.Structure):\n262:     _fields_ = [\n263:         (name, ctypes.c_ulonglong)\n264:         for name in (\n265:             \"ReadOperationCount\",\n266:             \"WriteOperationCount\",\n267:             \"OtherOperationCount\",\n268:             \"ReadTransferCount\",\n269:             \"WriteTransferCount\",\n270:             \"OtherTransferCount\",\n271:         )\n272:     ]\n273: \n274: \n275: class _JobLimits(ctypes.Structure):\n276:     \"\"\"JOBOBJECT_EXTENDED_LIMIT_INFORMATION.\"\"\"\n277: \n278:     _fields_ = [\n279:         (\"BasicLimitInformation\", _JobBasicLimits),\n280:         (\"IoInfo\", _JobIoCounters),\n281:         (\"ProcessMemoryLimit\", ctypes.c_size_t),\n282:         (\"JobMemoryLimit\", ctypes.c_size_t),\n283:         (\"PeakProcessMemoryUsed\", ctypes.c_size_t),\n284:         (\"PeakJobMemoryUsed\", ctypes.c_size_t),\n285:     ]\n286: \n287: \n288: class _ProcEntry(ctypes.Structure):\n289:     \"\"\"PROCESSENTRY32W (Toolhelp32 snapshot row: pid + parent pid).\"\"\"\n290: \n291:     _fields_ = [\n292:         (\"dwSize\", ctypes.c_uint32),\n293:         (\"cntUsage\", ctypes.c_uint32),\n294:         (\"th32ProcessID\", ctypes.c_uint32),\n295:         (\"th32DefaultHeapID\", ctypes.c_size_t),\n296:         (\"th32ModuleID\", ctypes.c_uint32),\n297:         (\"cntThreads\", ctypes.c_uint32),\n298:         (\"th32ParentProcessID\", ctypes.c_uint32),\n299:         (\"pcPriClassBase\", ctypes.c_long),\n300:         (\"dwFlags\", ctypes.c_uint32),\n301:         (\"szExeFile\", ctypes.c_wchar * 260),\n302:     ]\n303: \n304: \n305: def _descendant_pids(pid: int) -> list[int]:\n306:     \"\"\"Live descendants of `pid`, nearest first (Toolhelp32 snapshot).\n307: \n308:     Empty on any failure — the walk only widens the Job's net, so a\n309:     missed snapshot must never fail a session start.\n310:     \"\"\"\n311:     if os.name != \"nt\":\n312:         return []\n313:     try:\n314:         # use_last_error=True so the failure log's WinError is the real one\n315:         k32 = ctypes.WinDLL(\"kernel32\", use_last_error=True)\n316:         k32.CreateToolhelp32Snapshot.restype = ctypes.c_void_p\n317:         k32.CreateToolhelp32Snapshot.argtypes = [ctypes.c_uint32, ctypes.c_uint32]\n318:         k32.Process32FirstW.argtypes = [ctypes.c_void_p, ctypes.POINTER(_ProcEntry)]\n319:         k32.Process32NextW.argtypes = [ctypes.c_void_p, ctypes.POINTER(_ProcEntry)]\n320:         snap = k32.CreateToolhelp32Snapshot(_TH32CS_SNAPPROCESS, 0)\n321:         if not snap or snap == _INVALID_HANDLE_VALUE:\n322:             _log(f\"[supervisor] descendant walk: snapshot failed (WinError {ctypes.get_last_error()})\")\n323:             return []\n324:         pairs: list[tuple[int, int]] = []\n325:         entry = _ProcEntry()\n326:         entry.dwSize = ctypes.sizeof(entry)\n327:         more = k32.Process32FirstW(snap, ctypes.byref(entry))\n328:         while more:\n329:             pairs.append((entry.th32ProcessID, entry.th32ParentProcessID))\n330:             more = k32.Process32NextW(snap, ctypes.byref(entry))\n331:         k32.CloseHandle(snap)\n332:     except Exception as e:  # noqa: BLE001 - logged: net-widening only, the\n333:         _log(f\"[supervisor] descendant walk failed: {e!r}\")  # core Job holds\n334:         return []\n335:     children: dict[int, list[int]] = {}\n336:     for p, pp in pairs:\n337:         children.setdefault(pp, []).append(p)\n338:     out: list[int] = []\n339:     frontier, seen = [pid], {pid}\n340:     while frontier:\n341:         nxt: list[int] = []\n342:         for f in frontier:\n343:             for c in children.get(f, ()):\n344:                 if c not in seen:\n345:                     seen.add(c)\n346:                     out.append(c)\n347:                     nxt.append(c)\n348:         frontier = nxt\n349:     return out\n350: \n351: \n352: def _job_assign(pid: int) -> int | None:\n353:     \"\"\"Put a fresh session child into a kill-on-close Job (Windows only).\n354: \n355:     Returns the Job handle for _kill to close, or None when the guarantee is\n356:     unavailable. None is NOT a degenerate \"keep going\" answer: a session we\n357:     cannot guarantee to kill is a session we must not run, so the caller\n358:     REFUSES to start it (see start_session). POSIX always gets None — there\n359:     the process group is the guarantee.\n360:     \"\"\"\n361:     if os.name != \"nt\":\n362:         return None\n363:     try:\n364:         # use_last_error=True: ctypes' own Win32 traffic would otherwise\n365:         # clobber the real GetLastError value before we can read it\n366:         k32 = ctypes.WinDLL(\"kernel32\", use_last_error=True)\n367:         k32.CreateJobObjectW.restype = ctypes.c_void_p\n368:         k32.CreateJobObjectW.argtypes = [ctypes.c_void_p, ctypes.c_void_p]\n369:         k32.SetInformationJobObject.argtypes = [\n370:             ctypes.c_void_p,\n371:             ctypes.c_int,\n372:             ctypes.c_void_p,\n373:             ctypes.c_uint32,\n374:         ]\n375:         k32.OpenProcess.restype = ctypes.c_void_p\n376:         k32.OpenProcess.argtypes = [ctypes.c_uint32, ctypes.c_uint32, ctypes.c_uint32]\n377:         k32.AssignProcessToJobObject.argtypes = [ctypes.c_void_p, ctypes.c_void_p]\n378:         k32.CloseHandle.argtypes = [ctypes.c_void_p]\n379: \n380:         job = k32.CreateJobObjectW(None, None)\n381:         if not job:\n382:             _log(f\"[supervisor] Job assign failed: CreateJobObjectW (WinError {ctypes.get_last_error()})\")\n383:             return None\n384:         limits = _JobLimits()\n385:         limits.BasicLimitInformation.LimitFlags = _JOB_KILL_ON_JOB_CLOSE\n386:         if not k32.SetInformationJobObject(\n387:             job, _JOB_EXTENDED_LIMIT_INFO, ctypes.byref(limits), ctypes.sizeof(limits)\n388:         ):\n389:             _log(f\"[supervisor] Job assign failed: SetInformationJobObject (WinError {ctypes.get_last_error()})\")\n390:             k32.CloseHandle(job)\n391:             return None\n392:         proc = k32.OpenProcess(_PROCESS_SET_QUOTA | _PROCESS_TERMINATE, False, pid)\n393:         if not proc:\n394:             _log(f\"[supervisor] Job assign failed: OpenProcess({pid}) (WinError {ctypes.get_last_error()})\")\n395:             k32.CloseHandle(job)\n396:             return None\n397:         ok = k32.AssignProcessToJobObject(job, proc)\n398:         k32.CloseHandle(proc)\n399:         if not ok:\n400:             _log(f\"[supervisor] Job assign failed: AssignProcessToJobObject (WinError {ctypes.get_last_error()})\")\n401:             k32.CloseHandle(job)\n402:             return None\n403:         # Job membership is NOT retroactive: a fast launcher (the venv stub\n404:         # CreateProcess'es its real interpreter the instant it starts) can\n405:         # spawn its child BEFORE we get here, and that child inherits no Job\n406:         # and escapes the kill-on-close net — precisely the orphan that kept\n407:         # a .clc locked in the wild. Pull every already-live descendant in,\n408:         # re-walking briefly for children born in the race window; a member's\n409:         # own later children inherit the Job for free.\n410:         for wait in (0.0, 0.05, 0.1):\n411:             if wait:\n412:                 time.sleep(wait)\n413:             for d in _descendant_pids(pid):\n414:                 h = k32.OpenProcess(_PROCESS_SET_QUOTA | _PROCESS_TERMINATE, False, d)\n415:                 if h:\n416:                     k32.AssignProcessToJobObject(job, h)  # same-job re-assign is a no-op\n417:                     k32.CloseHandle(h)\n418:         return job\n419:     except Exception as e:  # noqa: BLE001 - logged, then refused by the caller\n420:         _log(f\"[supervisor] Job assign failed: {e!r}\")\n421:         return None\n422: \n423: \n424: def _job_close(job: int | None) -> None:\n425:     \"\"\"Close the session's Job handle. With KILL_ON_JOB_CLOSE the kernel\n426:     terminates every process still in the Job — the last line of defense when\n427:     a kill missed a member (a launcher that died before its interpreter, a\n428:     tree-walk that skipped a grandchild). Never raises.\"\"\"\n429:     if os.name != \"nt\" or not job:\n430:         return\n431:     try:\n432:         ctypes.windll.kernel32.CloseHandle(job)\n433:     except OSError:\n434:         pass\n435: \n436: \n437: class Supervisor:\n438:     \"\"\"Owns session children. No session logic itself — just spawn, route the\n439:     port back, and reap. Thread-safe: sessions dict guarded by a lock.\"\"\"\n440: \n441:     def __init__(\n442:         self,\n443:         agent_cmd: list[str],\n444:         cwd: str | None = None,\n445:         stale_s: float = SESSION_STALE_S,\n446:         idle_timeout_s: float = IDLE_TIMEOUT_S,\n447:         reap_interval_s: float = REAP_INTERVAL_S,\n448:         start_timeout_s: float = SESSION_START_TIMEOUT_S,\n449:     ) -> None:\n450:         self.agent_cmd = list(agent_cmd)\n451:         self.cwd = cwd\n452:         self.stale_s = stale_s\n453:         self.idle_timeout_s = idle_timeout_s\n454:         self.reap_interval_s = reap_interval_s\n455:         self.start_timeout_s = start_timeout_s\n456:         self.sessions: dict[str, Session] = {}\n457:         self._lock = threading.Lock()\n458:         self.last_activity = time.time()  # last moment a session existed\n459:         self.exit_event = threading.Event()\n460:         # set by POST /api/shutdown: exit as soon as no sessions remain\n461:         self.exit_when_idle = False\n462: \n463:     # ---- session lifecycle ----\n464: \n465:     def start_session(self, base_url: str | None = None) -> Session | None:\n466:         \"\"\"Spawn one agent.server child on a random port, learning the port from\n467:         its stdout banner. None when the child never prints it. base_url is\n468:         forwarded as --base-url.\"\"\"\n469:         # refresh the idle timer before spawning (a slow child must not let the\n470:         # reaper self-exit mid-start) and clear a pending shutdown flag\n471:         with self._lock:\n472:             self.last_activity = time.time()\n473:             self.exit_when_idle = False\n474:         try:\n475:             env = dict(os.environ)\n476:             cmd = [*self.agent_cmd, \"--port\", \"0\"]\n477:             if base_url:\n478:                 cmd += [\"--base-url\", base_url]\n479:             # POSIX: own process group -> group kill. Windows has no setsid/\n480:             # killpg; a new process group lets CTRL_BREAK reach the child.\n481:             spawn: dict = {\"start_new_session\": True} if os.name == \"posix\" else {}\n482:             if os.name == \"nt\":\n483:                 spawn[\"creationflags\"] = subprocess.CREATE_NEW_PROCESS_GROUP\n484:             proc = subprocess.Popen(\n485:                 cmd,\n486:                 cwd=self.cwd,\n487:                 stdout=subprocess.PIPE,\n488:                 stderr=subprocess.STDOUT,\n489:                 env=env,\n490:                 **spawn,\n... (showing lines 241-490 of 786; use offset=491 to continue)", "is_error": false, "diff": ""}
