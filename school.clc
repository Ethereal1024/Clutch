{"type": "tool_result", "timestamp": 1789621245.7657368, "id": "bedb3b5bf195", "tool_call_id": "call_756540c08216408fba637392", "content": "OK: edited C:\\Users\\12741\\Desktop\\临时文件\\Clutch\\agent\\tools\\websearch.py (+112 -0 lines)", "is_error": false, "diff": "--- a/agent\\tools\\websearch.py\n+++ b/agent\\tools\\websearch.py\n@@ -313,3 +313,115 @@\n         if self._pending and self._pending[\"title\"]:\n             self.results.append(self._pending)\n         self._pending, self._mode = None, \"\"\n+\n+\n+# ---- backends: (query, limit, config, get) -> list[{title,url,snippet}] ------\n+\n+\n+def _tavily(query: str, limit: int, config: Config, get: Callable[..., HttpResp]) -> list[dict[str, str]]:\n+    payload = json.dumps({\"query\": query, \"max_results\": limit}).encode(\"utf-8\")\n+    resp = get(\n+        \"https://api.tavily.com/search\",\n+        method=\"POST\",\n+        body=payload,\n+        headers={\n+            \"Content-Type\": \"application/json\",\n+            \"Authorization\": f\"Bearer {config.tavily_api_key}\",\n+            \"Accept\": \"application/json\",\n+        },\n+    )\n+    try:\n+        data = json.loads(resp.body)\n+        raw = data.get(\"results\") or []\n+    except ValueError as e:\n+        raise BackendError(f\"tavily returned non-JSON body: {e}\") from e\n+    out = [\n+        {\n+            \"title\": str(r.get(\"title\") or \"\").strip(),\n+            \"url\": str(r.get(\"url\") or \"\").strip(),\n+            \"snippet\": _clean_snippet(str(r.get(\"content\") or \"\")),\n+        }\n+        for r in raw\n+        if isinstance(r, dict) and r.get(\"url\")\n+    ]\n+    if not out:\n+        raise BackendError(\"response had no usable results\")\n+    return out[:limit]\n+\n+\n+def _searxng(query: str, limit: int, config: Config, get: Callable[..., HttpResp]) -> list[dict[str, str]]:\n+    url = f\"{config.searxng_url}/search?{urllib.parse.urlencode({'q': query, 'format': 'json'})}\"\n+    resp = get(url, headers={\"Accept\": \"application/json\"})\n+    try:\n+        data = json.loads(resp.body)\n+        raw = data.get(\"results\") or []\n+    except ValueError as e:\n+        raise BackendError(f\"searxng returned non-JSON body (format=json enabled?): {e}\") from e\n+    out = [\n+        {\n+            \"title\": str(r.get(\"title\") or \"\").strip(),\n+            \"url\": str(r.get(\"url\") or \"\").strip(),\n+            \"snippet\": _clean_snippet(str(r.get(\"content\") or \"\")),\n+        }\n+        for r in raw\n+        if isinstance(r, dict) and r.get(\"url\")\n+    ]\n+    if not out:\n+        raise BackendError(\"response had no usable results\")\n+    return out[:limit]\n+\n+\n+def _bing(query: str, limit: int, config: Config, get: Callable[..., HttpResp]) -> list[dict[str, str]]:\n+    url = \"https://www.bing.com/search?\" + urllib.parse.urlencode(\n+        {\"q\": query, \"format\": \"rss\", \"count\": str(min(limit, 30))}\n+    )\n+    resp = get(url, headers={\"Accept\": \"application/rss+xml, application/xml;q=0.9, */*;q=0.8\"})\n+    try:\n+        root = ET.fromstring(resp.body)\n+    except ET.ParseError as e:\n+        raise BackendError(f\"bing RSS is not parseable XML: {e}\") from e\n+    out = []\n+    for item in root.iter(\"item\"):\n+        title = (item.findtext(\"title\") or \"\").strip()\n+        link = (item.findtext(\"link\") or \"\").strip()\n+        if not (title and link):\n+            continue\n+        out.append({\"title\": _clean_snippet(title), \"url\": link, \"snippet\": _clean_snippet(item.findtext(\"description\") or \"\")})\n+        if len(out) >= limit:\n+            break\n+    if not out:\n+        raise BackendError(\"no items in the RSS (blocked, or genuinely no results)\")\n+    return out\n+\n+\n+def _ddg(query: str, limit: int, config: Config, get: Callable[..., HttpResp]) -> list[dict[str, str]]:\n+    url = \"https://html.duckduckgo.com/html/?\" + urllib.parse.urlencode({\"q\": query})\n+    resp = get(url)\n+    parser = _DdgParser()\n+    parser.feed(_decode_body(resp.body, resp.content_type))\n+    parser.close()\n+    out = [r for r in parser.results if r[\"url\"]][:limit]\n+    if not out:\n+        raise BackendError(\"no results parsed (bot-checked, blocked, or layout changed)\")\n+    return out\n+\n+\n+_BACKENDS: dict[str, Callable[[str, int, Config, Callable[..., HttpResp]], list[dict[str, str]]]] = {\n+    \"tavily\": _tavily,\n+    \"searxng\": _searxng,\n+    \"bing\": _bing,\n+    \"ddg\": _ddg,\n+}\n+_DEFAULT_CHAIN = (\"tavily\", \"searxng\", \"bing\", \"ddg\")\n+\n+\n+def _available_backends(config: Config) -> tuple[str, ...]:\n+    \"\"\"The usable subset of the chain: keyless backends are always in.\"\"\"\n+    out = []\n+    for name in _DEFAULT_CHAIN:\n+        if name == \"tavily\" and not config.tavily_api_key:\n+            continue\n+        if name == \"searxng\" and not config.searxng_url:\n+            continue\n+        out.append(name)\n+    return tuple(out)\n"}
{"type": "assistant_message", "timestamp": 1789621267.5882652, "id": "eca97b70e5f9", "content": "第 4 段（web_search / web_fetch 工具入口）：", "tool_calls": [{"id": "call_52a420e71c894698b1ebc110", "name": "edit_file", "arguments": "{\"new_string\":\"def _available_backends(config: Config) -> tuple[str, ...]:\\n    \\\"\\\"\\\"The usable subset of the chain: keyless backends are always in.\\\"\\\"\\\"\\n    out = []\\n    for name in _DEFAULT_CHAIN:\\n        if name == \\\"tavily\\\" and not config.tavily_api_key:\\n            continue\\n        if name == \\\"searxng\\\" and not config.searxng_url:\\n            continue\\n        out.append(name)\\n    return tuple(out)\\n\\n\\ndef _short(reason: object) -> str:\\n    return re.sub(r\\\"\\\\s+\\\", \\\" \\\", str(reason)).strip()[:160]\\n\\n\\ndef web_search(\\n    workspace: Workspace,\\n    config: Config,\\n    query: str,\\n    max_results: int | None = None,\\n    backend: str = \\\"\\\",\\n    cancel: Any = None,\\n) -> dict[str, Any]:\\n    \\\"\\\"\\\"Search the web; backends fall through in order until one yields.\\\"\\\"\\\"\\n    q = (query or \\\"\\\").strip()\\n    if not q:\\n        return {\\\"content\\\": \\\"ERROR: query is required\\\", \\\"error\\\": True}\\n    limit = max(1, min(int(max_results or config.web_search_max_results), 20))\\n    if backend:\\n        if backend not in _BACKENDS:\\n            return {\\n                \\\"content\\\": f\\\"ERROR: unknown backend {backend!r}; available: \\\"\\n                + \\\", \\\".join(_DEFAULT_CHAIN)\\n                + \\\" (tavily needs CLUTCH_TAVILY_API_KEY, searxng needs CLUTCH_SEARXNG_URL)\\\",\\n                \\\"error\\\": True,\\n            }\\n        if backend in (\\\"tavily\\\",) and not config.tavily_api_key:\\n            return {\\\"content\\\": \\\"ERROR: backend 'tavily' needs CLUTCH_TAVILY_API_KEY\\\", \\\"error\\\": True}\\n        if backend in (\\\"searxng\\\",) and not config.searxng_url:\\n            return {\\\"content\\\": \\\"ERROR: backend 'searxng' needs CLUTCH_SEARXNG_URL\\\", \\\"error\\\": True}\\n        chain: tuple[str, ...] = (backend,)\\n    else:\\n        chain = _available_backends(config)\\n    get = functools.partial(_http_get, timeout=config.web_search_timeout, cancel=cancel)\\n    failures: list[str] = []\\n    for name in chain:\\n        try:\\n            results = _BACKENDS[name](q, limit, config, get)\\n        except (BackendError, WebError) as e:\\n            failures.append(f\\\"- {name}: {_short(e)}\\\")\\n            continue\\n        seen: set[str] = set()\\n        deduped = []\\n        for r in results:\\n            if r[\\\"url\\\"] in seen:\\n                continue\\n            seen.add(r[\\\"url\\\"])\\n            deduped.append(r)\\n        body = \\\"\\\\n\\\".join(f\\\"{i}. {r['title']}\\\\n   {r['url']}\\\\n   {r['snippet']}\\\" for i, r in enumerate(deduped, 1))\\n        return {\\\"content\\\": f\\\"{len(deduped)} results for {q!r} (via {name}):\\\\n\\\\n{body}\\\"}\\n    return {\\n        \\\"content\\\": \\\"ERROR: all search backends failed\\\\n\\\" + \\\"\\\\n\\\".join(failures),\\n        \\\"error\\\": True,\\n    }\\n\\n\\n_BINARY_TYPES = (\\\"image/\\\", \\\"video/\\\", \\\"audio/\\\")\\n_BINARY_EXACT = {\\\"application/pdf\\\", \\\"application/zip\\\", \\\"application/gzip\\\", \\\"application/x-tar\\\", \\\"application/octet-stream\\\"}\\n\\n\\ndef web_fetch(\\n    workspace: Workspace,\\n    config: Config,\\n    url: str,\\n    max_chars: int | None = None,\\n    start: int = 0,\\n    cancel: Any = None,\\n) -> dict[str, Any]:\\n    \\\"\\\"\\\"One page -> readable text; oversized pages continue at `start`.\\\"\\\"\\\"\\n    u = (url or \\\"\\\").strip()\\n    if not u:\\n        return {\\\"content\\\": \\\"ERROR: url is required\\\", \\\"error\\\": True}\\n    try:\\n        resp = _http_get(u, timeout=config.web_search_timeout, cancel=cancel)\\n    except WebError as e:\\n        return {\\\"content\\\": f\\\"ERROR: {_short(e)}\\\", \\\"error\\\": True}\\n    ctype = resp.content_type.split(\\\";\\\")[0].strip().lower()\\n    if ctype.startswith(_BINARY_TYPES) or ctype in _BINARY_EXACT:\\n        return {\\\"content\\\": f\\\"ERROR: unsupported content-type {ctype!r} (text pages only)\\\", \\\"error\\\": True}\\n    text = _decode_body(resp.body, resp.content_type)\\n    if \\\"html\\\" in ctype or (not ctype and text.lstrip()[:1] == \\\"<\\\"):\\n        extractor = _TextExtractor()\\n        extractor.feed(text)\\n        extractor.close()\\n        parts = ([f\\\"# {extractor.title}\\\"] if extractor.title else []) + [extractor.text() or \\\"(no extractable text; the page is probably JS-rendered)\\\"]\\n        page = \\\"\\\\n\\\\n\\\".join(parts)\\n    else:\\n        page = text\\n    limit = max(200, int(max_chars or config.read_max_chars))\\n    chunk, next_start = _window(page, int(start or 0), limit)\\n    if next_start is not None:\\n        remaining = len(page) - next_start\\n        chunk += f\\\"\\\\n... [{remaining} chars truncated; fetch again with start={next_start} to continue]\\\"\\n    prefix = f\\\"{resp.url}\\\\n\\\\n\\\" if resp.url.rstrip(\\\"/\\\") != urllib.parse.urlsplit(u).path and resp.url != u else \\\"\\\"\\n    return {\\\"content\\\": prefix + chunk}\",\"old_string\":\"def _available_backends(config: Config) -> tuple[str, ...]:\\n    \\\"\\\"\\\"The usable subset of the chain: keyless backends are always in.\\\"\\\"\\\"\\n    out = []\\n    for name in _DEFAULT_CHAIN:\\n        if name == \\\"tavily\\\" and not config.tavily_api_key:\\n            continue\\n        if name == \\\"searxng\\\" and not config.searxng_url:\\n            continue\\n        out.append(name)\\n    return tuple(out)\",\"path\":\"agent/tools/websearch.py\"}"}], "reasoning": "Piece 3 done (+112). Piece 4: the two tool entry points (web_search + web_fetch)."}
