{"type": "tool_result", "timestamp": 1789815395.1850982, "id": "fb02f91a0750", "tool_call_id": "call_423d04239ecc4202823fe64e", "content": "400:     url = \"https://html.duckduckgo.com/html/?\" + urllib.parse.urlencode({\"q\": query})\n401:     resp = get(url)\n402:     parser = _DdgParser()\n403:     parser.feed(_decode_body(resp.body, resp.content_type))\n404:     parser.close()\n405:     out = [r for r in parser.results if r[\"url\"]][:limit]\n406:     if not out:\n407:         raise BackendError(\"no results parsed (bot-checked, blocked, or layout changed)\")\n408:     return out\n409: \n410: \n411: # ---- HTTP MCP client (JSON-RPC over POST) ------------------------------------\n412: \n413: \n414: _MCP_PROTO = \"2025-03-26\"  # protocol version announced in the initialize call\n415: \n416: \n417: def _mcp_rpc(\n418:     url: str,\n419:     payload: dict,\n420:     session: str | None,\n421:     timeout: float,\n422:     cancel: Any = None,\n423: ) -> tuple[dict, str | None]:\n424:     \"\"\"One JSON-RPC POST to an HTTP MCP server; returns (response, session id).\n425: \n426:     Deliberately NOT routed through _http_get: the private-network guard exists\n427:     for model-controlled URLs, while this endpoint comes from operator config\n428:     and is typically loopback. Every failure surfaces as WebError so callers\n429:     treat MCP problems like any other backend failure.\n430:     \"\"\"\n431:     if cancel is not None and cancel.is_set():\n432:         raise WebError(\"aborted by user\")\n433:     body = json.dumps(payload).encode(\"utf-8\")\n434:     headers = {\n435:         \"Content-Type\": \"application/json\",\n436:         \"Accept\": \"application/json, text/event-stream\",\n437:     }\n438:     if session:\n439:         headers[\"Mcp-Session-Id\"] = session\n440:     request = urllib.request.Request(url, data=body, headers=headers, method=\"POST\")\n441:     try:\n442:         resp = urllib.request.urlopen(request, timeout=timeout)\n443:     except urllib.error.HTTPError as e:\n444:         raise WebError(f\"HTTP {e.code} from MCP server {url}\") from e\n445:     except urllib.error.URLError as e:\n446:         reason = getattr(e, \"reason\", e)\n447:         if isinstance(reason, (socket.timeout, TimeoutError)):\n448:             raise WebError(f\"MCP server timed out after {timeout:.0f}s: {url}\")\n449:         raise WebError(f\"MCP server unreachable ({reason}): {url}\") from e\n450:     except (ValueError, OSError) as e:\n451:         raise WebError(f\"MCP request failed ({e}): {url}\") from e\n452:     with resp:\n453:         raw = _drain(resp, cancel, _MAX_BYTES)\n454:     sid = resp.headers.get(\"Mcp-Session-Id\") or session\n455:     text = _decode_body(raw, resp.headers.get(\"Content-Type\", \"\"))\n456:     if text.startswith(\"event:\") or text.startswith(\"data:\") or \"\\ndata:\" in text[:2048]:\n457:         # SSE-framed reply: keep the last data frame (the JSON-RPC response)\n458:         frames = [ln[5:].strip() for ln in text.splitlines() if ln.startswith(\"data:\")]\n459:         text = frames[-1] if frames else \"\"\n460:     if not text.strip():\n461:         return {}, sid  # e.g. 202 Accepted for a notification\n462:     try:\n463:         data = json.loads(text)\n464:     except ValueError as e:\n465:         raise WebError(f\"MCP server returned non-JSON: {_short(e)}\") from e\n466:     if isinstance(data, dict) and data.get(\"error\") is not None:\n467:         err = data[\"error\"]\n468:         msg = err.get(\"message\", str(err)) if isinstance(err, dict) else str(err)\n469:         raise WebError(f\"MCP error: {_short(msg)}\")\n470:     return (data if isinstance(data, dict) else {}), sid\n471: \n472: \n473: def _mcp_call(\n474:     url: str,\n475:     tool: str,\n476:     args: dict,\n477:     timeout: float,\n478:     cancel: Any = None,\n479: ) -> Any:\n480:     \"\"\"initialize -> tools/call against an HTTP MCP server; returns the parsed\n481:     tool output (JSON when it parses, else the plain text).\"\"\"\n482:     hello = {\n483:         \"jsonrpc\": \"2.0\",\n484:         \"id\": 1,\n485:         \"method\": \"initialize\",\n486:         \"params\": {\n487:             \"protocolVersion\": _MCP_PROTO,\n488:             \"capabilities\": {},\n489:             \"clientInfo\": {\"name\": \"clutch\", \"version\": \"0.1\"},\n490:         },\n491:     }\n492:     _, session = _mcp_rpc(url, hello, None, timeout, cancel)\n493:     if session:\n494:         _mcp_rpc(\n495:             url,\n496:             {\"jsonrpc\": \"2.0\", \"method\": \"notifications/initialized\"},\n497:             session,\n498:             timeout,\n499:             cancel,\n500:         )\n501:     resp, _ = _mcp_rpc(\n502:         url,\n503:         {\n504:             \"jsonrpc\": \"2.0\",\n505:             \"id\": 2,\n506:             \"method\": \"tools/call\",\n507:             \"params\": {\"name\": tool, \"arguments\": args},\n508:         },\n509:         session,\n510:         timeout,\n511:         cancel,\n512:     )\n513:     result = resp.get(\"result\") or {}\n514:     parts = result.get(\"content\") or []\n515:     text = \"\\n\".join(\n516:         p.get(\"text\", \"\") for p in parts if isinstance(p, dict) and p.get(\"type\") == \"text\"\n517:     ).strip()\n518:     if result.get(\"isError\") and text:\n519:         raise WebError(f\"MCP tool error: {_short(text)}\")\n520:     try:\n521:         return json.loads(text)\n522:     except ValueError:\n523:         return text\n524: \n525: \n526: # ---- registry ---------------------------------------------------------------\n527: # One protocol for every source: a Backend knows how to search and whether it\n528: # exists on this machine. web_search only ever sees this shape, so adding a\n529: # source (e.g. an MCP service) touches nothing else in this module.\n530: \n531: \n532: @dataclass(frozen=True)\n533: class Backend:\n534:     name: str\n535:     search: Callable[[str, int, Config, Callable[..., HttpResp]], list[dict[str, str]]]\n536:     available: Callable[[Config], bool] = lambda config: True\n537: \n538: \n539: _BACKENDS: dict[str, Backend] = {\n540:     \"tavily\": Backend(\"tavily\", _tavily, lambda c: bool(c.tavily_api_key)),\n541:     \"searxng\": Backend(\"searxng\", _searxng, lambda c: bool(c.searxng_url)),\n542:     \"bing\": Backend(\"bing\", _bing),\n543:     \"ddg\": Backend(\"ddg\", _ddg),\n544: }\n545: # Base try order; the live chain is this filtered through Backend.available.\n546: _DEFAULT_CHAIN = tuple(_BACKENDS)\n547: \n548: \n549: def _mcp_backend(provider: McpProvider) -> Backend:\n550:     \"\"\"Adapt an MCP provider to the uniform Backend shape.\"\"\"\n551: \n552:     def search(q: str, limit: int, config: Config, get: Callable[..., HttpResp]) -> list[dict[str, str]]:\n553:         cancel = (getattr(get, \"keywords\", None) or {}).get(\"cancel\")\n554:         data = _mcp_call(\n555:             provider.url_for(config),\n556:             provider.search_tool,\n557:             provider.search_args(q, limit),\n558:             config.web_search_timeout,\n559:             cancel=cancel,\n560:         )\n561:         rows = provider.map_results(data)\n562:         if not rows:\n563:             raise BackendError(f\"no results for {q!r} (empty feed or unmapped payload)\")\n564:         return rows[:limit]\n565: \n566:     return Backend(provider.name, search, lambda c, p=provider: bool(p.url_for(c)))\n567: \n568: \n569: for _p in MCP_PROVIDERS.values():\n570:     _BACKENDS[_p.name] = _mcp_backend(_p)\n571: \n572: \n573: def _available_backends(config: Config) -> tuple[str, ...]:\n574:     \"\"\"The usable subset of the chain: registered AND configured on this machine.\n575: \n576:     Rendered into prompts and error texts, so an unconfigured service simply\n577:     does not exist here — no name, no install advice.\n578:     \"\"\"\n579:     return tuple(b.name for b in _BACKENDS.values() if b.available(config))\n580: \n581: \n582: # Public alias: server and registry render UI/prompt text from this too.\n583: available_backends = _available_backends\n584: \n585: \n586: def mcp_status(url: str, provider: McpProvider, timeout: float = 3.0) -> Any:\n587:     \"\"\"Query a provider's status tool (e.g. login state); raw parsed payload.\n588: \n589:     Raises WebError on any failure — the caller turns that into a status row,\n590:     never into user-facing advice.\n591:     \"\"\"\n592:     if not provider.status_tool:\n593:         return None\n594:     return _mcp_call(url, provider.status_tool, {}, timeout)\n595: \n596: \n597: def _short(reason: object) -> str:\n598:     return re.sub(r\"\\s+\", \" \", str(reason)).strip()[:160]\n599: \n600: \n601: def web_search(\n602:     workspace: Workspace,\n603:     config: Config,\n604:     query: str,\n605:     max_results: int | None = None,\n606:     backend: str = \"\",\n607:     cancel: Any = None,\n608: ) -> dict[str, Any]:\n609:     \"\"\"Search the web; backends fall through in order until one yields.\"\"\"\n... (showing lines 400-609 of 689; use offset=610 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789815395.189195, "id": "ac28caa137d6", "tool_call_id": "call_b7fdb3565ae349f486331332", "content": "60:     compaction_enabled: bool = True\n61:     compaction_model: str | None = None  # None = the main model\n62: \n63:     # Tool execution\n64:     command_timeout: float = 30.0\n65:     output_limit: int = 6000\n66:     output_head: int = 2500\n67:     output_tail: int = 2500\n68:     read_max_chars: int = 20000\n69: \n70:     # Web access (tools/websearch.py): keyless out of the box (Bing RSS -> DDG\n71:     # HTML); better backends activate automatically once their env is present\n72:     web_search_timeout: float = 15.0\n73:     web_search_max_results: int = 8\n74:     # Tavily (https://tavily.com, LLM-first search API, free tier)\n75:     tavily_api_key: str | None = field(\n76:         default_factory=lambda: os.environ.get(\"CLUTCH_TAVILY_API_KEY\") or os.environ.get(\"TAVILY_API_KEY\")\n77:     )\n78:     # Self-hosted SearXNG instance exposing format=json (searxng/searxng)\n79:     searxng_url: str = field(\n80:         default_factory=lambda: (\n81:             os.environ.get(\"CLUTCH_SEARXNG_URL\") or os.environ.get(\"SEARXNG_URL\") or \"\"\n82:         ).rstrip(\"/\")\n83:     )\n84:     # Optional MCP tool servers doubling as search backends, keyed by provider\n85:     # name (see tools/mcpprovider.py), e.g. {\"xiaohongshu\": \"http://localhost:18060/mcp\"}.\n86:     # Populated from settings.json keys mcp_<name> or CLUTCH_MCP_<NAME>_URL;\n87:     # empty means the backend does not exist on this machine at all.\n88:     mcp_urls: dict[str, str] = field(default_factory=dict)\n89: \n90:     # Agent mode: \"work\" = full toolset, \"chat\" = read-only (whitelist + memory + skills)\n91:     mode: str = \"work\"\n92: \n93:     # Commands that hang in a non-TTY pipe\n94:     blocked_prefixes: list[str] = field(\n95:         default_factory=lambda: [\n96:             \"vim\",\n97:             \"vi\",\n98:             \"emacs\",\n99:             \"nano\",\n100:             \"less\",\n101:             \"more\",\n102:             \"tail -f\",\n103:             \"top\",\n104:             \"htop\",\n105:             \"make\",\n106:         ]\n107:     )\n108: \n109:     # Runtime\n110:     port: int = 8890\n111:     host: str = \"127.0.0.1\"  # bind address; 0.0.0.0 exposes the API to other devices\n112:     # Skills: catalog in the system prompt; loaded on demand via load_skill\n113:     enable_skills: bool = True\n114:     skills_dir: Path = Path(__file__).resolve().parent / \"skills\"\n115:     # Permission: confirm risky actions with the user, not a sandbox\n116:     non_interactive: bool = False  # auto-allow (used by eval harness / unattended runs)\n117: \n118:     def truncate(self, text: str) -> str:\n119:         \"\"\"Head/tail trim oversized output; the middle is replaced with an omitted note.\"\"\"\n... (showing lines 60-119 of 123; use offset=120 to continue)", "is_error": false, "diff": ""}
