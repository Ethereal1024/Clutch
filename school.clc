         if sess is None:\n526:             return False\n527:         self._kill(sess.proc, sess.job)\n528:         _log(f\"[supervisor] session {session_id} stopped\")\n529:         return True\n530: \n531:     def heartbeat(self, session_id: str | None) -> bool:\n532:         if not session_id:\n533:             return False\n534:         with self._lock:\n535:             sess = self.sessions.get(session_id)\n536:             if sess is None:\n537:                 return False\n538:             sess.last_beat = time.time()\n539:         return True\n540: \n541:     def shutdown_all(self) -> None:\n542:         \"\"\"Best effort: kill every session child (idle exit / SIGTERM).\"\"\"\n543:         with self._lock:\n544:             sids = list(self.sessions.keys())\n545:         for sid in sids:\n546:             self.stop_session(sid)\n547: \n548:     # ---- reaper: stale sessions + idle self-exit ----\n549: \n550:     def reap_loop(self) -> None:\n551:         # an unhandled exception here would strand the supervisor and leak\n552:         # session children; log and keep going\n553:         while not self.exit_event.is_set():\n554:             try:\n555:                 now = time.time()\n556:                 stale: list[str] = []\n557:                 with self._lock:\n558:                     for sid, sess in list(self.sessions.items()):\n559:                         if now - sess.last_beat > self.stale_s:\n560:                             stale.append(sid)\n561:                     n = len(self.sessions)\n562:                     exit_when_idle = self.exit_when_idle\n563:                 for sid in stale:\n564:                     _log(f\"[supervisor] reaping stale session {sid}\")\n565:                     self.stop_session(sid)\n566:                 if n == 0 and (exit_when_idle or now - self.last_activity > self.idle_timeout_s):\n567:                     _log(\"[supervisor] idle, exiting\")\n568:                     self.exit_event.set()\n569:                     break\n570:             except Exception as e:  # noqa: BLE001 - a broken pass must not kill the reaper\n571:                 _log(f\"[supervisor] reap_loop error: {e}\")\n572:             self.exit_event.wait(self.reap_interval_s)\n573: \n574:     # ---- internals ----\n575: \n576:     def _wait_port(self, proc: subprocess.Popen) -> int | None:\n577:         \"\"\"Read the child's stdout until the port banner appears, forwarding\n578:         lines to our stdout so the pipe never fills. Banner detection is\n579:         decoupled from forwarding so a blocked stdout can't delay the banner.\"\"\"\n580:         q: \"queue.Queue[int]\" = queue.Queue()\n581:         sink: \"queue.Queue[str]\" = queue.Queue()\n582: \n583:         def reader() -> None:\n584:             try:\n585:                 for raw in proc.stdout:\n586:                     line = raw.decode(\"utf-8\", \"replace\")\n587:                     m = PORT_BANNER_RE.search(line)\n588:                     if m:\n589:                         q.put(int(m.group(1)))\n590:                     sink.put(line)\n591:             except Exception:  # noqa: BLE001 - pipe closed, child gone\n592:                 pass\n593: \n594:         def forwarder() -> None:\n595:             while True:\n596:                 try:\n597:                     line = sink.get()\n598:                 except Exception:  # noqa: BLE001\n599:                     return\n600:                 try:\n601:                     sys.stdout.write(line)\n602:                     sys.stdout.flush()\n603:                 except (OSError, ValueError):  # stdout gone: stop forwarding\n604:                     return\n605: \n606:         threading.Thread(target=reader, daemon=True).start()\n607:         threading.Thread(target=forwarder, daemon=True).start()\n608:         try:\n609:             return q.get(timeout=self.start_timeout_s)\n610:         except queue.Empty:\n611:             return None\n612: \n613:     @staticmethod\n614:     def _