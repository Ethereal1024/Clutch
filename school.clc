{"type": "tool_result", "timestamp": 1789815461.4387295, "id": "4bd9499f7a55", "tool_call_id": "call_8f554416395549878faae122", "content": "\"\"\"Offline checks for the MCP web-search plugin layer (loopback HTTP only).\n\nRun: python -m tests.mcpbackend_test\n\nCovers: provider URL resolution (settings > env), result mapping tolerance,\nthe JSON-RPC client (handshake, session id, SSE frames, plain-text and error\npaths) against a real loopback server, backend gating (an MCP backend exists\nonly when configured — and is named nowhere when it is not), error-as-data\ndegradation, and dynamic rendering of prompt + schema.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport sys\nimport threading\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\n\nimport agent.tools.websearch as ws\nfrom agent.config import Config\nfrom agent.server import _login_state, _mcp_keys_from, _split_mcp_fields, mcp_providers\nfrom agent.tools.mcpprovider import MCP_PROVIDERS\nfrom agent.tools.registry import build_default_tools\nfrom tests.testsupport import check\n\n\n# ---- loopback MCP server ------------------------------------------------------\n\nclass _Handler(BaseHTTPRequestHandler):\n    \"\"\"Scripted MCP server: initialize -> initialized -> tools/call.\"\"\"\n\n    behavior = \"json\"  # json | sse | text | error | rpcerror | empty\n\n    def log_message(self, *a):  # silence the test run\n        pass\n\n    def do_POST(self):  # noqa: N802 (stdlib naming)\n        length = int(self.headers.get(\"Content-Length\", 0))\n        body = json.loads(self.rfile.read(length) or b\"{}\")\n        method = body.get(\"method\", \"\")\n\n        if method == \"initialize\":\n            payload = {\"jsonrpc\": \"2.0\", \"id\": 1, \"result\": {\"protocolVersion\": ws._MCP_PROTO}}\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"application/json\")\n            self.send_header(\"Mcp-Session-Id\", \"sess-42\")\n            self.end_headers()\n            self.wfile.write(json.dumps(payload).encode())\n            return\n\n        if method == \"notifications/initialized\":\n            self.send_response(202)\n            self.end_headers()\n            return\n\n        call = self.path.strip(\"/\") or _Handler.behavior\n        if call == \"error\":\n            self.send_response(500)\n            self.end_headers()\n            self.wfile.write(b\"boom\")\n            return\n        if call == \"rpcerror\":\n            payload = {\"jsonrpc\": \"2.0\", \"id\": 2, \"error\": {\"code\": -32602, \"message\": \"bad params\"}}\n        elif call == \"text\":\n            payload = {\"jsonrpc\": \"2.0\", \"id\": 2, \"result\": {\"content\": [{\"type\": \"text\", \"text\": \"just words\"}]}}\n        elif call == \"empty\":\n            self.send_response(202)\n            self.end_headers()\n            return\n        else:\n            rows = json.dumps([{\"id\": \"abc\", \"title\": \"Note\", \"desc\": \"d\", \"xsec_token\": \"T\"}])\n            payload = {\"jsonrpc\": \"2.0\", \"id\": 2, \"result\": {\"content\": [{\"type\": \"text\", \"text\": rows}]}}\n        text = json.dumps(payload)\n        if call == \"sse\":\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream\")\n            self.end_headers()\n            self.wfile.write(f\"event: message\\ndata: {text}\\n\\n\".encode())\n            return\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.end_headers()\n        self.wfile.write(text.encode())\n\n\ndef main() -> None:\n    xhs = MCP_PROVIDERS[\"xiaohongshu\"]\n\n    # 1. URL resolution: config dict wins over env, trailing / stripped\n    check(xhs.url_for(Config()) == \"\", \"provider without config resolves to ''\")\n    os.environ[\"CLUTCH_MCP_XIAOHONGSHU_URL\"] = \"http://env.example/mcp\"\n    try:\n        check(xhs.url_for(Config()) == \"http://env.example/mcp\", \"env CLUTCH_MCP_<NAME>_URL is the fallback\")\n    finally:\n        del os.environ[\"CLUTCH_MCP_XIAOHONGSHU_URL\"]\n    cfg = Config()\n    cfg.mcp_urls[\"xiaohongshu\"] = \"http://localhost:18060/mcp/\"\n    check(xhs.url_for(cfg) == \"http://localhost:18060/mcp\", \"config beats env; trailing / stripped\")\n\n    # 2. result mapping: bare list and envelopes map; junk tolerated; token kept\n    feeds = [\n        {\"id\": \"abc\", \"title\": \"Note\", \"desc\": \"body\", \"xsec_token\": \"T0K\"},\n        {\"note_id\": \"n2\", \"title\": \"Second\", \"desc\": \"d2\"},\n        {\"title\": \"no id, dropped\"},\n        \"junk\",\n    ]\n    rows = xhs.map_results(feeds)\n    check(len(rows) == 2, \"mapping keeps only rows with an id\")\n    check(\n        rows[0][\"url\"] == \"https://www.xiaohongshu.com/explore/abc?xsec_token=T0K\",\n        \"mapping keeps xsec_token in the url\",\n    )\n    check(rows[1][\"url\"] == \"https://www.xiaohongshu.com/explore/n2\", \"mapping works without a token\")\n    check(xhs.map_results({\"data\": feeds}) == rows, \"mapping unwraps a data envelope\")\n    check(xhs.map_results({\"nope\": 1}) == [], \"mapping yields nothing on unknown shapes\")\n\n    # 3. settings-field helpers (server side)\n    body = {\"mcp_xiaohongshu\": \" http://localhost:18060/mcp/ \", \"mcp_bad\": \"ftp://x\", \"model\": \"m\"}\n    try:\n        _split_mcp_fields(body)\n        check(False, \"non-http mcp url rejected\")\n    except ValueError:\n        check(True, \"non-http mcp url rejected\")\n    clean = _split_mcp_fields({\"mcp_xiaohongshu\": \" http://h/mcp/ \", \"mcp_off\": \"\", \"api_key\": \"k\"})\n    check(clean == {\"mcp_xiaohongshu\": \"http://h/mcp\", \"mcp_off\": \"\"}, \"mcp fields normalized ('' clears)\")\n    check(_mcp_keys_from({\"mcp_x\": \"http://h\", \"base_url\": \"b\"}) == {\"mcp_x\": \"http://h\"}, \"mcp keys read back\")\n    check(_login_state({\"login\": True}) is True and _login_state({\"status\": \"logged_in\"}) is True,\n          \"login state normalized from common shapes\")\n    check(_login_state({\"whatever\": 1}) is None and _login_state(None) is None, \"unknown login shape -> None\")\n\n    # 4. JSON-RPC client against a real loopback server\n    srv = HTTPServer((\"127.0.0.1\", 0), _Handler)\n    threading.Thread(target=srv.serve_forever, daemon=True).start()\n    base = f\"http://127.0.0.1:{srv.server_port}\"\n    try:\n        data = ws._mcp_call(base + \"/\", \"search_feeds\", {\"keyword\": \"q\"}, 5.0)\n        check(isinstance(data, list) and data[0][\"id\"] == \"abc\", \"tools/call result parses as json\")\n\n        _Handler.behavior = \"sse\"\n        data = ws._mcp_call(base + \"/sse\", \"search_feeds\", {}, 5.0)\n        check(isinstance(data, list) and data[0][\"id\"] == \"abc\", \"SSE-framed reply handled\")\n\n        _Handler.behavior = \"text\"\n        check(ws._mcp_call(base + \"/text\", \"t\", {}, 5.0) == \"just words\", \"non-json text passes through\")\n\n        _Handler.behavior = \"empty\"\n        check(ws._mcp_call(base + \"/empty\", \"t\", {}, 5.0) == \"\", \"empty body (202) tolerated\")\n\n        _Handler.behavior = \"rpcerror\"\n        try:\n            ws._mcp_call(base + \"/rpcerror\", \"t\", {}, 5.0)\n            check(False, \"jsonrpc error raises WebError\")\n        except ws.WebError:\n            check(True, \"jsonrpc error raises WebError\")\n\n        _Handler.behavior = \"error\"\n        try:\n            ws._mcp_call(base + \"/error\", \"t\", {}, 5.0)\n            check(False, \"HTTP 500 raises WebError\")\n        except ws.WebError as e:\n            check(\"500\" in str(e), \"HTTP 500 raises a factual WebError\")\n\n        try:\n            ws._mcp_call(\"http://127.0.0.1:1/mcp\", \"t\", {}, 1.0)\n            check(False, \"refused connection raises WebError\")\n        except ws.WebError as e:\n            check(\"unreachable\" in str(e) or \"timed out\" in str(e), \"refused connection is a factual status\")\n    finally:\n        srv.shutdown()\n        srv.server_close()\n\n    # 5. gating: unconfigured -> the backend does not exist anywhere\n    plain = Config()\n    avail = ws.available_backends(plain)\n    check(\"xiaohongshu\" not in avail, \"unconfigured mcp backend absent from the chain\")\n    check(\"bing\" in avail and \"ddg\" in avail, \"keyless backends always available\")\n    r = ws.web_search(None, plain, \"q\", backend=\"xiaohongshu\")\n    check(r.get(\"error\") and \"available: \" in r[\"content\"], \"pinning an unconfigured backend errors factually\")\n    check(\"install\" not in r[\"content\"].lower() and \"needs CLUTCH_\" not in r[\"content\"],\n          \"error never suggests installing or setting env vars\")\n    check(\"searxng\" not in r[\"content\"], \"unconfigured siblings are not named either\")\n    r = ws.web_search(None, plain, \"q\", backend=\"nope\")\n    check(r.get(\"error\") and \"available: \" in r[\"content\"] and \"needs CLUTCH_\" not in r[\"content\"],\n          \"unknown backend lists only the real ones, no setup advice\")\n\n    # 6. configured -> the backend joins the chain and serves mapped results\n    cfg2 = Config()\n    cfg2.mcp_urls[\"xiaohongshu\"] = base  # server is shut down: status-only impact below\n    check(\"xiaohongshu\" in ws.available_backends(cfg2), \"configured mcp backend joins the chain\")\n\n    real_rpc = ws._mcp_rpc\n\n    def fake_rpc(url, payload, session, timeout, cancel=None):\n        if payload.get(\"method\") == \"initialize\":\n            return {\"result\": {}}, \"sess-1\"\n        if payload.get(\"method\") == \"notifications/initialized\":\n            return {}, session\n        rows_json = json.dumps([{\"id\": \"f1\", \"title\": \"Found\", \"desc\": \"snippet\", \"xsec_token\": \"tk\"}])\n        return {\"result\": {\"content\": [{\"type\": \"text\", \"text\": rows_json}]}}, session\n\n    ws._mcp_rpc = fake_rpc\n    try:\n        r = ws.web_search(None, cfg2, \"note\", backend=\"xiaohongshu\")\n        check(\n            not r.get(\"error\") and \"Found\" in r[\"content\"] and \"xsec_token=tk\" in r[\"content\"],\n            \"web_search serves mapped mcp results end to end\",\n        )\n\n        def dead_rpc(*a, **k):\n            raise ws.WebError(\"MCP server unreachable (refused): http://localhost:18060/mcp\")\n\n        ws._mcp_rpc = dead_rpc\n        r = ws.web_search(None, cfg2, \"note\", backend=\"xiaohongshu\")\n        check(r.get(\"error\") and \"unreachable\" in r[\"content\"], \"mcp failure degrades to error-as-data\")\n    finally:\n        ws._mcp_rpc = real_rpc\n\n    # 7. prompt + schema render dynamically from the configured set\n    tools_plain = {t.name: t for t in build_default_tools(plain)}\n    tools_xhs = {t.name: t for t in build_default_tools(cfg2)}\n    check(\"xiaohongshu\" not in tools_plain[\"web_search\"].description,\n          \"prompt on an unconfigured host never names the mcp backend\")\n    check(\"xiaohongshu\" in tools_xhs[\"web_search\"].description,\n          \"prompt on a configured host names the mcp backend\")\n    check(\"bing | ddg\" in tools_plain[\"web_search\"].parameters[\"properties\"][\"backend\"][\"description\"],\n          \"schema backend param lists the real chain\")\n    check(len(mcp_providers()) == 1, \"server helper exposes the registry\")\n\n    print(\"all passed\")\n\n\nif __name__ == \"__main__\":\n    main()\n", "is_error": false, "diff": ""}
{"type": "assistant_message", "timestamp": 1789815812.6772435, "id": "9c777ede2d4b", "content": "全部上下文就绪。开始动手前最后确认三处：server_test 对 settings POST 的覆盖、pyproject 打包方式（presets 数据文件要进包）、设置弹窗的样式类。", "tool_calls": [{"id": "call_93a5df0306544fdab2c06df1", "name": "grep", "arguments": "{\"path\":\"tests/server_test.py\",\"pattern\":\"api/settings|mcp\"}"}, {"id": "call_582d7ccd448045e2a005cbf7", "name": "read_file", "arguments": "{\"limit\":30,\"offset\":38,\"path\":\"pyproject.toml\"}"}, {"id": "call_bf27f5da247f40c7850a98e3", "name": "read_file", "arguments": "{\"limit\":25,\"offset\":40,\"path\":\"ui/index.html\"}"}], "reasoning": "Now I have full context. Time to design the changes precisely.\n\n## Design\n\n### 1. `agent/tools/websearch.py` — make MCP backends config-driven\n\nChanges:\n- Import: `from .mcpprovider import McpService, parse_services, map_results as _map_service_results, search_args as _service_search_args` — actually simpler: `from .mcpprovider import McpService, parse_services` and call module functions.\n- `_mcp_backend(service: McpService) -> Backend`: \n  ```python\n  def _mcp_backend(service: McpService) -> Backend:\n      def search(q, limit, config, get):\n          cancel = ...\n          data = _mcp_call(service.url, service.search_tool, mcpprovider.search_args(service, q, limit), config.web_search_timeout, cancel=cancel)\n          rows = mcpprovider.map_results(service, data)\n          if not rows: raise BackendError(...)\n          return rows[:limit]\n      return Backend(service.name, search, lambda c, s=service: ...)\n  ```\n  Wait — availability: `Backend.available` is `Callable[[Config], bool]`. The service comes from config (`config.mcp_services`), so availability is \"service with this name exists in config.mcp_services and is complete() and enabled\". \n\n- The static `_BACKENDS` dict holds the 4 native backends. MCP backends are per-config, so:\n  ```python\n  _BACKENDS: dict[str, Backend] = {...native...}\n  \n  def _backends(config: Config) -> dict[str, Backend]:\n      \"\"\"Native backends plus this machine's configured MCP services.\"\"\"\n      out = dict(_BACKENDS)\n      for service, _errs in ... parse config.mcp_services\n      return out\n  ```\n  How should config carry services? Option A: `config.mcp_services: list[dict]` (raw records). Then websearch parses with `parse_services`. Option B: `config.mcp_services: list[McpService]` (already parsed). \n\n  Where does parsing happen? Config is a plain dataclass populated from settings in server.main(). The cleanest: Config stores raw records (`mcp_services: list[dict[str, Any]]`), and websearch parses them per call (cheap — a few records). But `_available_backends(config)` is called multiple times per request (registry build + web_search). Parsing a handful of records is microseconds; fine. But duplicate-name handling: parse_services dedupes and reports errors — errors should go somewhere. websearch shouldn't print; it should just skip broken records (factual absence — a broken record is an absent backend). parse_services already returns errors; websearch ignores them (or we could log). Since parse is lenient, skipping is the natural degradation.\n\n  Also MCP backends should join the chain AFTER the native ones (try native first, then MCP). Order: `_DEFAULT_CHAIN` = native tuple; MCP services appended in config order. That matches \"the live chain is this filtered through Backend.available\".\n\n  Wait — should MCP go before or after ddg? Previously (v0.1.14) `_BACKENDS[_p.name] = _mcp_backend(_p)` appended xiaohongshu at the END of the dict → chain order tavily, searxng, bing, ddg, xiaohongshu. Keep MCP last: native first, then services in declared order. Good.\n\n  Availability check per service: `service.enabled and service.complete()`. Since services come from config, the backend \"exists\" iff present in parsed services with url+search_tool.\n\n  Implementation:\n  ```python\n  def _config_backends(config: Config) -> list[Backend]:\n      services, _errors = parse_services(getattr(config, \"mcp_services\", None))\n      return [_mcp_backend(s) for s in services if s.enabled and s.complete()]\n\n  def _all_backends(config: Config) -> dict[str, Backend]:\n      out = dict(_BACKENDS)\n      for b in _config_backends(config):\n          out[b.name] = b\n      return out\n\n  def _available_backends(config):\n      return tuple(name for name, b in _all_backends(config).items() if b.available(config))\n  ```\n  And in `web_search`, replace `_BACKENDS[name].search(...)` with `_all_backends(config)[name].search(...)` — but that parses twice per call; fine, or build once at top: `backends = _all_backends(config)`. Careful: if backend not in backends (can't happen since chain comes from the same dict). Use `backends[name]`.\n\n  Also mcp_status: `def mcp_status(url, service, timeout=3.0)` using `service.status_tool`, and normalize via `mcpprovider.normalize_login(state, service.login_field)` — server's `_login_state` currently duplicates the truthy logic; the new engine has `normalize_login`. Server should use the engine's version: `_login_state` can delegate or be replaced. Memory design says server's status probe normalizes best-effort. Simplify: server imports `normalize_login` from mcpprovider and drops its own `_login_state`. But the test imports `_login_state` from agent.server... I'll rewrite the test anyway. Better: delete `_login_state` from server, import `normalize_login` as `_login_state` alias: `from .tools.mcpprovider import normalize_login as _login_state`. Clean.\n\n  Docstring header of websearch.py: the module docstring lists backends; add a line about operator-configured MCP services. Also mention in the chain order. Let me update lines 5-10 to add e.g.:\n  ```\n  plus any MCP tool services the operator declared in settings (mcp_services);\n  each joins the chain after the native backends.\n  ```\n\n### 2. `agent/config.py` — replace `mcp_urls` with `mcp_services`\n\n```python\n# Optional MCP tool servers doubling as search backends: a list of declarative\n# records (see tools/mcpprovider.py for the exact shape), stored in\n# settings.json under \"mcp_services\" and editable in the settings UI. A service\n# absent from this list does not exist anywhere in the product.\nmcp_services: list[dict[str, Any]] = field(default_factory=list)\n```\nNeed `Any` import in config.py? Check its imports. Probably `from typing import ...`? Let me check top of config.py later. Could use `list[dict]` to avoid the import.\n\nEnv var `CLUTCH_MCP_<NAME>_URL`: the old design resolved env per provider. The new declarative engine: do we keep env support? The memory design said \"_available_backends = registry AND configured (mcp_urls in Config, key prefix mcp_, env CLUTCH_MCP_<NAME>_URL, settings.json same key)\". The new engine's docstring says \"every MCP source is a declarative record from the settings file (Config.mcp_services)\". The old test checked env fallback. With records, env support could be: `CLUTCH_MCP_<NAME>_URL` — but what's NAME for a declarative record? The record's own name. So env could fill/override a record's url? That's weird. I think dropping env support is cleaner and consistent with the no-bias/data-driven model: settings.json is the single source. But the README previously documented `CLUTCH_MCP_<名字>_URL`. Since we're rewriting that README paragraph anyway, drop env and document settings/UI only. Hmm — but headless users (no UI) may want env. The UI writes settings.json; headless users can edit settings.json directly. Keep it simple: settings only. Wait, but the \"config.mcp_urls\" mention \"or CLUTCH_MCP_<NAME>_URL\" in config comment. I'll drop env — simpler, and the memory's newer design (the one that landed in mcpprovider.py docstring) says \"declarative record from the settings file\". The engine module docstring only mentions settings. Decision: settings.json `mcp_services` list only.\n\nHmm, wait — let me not over-decide. Is there value in env for containerized deployments? The server loads settings.json; a headless operator can also write ~/.clutch/settings.json. Fine. Drop env. Also update test accordingly.\n\nMigration of legacy `mcp_<name>` string keys: per memory, \"old mcp_xiaohongshu settings key converted one-time via preset\". Preset = DATA. So ship a presets data file. Where? `agent/mcp_presets.json`? Hmm, but \"shipping zero presets is acceptable\" — yet migration needs the xiaohongshu preset because the user's actual machine has `mcp_xiaohongshu` set. Wait — does it? The smoke test \"restored ~/.clutch/settings.json afterwards\" suggests the user's real settings.json may or may not have mcp_xiaohongshu. The user HAS a xiaohongshu MCP setup (memory: \"Xiaohongshu open-source access landscape\"; v0.1.14 shipped with xiaohongshu provider built in and the user then complained about the hardcode). So yes, their settings.json likely has `mcp_xiaohongshu: http://localhost:18060/mcp`.\n\nMigration design:\n- New key `mcp_services` (list of records) in settings.json.\n- Legacy `mcp_<name>` string keys: when loading, if a legacy key exists and `mcp_services` has no record with that name, and a preset with that name exists in the presets data file, synthesize a record = preset + url from the legacy key, append to mcp_services. After a successful save (settings POST writes `mcp_services`), legacy keys... hmm, when do we drop the legacy key? \"One-time\": once converted, the synthesized record persists in mcp_services (saved on next settings save). But if the user never saves settings, conversion happens on every boot (idempotent — converts again to same record, appended only if name not already in mcp_services). When should legacy keys be deleted from settings.json? If we delete on load, we mutate the file at boot (side effect at boot — currently main() only reads). Safer: keep legacy keys (harmless: `_split_mcp_fields`-era handling is gone; new code must NOT interpret `mcp_*` string keys as config anymore... wait, but then they linger). \n\n  Hmm, actually simpler: keep the legacy keys in the file but ignore them once mcp_services contains that name. The settings POST with the new UI writes mcp_services and could also clean up legacy `mcp_*` keys for names it persisted. Let me think about what's minimal and safe:\n\n  - `load_settings()` unchanged (raw dict).\n  - New helper in server (or config module?): `mcp_service_records(raw: dict) -> list[dict]`: parse raw[\"mcp_services\"] (validated), then for each legacy `mcp_<name>` string key not already covered, look up presets; if found append preset record with url; if not found... skip (factual absence). Return the record list.\n  - Boot: `config.mcp_services = mcp_service_records(load_settings())`.\n  - Settings GET: return the effective records for UI rendering.\n  - Settings POST: accept `mcp_services` (list of records from UI, validated via parse_services → store validated canonical records), and when saving, drop legacy `mcp_*` keys whose names are now covered by mcp_services (so the file converges). Keep other legacy keys? If a legacy key has no preset, it's dead weight — drop it too? Dropping data the user set... it's a legacy key of a removed feature; keeping it ignored is safer than deleting. But then GET shows nothing and POST keeps re-saving it forever. Meh. Decision: on POST save, drop ALL legacy `mcp_<name>` string keys whose name matches `[a-z0-9][a-z0-9_-]*` AND that are not preserved... hmm.\n\n  Wait, careful: `_mcp_keys_from` currently carries legacy keys across on save. New UI saves mcp_services. If we keep the legacy-carry logic, a legacy `mcp_xiaohongshu` key would persist forever AND the migration would keep re-synthesizing the service — actually that's fine as long as synthesis only happens when the name is NOT already in mcp_services. The user's edited/added services live in mcp_services. But if the user DELETES the xiaohongshu row in the UI (removes it from mcp_services), the legacy key would resurrect it on next boot! That's bad — deletion must stick.\n\n  So: when the UI saves mcp_services, legacy keys for saved names must be removed from settings.json. And conversion must only happen when the name is absent from mcp_services. Deletion flow: user removes row → POST mcp_services without it → save drops legacy mcp_xiaohongshu key → next boot no resurrection. \n\n  Simpler alternative: do the conversion ONCE at load time and immediately rewrite settings.json (migrate + drop legacy keys). \"One-time\" literally. But writing settings at boot is a side effect; the boot path currently never writes settings. Also concurrency: server may run while... eh. The POST-based convergence avoids boot writes: legacy keys only get cleaned when the user saves settings, until then conversion is idempotent per boot. Deletion stickiness: if user deletes a service that came from a legacy key, POST must drop the legacy key. So POST logic: when `mcp_services` is present in the body, the saved file gets mcp_services = validated records, and legacy `mcp_<name>` keys are dropped for names that are NOT... hmm wait. If user deletes xiaohongshu, mcp_services=[] or without it; POST drops legacy key mcp_xiaohongshu → good. What if user never touches mcp_services in a POST (e.g. saves only api_key)? Then legacy keys carried across as before (current behavior via _mcp_keys_from) and no resurrection issue since mcp_services wasn't touched.\n\n  Rule: legacy `mcp_<name>` keys are carried across on save UNLESS the body contains `mcp_services`, in which case legacy keys are all dropped (the services list is now the single source of truth; anything not in it is deleted, and its preset-backed legacy key must go so deletion sticks). Wait — but dropping ALL legacy keys when mcp_services is posted: is there a legacy key that mcp_services doesn't cover and that should survive? Legacy keys only ever held URLs of the built-in providers (v0.1.14: just xiaohongshu). With the conversion having synthesized records for preset-matched keys at boot, by the time the user saves from the settings UI, mcp_services already contains those records (GET returned them; UI round-trips them). So a POST with mcp_services covers everything; dropping all legacy keys is correct convergence. And a POST without mcp_services carries legacy keys as before. \n\n  Hmm, but one more scenario: headless user edits settings.json adding `mcp_xiaohongshu` manually after the new version... presets still convert it. OK.\n\n  Now — where does the preset data live? `agent/mcp_presets.json`? Wait, actually... let me reconsider whether presets are needed at all. The no-bias memory says \"shipping zero presets is acceptable\" and migration \"via preset\". The point of the preset file is only to migrate the user's own existing config. Alternatives: document a manual migration (README note: \"old mcp_<name> keys: re-add the service in settings\"). But the user experience regression: their working backend silently dies after upgrade. The memory says the agreed plan is preset-based conversion. Let me follow it: ship `agent/mcp_presets.json` with the xiaohongshu record (data, editable/deletable). Code references only \"presets\" generically.\n\n  Hmm wait, actually — is a shipped preset file itself a \"bias\" violation? The memory says: \"Any built-in platform presets must be editable/deletable DATA (e.g. presets.json), never code; shipping zero presets is acceptable.\" So shipping a presets.json WITH xiaohongshu is explicitly sanctioned as DATA. And it only ACTIVATES when the operator's settings already reference the name (legacy key). It never surfaces anywhere unprompted: UI \"+ add service\" rows are blank; presets do not appear as suggestions... wait, should presets prefill the \"+ add service\" UI? No — that would surface the name on unconfigured hosts (bias). Presets exist purely for migration of legacy keys. Keep them invisible unless the name is already configured.\n\n  Where does the preset lookup code live? mcpprovider.py (import-safe, stdlib only) — `load_presets()` reading a JSON file next to the module. Or in server.py directly. server.py already imports mcpprovider. Put it in mcpprovider.py:\n\n  ```python\n  _PRESETS_PATH = Path(__file__).with_name(\"mcp_presets.json\")\n\n  def presets() -> dict[str, dict]:\n      \"\"\"Built-in starter records, DATA not code ... missing/invalid file -> {}\"\"\"\n  ```\n  Hmm, needs pathlib import. Fine, stdlib. And a migration helper:\n\n  ```python\n  def migrate_services(raw: Any, legacy_urls: dict[str, str]) -> tuple[list[dict], bool]:\n      \"\"\"settings -> canonical mcp_services records; legacy mcp_<name> URL keys\n      are converted once via presets. Returns (records, mutated).\"\"\"\n  ```\n  Hmm, where's the boundary? Let me keep server.py thin and put the mechanics in mcpprovider.py:\n\n  ```python\n  def service_records(settings: dict) -> tuple[list[dict], list[str]]:\n      \"\"\"Canonical mcp_services records for a raw settings dict: the declared\n      list, plus any legacy mcp_<name> URL keys converted through presets.\n      Returns (records, names_of_legacy_keys_consumed).\"\"\"\n  ```\n  Second element = legacy key names that were converted (so the settings POST knows which legacy keys are covered... but I decided: POST with mcp_services drops ALL legacy keys). Hmm, do I even need the consumed list? For the POST-drop-all-legacy decision, no. Keep the return simple: just records.\n\n  Wait, also: should `service_records` validate? The records go into Config.mcp_services as dicts, parsed later by websearch.parse_services. Synthesized preset records are valid by construction. Declared list records: pass through as-is; parse_services skips junk later (factual absence) — but the settings POST should validate at save time (so the UI gets an error). OK.\n\n  Let me define in mcpprovider.py:\n\n  ```python\n  def presets() -> dict[str, dict[str, Any]]:\n      \"\"\"Declarative starter records shipped as data (agent/mcp_presets.json).\n\n      Data, never code: an operator may edit or delete the file, and a record\n      activates only when the settings name it (a legacy mcp_<name> URL key or\n      an mcp_services entry). Nothing here is suggested, rendered or named\n      anywhere else.\n      \"\"\"\n\n  def service_records(settings: Mapping[str, Any]) -> list[dict[str, Any]]:\n      \"\"\"Effective mcp_services records from a raw settings dict: the declared\n      list first, then legacy mcp_<name> URL keys converted via presets (only\n      for names not already declared, and only when a preset exists).\"\"\"\n  ```\n\n  Implementation of service_records:\n  ```python\n  def service_records(settings):\n      raw = settings.get(\"mcp_services\")\n      records = [r for r in raw if isinstance(r, dict)] if isinstance(raw, list) else []\n      known = {str(r.get(\"name\", \"\")).strip().lower() for r in records}\n      out = list(records)\n      for key, value in settings.items():\n          if not key.startswith(\"mcp_\") or not isinstance(value, str) or not value.strip():\n              continue\n          name = key[4:].strip().lower()\n          if not name or name in known or not _NAME_RE.match(name):\n              continue\n          preset = presets().get(name)\n          if not preset:\n              continue\n          record = dict(preset)\n          record[\"name\"] = name\n          record[\"url\"] = value.strip().rstrip(\"/\")\n          out.append(record)\n          known.add(name)\n      return out\n  ```\n\n  Hmm, presets().get(name) — preset records must not carry a url? Or preset url is a default (e.g. \"http://localhost:18060/mcp\")? If the preset carries a default url, then a legacy key just overrides it. And could a preset be activated WITHOUT any settings key? No — service_records only consults presets for names present in settings. Good: preset data never activates itself.\n\n  Should preset include url? For xiaohongshu-mcp the default endpoint is http://localhost:18060/mcp. Include it as \"url\" so `record[\"url\"] = legacy value` overrides. Fine.\n\n  Caching presets(): read once per call is fine (small file, called rarely). But called per web_search? No — service_records is called at boot and in settings GET/POST. websearch parses Config.mcp_services (already records). OK, no cache needed; still, a tiny `functools.lru_cache`-style cache? mcpprovider must stay import-safe stdlib — functools is stdlib. But cache breaks the \"editable file\" story (edits require restart). Read fresh each time; it's tiny.\n\n### 3. `agent/server.py`\n\n- Import line 46: `from .tools.mcpprovider import MCP_PROVIDERS as _MCP_PROVIDER_REGISTRY` → `from .tools.mcpprovider import normalize_login as _login_state` — wait there's already a `_login_state` def at line 110; replace it with the import alias, or keep the def but delegate. Cleanest: import `normalize_login as _login_state` and delete the local def. But `_login_state(state)` in server took 1 arg; engine's takes (state, login_field=\"\"). Call sites pass login_field: `row[\"login\"] = _login_state(state, svc.login_field)`.\n- Import `service_records` too: `from .tools.mcpprovider import service_records as _mcp_service_records, normalize_login as _login_state`.\n- Delete `mcp_providers()` (line 83-85), `_split_mcp_fields` (88-102), `_mcp_keys_from` (105-107), `_login_state` (110-~125).\n\n  Wait — `_mcp_keys_from` is used at line 396 (carry legacy keys across on save) and 847 (boot). Boot now uses service_records. The save-carry logic needs replacement:\n\n  New `_split_mcp_fields(body)` replacement: pull `mcp_services` list from body:\n  ```python\n  def _services_from(body: dict) -> list[dict] | None:\n      \"\"\"The mcp_services list from a settings POST body; None = not touched.\n      Each record is validated with parse_service, then canonicalized.\"\"\"\n      if \"mcp_services\" not in body:\n          return None\n      raw = body[\"mcp_services\"]\n      if not isinstance(raw, list):\n          raise ValueError(\"mcp_services must be a list of service objects\")\n      services, errors = parse_services(raw)\n      if errors:\n          raise ValueError(\"; \".join(errors[:3]))  # hmm\n      return [s.record() for s in services]\n  ```\n  Hmm, error reporting: parse_services skips bad entries with errors. For a settings POST, failing the whole save on one bad record? The UI sends what it rendered, so records should be valid; a hard error surfaces to the user. But partial-accept (skip bad, save good) loses data silently. Hard error is honest. But error text: parse_services errors contain indexes: \"service[2]: name must match...\". Good enough: `raise ValueError(\"; \".join(errors))`. Hmm, maybe limit to first 3.\n\n  Also: UI-created new services may have empty url (user added a row but didn't fill it) — parse_service allows url=\"\" (incomplete → never joins chain). Should saving a url-less record be allowed? It'd sit in settings inert. Better: allow (it's a draft), it simply doesn't exist until complete. OK.\n\n  Enabled=false records also saved. Fine.\n\n- Settings POST (lines ~360-414):\n  ```python\n  try:\n      services = _services_from(body)\n  except ValueError as e:\n      return self._json({\"error\": str(e)}, status=400)\n  if (not any((base_url, model, api_key)) and \"reasoning_effort\" not in body and services is None):\n      return self._json({\"error\": \"nothing to save\"}, status=400)\n  with self._state.lock:\n      ... llm fields ...\n      if services is not None:\n          from records -> self._cfg.mcp_services = services  (re-parse into live config)\n  ```\n  Wait — `self._cfg.mcp_services` currently holds... what? Boot sets config.mcp_services = service_records(raw) (list of dicts). The live server updates it on POST. Since websearch parses dicts per call, POST can just assign the canonical record list. Good.\n\n  Persisted file:\n  ```python\n  saved = flatten_settings(load_settings())\n  # legacy mcp_<name> keys fold into mcp_services at boot; once the services\n  # list is saved it is the single source, so they never carry across\n  if services is None:\n      saved.update({k: v for k, v in load_settings().items() if k.startswith(\"mcp_\") and isinstance(v, str) and v})\n  ```\n  Hmm wait — original code: `saved = {**_mcp_keys_from(load_settings()), **flatten_settings(load_settings())}`. It spreads mcp keys then flatten over them. flatten doesn't know mcp keys so both survive. Equivalent to saved = flatten ∪ mcp_keys. So new code: always carry legacy keys EXCEPT when services is not None (then drop all legacy keys — the list replaces them). And if services is not None: `saved[\"mcp_services\"] = services`.\n\n  Hold on, \"drop ALL legacy keys when services is posted\" — what if POST is api_key-only but UI sends mcp_services anyway (the UI always sends the whole list it rendered)? Then legacy keys drop, and the rendered list already includes the migrated records (GET returned them from service_records). Correct convergence. ✔\n\n  But subtle: what if the settings POST happens from a STALE page that rendered services before... edge case, ignore.\n\n- `_settings_get` (416-438): replace mcp_providers metadata with the effective records:\n  ```python\n  \"mcp_services\": _mcp_service_records(load_settings()),\n  ```\n  Wait, but the live config might differ from the file (unsaved runtime changes)? mcp services only change via POST which saves. Boot loads from file. So file == effective. Use `self._cfg.mcp_services`? After POST we set self._cfg.mcp_services = services. And boot set it from service_records. So `self._cfg.mcp_services` IS the effective list. But `_settings_get` currently reads raw file for mcp values. Use `self._cfg.mcp_services` — simpler and truthful (\"what this server runs\"). Hmm — but is _settings_get ever called on a server whose config predates...? No. Use self._cfg.mcp_services.\n\n  What does the UI need per record? name, label, url, search_tool, args, fields, list_key, status_tool, login_field, enabled. That's `record()` of each. But config stores dicts (already canonical records from POST or boot synthesis). Preset-synthesized records are full records. So UI gets dicts directly. Edge: settings.json hand-edited with junk records — websearch drops them (factual absence); GET would render them raw. Should GET filter through parse? Yes, cleaner: return only parseable records:\n  ```python\n  services, _errs = parse_services(self._cfg.mcp_services)\n  \"mcp_services\": [s.record() for s in services],\n  ```\n  This also drops DEFAULT_FIELDS into the payload (fields dict is fully populated after parse) — fine, UI prefills.\n\n- `_mcp_status` (440-465): iterate services instead of registry:\n  ```python\n  services, _errs = parse_services(self._cfg.mcp_services)\n  for s in services:\n      if not s.enabled or not s.complete(): -> row configured=False? \n  ```\n  Status rows: {\"name\", \"configured\", \"reachable\", \"login\"}. With records: a record exists (configured=True) if url+search_tool... actually configured should mean \"has a url\". If no url → configured False, UI shows blank. Incomplete (url but no search_tool): configured True but can't search; reachable probe? `_mcp_status_probe(url, service)` requires status_tool. New mcp_status signature: `mcp_status(url, service, timeout)` where service.status_tool decides. Keep:\n  ```python\n  for s in services:\n      row = {\"name\": s.name, \"configured\": bool(s.url), \"enabled\": s.enabled, \"reachable\": None, \"login\": None}\n      if s.url:\n          try:\n              state = _mcp_status_probe(s.url, s) if s.status_tool else None\n              row[\"reachable\"] = True\n              row[\"login\"] = _login_state(state, s.login_field)\n          except Exception as e:\n              row[\"reachable\"] = False\n              row[\"detail\"] = str(e)[:160]\n      out.append(row)\n  self._json({\"services\": out})\n  ```\n  Key rename \"providers\" → \"services\"? UI is ours; update both. Keep \"services\".\n\n  Hmm wait, should disabled services appear in status? They don't join the chain. UI shows them; status could still probe (informational). Simpler: include all parsed services; the UI shows the enabled flag. Actually keep it minimal: skip nothing, report `enabled` so UI can render dimmed. OK.\n\n- main() boot (845-848):\n  ```python\n  # MCP web-search services: declarative records in settings.json\n  # (mcp_services); legacy mcp_<name> URL keys convert through the preset data\n  # file, so a v0.1.14 setup keeps working.\n  config.mcp_services = service_records(load_settings())\n  ```\n\n### 4. mcpprovider.py additions\n\nAdd `presets()` + `service_records()` + `from pathlib import Path` + typing Mapping? Keep signatures simple (dict). Also `__future__ annotations` already there.\n\nActually wait — I need to double check one thing in the engine: `parse_service` merges DEFAULT_FIELDS for missing field overrides; `record()` returns asdict including full fields. Good for UI round-trip: GET returns full fields; POST sends them back; parse keeps them. ✔\n\nBut hmm — `parse_service` forces fields keys to exactly title/url/snippet (ignores extra keys) and args keys arbitrary. Also `enabled` parsing: `str(raw.get(\"enabled\", True)).strip().lower() not in (...)` — for bool False: str(False)=\"false\" → not in truthy-set → False ✔; for True: \"true\" → in? The tuple is (\"false\",\"0\",\"no\",\"off\") — \"true\" not in it → enabled=True ✔.\n\n### 5. websearch.py final shape\n\n```python\nfrom .mcpprovider import McpService, map_results, parse_services, search_args\n```\nName clash: websearch already has local `map_results`? No — the old provider had methods. websearch has no map_results. But `search_args`... no clash. OK import directly.\n\n`_mcp_backend`:\n```python\ndef _mcp_backend(service: McpService) -> Backend:\n    \"\"\"Adapt one operator-declared MCP service to the uniform Backend shape.\"\"\"\n    def search(q, limit, config, get):\n        cancel = (getattr(get, \"keywords\", None) or {}).get(\"cancel\")\n        data = _mcp_call(\n            service.url,\n            service.search_tool,\n            search_args(service, q, limit),\n            config.web_search_timeout,\n            cancel=cancel,\n        )\n        rows = map_results(service, data)\n        if not rows:\n            raise BackendError(f\"no results for {q!r} (empty feed or unmapped payload)\")\n        return rows[:limit]\n    return Backend(service.name, search)\n```\navailable: Backend.available(config) — the backend exists iff the service is in the parsed set; since we build the dict FROM config each time, the MCP backends in the dict are by construction available: `lambda config: True`. Wait but the dict lookup `_BACKENDS[name]` in web_search uses names from `_available_backends(config)` which now derives from the same per-config dict — consistent. So MCP backends get default available=True. \n\n```python\ndef _all_backends(config: Config) -> dict[str, Backend]:\n    \"\"\"Native backends plus the machine's configured MCP services (in declared\n    order, after the native ones). A service that is disabled or incomplete\n    simply does not exist.\"\"\"\n    out = dict(_BACKENDS)\n    services, _errors = parse_services(config.mcp_services)\n    for s in services:\n        if s.enabled and s.complete():\n            out[s.name] = _mcp_backend(s)\n    return out\n\ndef _available_backends(config: Config) -> tuple[str, ...]:\n    \"\"\"... (docstring mostly same)\"\"\"\n    return tuple(name for name, b in _all_backends(config).items() if b.available(config))\n```\n\nweb_search: `backends = _all_backends(config)` at top; `results = backends[name].search(...)`.\n\nmcp_status:\n```python\ndef mcp_status(url: str, service: McpService, timeout: float = 3.0) -> Any:\n    if not service.status_tool:\n        return None\n    return _mcp_call(url, service.status_tool, {}, timeout)\n```\n\nModule docstring: update the backend list mention. Lines 5-10 list the four; add line: `plus operator-declared MCP services (settings mcp_services) after the native ones`.\n\nImport line 42 replacement. Also remove the `MCP_PROVIDERS` import.\n\n### 6. config.py\n\nReplace mcp_urls field:\n```python\n# Optional MCP tool servers doubling as search backends: declarative records\n# (shape in tools/mcpprovider.py), stored in settings.json under mcp_services\n# and edited in the settings UI. The core names no service anywhere: one not\n# declared here does not exist on this machine.\nmcp_services: list[dict] = field(default_factory=list)\n```\n\n### 7. ui/app.js — new MCP section\n\nRewrite initMcpServices: render rows from GET /api/settings `mcp_services` records. Each row: fields for... how much to expose? The record has: name, label, url, search_tool, args (template dict), fields (3 mappings), list_key, status_tool, login_field, enabled. A full editor UI is heavy. Memory design: \"UI gets '+ add service' rows\". Minimal viable: per-service row(s) with the essentials, plus \"+ add service\" and delete per row, plus a JSON \"advanced\" editor? Hmm.\n\nWhat's the simplest UI that's honest and complete? Options:\n\nA) Per service, one row: label/name input + url input + delete button; a collapsed \"advanced\" JSON textarea for the rest (search_tool, args, fields...). Ugly.\n\nB) Per service, a small block of fields: name (only for new), url, search tool, and a details <details> for args/fields/status. \n\nC) Table with columns: name, url, search tool, status dot, delete. \"+ add service\" appends a blank row. Args/fields default (DEFAULT_FIELDS apply server-side when absent), so a minimal service = name + url + search_tool. Power users edit settings.json for exotic mappings. README documents the record shape. This matches \"Adding a source is editing config\" philosophy while the UI covers the common case.\n\nI'll go with C+: grid rows with inputs: label/name, url, search_tool; a delete ✕ per row; \"+ add service\" button; Save button; status span per row. For power tuning (args/fields/list_key/status_tool), document settings.json editing in README. Hmm — but status_tool/login_field drive the \"logged in\" display; without UI the user can't set them... via settings.json. Acceptable; README documents.\n\nHmm wait, let me reconsider B — a per-row second line with \"status tool\" input? That's 4 inputs per row: name, url, search tool, status tool (optional). That's reasonable and keeps everything visible without JSON editing. args/fields stay config-only (defaults are good for well-formed services). Let me do: each row = [name][url][search tool][status tool(optional)][✕] — too wide for a modal (modal width?). The settings modal has `fs-conn-row` rows with input+span. A 4-column grid could work but might overflow on narrow windows.\n\nCompromise: two lines per service:\n- Line 1: name input + url input + status span + ✕\n- Line 2 (indented, dim placeholders): search tool input + status tool input\nHmm, that's getting complex. Let me look at the modal layout... The existing rows use class fs-conn-row with input flexing. \n\nDecision: grid with 2 columns per line:\nRow A: [name][url]\nRow B: [search tool][status tool] + status text\n✕ delete button on row A.\n\"+ add service\" full-width small button. Save at bottom.\n\nActually — simpler and cleaner: keep ONE line per service like the current UI ([url input][status span]) plus a name prefix? The current UI had one input per provider because name was fixed. Now name is per-record. Minimum editable set: name, url, search_tool.\n\nLet me write:\n```\nWeb services (optional)                     [+ add]\n[ name ] [ url ..................... ] status  ✕\n[ search tool ] [ status tool ]                  (second line, dim placeholders)\n[ Save web services ] hint\n```\nEach service renders a container div with two rows. Fine — code it cleanly.\n\nSave: POST /api/settings {mcp_services: [...]} with records built from inputs: {name, url, search_tool, status_tool, enabled: true} — plus preserve label/args/fields/list_key/login_field from the loaded records (round-trip: keep original record fields, override the edited ones). New rows: {name, url, search_tool: \"\", ...defaults} — parse allows empty search_tool (incomplete → inert until filled). Hmm, POST validates via parse_services; empty search_tool passes validation. Good — user can add a draft.\n\nName validation client-side: regex ^[a-z0-9][a-z0-9_-]{0,63}$; invalid → hint shows server error (400 with message). Fine, let server report.\n\nEnabled toggle? Skip in UI (records default enabled). Keep an ✕ delete. If someone wants to disable, edit settings.json. OK.\n\nStatus display per row stays as before (\"connected · logged in\" etc.), matched by name: `/api/mcp_status` → {\"services\": [{name, configured, enabled, reachable, login}]}.\n\nAlso delete flow: remove row → save → legacy keys dropped server-side (since services posted) → no resurrection. ✔\n\nindex.html: `<div id=\"mcp-services\"></div>` stays.\n\n### 8. presets data file\n\n`agent/mcp_presets.json`:\n```json\n{\n  \"xiaohongshu\": {\n    \"name\": \"xiaohongshu\",\n    \"label\": \"Xiaohongshu\",\n    \"url\": \"http://localhost:18060/mcp\",\n    \"search_tool\": \"search_feeds\",\n    \"args\": {\"keyword\": \"{query}\", \"limit\": \"{limit}\"},\n    \"fields\": {\n      \"title\": \"title | name\",\n      \"url\": \"https://www.xiaohongshu.com/explore/{id}?xsec_token={xsec_token}\",\n      \"snippet\": \"desc | description\"\n    },\n    \"status_tool\": \"check_login_status\",\n    \"login_field\": \"logged_in\"\n  }\n}\n```\nWait — but \"code shouldn't contain platform names\" — the preset FILE is data, sanctioned. But hold on, the row mapping: old xhs map took `note_id` fallback for id? Old test: rows {\"id\": \"abc\"...} and {\"note_id\": \"n2\"...} both mapped. The url template uses {id} placeholders from row.get(\"id\") — note_id row would give empty id → url empty → dropped. Old bespoke code must have handled note_id fallback. To express in a template: `https://www.xiaohongshu.com/explore/{id}?xsec_token={xsec_token}` — placeholders fill from `row.get(m.group(1))` — only exact key. The engine doesn't support alternatives inside templates. Hmm! The old code mapped note_id → n2 URL. With the new engine, a row with only note_id yields url \"\" → row dropped. \n\nDoes real xiaohongshu-mcp return `id` or `note_id`? The old test had BOTH shapes. If the real service returns note_id, the preset template {id} breaks it. Options: extend the engine's template fill to support alternatives? Or make the template placeholder resolution go through `_field` chains: i.e., inside _map_url, placeholder values could support \"a | b\" chains... The placeholder regex is `{[a-z_][a-z0-9_]*}` — could allow ` | ` inside braces: `{id | note_id}`. That changes _PLACEHOLDER_RE. Alternatively preset uses \"id | note_id\"... \n\nCleaner: make `_map_url`'s placeholder lookup use `_field(row, name)` — since _field with a chain \"id | note_id\"... but the placeholder regex wouldn't match `{id | note_id}` (spaces/pipe not allowed). Extend regex to allow pipes/spaces inside placeholders: `\\{([a-z_][a-z0-9_ |.]*)\\}` then resolve each placeholder via _field (which handles both dots and pipes). And percent-encode the resolved value. That keeps one mechanism. But careful: `search_args` interpolation also uses _PLACEHOLDER_RE — chains make no sense there but _field isn't used there; values dict lookup would miss \"{id | note_id}\" → \"\". Hmm, better keep two regexes: template-placeholder regex (extended, resolved via _field) for url templates, and keep the simple one for args. \n\nWait — is this over-engineering? Check: does real xiaohongshu-mcp search_feeds return note_id or id? From the memory: \"url keeps xsec_token\" and the old bespoke `_xhs_map` code — the test's second row {\"note_id\": \"n2\"} tests \"mapping works without a token\" → old code did `row.get(\"id\") or row.get(\"note_id\")`. So the real payload presumably uses one of them (likely `id` with `note_id` fallback in some versions). To be safe and equivalent, support chains in url-template placeholders. Implementation in _map_url:\n\n```python\n_TEMPLATE_ARG_RE = re.compile(r\"\\{([a-z_][a-z0-9_. |]*)\\}\")\n\ndef _map_url(spec, row):\n    if \"{\" in spec:\n        return _TEMPLATE_ARG_RE.sub(\n            lambda m: urllib.parse.quote(str(_field(row, m.group(1))), safe=\"\"), spec\n        )\n    return str(_field(row, spec))\n```\n_field(\"id | note_id\") returns first non-empty → equivalent to old fallback. And `_field` handles dotted paths too — a bonus for nested ids. Quote(str(...)) — _field returns \"\" when nothing matches → empty segment; old code: row without id and without note_id → url .../explore/? hmm old code produced \"https://www.xiaohongshu.com/explore/\" maybe... Actually old map dropped rows with no id? The old test says {\"title\": \"no id, dropped\"} — dropped. With template: url = \".../explore/?xsec_token=\" — NOT empty → row kept with junk url! Regression vs old behavior for id-less rows. Hmm. But wait — the third test row has no id AND no note_id... it only has title. Old bespoke code dropped it. New engine: url template always produces something → kept with a junk URL. \n\nGuard: if any placeholder in the template resolved empty → drop the row? That changes _map_url to return \"\" when a required placeholder is empty. Sensible semantics: an unfilled placeholder means the row lacks the address → not a result. But what about OPTIONAL placeholders (e.g. token absent)? Old behavior: \"mapping works without a token\" — row {note_id: n2, no xsec_token} → url WITHOUT ?xsec_token= — the old code omitted the query string entirely when no token! Template can't express that. So old bespoke behavior: no token → url = explore/n2 (no \"?\"). A template `explore/{id}?xsec_token={xsec_token}` with empty token yields \"explore/n2?xsec_token=\" — ugly but functional? xiaohongshu pages might work without token param... The old test asserted exact equality with no trailing \"?...\". I'm rewriting the test to the engine's semantics anyway. The engine's url template semantics are: placeholders fill, empty when missing. Trailing \"?xsec_token=\" is cosmetically imperfect but the URL still resolves (xsec_token empty might 401 on xiaohongshu... unknown).\n\nOptions: (a) accept \"?xsec_token=\" empty; (b) add \"omit empty tail\" semantics — over-engineering; (c) preset snippet uses template and accepts the trailing token. Also add the drop-row-on-empty-placeholder rule for required parts? For {id} empty → \".../explore/?xsec_token=T\" junk. I'll add: template fill returns \"\" (row dropped) when the FIRST/any placeholder is empty? Simple rule: any placeholder that resolves to empty → row dropped. Con: kills optional-placeholder use. Pro: junk URLs never surface. Given \"a row with no address is not a result\" philosophy, dropping on any-empty-placeholder is coherent: a template is the address; an address with holes is not an address. Document it in the docstring. The no-token case: preset users get \"...?xsec_token=\" — hmm, that's an address with a hole (empty token) → dropped?! But xiaohongshu results DO carry xsec_token normally; the fallback no-token row would get dropped — old code kept it. Behavior delta: acceptable? The old test row {\"note_id\": \"n2\", \"title\": \"Second\", \"desc\": \"d2\"} (no token) was KEPT. If I drop empty-placeholder rows, that row vanishes — losing valid results. Hmm.\n\nAlternative: empty placeholder fills as empty string (keeps row, URL has \"?xsec_token=\" suffix). No-token rows kept with a slightly degraded URL. Junk id-less rows kept with junk URL (\"explore/?xsec_token=T0K\") — old code dropped those. But in practice every real xiaohongshu feed row has id/note_id, so junk rows don't occur. Which failure mode is worse? Dropping VALID rows (worse — loses results) vs keeping rare junk rows (mildly worse UX). Choose: fill empty, keep row — simpler engine, no special case. And the test expectation updates: no-token row → \"explore/n2?xsec_token=\". Hmm, that trailing junk bugs me...\n\nMiddle ground WITHOUT engine complexity: preset url template could be just the field-chain form? No — url needs construction from id+token.\n\nOK here's another thought — the engine's `map_results` could post-clean the url: strip dangling \"?param=\" empties? A tiny regex cleanup: `re.sub(r\"[?&][a-z_]+=(?=&|$)\", \"\")` — removes `?xsec_token=` and `&xsec_token=` empties. That's generic (any template with empty tail params), 1 line, no semantics change otherwise. Let me do: after template fill, strip empty query params. Actually careful with regex: \"explore/n2?xsec_token=\" → strip \"?xsec_token=\" → \"explore/n2\" ✔. \"explore/abc?xsec_token=T0K\" unchanged ✔. \"?a=&b=2\" → \"?b=2\"? regex removes \"?a=\" leaving \"b=2\" without \"?\" — broken. Use a proper approach: split on \"?\", filter empty params:\n\nHmm, this is creeping. STOP. Decision: keep the engine dumb (fill empties, keep row). The preset can't express optional params — fine; if the empty-token URL bothers the operator, they edit the preset (DATA!). It's editable data precisely so imperfect guesses don't require code. Old-code equivalence is not a goal; correctness of the ENGINE is. And for id-less rows: they're kept with a degenerate URL — meh. Actually wait, one more consideration: `_field` returns first NON-EMPTY alternative, so {id | note_id} handles the common case. Good enough. Moving on.\n\nHmm, actually — hmm, let me reconsider `xsec_token`: if url_template yields \"explore/n2?xsec_token=\" and xiaohongshu rejects empty tokens harder than absent tokens (possible!), results break. But rows without tokens are rare (feeds normally include xsec_token since the API change). Accept.\n\n### 9. mcpprovider.py docstring\n\nUpdate to mention presets data file + service_records. Also add the placeholder-chain note.\n\n### 10. README.md paragraph (lines 40-43)\n\nRewrite:\n```md\n外部 MCP 服务也可以接入为搜索后端：在设置弹窗的 Web services 区添加即可（存于\n`~/.clutch/settings.json` 的 `mcp_services` 列表，每条记录声明如何调用搜索工具、\n如何读取结果）。核心代码不含任何具体服务名：一条没配置的服务在工具、提示词、\n报错信息里都不存在，也不会出现任何\"请安装\"的提示。`agent/mcp_presets.json` 是\n可选的数据文件（可编辑可删除），仅用于把旧版 `mcp_<名字>` 键一次性迁移成记录。\n```\nAlso check README for other MCP references (line 40-43 only per grep). Also check \"Web services\" mention elsewhere? grep showed only lines 40-42. OK. Wait — also the README might document mcp_<名字> elsewhere (设置 section?). grep found only those lines. ✔\n\n### 11. web_search.md prompt — no change ($backends dynamic). ✔ registry.py — no change. ✔\n\n### 12. tests/mcpbackend_test.py — rewrite for the new model:\n\n- presets + service_records: legacy conversion, declared precedence, no-preset legacy key ignored, junk list tolerated.\n- parse_service/search_args/map_results unit checks (replacing old provider-method tests): url template with {id | note_id} chain? Test: template \"https://x.example/n/{id}?t={xsec_token}\"; note_id fallback row.\n- server helpers: _services_from validation (non-list → ValueError; bad record name → ValueError), POST persistence behavior is server-level (server_test covers POST? there's tests/server_test.py — check if it tests mcp settings POST... grep didn't show mcp in server_test. The old mcpbackend_test imported _split_mcp_fields etc. from server). New test imports: `_services_from` (rename?), `service_records`, `normalize_login`.\n- JSON-RPC client tests: unchanged (same client).\n- gating: cfg.mcp_services = [{...record...}] → backend joins; unconfigured → absent; unknown backend error.\n- web_search end-to-end via fake _mcp_rpc with a record with url+search_tool.\n- prompt/schema dynamic render: build_default_tools with mcp_services vs without.\n- mcp_status? server method — the old test didn't cover it (needs server instance). Skip (was skipped before too).\n\nAlso tests/websearch_test.py — does it touch MCP? grep earlier showed no mcp matches in websearch_test.py (the grep for def test_ showed its structure only; the mcp-grep on tests dir matched only mcpbackend_test.py lines). But websearch_test may import things like ws._BACKENDS? Let me check quickly with grep for `_BACKENDS|_available_backends|available_backends` in tests.\n\nAlso `_DEFAULT_CHAIN` — still used? It was defined from _BACKENDS; after refactor, is _DEFAULT_CHAIN used anywhere? It was \"Base try order\" comment; used? grep websearch for _DEFAULT_CHAIN... it appeared at line 546 definition; usage? In the shown code 601-647, chain comes from _available_backends only. _DEFAULT_CHAIN seems unused decoration — leave as is (or keep for clarity). Don't touch.\n\n### Also check: `Config` import of Any for list[dict] — use `list[dict]` without Any. Actually records values include ints/bools/strings; `list[dict]` is fine (bare dict = dict[Any, Any]).\n\n### server_test.py check for settings POST coverage\n\nLet me grep server_test for \"/api/settings\" to make sure my POST changes don't break existing tests.\n\nNow — ordering of the work:\n1. mcpprovider.py: add presets/service_records + extended template placeholders + docstring notes.\n2. config.py: mcp_services field.\n3. websearch.py: imports, _mcp_backend, _all_backends, web_search lookup, mcp_status, docstring.\n4. server.py: imports, helpers, POST, GET, status, boot.\n5. app.js: rewrite initMcpServices.\n6. mcp_presets.json: new file.\n7. tests/mcpbackend_test.py: rewrite.\n8. README.md: paragraph.\n9. Run tests: mcpbackend_test + websearch_test + server_test (server_test spins real server — heavier; still run).\n\nAlso update memory at the end.\n\nWait — one more check on `parse_services` usage in `_settings_get`/`_mcp_status`/websearch: `parse_services(config.mcp_services)` where config.mcp_services is list[dict] ✔.\n\nAnd `_services_from` naming in server: keep test-importable name. I'll call it `services_from_body`? Hmm, old names: _split_mcp_fields. New: `_services_from(body)`. Test imports it; underscore imports in tests are fine (existing test did).\n\nNow, UI details — let me write the app.js block carefully:\n\n```js\n// ---- MCP web services (settings modal section) -------------------------------\n// Rendered from GET /api/settings mcp_services records: a host without a\n// service configured just sees an empty list and an add button — nothing here\n// prompts anyone to install anything. The core names no service: rows exist\n// only for records this machine's operator declared.\n(function initMcpServices() {\n  const box = document.getElementById(\"mcp-services\");\n  if (!box) return;\n\n  let records = []; // last loaded records, so a save round-trips unknown fields\n\n  function rowFor(rec) {\n    const wrap = document.createElement(\"div\");\n    wrap.className = \"mcp-service\";\n    wrap.style.marginBottom = \"10px\";\n\n    const line1 = document.createElement(\"div\");\n    line1.className = \"fs-conn-row\";\n    line1.style.marginBottom = \"4px\";\n    const name = document.createElement(\"input\");\n    name.type = \"text\"; name.autocomplete = \"off\";\n    name.placeholder = \"name (a-z0-9-)\";\n    name.value = rec.name || \"\";\n    name.style.maxWidth = \"140px\";\n    const url = document.createElement(\"input\");\n    url.type = \"text\"; url.autocomplete = \"off\";\n    url.placeholder = \"http://localhost:port/mcp\";\n    url.value = rec.url || \"\";\n    const status = document.createElement(\"span\");\n    status.className = \"dim\";\n    status.dataset.mcpName = rec.name || \"\";\n    const del = document.createElement(\"button\");\n    del.type = \"button\"; del.className = \"ghost\"; // check existing button classes!\n    del.textContent = \"✕\"; del.title = \"remove this service\";\n    del.addEventListener(\"click\", () => wrap.remove());\n    line1.append(name, url, status, del);\n\n    const line2 = document.createElement(\"div\");\n    line2.className = \"fs-conn-row\";\n    const tool = document.createElement(\"input\");\n    tool.type = \"text\"; tool.autocomplete = \"off\";\n    tool.placeholder = \"search tool (required)\";\n    tool.value = rec.search_tool || \"\";\n    const stat = document.createElement(\"input\");\n    stat.type = \"text\"; stat.autocomplete = \"off\";\n    stat.placeholder = \"status tool (optional)\";\n    stat.value = rec.status_tool || \"\";\n    line2.append(tool, stat);\n\n    wrap.append(line1, line2);\n    return wrap;\n  }\n  ...\n}\n```\n\nHmm, I need to check what button classes exist in the UI (I used \"ghost\" — verify). Let me grep app.js for className button usage. Also `fs-conn-row` styling. And check the settings modal structure near #mcp-services in index.html.\n\nStatus text function shared:\n```js\nfunction statusText(row) {\n  if (!row || !row.configured) return \"\";\n  if (row.enabled === false) return \"disabled\";\n  if (row.reachable === false) return \"unreachable\";\n  if (row.login === true) return \"connected · logged in\";\n  if (row.login === false) return \"connected · not logged in\";\n  return \"connected\";\n}\n```\n\nrefreshStatus matches by CURRENT row name — dataset.mcpName must update when name input changes; simpler: on refreshStatus, iterate wrap elements and read the name input value directly:\n```js\nbox.querySelectorAll(\".mcp-service\").forEach((wrap) => {\n  const name = wrap.querySelector(\"input\").value.trim(); // first input = name\n  const st = byName[name];\n  wrap.querySelector(\"[data-mcp-name]\").textContent = statusText(st);\n});\n```\nDrop dataset entirely. \n\nrender(services):\n```js\nfunction render(services) {\n  box.textContent = \"\";\n  records = services || [];\n  const title = document.createElement(\"label\");\n  title.textContent = \"Web services (optional)\";\n  title.style.marginTop = \"16px\";\n  box.appendChild(title);\n  for (const rec of records) box.appendChild(rowFor(rec));\n  const add = document.createElement(\"button\");\n  add.type = \"button\";\n  add.textContent = \"+ add service\";\n  ... onclick appends rowFor({}) ...\n  const actions = ... Save button + hint ...\n}\n```\n\nsave click:\n```js\nconst payload = [];\nfor (const wrap of box.querySelectorAll(\".mcp-service\")) {\n  const inputs = wrap.querySelectorAll(\"input\");\n  const name = inputs[0].value.trim();\n  if (!name) { hint = \"each service needs a name\"; return; }\n  const base = records.find((r) => r.name === name) || {};\n  payload.push({ ...base, name, url: inputs[1].value.trim().replace(/\\/+$/, \"\"), search_tool: inputs[2].value.trim(), status_tool: inputs[3].value.trim() });\n}\nawait apiFetch(\"/api/settings\", { method: \"POST\", body: { mcp_services: payload } });\n```\nWait — base lookup by name: if user renamed a service, base lookup fails → loses args/fields. Edge case; acceptable (documented: renames drop advanced mappings; actually to be safer, match by index? rows render in records order; new rows appended. Match by row index against records when within range: `const base = records[i] && records[i].name === name ? records[i] : (records.find(...))`... over-thinking. Use index-based: rows were created from records in order, so `const idx = [...box.querySelectorAll(\".mcp-service\")].indexOf(wrap)` → base = records[idx] if its name matches, else find by name, else {}. Good enough — implement simply with a data attribute: rowFor sets wrap.dataset.rec = JSON.stringify(rec)! Then save uses the stored record as base. Clean:\n```js\nwrap.dataset.rec = JSON.stringify(rec);\n...\nconst base = JSON.parse(wrap.dataset.rec || \"{}\");\n```\nIf user renames, base keeps old fields (label/args/fields) — record keeps advanced mappings. \n\nServer POST validates name regex — hint shows server error. Also duplicate names → server 400 (\"duplicate name\"). Hint shows it. OK.\n\nOne more UI check: the settings modal Save button (main save) posts base_url/model/api_key etc. WITHOUT mcp_services → server keeps legacy keys / doesn't touch mcp_services. ✔ main.js writeSettingsFile — memory says it merges into existing file; with services only written via the MCP save, fine. But wait — main.js also has healSettingsMirror and settings sync between windows? Memory: \"main.js writeSettingsFile needs NO change (merges into existing file, mcp_* preserved)\". It merges — so mcp_services key survives. But now, does main.js whitelist keys when writing? \"merges into existing file\" — so new key fine. ✔ (verify quickly with grep for writeSettingsFile in ui/main.js.)\n\nLet me also double-check index.html modal area (line ~50) to see the section markup.\n\nNow, let me also reconsider: `service_records` merges legacy keys — it's called at boot and... in `_settings_get` I decided to use `self._cfg.mcp_services` (already service_records-processed at boot and updated at POST). ✔ \n\nEdge: `_services_from` returns canonical records; assign `self._cfg.mcp_services = services` INSIDE the lock. websearch reads config.mcp_services per call — parse each time (cheap). Thread-safety: list swap is atomic-ish; fine.\n\nLegacy keys & flatten_settings: check what flatten_settings does with unknown keys — memory says \"flatten_settings would DROP mcp_* keys so persistence merges them back from raw\". So saved starts from flatten (no mcp keys), then I conditionally add legacy keys (if services untouched) or mcp_services (if posted). Implementation:\n\n```python\nsaved = flatten_settings(load_settings())\nif services is None:\n    # untouched services: carry legacy mcp_<name> keys across so a plain save\n    # never wipes configured web services\n    saved.update(_mcp_keys_from(load_settings()))\nelse:\n    # the list replaces everything: legacy mcp_<name> keys die here so a\n    # deleted service cannot resurrect from its pre-migration key\n    saved[\"mcp_services\"] = services\n```\nSo KEEP `_mcp_keys_from` helper (it's still meaningful). Keep it. ✔ (test keeps testing it too.)\n\n`_split_mcp_fields` → replaced by `_services_from`. Old test imported _split_mcp_fields; new test imports _services_from. Nothing else imports _split_mcp_fields (grep showed only mcpbackend_test). ✔\n\nserver imports: replace line 46-47:\n```python\nfrom .tools.mcpprovider import normalize_login as _login_state\nfrom .tools.mcpprovider import parse_services as _parse_mcp_services, service_records as _mcp_service_records\nfrom .tools.websearch import mcp_status as _mcp_status_probe\n```\nWait, line 110-125 def _login_state — delete it (imported alias covers). But check _login_state's remaining body lines 119-125 — read exact text later. Also `mcp_providers()` def — delete; check callers: line 435 (settings_get) and 448 (_mcp_status) — both being rewritten. ✔ Any other callers? grep showed lines 83-85 def, 435, 448 only. Also test import. ✔\n\nNow parse_services import in server: used by _settings_get (render canonical records) and _mcp_status (iterate services). And _services_from uses parse_services. ✔\n\nEngine `_map_url` update with chain-aware placeholders + docstring tweak. Careful: `_PLACEHOLDER_RE` is also used by `search_args` interpolation (values.get(m.group(1))) — if I extend the shared regex, \"{id | note_id}\" in an ARG template would lookup a weird key → \"\". To be safe, use a separate regex for url templates:\n\n```python\n_URL_ARG_RE = re.compile(r\"\\{([a-z_][a-z0-9_. |]*?)\\}\")\n```\nHmm trailing space inside braces before }: \"…\" allow `[a-z0-9_. |]` chars; `_field` strips each alternative (p.strip()) ✔. Non-greedy not needed with the char class (no } inside). Use greedy.\n\n`_map_url`:\n```python\ndef _map_url(spec: str, row: dict) -> str:\n    \"\"\"A url mapping is a template — {placeholders} are filled from the row via\n    the same \"a.b | alt\" chains (percent-encoded: ids and tokens are payload,\n    never structure) — or a field chain naming where the ready-made url lives.\"\"\"\n    if \"{\" in spec:\n        return _URL_ARG_RE.sub(\n            lambda m: urllib.parse.quote(str(_field(row, m.group(1))), safe=\"\"), spec\n        )\n    return str(_field(row, spec))\n```\n\nPresets in mcpprovider.py:\n```python\nfrom pathlib import Path\n\n_PRESETS_FILE = Path(__file__).with_name(\"mcp_presets.json\")\n\ndef presets() -> dict[str, dict]:\n    \"\"\"Built-in starter records, shipped as data (agent/mcp_presets.json), never\n    code: an operator can edit or delete the file, and a record only matters\n    when the settings already name it (a legacy mcp_<name> URL key). Nothing\n    here is ever suggested, rendered or named anywhere else.\"\"\"\n\ndef service_records(settings: dict) -> list[dict]:\n    \"\"\"Effective mcp_services records from a raw settings dict: the declared\n    list, then legacy mcp_<name> URL keys converted one-time through presets\n    (skipped when the name is already declared or has no preset).\"\"\"\n```\n\npresets() reads json each call; wrap in try/except (OSError, ValueError) → {}.\n\nBoot in main(): `config.mcp_services = _mcp_service_records(load_settings())`.\n\nOne subtlety — `parse_services` on config.mcp_services at websearch: preset-synthesized record dicts contain \"label\", \"args\", \"fields\", etc. — parse_service handles ✔.\n\nType hints: `def presets() -> dict[str, dict[str, Any]]`. Fine.\n\n### Config import check\n\nconfig.py top imports: need to check whether `Any` imported — using `list[dict]` avoids it. ✔\n\nNow — does anything else reference `mcp_urls`? grep showed config.py def, server 390-392, test. And mcp.py? No. `agent/remote*`? The remote transport uploads agent package — presets json file must be included in packaging (pyproject package data?). Check pyproject for package inclusion of non-py files (e.g. prompts .md files are packaged — how?). prompts are .md inside agent — check pyproject [tool.setuptools] package-data or hatch. Let me check pyproject.toml quickly. If prompts/*.md are included via package-data config, add mcp_presets.json similarly.\n\nAlso VERSION file — bump? Release conventions memory: push/release via scripts. The user said \"开始\" meaning start coding the refactor. VERSION bump can wait for release; but memory \"Clutch push/release conventions\" — let me check what it says about version bumps... I haven't loaded it. The task is the refactor; releasing is a separate step (user usually triggers). I'll bump VERSION only if conventions say releases bump it at release time. Let me load that memory later when wrapping up. Actually — current VERSION is presumably 0.1.14. Leave version alone unless asked; the refactor is unreleased work. Hmm, but maybe conventions say VERSION reflects main. Skip for now; mention in final summary.\n\nOrder of operations now. Start editing.\n\nFirst: mcpprovider.py edits (3 edits: docstring mention, _map_url, add presets/service_records at the end + pathlib import).\n\nActually the docstring of the module says \"every MCP source is a declarative record from the settings file\" — add a sentence about presets data file. Keep concise.\n\nLet me write the edits.\n\nEdit 1 — mcpprovider.py import: add `from pathlib import Path` (stdlib import block: re, urllib.parse, dataclasses, typing). Insert after `import re`... alphabetical: pathlib before re? Order: `import pathlib`? Use `from pathlib import Path`. Imports currently:\n```python\nimport re\nimport urllib.parse\nfrom dataclasses import asdict, dataclass, field\nfrom typing import Any\n```\nAdd:\n```python\nimport re\nimport urllib.parse\nfrom dataclasses import asdict, dataclass, field\nfrom pathlib import Path\nfrom typing import Any\n```\n\nEdit 2 — module docstring: after the \"No platform is ever named in code\" paragraph add preset note:\n```\nBuilt-in presets, if any, are data too (mcp_presets.json beside this module):\nread only when the settings name them (a legacy mcp_<name> URL key), editable\nand deletable, never code.\n```\nHmm wording. Let me integrate into the existing paragraph.\n\nEdit 3 — _map_url + regex.\n\nEdit 4 — presets/service_records at the end (after normalize_login or before it? Logical place: near parse_services — records in/out. Put after parse_services, before the call side? It deals with settings dicts → put right after parse_services).\n\nCode:\n```python\n# ---- presets: starter records as data ----------------------------------------\n\n_PRESETS_FILE = Path(__file__).with_name(\"mcp_presets.json\")\n\n\ndef presets() -> dict[str, dict[str, Any]]:\n    \"\"\"Starter records shipped as data (never code): the file sits beside this\n    module, is safe to edit or delete, and a record only ever matters when the\n    operator's settings already name it — nothing here is suggested, rendered\n    or named anywhere else.\"\"\"\n    try:\n        data = json.loads(_PRESETS_FILE.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return {}\n    return {str(k): v for k, v in data.items() if isinstance(v, dict)} if isinstance(data, dict) else {}\n\n\ndef service_records(settings: dict[str, Any]) -> list[dict[str, Any]]:\n    \"\"\"Effective mcp_services records from a raw settings dict: the declared\n    list first, then legacy mcp_<name> URL keys converted one-time through a\n    preset (only for names neither already declared nor preset-less). Returns\n    plain dicts in settings order; records the caller still validates.\"\"\"\n    raw = settings.get(\"mcp_services\")\n    records = [r for r in raw if isinstance(r, dict)] if isinstance(raw, list) else []\n    known = {str(r.get(\"name\", \"\")).strip().lower() for r in records}\n    out = list(records)\n    if not out or True:  # legacy keys always checked\n        ...\n```\nNo silly branch. Write clean:\n\n```python\ndef service_records(settings: dict[str, Any]) -> list[dict[str, Any]]:\n    raw = settings.get(\"mcp_services\")\n    out = [r for r in raw if isinstance(r, dict)] if isinstance(raw, list) else []\n    known = {str(r.get(\"name\", \"\")).strip().lower() for r in out}\n    table = presets()\n    for key, value in settings.items():\n        if not key.startswith(\"mcp_\") or not isinstance(value, str):\n            continue\n        name = key[4:].strip().lower()\n        value = value.strip().rstrip(\"/\")\n        if not name or not value or name in known or not _NAME_RE.match(name):\n            continue\n        preset = table.get(name)\n        if not isinstance(preset, dict):\n            continue\n        record = {k: v for k, v in preset.items() if k != \"name\"}\n        record[\"name\"] = name\n        record[\"url\"] = value\n        out.append(record)\n        known.add(name)\n    return out\n```\nNeed `import json` in mcpprovider (not currently imported!). Add to imports.\n\nNow websearch edits. Import line 42:\n```python\nfrom .mcpprovider import McpService, map_results, parse_services, search_args\n```\nCheck for name collisions in websearch.py: grep \"map_results|search_args|parse_services\" — old code had none of these as module functions (they were provider methods). ✔\n\nDocstring lines 5-10: append a line after ddg:\n```\n  plus any operator-declared MCP services (settings mcp_services), after these\n```\nActually the block is a table; add a sentence after the list instead:\n\"Operator-declared MCP services (Config.mcp_services) join the chain after the native backends, in declared order.\"\n\n_mcp_backend replacement + _all_backends + _available_backends + web_search lookup + mcp_status.\n\nFor web_search:\n```python\n    get = functools.partial(...)\n    backends = _all_backends(config)\n    ...\n    results = backends[name].search(...)\n```\nWait, `available` for mcp backends is default True — `_all_backends` already filters enabled+complete. ✔\n\nmcp_status signature — old: (url, provider, timeout). New: (url, service, timeout). Same shape.\n\nserver.py edits as planned.\n\napp.js rewrite as planned — need to check button class conventions. Let me grep index.html/app.js for button classes quickly before writing. Also check the settings modal around #mcp-services.\n\ntests/mcpbackend_test.py rewrite — keep structure, replace provider parts:\n\n1. parse/search_args/map_results: record with template url:\n```python\nsvc = parse_service({\n    \"name\": \"notes\",\n    \"url\": \"http://localhost:18060/mcp\",\n    \"search_tool\": \"search_feeds\",\n    \"args\": {\"keyword\": \"{query}\", \"limit\": \"{limit}\"},\n    \"fields\": {\"url\": \"https://www.xiaohongshu.com/explore/{id | note_id}?xsec_token={xsec_token}\", \"snippet\": \"desc | description\"},\n})\n```\nHmm — wait, should the TEST name xiaohongshu? Tests naming a platform is fine (tests are not product surface; no-bias is about product behavior/code surface... strictly \"代码不应该有任何具备偏向性的设计\" — code shouldn't have biased design. A test asserting a preset record is fine; the preset data file itself names it — sanctioned as data). Use a generic \"notes\" service for the ENGINE tests, and test the PRESET via its actual record (xiaohongshu) in the migration tests — that proves the real-world record works through the generic engine. Good structure:\n\n- Engine tests with a synthetic \"notes\" service.\n- Migration tests: legacy key mcp_xiaohongshu → service_records produces the preset-backed record; the record parses (parse_service) and completes; map_results through the real preset record maps a realistic row (id + xsec_token) to the explore URL.\n- presets precedence: declared record with same name wins; unknown legacy key ignored; mcp_services junk tolerated.\n- server helpers: _services_from validation; _mcp_keys_from carry; _login_state from normalize_login import — test server import still works.\n- JSON-RPC loopback: same as before.\n- gating: cfg.mcp_services = [record] (synthetic) → joins chain; unconfigured → absent; backend pin error factual.\n- end-to-end via fake_rpc with the synthetic service (url=base, search_tool=...).\n- prompt/schema dynamic.\n- args type preservation: search_args keeps {limit} int.\n\nAlso keep a check that preset record survives round-trip: parse_service(preset).record() == canonical.\n\nNow check testsupport.check exists ✔ (used by other tests).\n\nAlso — tests/websearch_test.py: check it doesn't import removed names. grep for \"mcp\" showed nothing in websearch_test. ✔ But it might construct Config() and call web_search with backends — unchanged behavior. ✔\n\nserver_test.py — check /api/settings POST tests. grep for \"api/settings\" in tests/server_test.py.\n\npyproject packaging — check package data for prompts (how are .md included?) to mirror for mcp_presets.json.\n\nLet me run these three greps + read index.html modal region + check button classes in one batch."}
