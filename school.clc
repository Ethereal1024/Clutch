{"type": "tool_result", "timestamp": 1789633598.7420452, "id": "d80f5154fb0d", "tool_call_id": "call_8cd222b89e8246b086e0d7c9", "content": "1: \"\"\"Web access tools: web_search (multi-backend search) + web_fetch (page -> text).\n2: \n3: Built on the stdlib only (urllib + html.parser + ElementTree) — the LLM loop is\n4: hand-rolled here, and so is web access: no scraping SDK that rots when an\n5: engine tweaks its markup. Backends, tried in order, first success wins:\n6: \n7:   tavily   LLM-first search API, best quality   (CLUTCH_TAVILY_API_KEY)\n8:   searxng  self-hosted metasearch, JSON API     (CLUTCH_SEARXNG_URL)\n9:   bing     the undocumented RSS endpoint of cn.bing.com — keyless, CN-friendly\n10:   ddg      duckduckgo html endpoint — keyless\n11: \n12: Poka-yoke (make it hard for the model to misuse):\n13: - timeout: every request is bounded (Config.web_search_timeout); Stop is\n14:   honored between chunks so a hung fetch never outlives the user's patience\n15: - size cap: responses larger than max_bytes are rejected, not swallowed\n16: - private-network guard: web_fetch refuses loopback/LAN hosts (and follows\n17:   redirects only to public hosts) — a GET into the agent's own API or the\n18:   LAN stays impossible even when the model is talked into trying\n19: - error-as-data: backend failures list each reason; a truncating fetch says\n20:   how to fetch the next slice, mirroring read_file's offset hints\n21: \"\"\"\n22: \n23: from __future__ import annotations\n24: \n25: import functools\n26: import gzip\n27: import ipaddress\n28: import json\n29: import re\n30: import socket\n31: import urllib.error\n32: import urllib.parse\n33: import urllib.request\n34: import xml.etree.ElementTree as ET\n35: import zlib\n36: from dataclasses import dataclass\n37: from html import unescape\n38: from html.parser import HTMLParser\n39: from typing import Any, Callable\n40: \n41: from ..config import Config\n42: from .workspace import Workspace\n43: \n44: # browser-shaped but honest about the product; several CDNs 403 blank UAs\n45: USER_AGENT = (\n46:     \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) \"\n47:     \"Chrome/124.0 Safari/537.36 ClutchAgent/0.1\"\n48: )\n49: \n50: _MAX_BYTES = 2_000_000  # hard cap per response: pages are for reading, not hoarding\n51: \n52: \n... (showing lines 1-52 of 525; use offset=53 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789633598.7488847, "id": "32ad3a924c60", "tool_call_id": "call_79ed55f4abd54ea786720c11", "content": "405:     if not out:\n406:         raise BackendError(\"no results parsed (bot-checked, blocked, or layout changed)\")\n407:     return out\n408: \n409: \n410: _BACKENDS: dict[str, Callable[[str, int, Config, Callable[..., HttpResp]], list[dict[str, str]]]] = {\n411:     \"tavily\": _tavily,\n412:     \"searxng\": _searxng,\n413:     \"bing\": _bing,\n414:     \"ddg\": _ddg,\n415: }\n416: _DEFAULT_CHAIN = (\"tavily\", \"searxng\", \"bing\", \"ddg\")\n417: \n418: \n419: def _available_backends(config: Config) -> tuple[str, ...]:\n420:     \"\"\"The usable subset of the chain: keyless backends are always in.\"\"\"\n421:     out = []\n422:     for name in _DEFAULT_CHAIN:\n423:         if name == \"tavily\" and not config.tavily_api_key:\n424:             continue\n425:         if name == \"searxng\" and not config.searxng_url:\n426:             continue\n427:         out.append(name)\n428:     return tuple(out)\n429: \n430: \n431: def _short(reason: object) -> str:\n432:     return re.sub(r\"\\s+\", \" \", str(reason)).strip()[:160]\n433: \n434: \n435: def web_search(\n436:     workspace: Workspace,\n437:     config: Config,\n438:     query: str,\n439:     max_results: int | None = None,\n440:     backend: str = \"\",\n441:     cancel: Any = None,\n442: ) -> dict[str, Any]:\n443:     \"\"\"Search the web; backends fall through in order until one yields.\"\"\"\n444:     q = (query or \"\").strip()\n445:     if not q:\n446:         return {\"content\": \"ERROR: query is required\", \"error\": True}\n447:     limit = max(1, min(int(max_results or config.web_search_max_results), 20))\n448:     if backend:\n449:         if backend not in _BACKENDS:\n450:             return {\n451:                 \"content\": f\"ERROR: unknown backend {backend!r}; available: \"\n452:                 + \", \".join(_DEFAULT_CHAIN)\n453:                 + \" (tavily needs CLUTCH_TAVILY_API_KEY, searxng needs CLUTCH_SEARXNG_URL)\",\n454:                 \"error\": True,\n455:             }\n456:         if backend in (\"tavily\",) and not config.tavily_api_key:\n457:             return {\"content\": \"ERROR: backend 'tavily' needs CLUTCH_TAVILY_API_KEY\", \"error\": True}\n458:         if backend in (\"searxng\",) and not config.searxng_url:\n459:             return {\"content\": \"ERROR: backend 'searxng' needs CLUTCH_SEARXNG_URL\", \"error\": True}\n460:         chain: tuple[str, ...] = (backend,)\n461:     else:\n462:         chain = _available_backends(config)\n463:     get = functools.partial(_http_get, timeout=config.web_search_timeout, cancel=cancel)\n464:     failures: list[str] = []\n465:     for name in chain:\n466:         try:\n467:             results = _BACKENDS[name](q, limit, config, get)\n468:         except (BackendError, WebError) as e:\n469:             failures.append(f\"- {name}: {_short(e)}\")\n470:             continue\n471:         seen: set[str] = set()\n472:         deduped = []\n473:         for r in results:\n474:             if r[\"url\"] in seen:\n475:                 continue\n476:             seen.add(r[\"url\"])\n477:             deduped.append(r)\n478:         body = \"\\n\".join(f\"{i}. {r['title']}\\n   {r['url']}\\n   {r['snippet']}\" for i, r in enumerate(deduped, 1))\n479:         return {\"content\": f\"{len(deduped)} results for {q!r} (via {name}):\\n\\n{body}\"}\n480:     return {\n481:         \"content\": \"ERROR: all search backends failed\\n\" + \"\\n\".join(failures),\n482:         \"error\": True,\n483:     }\n484: \n485: \n486: _BINARY_TYPES = (\"image/\", \"video/\", \"audio/\")\n487: _BINARY_EXACT = {\"application/pdf\", \"application/zip\", \"application/gzip\", \"application/x-tar\", \"application/octet-stream\"}\n488: \n489: \n490: def web_fetch(\n491:     workspace: Workspace,\n492:     config: Config,\n493:     url: str,\n494:     max_chars: int | None = None,\n