{"type": "tool_result", "timestamp": 1789818111.423882, "id": "fc0a717f1768", "tool_call_id": "call_4a2bedc5dccf4f54b3cf9999", "content": "1: \"\"\"Web access tools: web_search (multi-backend search) + web_fetch (page -> text).\n2: \n3: Built on the stdlib only (urllib + html.parser + ElementTree) — the LLM loop is\n4: hand-rolled here, and so is web access: no scraping SDK that rots when an\n5: engine tweaks its markup. Backends, tried in order, first success wins:\n6: \n7:   tavily   LLM-first search API, best quality   (CLUTCH_TAVILY_API_KEY)\n8:   searxng  self-hosted metasearch, JSON API     (CLUTCH_SEARXNG_URL)\n9:   bing     the undocumented RSS endpoint of cn.bing.com — keyless, CN-friendly\n10:   ddg      duckduckgo html endpoint — keyless\n11: \n12: Operator-declared MCP services (Config.mcp_services, see tools/mcpprovider.py)\n13: join the chain after the native backends, in declared order; a service that is\n14: not declared simply does not exist on this machine.\n15: \n16: Poka-yoke (make it hard for the model to misuse):\n17: - timeout: every request is bounded (Config.web_search_timeout); Stop is\n18:   honored between chunks so a hung fetch never outlives the user's patience\n19: - size cap: responses larger than max_bytes are rejected, not swallowed\n20: - private-network guard: web_fetch refuses loopback/LAN hosts (and follows\n21:   redirects only to public hosts) — a GET into the agent's own API or the\n22:   LAN stays impossible even when the model is talked into trying\n23: - error-as-data: backend failures list each reason; a truncating fetch says\n24:   how to fetch the next slice, mirroring read_file's offset hints\n25: \"\"\"\n26: \n27: from __future__ import annotations\n28: \n29: import functools\n30: import gzip\n31: import ipaddress\n32: import json\n33: import re\n34: import socket\n35: import urllib.error\n36: import urllib.parse\n37: import urllib.request\n38: import xml.etree.ElementTree as ET\n39: import zlib\n40: from dataclasses import dataclass\n41: from html import unescape\n42: from html.parser import HTMLParser\n43: from typing import Any, Callable\n44: \n45: from ..config import Config\n46: from .mcpprovider import McpService, map_results, parse_services, search_args\n47: from .workspace import Workspace\n48: \n49: # browser-shaped but honest about the product; several CDNs 403 blank UAs\n50: USER_AGENT = (\n51:     \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) \"\n52:     \"Chrome/124.0 Safari/537.36 ClutchAgent/0.1\"\n53: )\n54: \n55: _MAX_BYTES = 2_000_000  # hard cap per response: pages are for reading, not hoarding\n56: \n57: \n58: class WebError(Exception):\n59:     \"\"\"A request-level failure (DNS, timeout, size cap, private host).\"\"\"\n60: \n61: \n62: class BackendError(Exception):\n63:     \"\"\"A backend responded but yielded nothing usable (blocked, layout changed).\"\"\"\n64: \n65: \n66: @dataclass\n67: class HttpResp:\n68:     url: str  # final URL after redirects\n69:     content_type: str\n70:     body: bytes\n71: \n72: \n73: # ---- HTTP core -------------------------------------------------------------\n74: \n75: \n76: def _assert_public_host(url: str) -> None:\n77:     \"\"\"Refuse non-public destinations: loopback, LAN, link-local, reserved.\n78: \n79:     Guards web_fetch against being pointed at the agent's own HTTP API or the\n80:     surrounding network. Resolve-then-connect leaves a (narrow) DNS-rebinding\n81:     race; this is a guard against honest mistakes, not a sandbox — work mode\n82:     already has full shell access.\n83:     \"\"\"\n84:     host = urllib.parse.urlsplit(url).hostname\n85:     if not host:\n86:         raise WebError(f\"URL has no host: {url!r}\")\n87:     if host == \"localhost\" or host.endswith((\".localhost\", \".local\", \".internal\")):\n88:         raise WebError(f\"non-public host refused: {host}\")\n89:     try:\n90:         infos = socket.getaddrinfo(host, None)\n91:     except OSError as e:\n92:         raise WebError(f\"cannot resolve host {host!r}: {e}\") from e\n93:     for info in infos:\n94:         ip = ipaddress.ip_address(info[4][0])\n95:         if not ip.is_global:\n96:             raise WebError(f\"non-public host refused: {host} ({ip})\")\n97: \n98: \n99: class _SafeRedirects(urllib.request.HTTPRedirectHandler):\n100:     \"\"\"Redirects pass through the same public-host check as the first hop.\"\"\"\n101: \n102:     def redirect_request(self, req, fp, code, msg, headers, newurl):\n103:         _assert_public_host(newurl)\n104:         return super().redirect_request(req, fp, code, msg, headers, newurl)\n105: \n106: \n107: def _drain(resp: Any, cancel: Any, max_bytes: int) -> bytes:\n108:     \"\"\"Read the body in chunks, honoring Stop between chunks.\"\"\"\n109:     chunks: list[bytes] = []\n110:     total = 0\n111:     while True:\n112:         if cancel is not None and cancel.is_set():\n113:             raise WebError(\"aborted by user\")\n114:         block = resp.read(65_536)\n115:         if not block:\n116:             break\n117:         total += len(block)\n118:         if total > max_bytes:\n119:             raise WebError(f\"response exceeds {max_bytes} bytes\")\n120:         chunks.append(block)\n121:     return b\"\".join(chunks)\n122: \n123: \n124: def _http_get(\n125:     url: str,\n126:     timeout: float = 15.0,\n127:     cancel: Any = None,\n128:     method: str = \"GET\",\n129:     body: bytes | None = None,\n130:     headers: dict[str, str] | None = None,\n131:     max_bytes: int = _MAX_BYTES,\n132: ) -> HttpResp:\n133:     \"\"\"One bounded HTTP request. Raises WebError with a short, model-readable\n134:     reason; every caller turns that into error-as-data.\"\"\"\n135:     if cancel is not None and cancel.is_set():\n136:         raise WebError(\"aborted by user\")\n137:     scheme = urllib.parse.urlsplit(url).scheme.lower()\n138:     if scheme not in (\"http\", \"https\"):\n139:         raise WebError(f\"unsupported URL scheme {scheme!r} (http/https only)\")\n140:     _assert_public_host(url)\n141:     req_headers = {\n142:         \"User-Agent\": USER_AGENT,\n143:         \"Accept\": \"*/*\",\n144:         \"Accept-Language\": \"zh-CN,zh;q=0.9,en;q=0.8\",\n145:         \"Accept-Encoding\": \"gzip\",\n146:     }\n147:     if headers:\n148:         req_headers.update(headers)\n149:     request = urllib.request.Request(url, data=body, headers=req_headers, method=method)\n150:     try:\n151:         resp = urllib.request.build_opener(_SafeRedirects()).open(request, timeout=timeout)\n152:     except WebError:\n153:         raise\n154:     except urllib.error.HTTPError as e:\n155:         raise WebError(f\"HTTP {e.code} from {url}\") from e\n156:     except urllib.error.URLError as e:\n157:         reason = getattr(e, \"reason\", e)\n158:         if isinstance(reason, (socket.timeout, TimeoutError)):\n159:             raise WebError(f\"timed out after {timeout:.0f}s\") from e\n160:         raise WebError(str(reason) or \"request failed\") from e\n161:     except (ValueError, OSError) as e:\n162:         raise WebError(f\"request failed: {e}\") from e\n163:     with resp:\n164:         raw = _drain(resp, cancel, max_bytes)\n165:     if resp.headers.get(\"Content-Encoding\", \"\").lower() == \"gzip\":\n166:         try:\n167:             raw = gzip.decompress(raw)\n168:         except OSError as e:\n169:             raise WebError(f\"malformed gzip body from {url}\") from e\n170:     elif resp.headers.get(\"Content-Encoding\", \"\").lower() == \"deflate\":\n171:         try:\n172:             raw = zlib.decompress(raw)\n173:         except zlib.error:\n174:             raw = zlib.decompress(raw, -zlib.MAX_WBITS)  # raw-deflate variant\n175:     return HttpResp(url=resp.geturl(), content_type=resp.headers.get(\"Content-Type\", \"\"), body=raw)\n176: \n177: \n178: _CHARSET_RE = re.compile(r\"charset=[\\\"']?([\\w\\-:+.]+)\", re.I)\n179: _META_CHARSET_RE = re.compile(r\"<meta[^>]+charset=[\\\"']?([\\w\\-:+.]+)\", re.I)\n180: \n181: \n182: def _decode_body(raw: bytes, content_type: str) -> str:\n183:     \"\"\"Bytes -> text: header charset, then a meta sniff, then utf-8, then\n184:     latin-1 (which never fails, so decoding cannot raise).\"\"\"\n185:     m = _CHARSET_RE.search(content_type or \"\")\n186:     charset = m.group(1) if m else None\n187:     if not charset:\n188:         m = _META_CHARSET_RE.search(raw[:4096].decode(\"ascii\", errors=\"ignore\"))\n189:         charset = m.group(1) if m else None\n190:     if charset:\n191:         try:\n192:             return raw.decode(charset, errors=\"replace\")\n193:         except (LookupError, ValueError):\n194:             pass  # unknown charset name: fall through to BOM/utf-8\n195:     for bom, enc in ((b\"\\xff\\xfe\", \"utf-16-le\"), (b\"\\xfe\\xff\", \"utf-16-be\")):\n196:         if raw.startswith(bom):\n197:             return raw.decode(enc, errors=\"replace\")\n198:     try:\n199:         return raw.decode(\"utf-8\")\n200:     except UnicodeDecodeError:\n201:         return raw.decode(\"latin-1\", errors=\"replace\")\n202: \n203: \n204: # ---- HTML -> readable text --------------------------------------------------\n205: \n206: _SNIPPET_TAG_RE = re.compile(r\"<[^>]+>\")\n207: \n208: \n209: def _clean_snippet(text: str) -> str:\n210:     \"\"\"Feed/blurb HTML to one line of plain text.\"\"\"\n... (showing lines 1-210 of 702; use offset=211 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789818111.4288409, "id": "d9df32a2c171", "tool_call_id": "call_8f509691d4d44629a2d6fe22", "content": "596: \n597: \n598: def mcp_status(url: str, service: McpService, timeout: float = 3.0) -> Any:\n599:     \"\"\"Query a service's status tool (e.g. login state); raw parsed payload.\n600: \n601:     Raises WebError on any failure — the caller turns that into a status row,\n602:     never into user-facing advice.\n603:     \"\"\"\n604:     if not service.status_tool:\n605:         return None\n606:     return _mcp_call(url, service.status_tool, {}, timeout)\n607: \n608: \n609: def _short(reason: object) -> str:\n610:     return re.sub(r\"\\s+\", \" \", str(reason)).strip()[:160]\n611: \n612: \n613: def web_search(\n614:     workspace: Workspace,\n615:     config: Config,\n616:     query: str,\n617:     max_results: int | None = None,\n618:     backend: str = \"\",\n619:     cancel: Any = None,\n620: ) -> dict[str, Any]:\n621:     \"\"\"Search the web; backends fall through in order until one yields.\"\"\"\n622:     q = (query or \"\").strip()\n623:     if not q:\n624:         return {\"content\": \"ERROR: query is required\", \"error\": True}\n625:     limit = max(1, min(int(max_results or config.web_search_max_results), 20))\n626:     backends = _all_backends(config)\n627:     available = tuple(name for name, backend in backends.items() if backend.available(config))\n628:     if backend:\n629:         # one factual gate for every source: not on the available list -> not\n630:         # named in the error either. No install/setup advice, ever.\n631:         if backend not in available:\n632:             return {\n633:                 \"content\": f\"ERROR: backend {backend!r} is not available; available: \"\n634:                 + (\", \".join(available) or \"none\"),\n635:                 \"error\": True,\n636:             }\n637:         chain: tuple[str, ...] = (backend,)\n638:     else:\n639:         chain = available\n640:     get = functools.partial(_http_get, timeout=config.web_search_timeout, cancel=cancel)\n641:     failures: list[str] = []\n642:     for name in chain:\n643:         try:\n644:             results = backends[name].search(q, limit, config, get)\n645:         except (BackendError, WebError) as e:\n646:             failures.append(f\"- {name}: {_short(e)}\")\n647:             continue\n648:         seen: set[str] = set()\n649:         deduped = []\n650:         for r in results:\n651:             if r[\"url\"] in seen:\n652:                 continue\n653:             seen.add(r[\"url\"])\n654:             deduped.append(r)\n655:         body = \"\\n\".join(f\"{i}. {r['title']}\\n   {r['url']}\\n   {r['snippet']}\" for i, r in enumerate(deduped, 1))\n656:         return {\"content\": f\"{len(deduped)} results for {q!r} (via {name}):\\n\\n{body}\"}\n657:     return {\n658:         \"content\": \"ERROR: all search backends failed\\n\" + \"\\n\".join(failures),\n659:         \"error\": True,\n660:     }\n661: \n662: \n663: _BINARY_TYPES = (\"image/\", \"video/\", \"audio/\")\n664: _BINARY_EXACT = {\"application/pdf\", \"application/zip\", \"application/gzip\", \"application/x-tar\", \"application/octet-stream\"}\n665: \n666: \n667: def web_fetch(\n668:     workspace: Workspace,\n669:     config: Config,\n670:     url: str,\n671:     max_chars: int | None = None,\n672:     start: int = 0,\n673:     cancel: Any = None,\n674: ) -> dict[str, Any]:\n675:     \"\"\"One page -> readable text; oversized pages continue at `start`.\"\"\"\n676:     u = (url or \"\").strip()\n677:     if not u:\n678:         return {\"content\": \"ERROR: url is required\", \"error\": True}\n679:     try:\n680:         resp = _http_get(u, timeout=config.web_search_timeout, cancel=cancel)\n681:     except WebError as e:\n682:         return {\"content\": f\"ERROR: {_short(e)}\", \"error\": True}\n683:     ctype = resp.content_type.split(\";\")[0].strip().lower()\n684:     if ctype.startswith(_BINARY_TYPES) or ctype in _BINARY_EXACT:\n685:         return {\"content\": f\"ERROR: unsupported content-type {ctype!r} (text pages only)\", \"error\": True}\n686:     text = _decode_body(resp.body, resp.content_type)\n687:     if \"html\" in ctype or (not ctype and text.lstrip()[:1] == \"<\"):\n688:         extractor = _TextExtractor()\n689:         extractor.feed(text)\n690:         extractor.close()\n691:         parts = ([f\"# {extractor.title}\"] if extractor.title else []) + [extractor.text() or \"(no extractable text; the page is probably JS-rendered)\"]\n692:         page = \"\\n\\n\".join(parts)\n693:     else:\n694:         page = text\n695:     limit = max(200, int(max_chars or config.read_max_chars))\n696:     chunk, next_start = _window(page, int(start or 0), limit)\n697:     if next_start is not None:\n698:         remaining = len(page) - next_start\n699:         chunk += f\"\\n... [{remaining} chars truncated; fetch again with start={next_start} to continue]\"\n700:     if resp.url != u:\n701:         chunk = f\"(redirected to {resp.url})\\n\\n{chunk}\"\n702:     return {\"content\": chunk}", "is_error": false, "diff": ""}
