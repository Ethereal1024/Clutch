{"type": "tool_result", "timestamp": 1789815025.480206, "id": "0dd55020741e", "tool_call_id": "call_7e94f36be0d8430e9d954742", "content": "78:         p.chmod(0o600)  # owner-only, the file holds a credential\n79:     except OSError as e:\n80:         print(f\"[clutch-server] cannot persist settings: {e}\", file=sys.stderr)\n81: \n82: \n83: def mcp_providers() -> list:\n84:     \"\"\"Registered MCP web-search providers (stable order for the UI).\"\"\"\n85:     return list(_MCP_PROVIDER_REGISTRY.values())\n86: \n87: \n88: def _split_mcp_fields(body: dict) -> dict[str, str]:\n89:     \"\"\"Pull mcp_<provider> URL fields out of a settings POST body.\n90: \n91:     Values must be http(s) URLs, or '' to clear the entry; names are free-form\n92:     so a newer UI can configure providers this build does not know.\n93:     \"\"\"\n94:     out: dict[str, str] = {}\n95:     for key, value in body.items():\n96:         if not key.startswith(\"mcp_\") or not isinstance(value, str):\n97:             continue\n98:         value = value.strip().rstrip(\"/\")\n99:         if value and not value.startswith((\"http://\", \"https://\")):\n100:             raise ValueError(f\"{key} must be an http(s) URL\")\n101:         out[key] = value\n102:     return out\n103: \n104: \n105: def _mcp_keys_from(raw: dict) -> dict[str, str]:\n106:     \"\"\"mcp_<provider> entries persisted in the settings file (flatten drops them).\"\"\"\n107:     return {k: v for k, v in raw.items() if k.startswith(\"mcp_\") and isinstance(v, str) and v}\n108: \n109: \n110: def _login_state(state: Any) -> bool | None:\n111:     \"\"\"Best-effort normalization of a provider's login-status payload.\"\"\"\n112:     truthy = (\"logged_in\", \"logged in\", \"true\", \"yes\", \"ok\", \"success\")\n113:     if isinstance(state, bool):\n114:         return state\n115:     if isinstance(state, str):\n116:         return state.strip().lower() in truthy\n117:     if isinstance(state, dict):\n... (showing lines 78-117 of 884; use offset=118 to continue)", "is_error": false, "diff": ""}
