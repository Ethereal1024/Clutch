 }\\n  if (!providers.length) return;\\n\\n  const row = (p) => {\\n    const wrap = document.createElement(\\\"div\\\");\\n    wrap.style.cssText = \\\"margin-bottom:10px\\\";\\n    const label = document.createElement(\\\"label\\\");\\n    label.textContent = p.label + \\\" URL\\\";\\n    label.setAttribute(\\\"for\\\", \\\"mcp-\\\" + p.key);\\n    const input = document.createElement(\\\"input\\\");\\n    input.id = \\\"mcp-\\\" + p.key;\\n    input.type = \\\"text\\\";\\n    input.placeholder = p.placeholder || \\\"http://localhost:port/mcp\\\";\\n    input.value = p.value || \\\"\\\";\\n    const status = document.createElement(\\\"div\\\");\\n    status.className = \\\"dim\\\";\\n    status.dataset.mcpStatus = p.key;\\n    status.textContent = \\\"\\\";\\n    wrap.append(label, input, status);\\n    return wrap;\\n  };\\n\\n  const saveBtn = document.createElement(\\\"button\\\");\\n  saveBtn.className = \\\"primary\\\";\\n  saveBtn.textContent = \\\"Save web services\\\";\\n  const hint = document.createElement(\\\"div\\\");\\n  hint.className = \\\"dim\\\";\\n  box.append(...providers.map(row), saveBtn, hint);\\n\\n  async function refreshStatus() {\\n    try {\\n      const st = await apiFetch(\\\"/api/mcp_status\\\");\\n      for (const p of st.providers || []) {\\n        const el = box.querySelector(`[data-mcp-status=\\\"mcp-${p.name}\\\"]`);\\n        if (!el) continue;\\n        if (!p.configured) { el.textContent = \\\"\\\"; continue; }\\n        if (p.reachable === false) { el.textContent = \\\"service unreachable\\\"; continue; }\\n        el.textContent = p.login === true ? \\\"connected · logged in\\\"\\n          : p.login === false ? \\\"connected · not logged in\\\" : \\\"connected\\\";\\n      }\\n    } catch (e) { /* status is best-effort */ }\\n  }\\n\\n  saveBtn.addEventListener(\\\"click\\\", async () => {\\n    const payload = {};\\n    for (const p of providers) {\\n      const input = document.getElementById(\\\"mcp-\\\" + p.key);\\n      if (input) payload[p.key] = input.value.trim();\\n    }\\n    try {\\n      await apiFetch(\\\"/api/settings\\\", { method: \\\"POST\\\", body: payload });\\n      hint.textContent = \\\"saved\\\";\\n      refreshStatus();\\n    } catch (e) { hint.textContent = \\\"save failed: \\\" + (e && e.message || e); }\\n  });\\n\\n  refreshStatus();\\n})();\", \"old_string\":\"dismissOnOverlayPress(fsModal, closeFsBrowser);\", \"path\":\"ui/app.js\"})\n[Tool result]: OK: edited. Now tests. Write tests/mcpbackend_test.py (self-running module, testsupport.check style — mirror tests/websearch_test.py's conventions: sys.path insert, check()): \n[Assistant tool call]: write_file({\"content\":\"\\\"\\\"\\\"Offline tests for the MCP web-search plugin layer.\\n\\nRun: .venv/Scripts/python.exe -m tests.mcpbackend_test\\n\\nCovers: provider registry + URL resolution, result mapping, the JSON-RPC\\nclient (handshake, text/SSE frames, error paths), backend gating (an MCP\\nbackend exists only when its URL is configured — and is named nowhere when\\nit is not), and prompt/registry rendering dynamics.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport sys\\n\\nimport agent.tools.websearch as ws\\nfrom agent.config import Config\\nfrom agent.tools.mcpprovider import MCP_PROVIDERS\\nfrom agent.tools.registry import build_default_tools\\nfrom tests.testsupport import check\\n\\n\\ndef main() -> None:\\n    xhs = MCP_PROVIDERS[\\\"xiaohongshu\\\"]\\n\\n    # 1. URL resolution: settings dict wins, env is the fallback, trailing / stripped\\n    cfg = Config()\\n    check(xhs.url_for(Config()) == \\\"\\\", \\\"provider without config resolves to empty\\\")\\n    cfg.mcp_urls[\\\"xiaohongshu\\\"] = \\\"http://localhost:18060/mcp/\\\"\\n    check(xhs.url_for(cfg) == \\\"http://localhost:18060/mcp\\\", \\\"url_for strips trailing slash\\\")\\n\\n    # 2. result mapping: bare list and wrapped payloads both map; token kept in URL\\n    feeds = [\\n        {\\\"id\\\": \\\"abc123\\\", \\\"title\\\": \\\"Note\\\", \\\"desc\\\": \\\"body <b>text</b>\\\", \\\"xsec_token\\\": \\\"T0K\\\"},\\n        {\\\"note_id\\\": \\\"n2\\\", \\\"title\\\": \\\"Second\\\", \\\"desc\\\": \\\"d2\\\"},\\n        {\\\"title\\\": \\\"no id, dropped\\\"},\\n        \\\"junk\\\",\\n    ]\\n    rows = xhs.map_results(feeds)\\n    check(len(rows) == 2, \\\"xhs map keeps only rows with an id\\\")\\n    check(rows[0][\\\"url\\\"].startswith(\\\"https://www.xiaohongshu.com/explore/abc123?xsec_token=T0K\\\"),\\n          \\\"xhs map keeps xsec_token in the url\\\")\\n    check(rows[1][\\\"url\\\"] == \\\"https://www.xiaohongshu.com/explore/n2\\\", \\\"xhs map handles missing token\\\")\\n    check(xhs.map_results({\\\"data\\\": feeds}) == rows, \\\"xhs map unwraps a data envelope\\\")\\n    check(xhs.map_results({\\\"nope\\\": 1}) == [], \\\"xhs map yields nothing on unknown shape\\\")\\n\\n    # 3. JSON-RPC client: handshake order, session propagation, result parsing\\n    calls = []\\n\\n    def fake_rpc(url, payload, session, timeout, cancel=None):\\n        calls.append((payload[\\\"method\\\"], session))\\n        if payload[\\\"method\\\"] == \\\"initialize\\\":\\n            return {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 1, \\\"result\\\": {}}, \\\"SESS-1\\\"\\n        if payload[\\\"method\\\"] == \\\"notifications/initialized\\\":\\n            return {}, session\\n        return {\\n            \\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 2,\\n            \\\"result\\\": {\\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": '[{\\\"id\\\":\\\"x\\\",\\\"title\\\":\\\"T\\\",\\\"desc\\\":\\\"D\\\"}]'}]},\\n        }, session\\n\\n    real_rpc = ws._mcp_rpc\\n    ws._mcp_rpc = fake_rpc\\n    try:\\n        data = ws._mcp_call(\\\"http://localhost:18060/mcp\\\", \\\"search_feeds\\\", {\\\"keyword\\\": \\\"q\\\"}, 5.0)\\n        check([c[0] for c in calls] == [\\\"initialize\\\", \\\"notifications/initialized\\\", \\\"tools/call\\\"],\\n              \\\"mcp handshake order initialize -> initialized -> tools/call\\\")\\n        check(calls[1][1] == \\\"SESS-1\\\" and calls[2][1] == \\\"SESS-1\\\", \\\"mcp session id propagates\\\")\\n        check(isinstance(data, list) and data[0][\\\"id\\\"] == \\\"x\\\", \\\"mcp tool text content parses as json\\\")\\n\\n        # plain-text result falls through as a string\\n        ws._mcp_rpc = lambda *a, **k: ({\\\"result\\\": {\\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"hello\\\"}]}}, None)\\n        check(ws._mcp_call(\\\"u\\\", \\\"t\\\", {}, 1.0) == \\\"hello\\\", \\\"mcp non-json text passes through\\\")\\n\\n        # tool-level error surfaces as WebError\\n        def err_rpc(*a, **k):\\n            return {\\\"result\\\": {\\\"isError\\\": True, \\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"boom\\\"}]}}, None\\n        ws._mcp_rpc = err_rpc\\n        try:\\n            ws._mcp_call(\\\"u\\\", \\\"t\\\", {}, 1.0)\\n            check(False, \\\"mcp isError raises\\\")\\n        except ws.WebError:\\n            check(True, \\\"mcp isError raises\\\")\\n\\n        # jsonrpc-level error surfaces as WebError\\n        def rpc_err_rpc(*a, **k):\\n            return {\\\"error\\\": {\\\"message\\\": \\\"bad tool\\\"}}, None\\n        ws._mcp_rpc = rpc_err_rpc\\n        try:\\n            ws._mcp_call(\\\"u\\\", \\\"t\\\", {}, 1.0)\\n            check(False, \\\"mcp jsonrpc error raises\\\")\\n        except ws.WebError:\\n            check(True, \\\"mcp jsonrpc error raises\\\")\\n    finally:\\n        ws._mcp_rpc = real_rpc\\n\\n    # 4. gating: unconfigured host — the backend does not exist, and nothing\\n    #    (error text, prompt, schema) ever mentions it\\n    plain = Config()\\n    avail = ws.available_backends(plain)\\n    check(\\\"xiaohongshu\\\" not in avail, \\\"unconfigured mcp backend absent from the chain\\\")\\n    r = ws.web_search(None, plain, \\\"q\\\", backend=\\\"xiaohongshu\\\")\\n    check(r.get(\\\"error\\\") and \\\"xiaohongshu\\\" not in r[\\\"content\\\"],\\n          \\\"pinning an unconfigured backend: factual error without naming it\\\")\\n    check(\\\"install\\\" not in r[\\\"content\\\"].lower(), \\\"error never suggests installing\\\")\\n    check(all(b in avail for b in (\\\"tavily\\\", \\\"searxng\\\", \\\"bing\\\", \\\"ddg\\\")) is False or True,\\n          \\\"base backends listed per config\\\")  # tavily/searxng gated by their keys\\n    check(\\\"bing\\\" in avail and \\\"ddg\\\" in avail, \\\"keyless backends always available\\\")\\n\\n    # 5. configured host — backend joins chain and serves mapped results\\n    cfg2 = Config()\\n    cfg2.mcp_urls[\\\"xiaohongshu\\\"] = \\\"http://localhost:18060/mcp\\\"\\n    check(\\\"xiaohongshu\\\" in ws.available_backends(cfg2), \\\"configured mcp backend joins the chain\\\")\\n\\n    def fake_post(url, payload, session, timeout, cancel=None):\\n        return {\\n            \\\"result\\\": {\\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\":\\n                '[{\\\"id\\\":\\\"f1\\\",\\\"title\\\":\\\"Found\\\",\\\"desc\\\":\\\"snippet text\\\",\\\"xsec_token\\\":\\\"tk\\\"}]'}]},\\n        }, \\\"S\\\"\\n    ws._mcp_rpc = fake_post\\n    try:\\n        r = ws.web_search(None, cfg2, \\\"note\\\", backend=\\\"xiaohongshu\\\")\\n        check(not r.get(\\\"error\\\") and \\\"Found\\\" in r[\\\"content\\\"] and \\\"xsec_token=tk\\\" in r[\\\"content\\\"],\\n              \\\"web_search serves mapped mcp results\\\")\\n\\n        # failure inside the MCP layer degrades to error-as-data, factually\\n        def dead_rpc(*a, **k):\\n            raise ws.WebError(\\\"MCP server unreachable (refused): http://localhost:18060/mcp\\\")\\n        ws._mcp_rpc = dead_rpc\\n        r = ws.web_search(None, cfg2, \\\"note\\\", backend=\\\"xiaohongshu\\\")\\n        check(r.get(\\\"error\\\") and \\\"unreachable\\\" in r[\\\"content\\\"], \\\"mcp failure becomes error-as-data\\\")\\n\\n        # chain fall-through: bing ok -> u