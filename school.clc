{"type": "tool_result", "timestamp": 1789898383.046185, "id": "b497b3276a9e", "tool_call_id": "call_11594f5d76f7416c8ca7084e", "content": "[project]\nname = \"clutch\"\nversion = \"0.1.0\"\ndescription = \"A self-built coding agent: LLM loop + tools + events, driven by a GUI. CLI removed.\"\nrequires-python = \">=3.10\"\nlicense = \"MIT\"\ndependencies = [\n    \"openai>=1.0\",\n    \"httpx2>=2.0\",\n]\n\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n\n[tool.hatch.build.targets.wheel]\npackages = [\"agent\"]\n\n# ship the cross-language transport defaults (workspace.py and ui/ssh-tunnel.js\n# both read this single source for the remote wire limits)\n[tool.hatch.build.targets.wheel.force-include]\n\"agent/transport_defaults.json\" = \"agent/transport_defaults.json\"\n\n[[tool.uv.index]]\nurl = \"https://pypi.tuna.tsinghua.edu.cn/simple\"\ndefault = true\n\n[dependency-groups]\ndev = [\n    \"ruff>=0.16.5\",\n    \"pyinstaller>=6.0\",\n]\n\n[tool.ruff]\nline-length = 120\ntarget-version = \"py310\"\n\n[tool.ruff.lint]\nselect = [\"E\", \"F\", \"W\", \"B\", \"I\"]\n", "is_error": false, "diff": ""}
