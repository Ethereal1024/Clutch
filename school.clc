{"type": "tool_result", "timestamp": 1789632728.0404236, "id": "6512b1ceed1c", "tool_call_id": "call_3dc68ba617694af28ef8bf0e", "content": "1: \"\"\"Declarative tool registry.\n2: \n3: Single source of truth: one Tool definition yields both the OpenAI function-calling\n4: schema and the local execution entry. Tool descriptions live here as schema data;\n5: error texts live in agent/prompts/.\n6: \"\"\"\n7: \n8: from __future__ import annotations\n9: \n10: import inspect\n11: import threading\n12: from dataclasses import dataclass\n13: from typing import Any, Callable\n14: \n15: from ..config import Config\n16: from ..memory import MemoryStore\n17: from ..prompts import render\n18: from ..skills import cached_library\n19: from . import filesystem, shell, websearch\n20: from .workspace import Workspace\n21: \n22: # (workspace, config, **args) -> dict{content, error?}\n23: ToolImpl = Callable[..., dict[str, Any]]\n24: \n25: \n26: @dataclass\n27: class Tool:\n28:     name: str\n29:     description: str\n30:     parameters: dict[str, Any]  # JSON Schema (properties + required)\n31:     func: ToolImpl\n32: \n33:     def to_openai_schema(self) -> dict[str, Any]:\n34:         return {\n35:             \"type\": \"function\",\n36:             \"function\": {\n37:                 \"name\": self.name,\n38:                 \"description\": self.description,\n39:                 \"parameters\": {\n40:                     \"type\": \"object\",\n41:                     \"properties\": self.parameters.get(\"properties\", {}),\n42:                     \"required\": self.parameters.get(\"required\", []),\n43:                 },\n44:             },\n45:         }\n46: \n47: \n48: def _str_param(desc: str) -> dict[str, Any]:\n49:     return {\"type\": \"string\", \"description\": desc}\n50: \n51: \n52: def build_default_tools(config: Config, memories: MemoryStore | None = None) -> list[Tool]:\n53:     chat_mode = config.mode == \"chat\"\n54:     tools = [\n55:         Tool(\n56:             name=\"read_file\",\n57:             description=render(\"tools/read_file.md\", read_max_chars=config.read_max_chars),\n58:             parameters={\n... (showing lines 1-58 of 372; use offset=59 to continue)", "is_error": false, "diff": ""}
