{"type": "tool_result", "timestamp": 1789814988.0009768, "id": "490275e4fbdf", "tool_call_id": "call_71c2d0d2f6834fff9dc5d5ef", "content": "OK: command succeeded\nstdout:\n46:from .tools.mcpprovider import MCP_PROVIDERS as _MCP_PROVIDER_REGISTRY\n47:from .tools.websearch import mcp_status as _mcp_status_probe\n83:def mcp_providers() -> list:\n84:    \"\"\"Registered MCP web-search providers (stable order for the UI).\"\"\"\n85:    return list(_MCP_PROVIDER_REGISTRY.values())\n88:def _split_mcp_fields(body: dict) -> dict[str, str]:\n89:    \"\"\"Pull mcp_<provider> URL fields out of a settings POST body.\n96:        if not key.startswith(\"mcp_\") or not isinstance(value, str):\n105:def _mcp_keys_from(raw: dict) -> dict[str, str]:\n106:    \"\"\"mcp_<provider> entries persisted in the settings file (flatten drops them).\"\"\"\n107:    return {k: v for k, v in raw.items() if k.startswith(\"mcp_\") and isinstance(v, str) and v}\n206:        elif path == \"/api/mcp_status\":\n207:            self._mcp_status()\n368:            mcp_updates = _split_mcp_fields(body)\n374:            and not mcp_updates\n388:            for key, value in mcp_updates.items():\n390:                    self._cfg.mcp_urls[key[4:]] = value\n392:                    self._cfg.mcp_urls.pop(key[4:], None)\n394:        # carry the mcp_<provider> keys across so a settings save never wipes\n396:        saved = {**_mcp_keys_from(load_settings()), **flatten_settings(load_settings())}\n408:        for key, value in mcp_updates.items():\n426:                # MCP web-search services: rendered dynamically by the UI; a\n428:                \"mcp_providers\": [\n430:                        \"key\": f\"mcp_{p.name}\",\n433:                        \"value\": self._cfg.mcp_urls.get(p.name) or raw.get(f\"mcp_{p.name}\", \"\"),\n435:                    for p in mcp_providers()\n440:    def _mcp_status(self) -> None:\n441:        \"\"\"Per-provider MCP reachability + login state, for the settings modal.\n448:        for p in mcp_providers():\n458:                    state = _mcp_status_probe(url, p) if p.status_tool else None\n845:    # MCP web-search services (settings.json keys mcp_<provider>); the env-only\n846:    # CLUTCH_MCP_<NAME>_URL is resolved by the provider itself at call time\n847:    for _key, _value in _mcp_keys_from(load_settings()).items():\n848:        config.mcp_urls[_key[4:]] = _value.rstrip(\"/\")\n", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789814988.130518, "id": "fa52afe28fce", "tool_call_id": "call_ec47543f92c54e9c8a77e96e", "content": "OK: command succeeded\nstdout:\nagent/config.py:85:    # name (see tools/mcpprovider.py), e.g. {\"xiaohongshu\": \"http://localhost:18060/mcp\"}.\nagent/config.py:86:    # Populated from settings.json keys mcp_<name> or CLUTCH_MCP_<NAME>_URL;\nagent/config.py:88:    mcp_urls: dict[str, str] = field(default_factory=dict)\nui/app.js:2814:// Rendered from GET /api/settings mcp_providers metadata: a host without a\nui/app.js:2818:  const box = document.getElementById(\"mcp-services\");\nui/app.js:2833:      input.id = \"mcp-input-\" + p.key;\nui/app.js:2836:      input.placeholder = p.placeholder || \"http://localhost:port/mcp\";\nui/app.js:2840:      status.dataset.mcpStatus = p.key;\nui/app.js:2855:    save.id = \"mcp-services-save\";\nui/app.js:2866:        const el = document.getElementById(\"mcp-input-\" + p.key);\nui/app.js:2881:      const st = await apiFetch(\"/api/mcp_status\");\nui/app.js:2883:      for (const row of (st && st.providers) || []) byKey[\"mcp_\" + row.name] = row;\nui/app.js:2884:      box.querySelectorAll(\"[data-mcp-status]\").forEach((el) => {\nui/app.js:2885:        const row = byKey[el.dataset.mcpStatus];\nui/app.js:2902:      render(s.mcp_providers || [], {});\nREADME.md:40:外部 MCP 服务也可以接入为搜索后端（如 xiaohongshu-mcp）：在设置弹窗的\nREADME.md:41:Web services 区填入服务地址即可（存于 `~/.clutch/settings.json` 的 `mcp_<名字>`\n", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789814988.1342154, "id": "d0bdacc0f3fe", "tool_call_id": "call_527a6ebe59414065ad2aa1de", "content": "1: \"\"\"Web access tools: web_search (multi-backend search) + web_fetch (page -> text).\n2: \n3: Built on the stdlib only (urllib + html.parser + ElementTree) — the LLM loop is\n4: hand-rolled here, and so is web access: no scraping SDK that rots when an\n5: engine tweaks its markup. Backends, tried in order, first success wins:\n6: \n7:   tavily   LLM-first search API, best quality   (CLUTCH_TAVILY_API_KEY)\n8:   searxng  self-hosted metasearch, JSON API     (CLUTCH_SEARXNG_URL)\n9:   bing     the undocumented RSS endpoint of cn.bing.com — keyless, CN-friendly\n10:   ddg      duckduckgo html endpoint — keyless\n11: \n12: Poka-yoke (make it hard for the model to misuse):\n13: - timeout: every request is bounded (Config.web_search_timeout); Stop is\n14:   honored between chunks so a hung fetch never outlives the user's patience\n15: - size cap: responses larger than max_bytes are rejected, not swallowed\n16: - private-network guard: web_fetch refuses loopback/LAN hosts (and follows\n17:   redirects only to public hosts) — a GET into the agent's own API or the\n18:   LAN stays impossible even when the model is talked into trying\n19: - error-as-data: backend failures list each reason; a truncating fetch says\n20:   how to fetch the next slice, mirroring read_file's offset hints\n21: \"\"\"\n22: \n23: from __future__ import annotations\n24: \n25: import functools\n26: import gzip\n27: import ipaddress\n28: import json\n29: import re\n30: import socket\n31: import urllib.error\n32: import urllib.parse\n33: import urllib.request\n34: import xml.etree.ElementTree as ET\n35: import zlib\n36: from dataclasses import dataclass\n37: from html import unescape\n38: from html.parser import HTMLParser\n39: from typing import Any, Callable\n40: \n41: from ..config import Config\n42: from .mcpprovider import McpProvider, MCP_PROVIDERS\n43: from .workspace import Workspace\n44: \n45: # browser-shaped but honest about the product; several CDNs 403 blank UAs\n46: USER_AGENT = (\n47:     \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) \"\n48:     \"Chrome/124.0 Safari/537.36 ClutchAgent/0.1\"\n49: )\n50: \n51: _MAX_BYTES = 2_000_000  # hard cap per response: pages are for reading, not hoarding\n52: \n53: \n54: class WebError(Exception):\n55:     \"\"\"A request-level failure (DNS, timeout, size cap, private host).\"\"\"\n56: \n57: \n58: class BackendError(Exception):\n59:     \"\"\"A backend responded but yielded nothing usable (blocked, layout changed).\"\"\"\n60: \n61: \n62: @dataclass\n63: class HttpResp:\n64:     url: str  # final URL after redirects\n65:     content_type: str\n66:     body: bytes\n67: \n68: \n69: # ---- HTTP core -------------------------------------------------------------\n70: \n... (showing lines 1-70 of 689; use offset=71 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789814988.1377194, "id": "c166abc152fa", "tool_call_id": "call_c4a2443ac58f46d29ac2f530", "content": "473: def _mcp_call(\n474:     url: str,\n475:     tool: str,\n476:     args: dict,\n477:     timeout: float,\n478:     cancel: Any = None,\n479: ) -> Any:\n480:     \"\"\"initialize -> tools/call against an HTTP MCP server; returns the parsed\n481:     tool output (JSON when it parses, else the plain text).\"\"\"\n482:     hello = {\n483:         \"jsonrpc\": \"2.0\",\n484:         \"id\": 1,\n485:         \"method\": \"initialize\",\n486:         \"params\": {\n487:             \"protocolVersion\": _MCP_PROTO,\n488:             \"capabilities\": {},\n489:             \"clientInfo\": {\"name\": \"clutch\", \"version\": \"0.1\"},\n490:         },\n491:     }\n492:     _, session = _mcp_rpc(url, hello, None, timeout, cancel)\n493:     if session:\n494:         _mcp_rpc(\n495:             url,\n496:             {\"jsonrpc\": \"2.0\", \"method\": \"notifications/initialized\"},\n497:             session,\n498:             timeout,\n499:             cancel,\n500:         )\n501:     resp, _ = _mcp_rpc(\n502:         url,\n503:         {\n504:             \"jsonrpc\": \"2.0\",\n505:             \"id\": 2,\n506:             \"method\": \"tools/call\",\n507:             \"params\": {\"name\": tool, \"arguments\": args},\n508:         },\n509:         session,\n510:         timeout,\n511:         cancel,\n512:     )\n513:     result = resp.get(\"result\") or {}\n514:     parts = result.get(\"content\") or []\n515:     text = \"\\n\".join(\n516:         p.get(\"text\", \"\") for p in parts if isinstance(p, dict) and p.get(\"type\") == \"text\"\n517:     ).strip()\n518:     if result.get(\"isError\") and text:\n519:         raise WebError(f\"MCP tool error: {_short(text)}\")\n520:     try:\n521:         return json.loads(text)\n522:     except ValueError:\n523:         return text\n524: \n525: \n526: # ---- registry ---------------------------------------------------------------\n527: # One protocol for every source: a Backend knows how to search and whether it\n528: # exists on this machine. web_search only ever sees this shape, so adding a\n529: # source (e.g. an MCP service) touches nothing else in this module.\n530: \n531: \n532: @dataclass(frozen=True)\n533: class Backend:\n534:     name: str\n535:     search: Callable[[str, int, Config, Callable[..., HttpResp]], list[dict[str, str]]]\n536:     available: Callable[[Config], bool] = lambda config: True\n537: \n538: \n539: _BACKENDS: dict[str, Backend] = {\n540:     \"tavily\": Backend(\"tavily\", _tavily, lambda c: bool(c.tavily_api_key)),\n541:     \"searxng\": Backend(\"searxng\", _searxng, lambda c: bool(c.searxng_url)),\n542:     \"bing\": Backend(\"bing\", _bing),\n... (showing lines 473-542 of 689; use offset=543 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789814988.140223, "id": "321657f7e7b1", "tool_call_id": "call_44c38a3c50224410a953a784", "content": "584: \n585: \n586: def mcp_status(url: str, provider: McpProvider, timeout: float = 3.0) -> Any:\n587:     \"\"\"Query a provider's status tool (e.g. login state); raw parsed payload.\n588: \n589:     Raises WebError on any failure — the caller turns that into a status row,\n590:     never into user-facing advice.\n591:     \"\"\"\n592:     if not provider.status_tool:\n593:         return None\n594:     return _mcp_call(url, provider.status_tool, {}, timeout)\n595: \n596: \n597: def _short(reason: object) -> str:\n598:     return re.sub(r\"\\s+\", \" \", str(reason)).strip()[:160]\n599: \n600: \n601: def web_search(\n602:     workspace: Workspace,\n603:     config: Config,\n604:     query: str,\n605:     max_results: int | None = None,\n606:     backend: str = \"\",\n607:     cancel: Any = None,\n608: ) -> dict[str, Any]:\n609:     \"\"\"Search the web; backends fall through in order until one yields.\"\"\"\n610:     q = (query or \"\").strip()\n611:     if not q:\n612:         return {\"content\": \"ERROR: query is required\", \"error\": True}\n613:     limit = max(1, min(int(max_results or config.web_search_max_results), 20))\n614:     available = _available_backends(config)\n615:     if backend:\n616:         # one factual gate for every source: not on the available list -> not\n617:         # named in the error either. No install/setup advice, ever.\n618:         if backend not in available:\n619:             return {\n620:                 \"content\": f\"ERROR: backend {backend!r} is not available; available: \"\n621:                 + (\", \".join(available) or \"none\"),\n622:                 \"error\": True,\n623:             }\n624:         chain: tuple[str, ...] = (backend,)\n625:     else:\n626:         chain = available\n627:     get = functools.partial(_http_get, timeout=config.web_search_timeout, cancel=cancel)\n628:     failures: list[str] = []\n629:     for name in chain:\n630:         try:\n631:             results = _BACKENDS[name].search(q, limit, config, get)\n632:         except (BackendError, WebError) as e:\n633:             failures.append(f\"- {name}: {_short(e)}\")\n634:             continue\n635:         seen: set[str] = set()\n636:         deduped = []\n637:         for r in results:\n638:             if r[\"url\"] in seen:\n639:                 continue\n640:             seen.add(r[\"url\"])\n641:             deduped.append(r)\n642:         body = \"\\n\".join(f\"{i}. {r['title']}\\n   {r['url']}\\n   {r['snippet']}\" for i, r in enumerate(deduped, 1))\n643:         return {\"content\": f\"{len(deduped)} results for {q!r} (via {name}):\\n\\n{body}\"}\n644:     return {\n645:         \"content\": \"ERROR: all search backends failed\\n\" + \"\\n\".join(failures),\n646:         \"error\": True,\n647:     }\n648: \n649: \n650: _BINARY_TYPES = (\"image/\", \"video/\", \"audio/\")\n651: _BINARY_EXACT = {\"application/pdf\", \"application/zip\", \"application/gzip\", \"application/x-tar\", \"application/octet-stream\"}\n652: \n653: \n654: def web_fetch(\n655:     workspace: Workspace,\n656:     config: Config,\n657:     url: str,\n658:     max_chars: int | None = None,\n659:     start: int = 0,\n660:     cancel: Any = None,\n661: ) -> dict[str, Any]:\n662:     \"\"\"One page -> readable text; oversized pages continue at `start`.\"\"\"\n663:     u = (url or \"\").strip()\n664:     if not u:\n665:         return {\"content\": \"ERROR: url is required\", \"error\": True}\n666:     try:\n667:         resp = _http_get(u, timeout=config.web_search_timeout, cancel=cancel)\n668:     except WebError as e:\n669:         return {\"content\": f\"ERROR: {_short(e)}\", \"error\": True}\n670:     ctype = resp.content_type.split(\";\")[0].strip().lower()\n671:     if ctype.startswith(_BINARY_TYPES) or ctype in _BINARY_EXACT:\n672:         return {\"content\": f\"ERROR: unsupported content-type {ctype!r} (text pages only)\", \"error\": True}\n673:     text = _decode_body(resp.body, resp.content_type)\n674:     if \"html\" in ctype or (not ctype and text.lstrip()[:1] == \"<\"):\n675:         extractor = _TextExtractor()\n676:         extractor.feed(text)\n677:         extractor.close()\n678:         parts = ([f\"# {extractor.title}\"] if extractor.title else []) + [extractor.text() or \"(no extractable text; the page is probably JS-rendered)\"]\n679:         page = \"\\n\\n\".join(parts)\n680:     else:\n681:         page = text\n682:     limit = max(200, int(max_chars or config.read_max_chars))\n683:     chunk, next_start = _window(page, int(start or 0), limit)\n684:     if next_start is not None:\n685:         remaining = len(page) - next_start\n686:         chunk += f\"\\n... [{remaining} chars truncated; fetch again with start={next_start} to continue]\"\n687:     if resp.url != u:\n688:         chunk = f\"(redirected to {resp.url})\\n\\n{chunk}\"\n689:     return {\"content\": chunk}", "is_error": false, "diff": ""}
