{"type": "tool_result", "timestamp": 1789877630.9936123, "id": "116229e33f1d", "tool_call_id": "call_0994f3e250db4940ba2393fa", "content": "349:     def execute(\n350:         self,\n351:         workspace: Workspace,\n352:         config: Config,\n353:         name: str,\n354:         args: dict[str, Any],\n355:         cancel: threading.Event | None = None,\n356:     ) -> dict[str, Any]:\n357:         tool = self._tools.get(name)\n358:         if tool is None:\n359:             return {\n360:                 \"content\": render(\"unknown_tool.md\", tool=name, available=\", \".join(self.names())),\n361:                 \"error\": True,\n362:             }\n363:         try:\n364:             args = self._coerce_types(tool, args)\n365:             # subprocess tools run in a child process — but only where that is\n366:             # meaningful (see Tool.subprocess): frozen builds and remote\n367:             # workspaces fall back to the plain in-process call\n368:             use_child = (\n369:                 tool.subprocess\n370:                 and not getattr(sys, \"frozen\", False)\n371:                 and isinstance(workspace, LocalWorkspace)\n372:             )\n373:             if use_child:\n374:                 result = self._exec_subprocess(workspace, config, name, args, cancel)\n375:             elif self._cancelable.get(name):\n376:                 result = tool.func(workspace, config, cancel=cancel, **args)\n377:             else:\n378:                 result = tool.func(workspace, config, **args)\n379:         except TypeError as e:\n380:             result = {\"content\": render(\"errors/invalid_arguments.md\", error=e), \"error\": True}\n381:         except Exception as e:  # noqa: BLE001 -- tool boundary: report to model\n382:             result = {\"content\": render(\"errors/tool_exception.md\", error=e), \"error\": True}\n383:         # normalize: every tool result carries error/diff so callers can index them\n384:         result.setdefault(\"error\", False)\n385:         result.setdefault(\"diff\", \"\")\n386:         return result\n387: \n388:     def _exec_subprocess(\n389:         self,\n390:         workspace: Workspace,\n391:         config: Config,\n392:         name: str,\n... (showing lines 349-392 of 483; use offset=393 to continue)", "is_error": false, "diff": ""}
