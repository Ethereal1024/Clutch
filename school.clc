{"type": "tool_result", "timestamp": 1789878564.160649, "id": "7b83d32b5aa7", "tool_call_id": "call_ed1377b51a374be49927a521", "content": "105: \n106: class LocalTransport(Transport):\n107:     \"\"\"Run commands via subprocess in a fixed cwd (the workspace root).\n108: \n109:     The shell comes from local_shell(): a POSIX host's /bin/sh via shell=True;\n110:     on Windows a detected Git Bash via `bash -c <cmd>` (the agent speaks POSIX)\n111:     or, absent any bash, cmd.exe via shell=True — see localshell's module\n112:     docstring. Text mode is pinned to utf-8/replace: a Chinese Windows box\n113:     would otherwise decode command output as GBK and hand the model mojibake.\n114:     \"\"\"\n115: \n116:     def __init__(self, cwd: str) -> None:\n117:         self.cwd = cwd\n118: \n119:     def run(\n120:         self, command: str, timeout: float, *, binary: bool = False, cancel: threading.Event | None = None\n121:     ) -> CommandResult:\n122:         shell = local_shell()\n123:         try:\n124:             proc = subprocess.Popen(\n125:                 [*shell.argv, command] if shell.argv else command,\n126:                 shell=shell.argv is None,\n127:                 cwd=self.cwd,\n128:                 stdout=subprocess.PIPE,\n129:                 stderr=subprocess.PIPE,\n130:                 # own session/process group on POSIX: the tree kill below then\n131:                 # cannot take the session server (a group mate) down with it\n132:                 start_new_session=os.name == \"posix\",\n133:             )\n134:         except OSError as e:\n135:             raise TransportError(f\"command could not start: {e}\") from e\n136: \n137:         # reader threads (not communicate()): the poll loop below must be free\n138:         # to wait in small slices, and the pipes must never back up a blocked\n139:         # child while we wait\n140:         out: list[bytes] = []\n141:         err: list[bytes] = []\n142:         readers = [\n143:             threading.Thread(target=_drain, args=(proc.stdout, out), daemon=True),\n144:             threading.Thread(target=_drain, args=(proc.stderr, err), daemon=True),\n145:         ]\n146:         for t in readers:\n147:             t.start()\n148: \n149:         deadline = time.monotonic() + timeout\n150:         while True:\n151:             try:\n152:                 code = proc.wait(timeout=_CANCEL_POLL)\n153:                 break\n154:             except subprocess.TimeoutExpired:\n155:                 if cancel is not None and cancel.is_set():\n156:                     _kill_tree(proc)\n157:                     proc.wait(timeout=10)\n158:                     raise TransportError(\"command aborted by Stop\", aborted=True) from None\n159:                 if time.monotonic() >= deadline:\n160:                     _kill_tree(proc)\n161:                     proc.wait(timeout=10)\n162:                     raise TransportError(f\"command timed out ({timeout:.0f}s)\", timeout=True) from None\n163:         for t in readers:\n164:             t.join(timeout=10)\n165:         if binary:\n166:             # raw bytes round-tripped through latin-1 (lossless byte <-> str)\n167:             return CommandResult(\n168:                 code,\n169:                 b\"\".join(out).decode(\"latin-1\"),\n170:                 b\"\".join(err).decode(\"latin-1\"),\n171:             )\n172:         return CommandResult(\n173:             code,\n174:             b\"\".join(out).decode(\"utf-8\", errors=\"replace\"),\n175:             b\"\".join(err).decode(\"utf-8\", errors=\"replace\"),\n176:         )\n177: \n178: \n179: class SshTransport(Transport):\n... (showing lines 105-179 of 242; use offset=180 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789878564.1676588, "id": "f7a727f33d49", "tool_call_id": "call_b48311f06f87446ab3b5a442", "content": "255:         relative to — the workspace root by default, or the ``cd``'d dir for a\n256:         run_command (``cd sub && ../x`` is judged from sub, not the root).\n257:         This is the single source of truth behind the permission gate's escape\n258:         list AND the shell guard's token rejection.\"\"\"\n259:         if not token:\n260:             return None\n261:         if token.startswith(\"~\"):\n262:             # workspace.home(), not expanduser: in ssh mode `~` is the REMOTE\n263:             # user's home, never the app host's\n264:             token = str(self.home()) + token[1:]\n265:         base = anchor if anchor is not None else self.root\n266:         root = self.realpath(self.root)\n267:         p = self.norm_join(str(base), token)\n268:         if _inside_or_scratch(p, root, self._scratch_dirs()):\n269:             return None\n270:         return p\n271: \n272:     def run(self, command: str, timeout: float, cancel: threading.Event | None = None) -> CommandResult:\n273:         \"\"\"Run a shell command in the workspace; transport-specific cwd handling.\n274:         ``cancel`` is Stop: the transport kills the command tree promptly.\"\"\"\n275:         return self._transport.run(command, timeout, cancel=cancel)\n276: \n277:     @abstractmethod\n278:     def read(self, path: str) -> str:\n279:         \"\"\"Return file contents; raise FileNotFoundError if missing.\"\"\"\n280: \n281:     @abstractmethod\n282:     def read_range(self, path: str, lo: int, hi: int) -> bytes:\n283:         \"\"\"Return the file's byte range [lo, hi) as RAW BYTES (the lazy log's\n284:         indexed reads: exact byte offsets, so materialization matches the file).\n285:         The range may cut mid-multibyte-character — implementations must round\n286:         the bytes through losslessly (remote: the transport's binary mode base64-encodes\n287:         client-side, so the remote needs no base64).\"\"\"\n288: \n289:     @abstractmethod\n290:     def size(self, path: str) -> int:\n291:         \"\"\"Total file size in bytes (O(1) metadata, no content transfer).\"\"\"\n292: \n293:     @abstractmethod\n294:     def write(self, path: str, content: str) -> None:\n295:         \"\"\"Create or overwrite a file (parents created as needed).\"\"\"\n296: \n297:     @abstractmethod\n298:     def list(self, path: str) -> list[str]:\n299:         \"\"\"Directory entries (dirs end with '/'), protected files excluded; raise NotADirectoryError.\"\"\"\n... (showing lines 255-299 of 715; use offset=300 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789878564.1716547, "id": "1b86eba68af4", "tool_call_id": "call_c27d061213254b5d9c9a09bc", "content": "30: \n31: import os\n32: import shlex\n33: import shutil\n34: import subprocess\n35: from dataclasses import dataclass\n36: \n37: \n38: @dataclass(frozen=True)\n39: class LocalShell:\n40:     \"\"\"The shell local commands will run under. ``argv`` is the spawn prefix\n41:     (None => subprocess shell=True); ``posix`` says the command text is POSIX\n42:     sh and must be tokenized as such.\"\"\"\n43: \n44:     argv: tuple[str, ...] | None\n45:     posix: bool\n46:     name: str  # \"posix-sh\" | \"bash\" | \"cmd\"\n47: \n48: \n49: # Standard Git-for-Windows bash locations, most common first. WSL's\n50: # System32\\bash.exe is deliberately NOT here (see module docstring).\n51: _BASH_CANDIDATES = (\n52:     r\"C:\\Program Files\\Git\\bin\\bash.exe\",\n53:     r\"C:\\Program Files\\Git\\usr\\bin\\bash.exe\",\n54:     r\"C:\\Program Files (x86)\\Git\\bin\\bash.exe\",\n55:     os.path.expandvars(r\"%LOCALAPPDATA%\\Programs\\Git\\bin\\bash.exe\"),\n56:     os.path.expandvars(r\"%USERPROFILE%\\scoop\\apps\\git\\current\\bin\\bash.exe\"),\n57: )\n58: \n59: _cache: LocalShell | None = None\n60: \n61: \n62: def local_shell() -> LocalShell:\n63:     \"\"\"The (cached) shell decision for this host. Tests: reset_cache.\"\"\"\n64:     global _cache\n65:     if _cache is None:\n66:         _cache = _detect()\n67:     return _cache\n68: \n69: \n70: def reset_cache(shell: LocalShell | None = None) -> None:\n71:     \"\"\"Tests only: pin a shell choice (None re-enables detection).\"\"\"\n72:     global _cache\n73:     _cache = shell\n74: \n75: \n76: def _detect() -> LocalShell:\n77:     if os.name != \"nt\":\n78:         return LocalShell(argv=None, posix=True, name=\"posix-sh\")\n79:     path_bash = shutil.which(\"bash\")\n80:     for cand in (os.environ.get(\"CLUTCH_BASH\"), *_BASH_CANDIDATES, path_bash):\n81:         if not cand or not os.path.isfile(cand) or _is_wsl_launcher(cand):\n82:             continue\n83:         if _probe_bash(cand):\n84:             return LocalShell(argv=(cand, \"-c\"), posix=True, name=\"bash\")\n85:     return LocalShell(argv=None, posix=False, name=\"cmd\")\n86: \n87: \n88: def _is_wsl_launcher(path: str) -> bool:\n89:     \"\"\"True for a bash.exe inside the Windows system dir: the WSL launcher,\n90:     whose filesystem is the Linux subsystem, not the workspace's drive.\"\"\"\n91:     sysdir = os.path.join(os.environ.get(\"SystemRoot\", r\"C:\\Windows\"), \"System32\")\n92:     try:\n93:         norm = os.path.normcase(os.path.abspath(path))\n94:         return norm.startswith(os.path.normcase(sysdir) + os.sep)\n95:     except OSError:  # pragma: no cover - unresolvable path: judge it by probe\n96:         return False\n97: \n98: \n99: def _probe_bash(path: str) -> bool:\n100:     \"\"\"A bash that cannot run a trivial -c command is not a shell we can use\n101:     (broken MSYS install, WSL distro without a default distro, ...).\"\"\"\n102:     try:\n103:         r = subprocess.run(\n104:             [path, \"-c\", \"echo clutch-bash-ok\"],\n105:             capture_output=True,\n106:             text=True,\n107:             timeout=10,\n108:         )\n109:     except (OSError, subprocess.TimeoutExpired):\n... (showing lines 30-109 of 182; use offset=110 to continue)", "is_error": false, "diff": ""}
