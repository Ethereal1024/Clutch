{"type": "tool_result", "timestamp": 1789815411.0794969, "id": "e8282ca1101c", "tool_call_id": "call_4c05c348bffa4156881f7224", "content": "40:     FinalEvent,\n41:     PermissionRequestEvent,\n42:     StateUpdateEvent,\n43:     event_to_json,\n44: )\n45: from .project import Project, create_project, open_project_lazy\n46: from .tools.mcpprovider import MCP_PROVIDERS as _MCP_PROVIDER_REGISTRY\n47: from .tools.websearch import mcp_status as _mcp_status_probe\n48: from .tools.workspace import Workspace\n49: \n50: # a client hanging up mid-SSE surfaces as one of these on the socket write;\n51: # end cleanly, never let socketserver print a traceback. The class is host\n52: # dependent: POSIX gives BrokenPipeError (EPIPE) or ConnectionResetError\n53: # (ECONNRESET) when the peer is gone, Windows gives ConnectionAbortedError\n54: # (WSAECONNABORTED/WSAECONNRESET), so leaving it out spams one traceback per\n55: # closed window on Windows. ValueError covers a write on an already-closed\n56: # stream.\n57: _SSE_ERR = (BrokenPipeError, ConnectionResetError, ConnectionAbortedError, ValueError)\n58: \n59: \n60: def _settings_path() -> Path:\n61:     return Path.home() / \".clutch\" / \"settings.json\"\n62: \n63: \n64: def load_settings() -> dict:\n65:     \"\"\"Read persisted settings (api_key). The file lives outside the repo on purpose.\"\"\"\n66:     p = _settings_path()\n67:     try:\n68:         return json.loads(p.read_text(encoding=\"utf-8\"))\n69:     except (OSError, json.JSONDecodeError):\n70:         return {}\n71: \n72: \n73: def save_settings(data: dict) -> None:\n74:     p = _settings_path()\n75:     try:\n76:         p.parent.mkdir(parents=True, exist_ok=True)\n77:         p.write_text(json.dumps(data, ensure_ascii=False), encoding=\"utf-8\")\n78:         p.chmod(0o600)  # owner-only, the file holds a credential\n79:     except OSError as e:\n80:         print(f\"[clutch-server] cannot persist settings: {e}\", file=sys.stderr)\n81: \n82: \n83: def mcp_providers() -> list:\n84:     \"\"\"Registered MCP web-search providers (stable order for the UI).\"\"\"\n85:     return list(_MCP_PROVIDER_REGISTRY.values())\n86: \n87: \n88: def _split_mcp_fields(body: dict) -> dict[str, str]:\n89:     \"\"\"Pull mcp_<provider> URL fields out of a settings POST body.\n90: \n91:     Values must be http(s) URLs, or '' to clear the entry; names are free-form\n92:     so a newer UI can configure providers this build does not know.\n93:     \"\"\"\n94:     out: dict[str, str] = {}\n95:     for key, value in body.items():\n96:         if not key.startswith(\"mcp_\") or not isinstance(value, str):\n97:             continue\n98:         value = value.strip().rstrip(\"/\")\n99:         if value and not value.startswith((\"http://\", \"https://\")):\n100:             raise ValueError(f\"{key} must be an http(s) URL\")\n101:         out[key] = value\n102:     return out\n103: \n104: \n105: def _mcp_keys_from(raw: dict) -> dict[str, str]:\n106:     \"\"\"mcp_<provider> entries persisted in the settings file (flatten drops them).\"\"\"\n107:     return {k: v for k, v in raw.items() if k.startswith(\"mcp_\") and isinstance(v, str) and v}\n108: \n109: \n110: def _login_state(state: Any) -> bool | None:\n111:     \"\"\"Best-effort normalization of a provider's login-status payload.\"\"\"\n112:     truthy = (\"logged_in\", \"logged in\", \"true\", \"yes\", \"ok\", \"success\")\n113:     if isinstance(state, bool):\n114:         return state\n115:     if isinstance(state, str):\n116:         return state.strip().lower() in truthy\n117:     if isinstance(state, dict):\n118:         for key in (\"login\", \"logged_in\", \"is_logged_in\", \"logged_in_status\", \"status\"):\n119:             v = state.get(key)\n... (showing lines 40-119 of 884; use offset=120 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789815411.0830908, "id": "fa66470afc5e", "tool_call_id": "call_921daf33fd1848e49fddb33a", "content": "360:             return self._json(\n361:                 {\"error\": f\"reasoning_effort must be one of {', '.join(REASONING_EFFORT_LEVELS)}\"},\n362:                 status=400,\n363:             )\n364:         base_url = (body.get(\"base_url\") or \"\").strip()\n365:         model = (body.get(\"model\") or \"\").strip()\n366:         api_key = (body.get(\"api_key\") or \"\").strip()\n367:         try:\n368:             mcp_updates = _split_mcp_fields(body)\n369:         except ValueError as e:\n370:             return self._json({\"error\": str(e)}, status=400)\n371:         if (\n372:             not any((base_url, model, api_key))\n373:             and \"reasoning_effort\" not in body\n374:             and not mcp_updates\n375:         ):\n376:             return self._json({\"error\": \"nothing to save\"}, status=400)\n377: \n378:         with self._state.lock:\n379:             if api_key:\n380:                 self._state.api_key = api_key\n381:             if base_url:\n382:                 self._cfg.base_url = base_url\n383:             if model:\n384:                 self._cfg.model = model\n385:             # empty value clears the knob (provider default); None = unset\n386:             if \"reasoning_effort\" in body:\n387:                 self._cfg.llm_reasoning_effort = reasoning_effort or None\n388:             for key, value in mcp_updates.items():\n389:                 if value:\n390:                     self._cfg.mcp_urls[key[4:]] = value\n391:                 else:\n392:                     self._cfg.mcp_urls.pop(key[4:], None)\n393:         # flatten migrates legacy profile maps but only knows the LLM fields;\n394:         # carry the mcp_<provider> keys across so a settings save never wipes\n395:         # configured web services\n396:         saved = {**_mcp_keys_from(load_settings()), **flatten_settings(load_settings())}\n397:         if base_url:\n398:             saved[\"base_url\"] = base_url\n399:         if model:\n400:             saved[\"model\"] = model\n401:         if api_key:\n402:             saved[\"api_key\"] = api_key\n403:         if \"reasoning_effort\" in body:\n404:             if reasoning_effort:\n405:                 saved[\"reasoning_effort\"] = reasoning_effort\n406:             else:\n407:                 saved.pop(\"reasoning_effort\", None)  # empty = clear the knob\n408:         for key, value in mcp_updates.items():\n409:             if value:\n410:                 saved[key] = value\n411:             else:\n412:                 saved.pop(key, None)  # empty = clear the service\n413:         save_settings(saved)\n414:         self._json({\"status\": \"ok\"})\n415: \n416:     def _settings_get(self) -> None:\n417:         \"\"\"Current LLM endpoint config for the settings modal (no credentials).\"\"\"\n418:         saved = flatten_settings(load_settings())\n419:         raw = load_settings()\n420:         self._json(\n421:             {\n422:                 \"base_url\": self._cfg.base_url or saved.get(\"base_url\", \"\"),\n423:                 \"model\": self._cfg.model or saved.get(\"model\", \"\"),\n424:                 \"reasoning_effort\": self._cfg.llm_reasoning_effort or saved.get(\"reasoning_effort\", \"\"),\n425:                 \"has_api_key\": bool(self._state.api_key or self._cfg.api_key or saved.get(\"api_key\")),\n426:                 # MCP web-search services: rendered dynamically by the UI; a\n427:                 # host without a service configured just gets an empty value\n428:                 \"mcp_providers\": [\n429:                     {\n430:                         \"key\": f\"mcp_{p.name}\",\n431:                         \"label\": p.label,\n432:                         \"placeholder\": p.placeholder,\n433:                         \"value\": self._cfg.mcp_urls.get(p.name) or raw.get(f\"mcp_{p.name}\", \"\"),\n434:                     }\n435:                     for p in mcp_providers()\n436:                 ],\n437:             }\n438:         )\n439: \n440:     def _mcp_status(self) -> None:\n441:         \"\"\"Per-provider MCP reachability + login state, for the settings modal.\n442: \n443:         Purely informational and only about services this machine's user chose\n444:         to configure: unconfigured providers report configured=False and the UI\n445:         leaves the row blank — nothing here suggests installing anything.\n446:         \"\"\"\n447:         out = []\n448:         for p in mcp_providers():\n449:             url = p.url_for(self._cfg)\n450:             row: dict[str, Any] = {\n451:                 \"name\": p.name,\n452:                 \"configured\": bool(url),\n453:                 \"reachable\": None,\n454:                 \"login\": None,\n455:             }\n456:             if url:\n457:                 try:\n458:                     state = _mcp_status_probe(url, p) if p.status_tool else None\n459:                     row[\"reachable\"] = True\n460:                     row[\"login\"] = _login_state(state)\n461:                 except Exception as e:  # noqa: BLE001 — any failure is a status, not a crash\n462:                     row[\"reachable\"] = False\n463:                     row[\"detail\"] = str(e)[:160]\n464:             out.append(row)\n465:         self._json({\"providers\": out})\n466: \n467:     def _permission_respond(self) -> None:\n468:         body = self._read_body()\n469:         if body is None:\n... (showing lines 360-469 of 884; use offset=470 to continue)", "is_error": false, "diff": ""}
