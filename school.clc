{"type": "tool_result", "timestamp": 1789616608.03759, "id": "03313190a5d6", "tool_call_id": "call_5c28c13db0ff4ee7b3523f1f", "content": "1: \"\"\"Shared helpers for the standalone test runners.\n2: \n3: Every runner (selfcheck / loop_test / server_test / supervisor_test / transport_test /\n4: lazy_check / ui_fonts_check) is a plain `python -m tests.X` module with no test\n5: framework. Two assertion styles live here:\n6: \n7: - check()            fails fast: prints and exits non-zero on the first broken\n8:                      assertion (the default for the runners above)\n9: - collecting_check() returns (check, failures) for runners that report every\n10:                      broken assertion at the end (lazy_check, ui_fonts_check)\n11: \n12: http_get() / http_post() drive the local HTTP API; both styles need them.\n13: \"\"\"\n14: \n15: from __future__ import annotations\n16: \n17: import json\n18: import os\n19: import sys\n20: import urllib.error\n21: import urllib.request\n22: from collections.abc import Callable\n23: \n24: from agent.tools.localshell import local_shell\n25: \n26: \n27: def posix_shell_argv() -> list[str] | None:\n28:     \"\"\"How to run POSIX sh command text on THIS host, or None when the host has\n29:     no POSIX shell at all.\n30: \n31:     The mock \"remote\" side of the transport tests speaks POSIX sh — the real\n32:     remote always does (exec-bridge.js runs `sh -c` there). On a POSIX app host\n33:     that is /bin/sh; on Windows it has to be a real bash (Git for Windows /\n34:     MSYS2), because subprocess(shell=True)/child_process.exec there is cmd.exe,\n35:     which cannot run heredocs, `printf` or `base64` and would fail the mock for\n36:     an environment reason rather than a product one.\n37:     \"\"\"\n38:     if os.name != \"nt\":\n39:         return [\"/bin/sh\", \"-c\"]\n40:     shell = local_shell()  # the app's own detection (CLUTCH_BASH, Git dirs, PATH)\n41:     return list(shell.argv) if shell.posix and shell.argv else None\n42: \n43: \n44: def check(cond: bool, name: str) -> None:\n45:     if not cond:\n46:         print(f\"FAIL: {name}\")\n47:         sys.exit(1)\n48:     print(f\"ok:   {name}\")\n49: \n50: \n51: def collecting_check(indent: str = \"\") -> tuple[Callable[[bool, str], None], list[str]]:\n52:     \"\"\"Counterpart of check() for runners that summarize at the end: the returned\n53:     check() prints and records instead of exiting, so the runner can report every\n54:     failure (the banner wording differs per runner, hence it stays there).\"\"\"\n55:     failures: list[str] = []\n56: \n57:     def check(cond: bool, label: str) -> None:\n58:         print(f\"{indent}{'ok:  ' if cond else 'FAIL: '}{label}\")\n59:         if not cond:\n60:             failures.append(label)\n... (showing lines 1-60 of 85; use offset=61 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789616608.043518, "id": "ac208265a684", "tool_call_id": "call_7229eef4a7fe46a6b53368d0", "content": "26:         self.max_retries = max_retries\n27:         self.retryable_status = retryable_status\n28:         self.reasoning_effort = reasoning_effort\n29: \n30:         proxy = get_proxy_for_url(base_url)\n31:         http_client = httpx2.Client(proxy=proxy, trust_env=False, timeout=self.request_timeout)\n32:         self.client = OpenAI(api_key=self.api_key, base_url=base_url, http_client=http_client)\n33:         self.model = model\n34: \n35:     def stream(\n36:         self,\n37:         messages: list[dict[str, Any]],\n38:         tools: list[dict[str, Any]] | None = None,\n39:     ) -> Iterator[dict[str, Any]]:\n40:         # Streamed chat completion.\n41:         #\n42:         # Transport failures raised while the SSE body is being consumed (read\n43:         # timeout / reset / truncated response) escape the openai SDK unwrapped\n44:         # as raw httpx2 exceptions (see LlmError.classify); this loop turns them\n45:         # into a retry. A retry restarts the request from scratch, so it is only\n46:         # safe when NOTHING of this attempt has reached the caller yet — retrying\n47:         # after a partial stream would re-emit already-delivered text and\n48:         # duplicate it in the transcript. A failure after the first token is\n49:         # therefore raised immediately (clear error instead of a silent stall);\n50:         # a failure before it retries with backoff, yielding a\n51:         # {\"type\": \"retry\", ...} notice first so the caller/UI can show\n52:         # \"reconnecting…\" instead of looking frozen until the next attempt dies.\n53:         attempts = max(1, int(self.max_retries))\n54:         for attempt in range(attempts):\n55:             delivered = False\n56:             try:\n57:                 kwargs: dict[str, Any] = {\n58:                     \"model\": self.model,\n59:                     \"messages\": messages,\n60:                 }\n61:                 if tools:\n62:                     kwargs[\"tools\"] = tools\n63:                 # reasoning_effort: only set when configured (provider default otherwise)\n64:                 if self.reasoning_effort:\n65:                     kwargs[\"extra_body\"] = {\n66:                         \"thinking\": {\n67:                             \"type\": \"enabled\",\n68:                             \"reasoning_effort\": self.reasoning_effort,\n69:                         }\n70:                     }\n71:                 resp = self.client.chat.completions.create(**kwargs, stream=True)\n72:                 state = StreamState()\n73:                 pending_finish: dict[str, Any] | None = None\n74: \n75:                 for chunk in resp:\n76:                     if state.finished:\n77:                         break  # finish chunk received; nothing left to drain\n78:                     if not getattr(chunk, \"choices\", None):\n79:                         continue\n80:                     for handler in self.handlers:\n... (showing lines 26-80 of 118; use offset=81 to continue)", "is_error": false, "diff": ""}
