d by a non-supervisor server ` +\n  Line 76:         \"(an old shared agent-server?) — close it; the app only runs through the supervisor\"\n  Line 82:   console.log(`[server-bootstrap] spawning supervisor: ${spec.cmd} ${spec.args.join(\" \")}`);\n  Line 83:   supervisorChild = spawn(spec.cmd, spec.args, {\n  Line 89:   supervisorChild.stdout.on(\"data\", (d) => process.stdout.write(d));\n  Line 90:   supervisorChild.stderr.on(\"data\", (d) => process.stderr.write(d));\n  Line 91:   supervisorChild.on(\"error\", (e) => console.error(\"[server-bootstrap] supervisor spawn error:\", e.message));\n  Line 92:   supervisorChild.on(\"exit\", (code, sig) => {\n  Line 93:     console.log(`[server-bootstrap] supervisor exited (code=${code} signal=${sig})`);\n  Line 94:     supervisorChild = null;\n  Line 98:     if ((await supervisorProbe()) === \"up\") return true;\n  Line 104: // ---- shared supervisor session HTTP (identical local and behind the tunnel) ----\n  Line 105: async function supervisorSessionStart(base, baseUrl) {\n  Line 106:   // POST {base}/api/session/start {base_url} -> {session_id, port}\n  Line 110:     const r = await fetch(`${base}/api/session/start`, {\n  Line 117:       return { error: `${base} is not a Clutch supervisor (old shared server?)` };\n  Line 129: function supervisorSessionStop(base, sid) {\n  Line 132:     fetch(`${base}/api/session/stop`, {\n  Line 137:   } catch { /* supervisor already gone: nothing to tell */ }\n  Line 140: // Keep a session alive; onFail fires when the supervisor stops answering\n  Line 148:         const r = await fetch(`${base}/api/session/heartbeat`, {\n  Line 166: // ---- local session: this window's session child from the LOCAL supervisor ----\n  Line 167: // onFail fires when the supervisor stops answering (idle-exit or crash)\n  Line 170:     return { mode: \"failed\", reason: \"could not start the machine supervisor\" };\n  Line 172:   const res = await supervisorSessionStart(`http://127.0.0.1:${SUPERVISOR_PORT}`);\n  Line 174:   const hb = startSupervisorHeartbeat(`http://127.0.0.1:${SUPERVISOR_PORT}`, res.sessionId, onFail);\n  Line 182:       supervisorSessionStop(`http://127.0.0.1:${SUPERVISOR_PORT}`, res.sessionId);\n  Line 183:       // we don't own the supervisor's lifetime: it self-exits at zero sessions\n  Line 189:   SUPERVISOR_PORT,\n  Line 191:   supervisorSessionStart,\n  Line 192:   supervisorSessionStop,\n\nui\\server-bundle.js:\n  Line 66:   for (const root of [\"agent\", \"scripts/server_entry.py\", \"scripts/supervisor_entry.py\", \"scripts/build-server-bundle.sh\"]) {\n  Line 77:     fs.existsSync(path.join(dist, \"agent-server\")) && fs.existsSync(path.join(dist, \"agent-supervisor\"));\n  Line 103:   let server, supervisor;\n  Line 106:     supervisor = path.join(process.resourcesPath, \"agent-supervisor\");\n  Line 107:     if (!fs.existsSync(server) || !fs.existsSync(supervisor)) {\n  Line 113:     supervisor = path.join(REPO, \"dist\", \"agent-supervisor\");\n  Line 115:   const version = fileHash(server) + fileHash(supervisor);\n  Line 118:   const supOut = path.join(CACHE, `agent-supervisor-${tag}-${version}`);\n  Line 122:     fs.copyFileSync(supervisor, supOut);\n  Line 130:   return { server: out, supervisor: supOut, version };\n\nui\\ssh-tunnel.js:\n  Line 2: // process: local forward to the remote supervisor API + reverse forward to the\n  Line 102:     const body = await httpGetBody(base + \"/api/health\", 3000);\n  Line 274:   'echo \"__ART__\"; (test -x \"$HOME/.clutch-server/agent-server\" -a -x \"$HOME/.clutch-server/agent-supervisor\" && echo bundle || true); (test -x \"$HOME/.clutch-server/venv/bin/python\" && echo pip || true); (test -d \"$HOME/.clutch-server/site-packages\" && echo pylibs || true)',\n  Line 301:   // remote supervisor runs on 8890 like local; session children get --base-url later\n  Line 306:     return `${nohup}${home}/.clutch-server/agent-supervisor ${args} --agent-cmd ${home}/.clutch-server/agent-server >/tmp/clu