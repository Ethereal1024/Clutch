{"type": "tool_result", "timestamp": 1789898111.3819578, "id": "088b4cbf76a9", "tool_call_id": "call_e2df1cf917b9401687ebe48b", "content": "1: \"\"\"Supervisor end-to-end check: spawns real agent.server session children and\n2: exercises lifecycle + the cross-process lock semantics the architecture relies on.\n3: \n4: Run: uv run python -m tests.supervisor_test\n5: \n6: The lock test is the important one: two SESSION CHILDREN (separate processes,\n7: each with its own _held cache) take the same .clc's kernel lock on this\n8: machine's tmp dir —\n9: the second open must get 409 via the kernel, exactly like the remote-supervisor\n10: case. This is what the shared-process architecture could never provide.\n11: \"\"\"\n12: \n13: from __future__ import annotations\n14: \n15: import json\n16: import os\n17: import sys\n18: import tempfile\n19: import threading\n20: import time\n21: from pathlib import Path\n22: \n23: from agent.supervisor import Supervisor, _SafeStdStream, build_server\n24: from tests.testsupport import check, http_get, http_post\n25: \n26: ROOT = Path(__file__).resolve().parents[1]\n27: \n28: \n29: def wait_until(pred, timeout_s: float = 10.0, what: str = \"condition\") -> bool:\n30:     deadline = time.time() + timeout_s\n31:     while time.time() < deadline:\n32:         if pred():\n33:             return True\n34:         time.sleep(0.05)\n35:     check(False, f\"timed out waiting for {what}\")\n36:     return False\n37: \n38: \n39: def shutdown_post(base: str) -> tuple[int, str]:\n40:     \"\"\"POST /api/shutdown, tolerating a reply torn by self-teardown.\n41: \n42:     Arming the exit flag can beat the HTTP response on the wire: the\n43:     supervisor may already be gone when the answer would arrive, so the\n44:     reply is best-effort — the exit event is the real verdict.\n45:     \"\"\"\n46:     try:\n47:         return http_post(f\"{base}/api/shutdown\")\n48:     except OSError:\n49:         return 0, \"\"\n50: \n51: \n52: def start_supervisor(**kwargs) -> tuple[Supervisor, int, threading.Thread]:\n53:     sup = Supervisor(\n54:         agent_cmd=[sys.executable, \"-m\", \"agent.server\"],\n55:         cwd=str(ROOT),\n56:         reap_interval_s=0.2,\n57:         **kwargs,\n58:     )\n59:     srv = build_server(0, sup)\n60:     t = threading.Thread(target=srv.serve_forever, daemon=True)\n61:     t.start()\n62:     threading.Thread(target=sup.reap_loop, daemon=True).start()\n63:     return sup, srv.server_address[1], t\n64: \n65: \n66: def main() -> int:\n67:     # ---- 1. lifecycle ----\n68:     sup, port, _ = start_supervisor(stale_s=60, idle_timeout_s=60)\n69:     base = f\"http://127.0.0.1:{port}\"\n70: \n71:     st, body = http_get(f\"{base}/api/health\")\n72:     check(st == 200 and '\"ok\"' in body, \"supervisor health ok\")\n73: \n74:     st, body = http_post(f\"{base}/api/session/start\")\n75:     check(st == 200, \"session start accepted\")\n76:     d1 = json.loads(body)\n77:     sid1, port1 = d1[\"session_id\"], d1[\"port\"]\n78:     check(len(sid1) > 0 and isinstance(port1, int), \"session returns id + port\")\n79: \n80:     # the session child is a full agent server\n81:     st, _ = http_get(f\"http://127.0.0.1:{port1}/api/health\")\n82:     check(st == 200, \"session child is healthy\")\n83: \n84:     st, body = http_post(f\"{base}/api/session/start\")\n85:     d2 = json.loads(body)\n86:     sid2, port2 = d2[\"session_id\"], d2[\"port\"]\n87:     check(sid1 != sid2 and port1 != port2, \"two sessions get distinct ports\")\n88: \n89:     # ---- 2. REAL cross-process lock: two session children, same .clc ----\n90:     with tempfile.TemporaryDirectory() as sdir:\n91:         proj_dir = Path(sdir) / \"work\"\n92:         proj_dir.mkdir()\n93:         s1 = f\"http://127.0.0.1:{port1}\"\n94:         s2 = f\"http://127.0.0.1:{port2}\"\n95: \n96:         st, body = http_post(f\"{s1}/api/project/new\", {\"dir\": str(proj_dir), \"name\": \"demo\"})\n97:         check(st == 200, \"child 1 creates project\")\n98:         clc = Path(json.loads(body)[\"project\"])\n99:         check(clc.exists(), \".clc file exists\")\n100: \n101:         st, _ = http_post(f\"{s1}/api/project/open\", {\"path\": str(clc)})\n102:         check(st == 200, \"child 1 opens project (holds flock)\")\n103: \n104:         st, body = http_post(f\"{s2}/api/project/open\", {\"path\": str(clc)})\n105:         check(st == 409, \"child 2 gets 409 on same project (kernel lock)\")\n106:         check(\"project_open_conflict\" in body, \"409 carries conflict code\")\n107: \n108:         # different projects never conflict\n109:         st, body = http_post(f\"{s2}/api/project/new\", {\"dir\": str(proj_dir), \"name\": \"other\"})\n110:         clc2 = Path(json.loads(body)[\"project\"])\n111:         st, _ = http_post(f\"{s2}/api/project/open\", {\"path\": str(clc2)})\n112:         check(st == 200, \"child 2 opens a different project freely\")\n113: \n114:         # child 1 exit releases the lock via the kernel -> child 2 can reopen\n115:         st, _ = http_post(f\"{base}/api/session/stop\", {\"session_id\": sid1})\n116:         check(st == 200, \"session 1 stopped\")\n117:         st, _ = http_post(f\"{s2}/api/project/open\", {\"path\": str(clc)})\n118:         check(st == 200, \"lock freed on process exit (no TTL needed)\")\n119: \n120:         # heartbeat unknown session -> 404\n121:         st, _ = http_post(f\"{base}/api/session/heartbeat\", {\"session_id\": \"nope\"})\n122:         check(st == 404, \"heartbeat for unknown session rejected\")\n123: \n124:         st, _ = http_post(f\"{base}/api/session/stop\", {\"session_id\": sid2})\n125:         check(st == 200, \"session 2 stopped\")\n126: \n127:     sup.shutdown_all()\n128: \n129:     # ---- 3. stale-session reaping (crashed window: heartbeat stops) ----\n130:     sup2, port2b, _ = start_supervisor(stale_s=0.6, idle_timeout_s=60)\n131:     base2 = f\"http://127.0.0.1:{port2b}\"\n132:     st, body = http_post(f\"{base2}/api/session/start\")\n133:     sid3 = json.loads(body)[\"session_id\"]\n134:     check(sid3 in sup2.sessions, \"session registered\")\n135:     # no heartbeats: the reaper must kill it\n136:     ok = wait_until(lambda: sid3 not in sup2.sessions, 10.0, \"stale session reaped\")\n137:     check(ok, \"stale session reaped without heartbeat\")\n138:     sup2.shutdown_all()\n139: \n140:     # ---- 4. heartbeat keeps a session alive ----\n141:     sup3, port3, _ = start_supervisor(stale_s=0.6, idle_timeout_s=60)\n142:     base3 = f\"http://127.0.0.1:{port3}\"\n143:     st, body = http_post(f\"{base3}/api/session/start\")\n144:     sid4 = json.loads(body)[\"session_id\"]\n145:     for _ in range(8):\n146:         st, _ = http_post(f\"{base3}/api/session/heartbeat\", {\"session_id\": sid4})\n147:         check(st == 200, \"heartbeat accepted\")\n148:         time.sleep(0.25)\n149:     check(sid4 in sup3.sessions, \"heartbeated session survives past stale window\")\n150:     sup3.shutdown_all()\n151: \n152:     # ---- 5. idle self-exit (last window closed) ----\n153:     sup4, port4, _ = start_supervisor(stale_s=60, idle_timeout_s=0.8)\n154:     base4 = f\"http://127.0.0.1:{port4}\"\n155:     st, body = http_post(f\"{base4}/api/session/start\")\n156:     sid5 = json.loads(body)[\"session_id\"]\n157:     st, _ = http_post(f\"{base4}/api/session/stop\", {\"session_id\": sid5})\n158:     ok = wait_until(lambda: sup4.exit_event.is_set(), 10.0, \"supervisor idle-exit\")\n159:     check(ok, \"supervisor self-exits after last session stops\")\n160:     sup4.shutdown_all()\n161: \n162:     # ---- 6. no parent watchdog: a session child ignores CLUTCH_SUPERVISOR_PID ----\n163:     import subprocess as _sp\n164: \n165:     wd_env = dict(os.environ)\n166:     wd_env[\"CLUTCH_SUPERVISOR_PID\"] = \"999999\"  # would have killed the old watchdog\n167:     wd = _sp.Popen(\n168:         [sys.executable, \"-m\", \"agent.server\", \"--port\", \"0\"],\n169:         cwd=str(ROOT),\n170:         env=wd_env,\n171:         stdout=_sp.DEVNULL,\n172:         stderr=_sp.DEVNULL,\n173:     )\n174:     time.sleep(7)  # the old watchdog fired at ~5s; surviving past this proves it is gone\n175:     check(wd.poll() is None, \"session child survives a bogus CLUTCH_SUPERVISOR_PID (no watchdog)\")\n176:     wd.terminate()\n177:     wd.wait(timeout=10)\n178: \n179:     # ---- 7. base_url forwarding (remote sessions point at the LLM proxy) ----\n180:     sup5, port5, _ = start_supervisor(stale_s=60, idle_timeout_s=60)\n181:     base5 = f\"http://127.0.0.1:{port5}\"\n182:     st, body = http_post(f\"{base5}/api/session/start\", {\"base_url\": \"http://127.0.0.1:8892/v1\"})\n183:     check(st == 200, \"session start with base_url accepted\")\n184:     d5 = json.loads(body)\n185:     args5 = sup5.sessions[d5[\"session_id\"]].proc.args\n186:     check(\n187:         \"--base-url\" in args5 and \"http://127.0.0.1:8892/v1\" in args5,\n188:         \"base_url forwarded to the session child (--base-url ...)\",\n189:     )\n190:     sup5.shutdown_all()\n191: \n192:     # ---- 8. agent command resolution: dev vs PyInstaller (sys.frozen) ----\n193:     import unittest.mock as _m\n194: \n195:     from agent.supervisor import _agent_cmd_default\n196: \n197:     with _m.patch.object(sys, \"frozen\", True, create=True):\n198:         cmd_frozen = _agent_cmd_default()\n199:     check(\n200:         len(cmd_frozen) == 1 and cmd_frozen[0].endswith(\"agent-server.exe\" if os.name == \"nt\" else \"agent-server\"),\n201:         \"frozen build spawns the sibling agent-server binary\",\n202:     )\n203:     with _m.patch.object(sys, \"frozen\", False, create=True):\n204:         cmd_dev = _agent_cmd_default()\n205:     check(\n206:         \"-m\" in cmd_dev and \"agent.server\" in cmd_dev,\n207:         \"dev build spawns python -m agent.server\",\n208:     )\n209: \n210:     # ---- 9. dead-parent resilience (orphaned supervisor: stdout is a dead stream) ----\n211:     # prints on the dead stream must not kill the handler / reaper\n212:     import os as _os\n213: \n214:     # a pipe whose read end is already closed: writing raises (BrokenPipeError\n215:     # on POSIX, OSError [Errno 22] on Windows). Portable where the old\n216:     # `fdopen(socket.fileno())` was not — a Windows socket handle is not a CRT\n217:     # fd, so fdopen there fails with [WinError 6] before the test even starts.\n218:     _r, _w = _os.pipe()\n219:     _os.close(_r)  # peer gone\n220:     dead_out = _os.fdopen(_w, \"w\")  # text stream over the dead pipe\n221:     _orig_out, _orig_err = sys.stdout, sys.stderr\n222:     try:\n223:         sys.stdout = _SafeStdStream(dead_out)\n224:         sys.stderr = _SafeStdStream(dead_out)\n225:         sup6, port6, _ = start_supervisor(stale_s=60, idle_timeout_s=60)\n226:         st, body = http_post(f\"http://127.0.0.1:{port6}/api/session/start\")\n227:         check(st == 200, \"session/start still responds when stdout is a dead socket\")\n228:         sid6 = json.loads(body)[\"session_id\"]\n229:         st, _ = http_post(f\"http://127.0.0.1:{port6}/api/session/stop\", {\"session_id\": sid6})\n230:         check(st == 200, \"session/stop still responds\")\n231:         sup6.shutdown_all()\n232:     finally:\n233:         sys.stdout, sys.stderr = _orig_out, _orig_err\n234:         try:\n235:             dead_out.close()  # flush may hit the dead socket\n236:         except (OSError, ValueError, TypeError):\n237:             pass\n238: \n239:     # ---- 10. /api/shutdown (normal app close: exit when empty, never in-use) ----\n240:     sup7, port7, _ = start_supervisor(stale_s=60, idle_timeout_s=30)\n241:     base7 = f\"http://127.0.0.1:{port7}\"\n242:     st, body = shutdown_post(base7)\n243:     check(st in (200, 0), \"shutdown accepted (reply may be torn by self-teardown)\")\n244:     time.sleep(2)\n245:     check(sup7.exit_event.is_set(), \"shutdown with no sessions exits promptly (no idle grace)\")\n246:     sup7.shutdown_all()\n247: \n248:     sup8, port8, _ = start_supervisor(stale_s=60, idle_timeout_s=30)\n249:     base8 = f\"http://127.0.0.1:{port8}\"\n250:     st, body = http_post(f\"{base8}/api/session/start\")\n251:     sid8 = json.loads(body)[\"session_id\"]\n252:     st, _ = http_post(f\"{base8}/api/shutdown\")\n253:     check(st == 200, \"shutdown accepted while a session is live\")\n254:     time.sleep(2)\n255:     check(not sup8.exit_event.is_set(), \"shutdown does NOT kill an in-use supervisor\")\n256:     # a shutdown POST with sessions live is IGNORED (never armed): otherwise one\n257:     # instance's exit would kill the supervisor the moment ANOTHER window's\n258:     # re-claim transiently hit n==0\n259:     st, _ = http_post(f\"{base8}/api/session/stop\", {\"session_id\": sid8})\n260:     check(st == 200, \"session stopped\")\n261:     time.sleep(3)\n262:     check(not sup8.exit_event.is_set(), \"ignored in-use shutdown leaves no sticky flag\")\n263:     # the real last-window path: shutdown POST at n==0 arms and exits promptly\n264:     st, _ = shutdown_post(base8)\n265:     check(st in (200, 0), \"shutdown accepted at n==0 (reply may be torn by self-teardown)\")\n266:     ok = wait_until(lambda: sup8.exit_event.is_set(), 6.0, \"exit after last session (shutdown flag)\")\n267:     check(ok, \"shutdown supervisor exits as soon as its sessions are gone\")\n268:     sup8.shutdown_all()\n269: \n270:     # ---- 11. stop when the graceful signal is UNDELIVERABLE (W2) ----\n... (showing lines 1-270 of 519; use offset=271 to continue)", "is_error": false, "diff": ""}
