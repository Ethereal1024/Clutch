{"type": "tool_result", "timestamp": 1789632711.9638913, "id": "31af0d7356e3", "tool_call_id": "call_1bfed08f4ced4edbae78d19a", "content": "1: \"\"\"Web access tools: web_search (multi-backend search) + web_fetch (page -> text).\n2: \n3: Built on the stdlib only (urllib + html.parser + ElementTree) — the LLM loop is\n4: hand-rolled here, and so is web access: no scraping SDK that rots when an\n5: engine tweaks its markup. Backends, tried in order, first success wins:\n6: \n7:   tavily   LLM-first search API, best quality   (CLUTCH_TAVILY_API_KEY)\n8:   searxng  self-hosted metasearch, JSON API     (CLUTCH_SEARXNG_URL)\n9:   bing     the undocumented RSS endpoint of cn.bing.com — keyless, CN-friendly\n10:   ddg      duckduckgo html endpoint — keyless\n11: \n12: Poka-yoke (make it hard for the model to misuse):\n13: - timeout: every request is bounded (Config.web_search_timeout); Stop is\n14:   honored between chunks so a hung fetch never outlives the user's patience\n15: - size cap: responses larger than max_bytes are rejected, not swallowed\n16: - private-network guard: web_fetch refuses loopback/LAN hosts (and follows\n17:   redirects only to public hosts) — a GET into the agent's own API or the\n18:   LAN stays impossible even when the model is talked into trying\n19: - error-as-data: backend failures list each reason; a truncating fetch says\n20:   how to fetch the next slice, mirroring read_file's offset hints\n21: \"\"\"\n22: \n23: from __future__ import annotations\n24: \n25: import functools\n26: import gzip\n27: import ipaddress\n28: import json\n29: import re\n30: import socket\n31: import urllib.error\n32: import urllib.parse\n33: import urllib.request\n34: import xml.etree.ElementTree as ET\n35: import zlib\n36: from dataclasses import dataclass\n37: from html import unescape\n38: from html.parser import HTMLParser\n39: from typing import Any, Callable\n40: \n41: from ..config import Config\n42: from .workspace import Workspace\n43: \n44: # browser-shaped but honest about the product; several CDNs 403 blank UAs\n45: USER_AGENT = (\n46:     \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) \"\n47:     \"Chrome/124.0 Safari/537.36 ClutchAgent/0.1\"\n48: )\n49: \n50: _MAX_BYTES = 2_000_000  # hard cap per response: pages are for reading, not hoarding\n51: \n52: \n53: class WebError(Exception):\n54:     \"\"\"A request-level failure (DNS, timeout, size cap, private host).\"\"\"\n55: \n56: \n57: class BackendError(Exception):\n58:     \"\"\"A backend responded but yielded nothing usable (blocked, layout changed).\"\"\"\n59: \n60: \n61: @dataclass\n62: class HttpResp:\n63:     url: str  # final URL after redirects\n64:     content_type: str\n65:     body: bytes\n66: \n67: \n68: # ---- HTTP core -------------------------------------------------------------\n69: \n70: \n71: def _assert_public_host(url: str) -> None:\n72:     \"\"\"Refuse non-public destinations: loopback, LAN, link-local, reserved.\n73: \n74:     Guards web_fetch against being pointed at the agent's own HTTP API or the\n75:     surrounding network. Resolve-then-connect leaves a (narrow) DNS-rebinding\n76:     race; this is a guard against honest mistakes, not a sandbox — work mode\n77:     already has full shell access.\n78:     \"\"\"\n79:     host = urllib.parse.urlsplit(url).hostname\n80:     if not host:\n81:         raise WebError(f\"URL has no host: {url!r}\")\n82:     if host == \"localhost\" or host.endswith((\".localhost\", \".local\", \".internal\")):\n83:         raise WebError(f\"non-public host refused: {host}\")\n84:     try:\n85:         infos = socket.getaddrinfo(host, None)\n86:     except OSError as e:\n87:         raise WebError(f\"cannot resolve host {host!r}: {e}\") from e\n88:     for info in infos:\n89:         ip = ipaddress.ip_address(info[4][0])\n90:         if not ip.is_global:\n91:             raise WebError(f\"non-public host refused: {host} ({ip})\")\n92: \n93: \n94: class _SafeRedirects(urllib.request.HTTPRedirectHandler):\n95:     \"\"\"Redirects pass through the same public-host check as the first hop.\"\"\"\n96: \n97:     def redirect_request(self, req, fp, code, msg, headers, newurl):\n98:         _assert_public_host(newurl)\n99:         return super().redirect_request(req, fp, code, msg, headers, newurl)\n100: \n101: \n102: def _drain(resp: Any, cancel: Any, max_bytes: int) -> bytes:\n103:     \"\"\"Read the body in chunks, honoring Stop between chunks.\"\"\"\n104:     chunks: list[bytes] = []\n105:     total = 0\n106:     while True:\n107:         if cancel is not None and cancel.is_set():\n108:             raise WebError(\"aborted by user\")\n109:         block = resp.read(65_536)\n110:         if not block:\n111:             break\n112:         total += len(block)\n113:         if total > max_bytes:\n114:             raise WebError(f\"response exceeds {max_bytes} bytes\")\n115:         chunks.append(block)\n116:     return b\"\".join(chunks)\n117: \n118: \n119: def _http_get(\n120:     url: str,\n121:     timeout: float = 15.0,\n122:     cancel: Any = None,\n123:     method: str = \"GET\",\n124:     body: bytes | None = None,\n125:     headers: dict[str, str] | None = None,\n126:     max_bytes: int = _MAX_BYTES,\n127: ) -> HttpResp:\n128:     \"\"\"One bounded HTTP request. Raises WebError with a short, model-readable\n129:     reason; every caller turns that into error-as-data.\"\"\"\n130:     if cancel is not None and cancel.is_set():\n131:         raise WebError(\"aborted by user\")\n132:     scheme = urllib.parse.urlsplit(url).scheme.lower()\n133:     if scheme not in (\"http\", \"https\"):\n134:         raise WebError(f\"unsupported URL scheme {scheme!r} (http/https only)\")\n135:     _assert_public_host(url)\n136:     req_headers = {\n137:         \"User-Agent\": USER_AGENT,\n138:         \"Accept\": \"*/*\",\n139:         \"Accept-Language\": \"zh-CN,zh;q=0.9,en;q=0.8\",\n140:         \"Accept-Encoding\": \"gzip\",\n141:     }\n142:     if headers:\n143:         req_headers.update(headers)\n144:     request = urllib.request.Request(url, data=body, headers=req_headers, method=method)\n145:     try:\n146:         resp = urllib.request.build_opener(_SafeRedirects()).open(request, timeout=timeout)\n147:     except WebError:\n148:         raise\n149:     except urllib.error.HTTPError as e:\n150:         raise WebError(f\"HTTP {e.code} from {url}\") from e\n151:     except urllib.error.URLError as e:\n152:         reason = getattr(e, \"reason\", e)\n153:         if isinstance(reason, (socket.timeout, TimeoutError)):\n154:             raise WebError(f\"timed out after {timeout:.0f}s\") from e\n155:         raise WebError(str(reason) or \"request failed\") from e\n156:     except (ValueError, OSError) as e:\n157:         raise WebError(f\"request failed: {e}\") from e\n158:     with resp:\n159:         raw = _drain(resp, cancel, max_bytes)\n160:     if resp.headers.get(\"Content-Encoding\", \"\").lower() == \"gzip\":\n161:         try:\n162:             raw = gzip.decompress(raw)\n163:         except OSError as e:\n164:             raise WebError(f\"malformed gzip body from {url}\") from e\n165:     elif resp.headers.get(\"Content-Encoding\", \"\").lower() == \"deflate\":\n166:         try:\n167:             raw = zlib.decompress(raw)\n168:         except zlib.error:\n169:             raw = zlib.decompress(raw, -zlib.MAX_WBITS)  # raw-deflate variant\n170:     return HttpResp(url=resp.geturl(), content_type=resp.headers.get(\"Content-Type\", \"\"), body=raw)\n171: \n172: \n173: _CHARSET_RE = re.compile(r\"charset=[\\\"']?([\\w\\-:+.]+)\", re.I)\n174: _META_CHARSET_RE = re.compile(r\"<meta[^>]+charset=[\\\"']?([\\w\\-:+.]+)\", re.I)\n175: \n176: \n177: def _decode_body(raw: bytes, content_type: str) -> str:\n178:     \"\"\"Bytes -> text: header charset, then a meta sniff, then utf-8, then\n179:     latin-1 (which never fails, so decoding cannot raise).\"\"\"\n180:     m = _CHARSET_RE.search(content_type or \"\")\n181:     charset = m.group(1) if m else None\n182:     if not charset:\n183:         m = _META_CHARSET_RE.search(raw[:4096].decode(\"ascii\", errors=\"ignore\"))\n184:         charset = m.group(1) if m else None\n185:     if charset:\n186:         try:\n187:             return raw.decode(charset, errors=\"replace\")\n188:         except (LookupError, ValueError):\n189:             pass  # unknown charset name: fall through to BOM/utf-8\n190:     for bom, enc in ((b\"\\xff\\xfe\", \"utf-16-le\"), (b\"\\xfe\\xff\", \"utf-16-be\")):\n191:         if raw.startswith(bom):\n192:             return raw.decode(enc, errors=\"replace\")\n193:     try:\n194:         return raw.decode(\"utf-8\")\n195:     except UnicodeDecodeError:\n196:         return raw.decode(\"latin-1\", errors=\"replace\")\n197: \n198: \n199: # ---- HTML -> readable text --------------------------------------------------\n200: \n201: _SNIPPET_TAG_RE = re.compile(r\"<[^>]+>\")\n202: \n203: \n204: def _clean_snippet(text: str) -> str:\n205:     \"\"\"Feed/blurb HTML to one line of plain text.\"\"\"\n206:     text = _SNIPPET_TAG_RE.sub(\" \", text)\n207:     text = unescape(text).replace(\"\\xa0\", \" \")\n208:     return re.sub(r\"\\s+\", \" \", text).strip()[:300]\n209: \n210: \n211: class _TextExtractor(HTMLParser):\n212:     \"\"\"Page HTML to title + readable text: script/style/nav chrome dropped,\n213:     block boundaries become newlines, runs of blank lines collapse.\"\"\"\n214: \n215:     _SKIP = frozenset(\n... (showing lines 1-215 of 525; use offset=216 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789632711.966422, "id": "36e9a003d49e", "tool_call_id": "call_649957777b4d4a60a057b9d7", "content": "215:     _SKIP = frozenset(\n216:         {\"script\", \"style\", \"noscript\", \"template\", \"svg\", \"iframe\", \"object\",\n217:          \"embed\", \"canvas\", \"nav\", \"aside\", \"footer\", \"form\", \"button\",\n218:          \"select\", \"option\", \"input\", \"label\", \"head\"}\n219:     )\n220:     _BLOCK = frozenset(\n221:         {\"p\", \"div\", \"li\", \"tr\", \"table\", \"ul\", \"ol\", \"dl\", \"dt\", \"dd\", \"pre\",\n222:          \"blockquote\", \"section\", \"article\", \"main\", \"figure\", \"figcaption\",\n223:          \"h1\", \"h2\", \"h3\", \"h4\", \"h5\", \"h6\", \"br\", \"hr\"}\n224:     )\n225: \n226:     def __init__(self) -> None:\n227:         super().__init__(convert_charrefs=True)\n228:         self.title = \"\"\n229:         self._chunks: list[str] = []\n230:         self._skip_depth = 0\n231:         self._in_title = False\n232: \n233:     def handle_starttag(self, tag, attrs):\n234:         if tag == \"title\":\n235:             self._in_title = True\n236:             return\n237:         if tag in self._SKIP:\n238:             self._skip_depth += 1\n239:         elif not self._skip_depth and tag in self._BLOCK:\n240:             self._chunks.append(\"\\n\")\n241: \n242:     def handle_endtag(self, tag):\n243:         if tag == \"title\":\n244:             self._in_title = False\n245:         elif tag in self._SKIP and self._skip_depth:\n246:             self._skip_depth -= 1\n247:         elif not self._skip_depth and tag in self._BLOCK:\n248:             self._chunks.append(\"\\n\")\n249: \n250:     def handle_data(self, data):\n251:         if self._in_title:\n252:             self.title += data.strip()\n253:         elif not self._skip_depth:\n254:             self._chunks.append(data)\n255: \n256:     def text(self) -> str:\n257:         raw = \"\".join(self._chunks).replace(\"\\xa0\", \" \")\n258:         lines = (re.sub(r\"[ \\t\\r\\f]+\", \" \", ln).strip() for ln in raw.split(\"\\n\"))\n259:         return \"\\n\".join(ln for ln in lines if ln)\n260: \n261: \n262: def _window(text: str, start: int, limit: int) -> tuple[str, int | None]:\n263:     \"\"\"One character slice plus the next offset (None when nothing remains).\"\"\"\n264:     start = max(0, start)\n265:     chunk = text[start : start + limit]\n266:     rest = len(text) - (start + len(chunk))\n267:     return chunk, (start + len(chunk) if rest > 0 else None)\n268: \n269: \n270: # ---- result parsers ----------------------------------------------------------\n271: \n272: \n273: class _DdgParser(HTMLParser):\n274:     \"\"\"The duckduckgo html endpoint: <a class=\"result__a\">title</a> whose href\n275:     is a /l/?uddg=<encoded> redirect, then <a class=\"result__snippet\">blurb</a>.\"\"\"\n276: \n277:     def __init__(self) -> None:\n278:         super().__init__(convert_charrefs=True)\n279:         self.results: list[dict[str, str]] = []\n280:         self._pending: dict[str, str] | None = None\n281:         self._mode = \"\"  # \"\" | \"title\" | \"snippet\"\n282:         self._buf: list[str] = []\n283: \n284:     def handle_starttag(self, tag, attrs):\n285:         if tag != \"a\":\n286:             return\n287:         cls = dict(attrs).get(\"class\", \"\")\n288:         if \"result__a\" in cls:\n289:             self._flush()\n290:             href = dict(attrs).get(\"href\", \"\")\n291:             qs = urllib.parse.parse_qs(urllib.parse.urlsplit(href).query).get(\"uddg\")\n292:             self._pending = {\"url\": urllib.parse.unquote(qs[0]) if qs else href, \"title\": \"\", \"snippet\": \"\"}\n293:             self._mode, self._buf = \"title\", []\n294:         elif \"result__snippet\" in cls and self._pending is not None:\n295:             self._mode, self._buf = \"snippet\", []\n296: \n297:     def handle_data(self, data):\n298:         if self._mode:\n299:             self._buf.append(data)\n300: \n301:     def handle_endtag(self, tag):\n302:         if tag != \"a\" or not self._pending:\n303:             return\n304:         if self._mode == \"title\":\n305:             self._pending[\"title\"] = re.sub(r\"\\s+\", \" \", \"\".join(self._buf)).strip()\n306:             self._mode = \"\"\n307:         elif self._mode == \"snippet\":\n308:             self._pending[\"snippet\"] = _clean_snippet(\"\".join(self._buf))\n309:             self.results.append(self._pending)\n310:             self._pending, self._mode = None, \"\"\n311: \n312:     def _flush(self):\n313:         \"\"\"A result__a without a trailing snippet still counts.\"\"\"\n314:         if self._pending and self._pending[\"title\"]:\n315:             self.results.append(self._pending)\n316:         self._pending, self._mode = None, \"\"\n317: \n318: \n319: # ---- backends: (query, limit, config, get) -> list[{title,url,snippet}] ------\n320: \n321: \n322: def _tavily(query: str, limit: int, config: Config, get: Callable[..., HttpResp]) -> list[dict[str, str]]:\n323:     payload = json.dumps({\"query\": query, \"max_results\": limit}).encode(\"utf-8\")\n324:     resp = get(\n325:         \"https://api.tavily.com/search\",\n326:         method=\"POST\",\n327:         body=payload,\n328:         headers={\n329:             \"Content-Type\": \"application/json\",\n330:             \"Authorization\": f\"Bearer {config.tavily_api_key}\",\n331:             \"Accept\": \"application/json\",\n332:         },\n333:     )\n334:     try:\n335:         data = json.loads(resp.body)\n336:         raw = data.get(\"results\") or []\n337:     except ValueError as e:\n338:         raise BackendError(f\"tavily returned non-JSON body: {e}\") from e\n339:     out = [\n340:         {\n341:             \"title\": str(r.get(\"title\") or \"\").strip(),\n342:             \"url\": str(r.get(\"url\") or \"\").strip(),\n343:             \"snippet\": _clean_snippet(str(r.get(\"content\") or \"\")),\n344:         }\n345:         for r in raw\n346:         if isinstance(r, dict) and r.get(\"url\")\n347:     ]\n348:     if not out:\n349:         raise BackendError(\"response had no usable results\")\n350:     return out[:limit]\n351: \n352: \n353: def _searxng(query: str, limit: int, config: Config, get: Callable[..., HttpResp]) -> list[dict[str, str]]:\n354:     url = f\"{config.searxng_url}/search?{urllib.parse.urlencode({'q': query, 'format': 'json'})}\"\n355:     resp = get(url, headers={\"Accept\": \"application/json\"})\n356:     try:\n357:         data = json.loads(resp.body)\n358:         raw = data.get(\"results\") or []\n359:     except ValueError as e:\n360:         raise BackendError(f\"searxng returned non-JSON body (format=json enabled?): {e}\") from e\n361:     out = [\n362:         {\n363:             \"title\": str(r.get(\"title\") or \"\").strip(),\n364:             \"url\": str(r.get(\"url\") or \"\").strip(),\n365:             \"snippet\": _clean_snippet(str(r.get(\"content\") or \"\")),\n366:         }\n367:         for r in raw\n368:         if isinstance(r, dict) and r.get(\"url\")\n369:     ]\n370:     if not out:\n371:         raise BackendError(\"response had no usable results\")\n372:     return out[:limit]\n373: \n374: \n375: def _bing(query: str, limit: int, config: Config, get: Callable[..., HttpResp]) -> list[dict[str, str]]:\n376:     url = \"https://www.bing.com/search?\" + urllib.parse.urlencode(\n377:         {\"q\": query, \"format\": \"rss\", \"count\": str(min(limit, 30))}\n378:     )\n379:     resp = get(url, headers={\"Accept\": \"application/rss+xml, application/xml;q=0.9, */*;q=0.8\"})\n380:     try:\n381:         root = ET.fromstring(resp.body)\n382:     except ET.ParseError as e:\n383:         raise BackendError(f\"bing RSS is not parseable XML: {e}\") from e\n384:     out = []\n385:     for item in root.iter(\"item\"):\n386:         title = (item.findtext(\"title\") or \"\").strip()\n387:         link = (item.findtext(\"link\") or \"\").strip()\n388:         if not (title and link):\n389:             continue\n390:         out.append({\"title\": _clean_snippet(title), \"url\": link, \"snippet\": _clean_snippet(item.findtext(\"description\") or \"\")})\n391:         if len(out) >= limit:\n392:             break\n393:     if not out:\n394:         raise BackendError(\"no items in the RSS (blocked, or genuinely no results)\")\n395:     return out\n396: \n397: \n398: def _ddg(query: str, limit: int, config: Config, get: Callable[..., HttpResp]) -> list[dict[str, str]]:\n399:     url = \"https://html.duckduckgo.com/html/?\" + urllib.parse.urlencode({\"q\": query})\n400:     resp = get(url)\n401:     parser = _DdgParser()\n402:     parser.feed(_decode_body(resp.body, resp.content_type))\n403:     parser.close()\n404:     out = [r for r in parser.results if r[\"url\"]][:limit]\n405:     if not out:\n406:         raise BackendError(\"no results parsed (bot-checked, blocked, or layout changed)\")\n407:     return out\n408: \n409: \n410: _BACKENDS: dict[str, Callable[[str, int, Config, Callable[..., HttpResp]], list[dict[str, str]]]] = {\n411:     \"tavily\": _tavily,\n412:     \"searxng\": _searxng,\n413:     \"bing\": _bing,\n414:     \"ddg\": _ddg,\n415: }\n416: _DEFAULT_CHAIN = (\"tavily\", \"searxng\", \"bing\", \"ddg\")\n417: \n418: \n419: def _available_backends(config: Config) -> tuple[str, ...]:\n420:     \"\"\"The usable subset of the chain: keyless backends are always in.\"\"\"\n421:     out = []\n422:     for name in _DEFAULT_CHAIN:\n423:         if name == \"tavily\" and not config.tavily_api_key:\n424:             continue\n425:         if name == \"searxng\" and not config.searxng_url:\n426:             continue\n427:         out.append(name)\n428:     return tuple(out)\n429: \n430: \n431: def _short(reason: object) -> str:\n432:     return re.sub(r\"\\s+\", \" \", str(reason)).strip()[:160]\n433: \n434: \n435: def web_search(\n436:     workspace: Workspace,\n437:     config: Config,\n438:     query: str,\n439:     max_results: int | None = None,\n... (showing lines 215-439 of 525; use offset=440 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789632711.9897077, "id": "9861b9afff58", "tool_call_id": "call_8bc58350912f4d4d9418e725", "content": "\"\"\"Centralized configuration.\n\nAll tunables live here (or in CLI args); prompts stay in agent/prompts/.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\n\n# Reasoning effort knob (extra_body thinking.reasoning_effort); ignored by models without thinking\nREASONING_EFFORT_LEVELS = (\"low\", \"medium\", \"max\")\n\n# Persisted settings fields: flat, no provider presets\n_SETTING_FIELDS = (\"base_url\", \"model\", \"api_key\", \"reasoning_effort\")\n\n\ndef flatten_settings(saved: dict) -> dict:\n    \"\"\"Normalize a settings file into the flat field map (known fields only);\n    legacy {profiles, active} maps collapse to the active profile.\"\"\"\n    if isinstance(saved, dict) and isinstance(saved.get(\"profiles\"), dict):\n        saved = saved.get(\"profiles\", {}).get(saved.get(\"active\") or \"\", {}) or {}\n    return {k: saved[k] for k in _SETTING_FIELDS if isinstance(saved, dict) and saved.get(k)}\n\n\n@dataclass\nclass Config:\n    # LLM endpoint: settings modal / env (CLUTCH_*) / CLI; empty = not configured yet\n    model: str = field(default_factory=lambda: os.environ.get(\"CLUTCH_MODEL\", \"\"))\n    base_url: str = field(default_factory=lambda: os.environ.get(\"CLUTCH_BASE_URL\", \"\"))\n    api_key: str | None = field(default_factory=lambda: os.environ.get(\"CLUTCH_API_KEY\"))\n    # LLM request tuning\n    llm_request_timeout: float = 60.0\n    # Streaming read budget. httpx's read timeout bounds the GAP between two\n    # chunks, not the total response time, so reusing request_timeout for it\n    # kills any stream whose provider stalls (or whose buffering relay flushes\n    # only at the end) for over 60s — the classic \"network is fine yet request\n    # timed out\". Connect stays tight (fail fast on dead routes) and reads get\n    # their own generous budget; see llm_clients/openai_client.py.\n    llm_read_timeout: float = 240.0\n    llm_max_retries: int = 3\n    llm_retryable_status: frozenset[int] = frozenset({429, 500, 502, 503, 504})\n    # None = leave the request unset (server default); otherwise one of REASONING_EFFORT_LEVELS\n    llm_reasoning_effort: str | None = None\n    # model context window in BYTES (compaction compares against it)\n    llm_context_window_bytes: int = 500_000\n\n    # Loop budget\n    max_turns: int = 0  # 0 = no turn limit (compaction keeps long runs going); >0 caps turns\n    # Doom-loop guard: N identical calls (same name + arguments + result content)\n    # in a row. First detection feeds a warning back as an error; repeating the\n    # exact warned call then aborts the run (abort_on_doom_loop=False keeps\n    # feeding feedback instead). Identical calls whose results change are\n    # progress (polling, flaky tests) and never trigger.\n    doom_loop_limit: int = 4\n    abort_on_doom_loop: bool = True\n\n    # Compaction: old turns roll into a summary as the window fills\n    compaction_enabled: bool = True\n    compaction_model: str | None = None  # None = the main model\n\n    # Tool execution\n    command_timeout: float = 30.0\n    output_limit: int = 6000\n    output_head: int = 2500\n    output_tail: int = 2500\n    read_max_chars: int = 20000\n\n    # Web access (tools/websearch.py): keyless out of the box (Bing RSS -> DDG\n    # HTML); better backends activate automatically once their env is present\n    web_search_timeout: float = 15.0\n    web_search_max_results: int = 8\n    # Tavily (https://tavily.com, LLM-first search API, free tier)\n    tavily_api_key: str | None = field(\n        default_factory=lambda: os.environ.get(\"CLUTCH_TAVILY_API_KEY\") or os.environ.get(\"TAVILY_API_KEY\")\n    )\n    # Self-hosted SearXNG instance exposing format=json (searxng/searxng)\n    searxng_url: str = field(\n        default_factory=lambda: (\n            os.environ.get(\"CLUTCH_SEARXNG_URL\") or os.environ.get(\"SEARXNG_URL\") or \"\"\n        ).rstrip(\"/\")\n    )\n\n    # Agent mode: \"work\" = full toolset, \"chat\" = read-only (whitelist + memory + skills)\n    mode: str = \"work\"\n\n    # Commands that hang in a non-TTY pipe\n    blocked_prefixes: list[str] = field(\n        default_factory=lambda: [\n            \"vim\",\n            \"vi\",\n            \"emacs\",\n            \"nano\",\n            \"less\",\n            \"more\",\n            \"tail -f\",\n            \"top\",\n            \"htop\",\n            \"make\",\n        ]\n    )\n\n    # Runtime\n    port: int = 8890\n    host: str = \"127.0.0.1\"  # bind address; 0.0.0.0 exposes the API to other devices\n    # Skills: catalog in the system prompt; loaded on demand via load_skill\n    enable_skills: bool = True\n    skills_dir: Path = Path(__file__).resolve().parent / \"skills\"\n    # Permission: confirm risky actions with the user, not a sandbox\n    non_interactive: bool = False  # auto-allow (used by eval harness / unattended runs)\n\n    def truncate(self, text: str) -> str:\n        \"\"\"Head/tail trim oversized output; the middle is replaced with an omitted note.\"\"\"\n        if len(text) <= self.output_limit:\n            return text\n        omitted = len(text) - self.output_head - self.output_tail\n        return f\"{text[: self.output_head]}\\n... [{omitted} chars omitted] ...\\n{text[-self.output_tail :]}\"\n", "is_error": false, "diff": ""}
