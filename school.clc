{"type": "tool_result", "timestamp": 1789870262.4318185, "id": "1963f0495eba", "tool_call_id": "call_88c06e6c5ac841188d5ea32b", "content": "140:             max_retries=cfg.llm_max_retries,\n141:             retryable_status=cfg.llm_retryable_status,\n142:             reasoning_effort=cfg.llm_reasoning_effort,\n143:         )\n144: \n145:     def build_llm(self) -> LlmClient:\n146:         \"\"\"LLM client for this server. Raises RuntimeError when no API key.\"\"\"\n147:         return self._build_llm(self.state.api_key or self.config.api_key, self.config.model, self.config)\n148: \n149:     def build_tools(self, project: Project | None = None, config: Config | None = None) -> ToolRegistry:\n150:         \"\"\"Tools for a run; config overrides self.config for a per-run mode\n151:         (chat read-only toolset vs work's full set).\"\"\"\n152:         cfg = config or self.config\n153:         return ToolRegistry(build_default_tools(cfg, memories=project.memories if project else None))\n154: \n155:     @abstractmethod\n156:     def build_workspace(self, project: Project) -> Workspace:\n157:         \"\"\"Workspace for a project's working directory (local or remote).\"\"\"\n158: \n159:     def start_task(\n160:         self,\n161:         task: str,\n162:         project: Project,\n163:         on_ask=None,\n164:         cancel: threading.Event | None = None,\n165:         config: Config | None = None,\n166:     ) -> Agent | None:\n167:         \"\"\"Assemble and claim a run on the project: workspace + LLM + tools +\n168:         gate + Agent. Returns the Agent (caller runs it) or None when a run is\n169:         already active.\n170:         \"\"\"\n171:         cfg = config or self.config\n172:         # reuse the UI-built workspace when it matches the project root, else build fresh\n173:         workspace = self.state.workspace\n174:         if workspace is None or workspace.root != project.workdir:\n175:             workspace = self.build_workspace(project)\n176:         workspace.protect(project.path)\n177:         llm = self.build_llm()  # before claiming the slot: a bad key must not stick busy\n178:         # compaction summarizer built lazily via a factory capturing the resolved key\n179:         compactor_factory = None\n... (showing lines 140-179 of 206; use offset=180 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789870262.4386952, "id": "e56272bed63c", "tool_call_id": "call_97f6b0f4acd7405fa211ec51", "content": "55: # dependent: POSIX gives BrokenPipeError (EPIPE) or ConnectionResetError\n56: # (ECONNRESET) when the peer is gone, Windows gives ConnectionAbortedError\n57: # (WSAECONNABORTED/WSAECONNRESET), so leaving it out spams one traceback per\n58: # closed window on Windows. ValueError covers a write on an already-closed\n59: # stream.\n60: _SSE_ERR = (BrokenPipeError, ConnectionResetError, ConnectionAbortedError, ValueError)\n61: \n62: \n63: def _settings_path() -> Path:\n64:     return Path.home() / \".clutch\" / \"settings.json\"\n65: \n66: \n67: def load_settings() -> dict:\n68:     \"\"\"Read persisted settings (api_key). The file lives outside the repo on purpose.\"\"\"\n69:     p = _settings_path()\n70:     try:\n71:         return json.loads(p.read_text(encoding=\"utf-8\"))\n72:     except (OSError, json.JSONDecodeError):\n73:         return {}\n74: \n75: \n76: def save_settings(data: dict) -> None:\n77:     p = _settings_path()\n78:     try:\n79:         p.parent.mkdir(parents=True, exist_ok=True)\n80:         p.write_text(json.dumps(data, ensure_ascii=False), encoding=\"utf-8\")\n81:         p.chmod(0o600)  # owner-only, the file holds a credential\n82:     except OSError as e:\n83:         print(f\"[clutch-server] cannot persist settings: {e}\", file=sys.stderr)\n84: \n85: \n86: def _services_from(body: dict) -> list[dict] | None:\n87:     \"\"\"The mcp_services list from a settings POST body; None = untouched.\n88: \n89:     Records are validated and canonicalized so only well-formed ones persist;\n90:     any bad entry fails the whole save (the UI shows the reason — never a\n91:     silent drop).\n92:     \"\"\"\n93:     if \"mcp_services\" not in body:\n94:         return None\n... (showing lines 55-94 of 856; use offset=95 to continue)", "is_error": false, "diff": ""}
