{"type": "tool_result", "timestamp": 1789625760.5583599, "id": "ba9ca7ba6ff1", "tool_call_id": "call_e67102dfd46441868432f854", "content": "42: from .workspace import Workspace\n43: \n44: # browser-shaped but honest about the product; several CDNs 403 blank UAs\n45: USER_AGENT = (\n46:     \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) \"\n47:     \"Chrome/124.0 Safari/537.36 ClutchAgent/0.1\"\n48: )\n49: \n50: _MAX_BYTES = 2_000_000  # hard cap per response: pages are for reading, not hoarding\n51: \n52: \n53: class WebError(Exception):\n54:     \"\"\"A request-level failure (DNS, timeout, size cap, private host).\"\"\"\n55: \n56: \n57: class BackendError(Exception):\n58:     \"\"\"A backend responded but yielded nothing usable (blocked, layout changed).\"\"\"\n59: \n60: \n61: @dataclass\n62: class HttpResp:\n63:     url: str  # final URL after redirects\n64:     content_type: str\n65:     body: bytes\n66: \n67: \n68: # ---- HTTP core -------------------------------------------------------------\n69: \n70: \n71: def _assert_public_host(url: str) -> None:\n72:     \"\"\"Refuse non-public destinations: loopback, LAN, link-local, reserved.\n73: \n74:     Guards web_fetch against being pointed at the agent's own HTTP API or the\n75:     surrounding network. Resolve-then-connect leaves a (narrow) DNS-rebinding\n76:     race; this is a guard against honest mistakes, not a sandbox — work mode\n77:     already has full shell access.\n78:     \"\"\"\n79:     host = urllib.parse.urlsplit(url).hostname\n80:     if not host:\n81:         raise WebError(f\"URL has no host: {url!r}\")\n82:     if host == \"localhost\" or host.endswith((\".localhost\", \".local\", \".internal\")):\n83:         raise WebError(f\"non-public host refused: {host}\")\n84:     try:\n85:         infos = socket.getaddrinfo(host, None)\n86:     except OSError as e:\n87:         raise WebError(f\"cannot resolve host {host!r}: {e}\") from e\n88:     for info in infos:\n89:         ip = ipaddress.ip_address(info[4][0])\n90:         if not ip.is_global:\n91:             raise WebError(f\"non-public host refused: {host} ({ip})\")\n92: \n93: \n94: class _SafeRedirects(urllib.request.HTTPRedirectHandler):\n95:     \"\"\"Redirects pass through the same public-host check as the first hop.\"\"\"\n96: \n97:     def redirect_request(self, req, fp, code, msg, headers, newurl):\n98:         _assert_public_host(newurl)\n99:         return super().redirect_request(req, fp, code, msg, headers, newurl)\n100: \n101: \n102: def _drain(resp: Any, cancel: Any, max_bytes: int) -> bytes:\n103:     \"\"\"Read the body in chunks, honoring Stop between chunks.\"\"\"\n104:     chunks: list[bytes] = []\n105:     total = 0\n106:     while True:\n107:         if cancel is not None and cancel.is_set():\n108:             raise WebError(\"aborted by user\")\n109:         block = resp.read(65_536)\n110:         if not block:\n111:             break\n112:         total += len(block)\n113:         if total > max_bytes:\n114:             raise WebError(f\"response exceeds {max_bytes} bytes\")\n115:         chunks.append(block)\n116:     return b\"\".join(chunks)\n117: \n118: \n119: def _http_get(\n120:     url: str,\n121:     timeout: float = 15.0,\n122:     cancel: Any = None,\n123:     method: str = \"GET\",\n124:     body: bytes | None = None,\n125:     headers: dict[str, str] | None = None,\n126:     max_bytes: int = _MAX_BYTES,\n127: ) -> HttpResp:\n128:     \"\"\"One bounded HTTP request. Raises WebError with a short, model-readable\n129:     reason; every caller turns that into error-as-data.\"\"\"\n130:     if cancel is not None and cancel.is_set():\n131:         raise WebError(\"aborted by user\")\n132:     scheme = urllib.parse.urlsplit(url).scheme.lower()\n133:     if scheme not in (\"http\", \"https\"):\n134:         raise WebError(f\"unsupported URL scheme {scheme!r} (http/https only)\")\n135:     _assert_public_host(url)\n136:     req_headers = {\n137:         \"User-Agent\": USER_AGENT,\n138:         \"Accept\": \"*/*\",\n139:         \"Accept-Language\": \"zh-CN,zh;q=0.9,en;q=0.8\",\n140:         \"Accept-Encoding\": \"gzip\",\n141:     }\n... (showing lines 42-141 of 525; use offset=142 to continue)", "is_error": false, "diff": ""}
