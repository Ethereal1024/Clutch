: int = 200) -> None:\n657:         body = json.dumps(obj).encode(\"utf-8\")\n658:         self.send_response(status)\n659:         self.send_header(\"Content-Type\", \"application/json\")\n660:         self.send_header(\"Content-Length\", str(len(body)))\n661:         self.end_headers()\n662:         self.wfile.write(body)\n663: \n664:     def _read_body(self) -> dict:\n665:         try:\n666:             n = int(self.headers.get(\"Content-Length\") or 0)\n667:             if n <= 0:\n668:                 return {}\n669:             return json.loads(self.rfile.read(n).decode(\"utf-8\") or \"{}\")\n670:         except (ValueError, json.JSONDecodeError):\n671:             return {}\n672: \n673:     def do_GET(self) -> None:\n674:         if self.path == \"/api/health\":\n675:             self._json({\"status\": \"ok\"})\n676:         else:\n677:             self._json({\"error\": \"not found\"}, 404)\n678: \n679:     def do_POST(self) -> None:\n680:         sup = self.supervisor\n681:         if self.path == \"/api/session/start\":\n682:             body = self._read_body()\n683:             sess = sup.start_session(base_url=body.get(\"base_url\") or None)\n684:             if sess is None:\n685:                 self._json({\"error\": \"session start failed\"}, 500)\n686:             else:\n687:                 self._json({\"session_id\": sess.session_id, \"port\": sess.port})\n688:         elif self.path == \"/api/session/stop\":\n689:             sid = self._read_body().get(\"session_id\")\n690:             ok = sup.stop_session(sid)\n691:             self._json({\"status\": \"ok\" if ok else \"unknown\"}, 200 if ok else 404)\n692:         elif self.path == \"/api/session/heartbeat\":\n693:             sid = self._read_body().get(\"session_id\")\n694:             ok = sup.heartbeat(sid)\n695:             self._json({\"status\": \"ok\" if ok else \"unknown\"}, 200 if ok else 404)\n696:         elif self.path == \"/api/shutdown\":\n697:             # normal close: exit once no sessions remain; arm the flag only\n698:             # when nothing is running (a sticky flag could kill a re-claim)\n699:             with sup._lock:\n700:                 if not sup.sessions:\n701:                     sup.exit_when_idle = True\n702:             self._json({\"status\": \"ok\"})\n703:         else:\n704:             self._json({\"error\": \"not found\"}, 404)\n705: \n706: \n707: def _agent_cmd_default() -> list[str]:\n708:     \"\"\"Dev: run agent.server with this interpreter. PyInstaller onefile: launch\n709:     the agent-server binary next to the supervisor.\"\"\"\n710:     if getattr(sys, \"frozen\", False):\n711:         # Windows bundles carry the .exe suffix\n712:         exe = \"agent-server.exe\" if os.name == \"nt\" else \"agent-server\"\n713:         return [os.path.join(os.path.dirname(sys.executable), exe)]\n714:     return [sys.executable, \"-m\", \"agent.server\"]\n715: \n716: \n717: def build_server(port: int, sup: Supervisor) -> ThreadingHTTPServer:\n718:     handler = type(\"ClutchSupervisorHandler\", (_Handler,), {\"supervisor\": sup})\n719:     try:\n720:         return ThreadingHTTPServer((\"127.0.0.1\", port), handler)\n721:     except OSError as e:\n722:         # an occupied port kills silently; say exactly what happened\n723:         raise SystemExit(\n724:             f\"[clutch-supervisor] ERROR: cannot bind 127.0.0.1:{port} — port in use \"\n725:             f\"({e}). Close the other Clutch/agent server on this port and retry.\"\n726:         ) from e\n727: \n728: \n729: def main() -> int:\n730:     # wrap before the first print: a dead stdout must not crash startup\n731:     sys.stdout = _SafeStdStream(sys.stdout)\n732:     sys.stderr = _SafeStdStream(sys.stderr)\n733: \n734:     ap = argparse.ArgumentParser(prog=\"agent.supervisor\")\n735:     ap.add_argument(\"--port\", type=int, default=DEFAULT_PORT)\n736:     ap.add_argument(\"--idle-timeout\", type=float, default=IDLE_TIMEOUT_S,\n737:                     help=\"exit after this many seconds with zero sessions\")\n738:     ap.add_argument(\"--agent-cmd\", default=None,\n739:                     help=\"executable used to spawn session children (default: \"\n740:                          \"this interpreter + -m agent.server)\")\n741:     ap.add_argument(\"--cwd\", default=None, help=\"working dir for session children\")\n742:     args = ap.parse_args()\n743: \n744:     agent_cmd = ([args.agent_cmd] if args.agent_cmd else _agent_cmd_default())\n745:     if args.cwd:\n746:         cwd = args.cwd\n747:     elif getattr(sys, \"frozen\", False):\n748:         cwd = os.path.expanduser(\"~\")  # no repo root inside the bundle\n749:     else:\n750:         cwd = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n751:     sup = Supervisor(agent_cmd=agent_cmd, cwd=cwd, idle_timeout_s=args.idle_timeout)\n752:     # a dead/full stdout must never hang logging or the session-start handler\n753:     _make_stdout_nonblocking()\n754:     srv = build_server(args.port, sup)\n755:     bound_port = srv.server_address[1]\n756:     _log(f\"[clutch-supervisor] http://127.0.0.1:{bound_port}  (session lifecycle API)\")\n757: \n758:     def _on_term(_signum, _frame):\n759:         _log(\"[supervisor] SIGTERM, shutting sessions down\")\n760:         sup.shutdown_all()\n761:         sup.exit_event.set()\n762:         sys.exit(0)\n763: \n764:     if hasattr(signal, \"SIGTERM\"):\n765:         signal.signal(signal.SIGTERM, _on_term)\n766: \n767:     threading.Thread(target=sup.reap_loop, daemon=True).start()\n768: \n769:     def _exit_watch() -> None:\n770:         # stop the HTTP server too, or serve_forever keeps the process alive\n771:         while not sup.exit_event.is_set():\n772:             time.sleep(0.2)\n773:         srv.shutdown()\n774: \n775:     threading.Thread(target=_exit_watch, daemon=True).start()\n776:     try:\n777:         srv.serve_forever()\n778:     except KeyboardInterrupt:\n779:         pass\n780:     finally:\n781:         sup.shutdown_all()\n782:     return 0\n783: \n784: \n785: if __name__ == \"__main__\":\n786:     sys.exit(main())", "is_error": false, "diff": ""}
