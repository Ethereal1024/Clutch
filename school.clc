{"type": "tool_result", "timestamp": 1789869435.7463543, "id": "38e27982bd7f", "tool_call_id": "call_43b3a2e1fca64fd0ace9d29f", "content": "1: \"\"\"Declarative tool registry.\n2: \n3: Single source of truth: one Tool definition yields both the OpenAI function-calling\n4: schema and the local execution entry. Tool descriptions live here as schema data;\n5: error texts live in agent/prompts/.\n6: \"\"\"\n7: \n8: from __future__ import annotations\n9: \n10: import inspect\n11: import threading\n12: from dataclasses import dataclass\n13: from typing import Any, Callable\n14: \n15: from ..config import Config\n16: from ..memory import MemoryStore\n17: from ..prompts import render\n18: from ..skills import cached_library\n19: from . import filesystem, shell, websearch\n20: from .workspace import Workspace\n21: \n22: # (workspace, config, **args) -> dict{content, error?}\n23: ToolImpl = Callable[..., dict[str, Any]]\n24: \n25: \n26: @dataclass\n27: class Tool:\n28:     name: str\n29:     description: str\n30:     parameters: dict[str, Any]  # JSON Schema (properties + required)\n31:     func: ToolImpl\n32: \n33:     def to_openai_schema(self) -> dict[str, Any]:\n34:         return {\n35:             \"type\": \"function\",\n36:             \"function\": {\n37:                 \"name\": self.name,\n38:                 \"description\": self.description,\n39:                 \"parameters\": {\n40:                     \"type\": \"object\",\n41:                     \"properties\": self.parameters.get(\"properties\", {}),\n42:                     \"required\": self.parameters.get(\"required\", []),\n43:                 },\n44:             },\n45:         }\n46: \n47: \n48: def _str_param(desc: str) -> dict[str, Any]:\n49:     return {\"type\": \"string\", \"description\": desc}\n50: \n51: \n52: def build_default_tools(config: Config, memories: MemoryStore | None = None) -> list[Tool]:\n53:     chat_mode = config.mode == \"chat\"\n54:     tools = [\n55:         Tool(\n56:             name=\"read_file\",\n57:             description=render(\"tools/read_file.md\", read_max_chars=config.read_max_chars),\n58:             parameters={\n59:                 \"properties\": {\n60:                     \"path\": _str_param(\"file path OR directory path, relative to the workspace root\"),\n61:                     \"max_chars\": {\n62:                         \"type\": \"integer\",\n63:                         \"description\": f\"max chars to read (default {config.read_max_chars})\",\n64:                     },\n65:                     \"offset\": {\n66:                         \"type\": \"integer\",\n67:                         \"description\": \"1-based start line for a line-range read\",\n68:                     },\n69:                     \"limit\": {\n70:                         \"type\": \"integer\",\n71:                         \"description\": \"max lines to read when offset is given\",\n72:                     },\n73:                 },\n74:                 \"required\": [\"path\"],\n75:             },\n76:             func=lambda sb, cfg, **kw: filesystem.read_file(sb, cfg, **kw),\n77:         ),\n78:         Tool(\n79:             name=\"grep\",\n80:             description=render(\"tools/grep.md\"),\n81:             parameters={\n82:                 \"properties\": {\n83:                     \"pattern\": _str_param(\"regex to search for\"),\n84:                     \"path\": _str_param(\"subdirectory or file to search (default: whole workspace)\"),\n85:                     \"include\": _str_param(\"filename glob filter (e.g. '*.py')\"),\n86:                 },\n87:                 \"required\": [\"pattern\"],\n88:             },\n89:             func=lambda sb, cfg, **kw: filesystem.grep(sb, cfg, **kw),\n90:         ),\n91:     ]\n92: \n93:     # chat mode: no write tools. The model never sees write_file/edit_file — the\n94:     # schema is the hard boundary, the system prompt the soft guide (prompts/).\n95:     if not chat_mode:\n96:         tools.append(\n97:             Tool(\n98:                 name=\"write_file\",\n99:                 description=render(\"tools/write_file.md\"),\n100:                 parameters={\n101:                     \"properties\": {\n102:                         \"path\": _str_param(\"file path, relative to the workspace root\"),\n103:                         \"content\": _str_param(\"full file content\"),\n104:                     },\n105:                     \"required\": [\"path\", \"content\"],\n106:                 },\n107:                 func=lambda sb, cfg, **kw: filesystem.write_file(sb, cfg, **kw),\n108:             )\n109:         )\n110:         tools.append(\n111:             Tool(\n112:                 name=\"edit_file\",\n113:                 description=render(\"tools/edit_file.md\"),\n114:                 parameters={\n115:                     \"properties\": {\n116:                         \"path\": _str_param(\"file path, relative to the workspace root\"),\n117:                         \"old_string\": _str_param(\"exact text to replace (must appear exactly once)\"),\n118:                         \"new_string\": _str_param(\"replacement text\"),\n119:                     },\n120:                     \"required\": [\"path\", \"old_string\", \"new_string\"],\n121:                 },\n122:                 func=lambda sb, cfg, **kw: filesystem.edit_file(sb, cfg, **kw),\n123:             )\n124:         )\n125: \n126:     # run_command exists in both modes; in chat mode its description advertises the\n127:     # read-only restriction and the tool rejects anything not provably read-only.\n128:     tools.append(\n129:         Tool(\n130:             name=\"run_command\",\n... (showing lines 1-130 of 377; use offset=131 to continue)", "is_error": false, "diff": ""}
