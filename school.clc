{"type": "tool_result", "timestamp": 1789626053.6104805, "id": "65aa63c23622", "tool_call_id": "call_9e28162b25d04418929aca40", "content": "500:         return PurePosixPath(self._remote_home)\n501: \n502:     def exec_shell(self) -> LocalShell:\n503:         \"\"\"The remote host runs the POSIX shell stack regardless of the app\n504:         host's OS: even on a Windows machine behind the UI, run_command text\n505:         parses as POSIX sh on the REMOTE — never tokenize it with the local\n506:         (cmd) rules. posix=True, argv=None (spawn decisions stay localshell's).\"\"\"\n507:         return LocalShell(argv=None, posix=True, name=\"posix-sh\")\n508: \n509:     def run(self, command: str, timeout: float, cancel: threading.Event | None = None) -> CommandResult:\n510:         cmd = f\"cd {shq(str(self.root))} && {command}\"\n511:         # oversized exec commands drop a minimal sshd: fail cleanly up front\n512:         size = len(cmd.encode(\"utf-8\"))\n513:         if size > _EXEC_MAX_COMMAND_BYTES:\n514:             raise TransportError(\n515:                 f\"command too long to send over the remote transport ({size} bytes); \"\n... (showing lines 500-515 of 709; use offset=516 to continue)", "is_error": false, "diff": ""}
