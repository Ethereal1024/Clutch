{"type": "tool_result", "timestamp": 1789870272.2973735, "id": "f2254ef4e28b", "tool_call_id": "call_88fda732a34048349d298cb6", "content": "28: class Config:\n29:     # LLM endpoint: settings modal / env (CLUTCH_*) / CLI; empty = not configured yet\n30:     model: str = field(default_factory=lambda: os.environ.get(\"CLUTCH_MODEL\", \"\"))\n31:     base_url: str = field(default_factory=lambda: os.environ.get(\"CLUTCH_BASE_URL\", \"\"))\n32:     api_key: str | None = field(default_factory=lambda: os.environ.get(\"CLUTCH_API_KEY\"))\n33:     # LLM request tuning\n34:     llm_request_timeout: float = 60.0\n35:     # Streaming read budget. httpx's read timeout bounds the GAP between two\n36:     # chunks, not the total response time, so reusing request_timeout for it\n37:     # kills any stream whose provider stalls (or whose buffering relay flushes\n38:     # only at the end) for over 60s — the classic \"network is fine yet request\n39:     # timed out\". Connect stays tight (fail fast on dead routes) and reads get\n40:     # their own generous budget; see llm_clients/openai_client.py.\n41:     llm_read_timeout: float = 240.0\n42:     llm_max_retries: int = 3\n43:     llm_retryable_status: frozenset[int] = frozenset({429, 500, 502, 503, 504})\n44:     # None = leave the request unset (server default); otherwise one of REASONING_EFFORT_LEVELS\n45:     llm_reasoning_effort: str | None = None\n46:     # model context window in BYTES (compaction compares against it)\n47:     llm_context_window_bytes: int = 500_000\n48: \n49:     # Loop budget\n50:     max_turns: int = 0  # 0 = no turn limit (compaction keeps long runs going); >0 caps turns\n51:     # Doom-loop guard: N identical calls (same name + arguments + result content)\n52:     # in a row. First detection feeds a warning back as an error; repeating the\n53:     # exact warned call then aborts the run (abort_on_doom_loop=False keeps\n54:     # feeding feedback instead). Identical calls whose results change are\n55:     # progress (polling, flaky tests) and never trigger.\n56:     doom_loop_limit: int = 4\n57:     abort_on_doom_loop: bool = True\n58: \n59:     # Compaction: old turns roll into a summary as the window fills\n60:     compaction_enabled: bool = True\n61:     compaction_model: str | None = None  # None = the main model\n62: \n63:     # Tool execution\n64:     command_timeout: float = 30.0\n65:     output_limit: int = 6000\n66:     output_head: int = 2500\n67:     output_tail: int = 2500\n68:     read_max_chars: int = 20000\n69: \n70:     # Web access (tools/websearch.py): keyless out of the box (Bing RSS -> DDG\n71:     # HTML); better backends activate automatically once their env is present\n72:     web_search_timeout: float = 15.0\n73:     web_search_max_results: int = 8\n74:     # Tavily (https://tavily.com, LLM-first search API, free tier)\n75:     tavily_api_key: str | None = field(\n76:         default_factory=lambda: os.environ.get(\"CLUTCH_TAVILY_API_KEY\") or os.environ.get(\"TAVILY_API_KEY\")\n77:     )\n... (showing lines 28-77 of 123; use offset=78 to continue)", "is_error": false, "diff": ""}
