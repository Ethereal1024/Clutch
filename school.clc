{"type": "tool_result", "timestamp": 1789870243.6236851, "id": "4b2cdb2b69c5", "tool_call_id": "call_60e2c8daca5c47039250bece", "content": "100:         self, msgs: list[dict[str, Any]]\n101:     ) -> tuple[str, list[dict[str, Any]], str, str]:\n102:         \"\"\"Stream one LLM turn; emits incremental reasoning/text events.\n103: \n104:         Returns (content, tool_calls, finish_reason, reasoning). tool_calls\n105:         entries are [{id, name, arguments(raw json string)}].\n106:         \"\"\"\n107:         content_parts: list[str] = []\n108:         reasoning_parts: list[str] = []\n109:         tool_accum: dict[int, dict[str, Any]] = {}\n110:         finish_reason = \"stop\"\n111: \n112:         try:\n113:             for ev in self.llm.stream(msgs, tools=self.registry.schemas()):\n114:                 # abort mid-stream: check the cancel flag between chunks\n115:                 if self.cancel and self.cancel.is_set():\n116:                     break\n117:                 t = ev[\"type\"]\n118:                 if t == \"reasoning\":\n119:                     reasoning_parts.append(ev[\"delta\"])\n120:                     self._emit(ReasoningDeltaEvent(content=ev[\"delta\"]))\n121:                 elif t == \"text\":\n122:                     content_parts.append(ev[\"delta\"])\n123:                     # incremental text: the UI accumulates + re-renders markdown\n124:                     self._emit(TextDeltaEvent(content=ev[\"delta\"]))\n125:                 elif t == \"tool_call_start\":\n126:                     tool_accum.setdefault(ev[\"index\"], {\"id\": ev[\"id\"], \"name\": ev[\"name\"], \"args\": \"\"})\n127:                     # live tool-call row: name arrives first, args stream after\n128:                     self._emit(ToolCallDeltaEvent(tool_call_id=ev[\"id\"], name=ev[\"name\"], delta=\"\"))\n129:                 elif t == \"tool_call_delta\":\n130:                     entry = tool_accum.setdefault(ev[\"index\"], {\"id\": \"\", \"name\": \"\", \"args\": \"\"})\n131:                     entry[\"args\"] += ev[\"delta\"]\n132:                     # stream args so the UI shows the call as it is generated\n133:                     self._emit(ToolCallDeltaEvent(tool_call_id=entry[\"id\"], name=\"\", delta=ev[\"delta\"]))\n134:                 elif t == \"retry\":\n135:                     # transient notice: a stream attempt failed before its first\n136:                     # token (network drop / read timeout) and the client is\n137:                     # reconnecting with backoff — live UI display only, never\n138:                     # durable; the next delta means the retry landed\n139:                     self._emit(\n140:                         LlmRetryEvent(\n141:                             attempt=ev.get(\"attempt\", 0),\n142:                             max_retries=ev.get(\"max\", 0),\n143:                             message=ev.get(\"message\", \"\"),\n144:                         )\n145:                     )\n146:                 elif t == \"finish\":\n147:                     finish_reason = ev[\"reason\"]\n148:                     content = \"\".join(content_parts)\n149:                     tool_calls = [\n150:                         {\"id\": e[\"id\"], \"name\": e[\"name\"], \"arguments\": e[\"args\"]} for e in tool_accum.values()\n151:                     ]\n152:                     return content, tool_calls, finish_reason, \"\".join(reasoning_parts)\n153:         except LlmError as e:\n154:             if e.code == \"context_window_exceeded\":\n155:                 raise agent_errors.context_window_error(e.message) from e\n156:             raise agent_errors.AgentError(code=e.code, message=e.message) from e\n157:         # any non-LlmError here is a genuine bug; let it propagate\n158:         return \"\".join(content_parts), [], finish_reason, \"\".join(reasoning_parts)\n159: \n... (showing lines 100-159 of 295; use offset=160 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789870243.6284447, "id": "05d0bebc55c5", "tool_call_id": "call_fb165aaafa984cdd812e2421", "content": "265: \n266:                 # ---- no tool call: natural finish (an empty reply is not one) ----\n267:                 self._emit(AssistantMessageEvent(content=content, reasoning=reasoning))\n268:                 if not content.strip():\n269:                     # empty reply is NOT a completion: feed it back as an error\n270:                     self._emit(UserMessageEvent(content=render(\"empty_response.md\")))\n271:                     continue\n272:                 return self._finish(\"completed\", content)\n273:         except agent_errors.AgentError as e:\n274:             # fatal LLM/context failures terminate gracefully\n275:             return self._finish(\"error\", str(e))\n276: \n277:     def _execute_tool(self, ev: ToolCallEvent) -> dict[str, Any]:\n278:         \"\"\"Parse args, check permission, then run the tool; denials feed an error back.\"\"\"\n279:         try:\n280:             args = parse_arguments(ev.arguments)\n281:         except ParseError as e:\n282:             return {\"content\": f\"ERROR: {e.message}\", \"error\": True}\n283:         args_repr = ev.arguments\n284:         if self.gate is not None:\n285:             try:\n286:                 self.gate.require(ev.name, args_repr, self.workspace)\n287:             except PermissionRequired as e:\n288:                 return {\"content\": f\"ERROR: {e.reason}\", \"error\": True}\n289:         try:\n290:             # Stop reaches the tool: run_command polls this event while its\n291:             # command is in flight and kills the tree the moment it is set\n292:             return self.registry.execute(self.workspace, self.config, ev.name, args, cancel=self.cancel)\n293:         finally:\n294:             # a user-approved escape is scoped to the one call it was granted for\n295:             self.workspace.clear_allowed()", "is_error": false, "diff": ""}
