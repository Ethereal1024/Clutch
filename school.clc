\\n    name.style.maxWidth = \\\"150px\\\";\\n    const url = inputRow(\\\"http://localhost:port/mcp\\\", rec.url);\\n    const status = document.createElement(\\\"span\\\");\\n    status.className = \\\"dim\\\";\\n    const del = document.createElement(\\\"button\\\");\\n    del.type = \\\"button\\\";\\n    del.title = \\\"remove this service\\\";\\n    del.textContent = \\\"✕\\\";\\n    del.addEventListener(\\\"click\\\", () => wrap.remove());\\n    top.append(name, url, status, del);\\n\\n    const tools = document.createElement(\\\"div\\\");\\n    tools.className = \\\"fs-conn-row\\\";\\n    tools.append(inputRow(\\\"search tool name\\\", rec.search_tool), inputRow(\\\"status tool (optional)\\\", rec.status_tool));\\n\\n    wrap.append(top, tools);\\n    return wrap;\\n  }\\n\\n  function render(services) {\\n    box.textContent = \\\"\\\";\\n    records = services || [];\\n    const title = document.createElement(\\\"label\\\");\\n    title.textContent = \\\"Web services (optional)\\\";\\n    title.style.marginTop = \\\"16px\\\";\\n    box.appendChild(title);\\n    for (const rec of records) box.appendChild(rowFor(rec));\\n\\n    const addRow = document.createElement(\\\"div\\\");\\n    addRow.className = \\\"fs-conn-row\\\";\\n    const add = document.createElement(\\\"button\\\");\\n    add.type = \\\"button\\\";\\n    add.textContent = \\\"＋ Add service\\\";\\n    add.addEventListener(\\\"click\\\", () => {\\n      box.insertBefore(rowFor({}), addRow);\\n      refreshStatus();\\n    });\\n    addRow.appendChild(add);\\n    box.appendChild(addRow);\\n\\n    const actions = document.createElement(\\\"div\\\");\\n    actions.className = \\\"fs-conn-row\\\";\\n    const save = document.createElement(\\\"button\\\");\\n    save.id = \\\"mcp-services-save\\\";\\n    save.className = \\\"primary\\\";\\n    save.textContent = \\\"Save web services\\\";\\n    const hint = document.createElement(\\\"span\\\");\\n    hint.className = \\\"dim\\\";\\n    actions.append(save, hint);\\n    box.appendChild(actions);\\n\\n    save.addEventListener(\\\"click\\\", async () => {\\n      const payload = [];\\n      let bad = \\\"\\\";\\n      box.querySelectorAll(\\\".mcp-service\\\").forEach((wrap) => {\\n        const inputs = wrap.querySelectorAll(\\\"input\\\");\\n        const name = inputs[0].value.trim();\\n        if (!/^[a-z0-9][a-z0-9_-]{0,63}$/.test(name)) {\\n          bad = \\\"each service needs a name matching a-z 0-9 -\\\";\\n          return;\\n        }\\n        // the stored record keeps the fields this form does not show (label,\\n        // args, field mappings, list_key) so a save never silently drops them\\n        const base = JSON.parse(wrap.dataset.rec || \\\"{}\\\");\\n        payload.push({\\n          ...base,\\n          name,\\n          url: inputs[1].value.trim().replace(/\\\\/+$/, \\\"\\\"),\\n          search_tool: inputs[2].value.trim(),\\n          status_tool: inputs[3].value.trim(),\\n        });\\n      });\\n      if (bad) {\\n        hint.textContent = bad;\\n        return;\\n      }\\n      try {\\n        await apiFetch(\\\"/api/settings\\\", { method: \\\"POST\\\", body: { mcp_services: payload } });\\n        records = payload;\\n        hint.textContent = \\\"saved\\\";\\n        refreshStatus();\\n      } catch (e) {\\n        hint.textContent = \\\"save failed: \\\" + ((e && e.message) || e);\\n      }\\n    });\\n  }\\n\\n  async function refreshStatus() {\\n    try {\\n      const st = await apiFetch(\\\"/api/mcp_status\\\");\\n      const byName = {};\\n      for (const row of (st && st.services) || []) byName[row.name] = row;\\n      box.querySelectorAll(\\\".mcp-service\\\").forEach((wrap) => {\\n        const name = wrap.querySelector(\\\"input\\\").value.trim();\\n        const el = wrap.querySelector(\\\".dim\\\");\\n        if (el) el.textContent = statusText(byName[name]);\\n      });\\n    } catch (e) {\\n      /* status is best-effort */\\n    }\\n  }\\n\\n  // (re)render every time the settings modal opens, so values stay fresh\\n  $(\\\"#settings-btn\\\").addEventListener(\\\"click\\\", async () => {\\n    try {\\n      const s = await apiFetch(\\\"/api/settings\\\");\\n      render(s.mcp_services || []);\\n      refreshStatus();\\n    } catch (e) {\\n      /* settings API down: the section stays empty */\\n    }\\n  });\\n})();\",\"old_string\":\"// ---- MCP web services (settings modal section) -------------------------------\\n// Rendered from GET /api/settings mcp_providers metadata: a host without a\\n// service configured just sees an empty optional row — nothing here prompts\\n// anyone to install anything.\\n(function initMcpServices() {\\n  const box = document.getElementById(\\\"mcp-services\\\");\\n  if (!box) return;\\n\\n  function render(providers, statusByProvider) {\\n    box.textContent = \\\"\\\";\\n    if (!providers.length) return;\\n    const title = document.createElement(\\\"label\\\");\\n    title.textContent = \\\"Web services (optional)\\\";\\n    title.style.marginTop = \\\"16px\\\";\\n    box.appendChild(title);\\n    for (const p of providers) {\\n      const row = document.createElement(\\\"div\\\");\\n      row.className = \\\"fs-conn-row\\\";\\n      row.style.marginBottom = \\\"8px\\\";\\n      const input = document.createElement(\\\"input\\\");\\n      input.id = \\\"mcp-input-\\\" + p.key;\\n      input.type = \\\"text\\\";\\n      input.autocomplete = \\\"off\\\";\\n      input.placeholder = p.placeholder || \\\"http://localhost:port/mcp\\\";\\n      input.value = p.value || \\\"\\\";\\n      const status = document.createElement(\\\"span\\\");\\n      status.className = \\\"dim\\\";\\n      status.dataset.mcpStatus = p.key;\\n      const st = statusByProvider[p.key];\\n      status.textContent =\\n        st === undefined ? \\\"\\\" :\\n        !st.configured ? \\\"\\\" :\\n        st.reachable === false ? \\\"unreachable\\\" :\\n        st.login === true ? \\\"connected · logged in\\\" :\\n        st.login === false ? \\\"connected · not logged in\\\" :\\n        \\\"connected\\\";\\n      row.append(input, status);\\n      box.appendChild(row);\\n    }\\n    const actions = document.createElement(\\\"div\\\");\\n    actions.className = \\\"fs-conn-row\\\";\\n    const save = document.createElement(\\\"button\\\");\\n    save.id = \\\"mcp-services-save\\\";\\n    save.className = \\\"primary\\\";\\n    save.textContent = \\\"Save web services\\\";\\n    const hint = document.createElement(\\\"span\\\");\\n    hint.className = \\\"dim\\\";\\n    actions.append(save, hint);\\n    box.appendChild(actions);\\n\\n    save.addEventListener(\\\"click\\\", async () => {\\n      const payload = {};\\n      for (const p of providers) {\\n        const el = document.getElementById(\\\"mcp-input-\\\" + p.key);\\n        if (el) payload[p.key] = el.value.trim();\\n      }\\n      try {\\n        await apiFetch(\\\"/api/settings\\\", { method: \\\"POST\\\", body: payload });\\n        hint.textContent = \\\"saved\\\";\\n        refreshStatus();\\n      } catch (e) {\\n        hint.textContent = \\\"save failed: \\\" + ((e && e.message) || e);\\n      }\\n    });\\n  }\\n\\n  async function refreshStatus() {\\n    try {\\n      const st = await apiFetch(\\\"/api/mcp_status\\\");\\n      const byKey = {};\\n      for (const row of (st && st.providers) || []) byKey[\\\"mcp_\\\" + row.name] = row;\\n      box.querySelectorAll(\\\"[data-mcp-status]\\\").forEach((el) => {\\n        const row = byKey[el.dataset.mcpStatus];\\n        el.textContent =\\n          !row || !row.configured ? \\\"\\\" :\\n          row.reachable === false ? \\\"unreachable\\\" :\\n          row.login === true ? \\\"connected · logged in\\\" :\\n          row.login === false ? \\\"connected · not logged in\\\" :\\n          \\\"connected\\\";\\n      });\\n    } catch (e) {\\n      /* status is best-effort */\\n    }\\n  }\\n\\n  // (re)render every time the settings modal opens, so values stay fresh\\n  $(\\\"#settings-btn\\\").addEventListener(\\\"click\\\", async () => {\\n    try {\\n      const s = await apiFetch(\\\"/api/settings\\\");\\n      render(s.mcp_providers || [], {});\\n      refreshStatus();\\n    } catch (e) {\\n      /* settings API down: the section stays empty */\\n    }\\n  });\\n})();\",\"path\":\"ui/app.js\"}", "tool_call_id": "call_93ba27fd531b4ac3a7713b38"}
{"type": "tool_result", "timestamp": 1789816110.4767818, "id": "c6761a6b4f4a", "tool_call_id": "call_93ba27fd531b4ac3a7713b38", "content": "OK: edited C:\\Users\\12741\\Desktop\\临时文件\\Clutch\\ui\\app.js (+105 -46 lines)", "is_error": false, "diff": "--- a/ui\\app.js\n+++ b/ui\\app.js\n@@ -2810,45 +2810,88 @@\n   connectSSE();\n })();\n \n-// ---- MCP web services (settings modal section) -------------------------------\n-// Rendered from GET /api/settings mcp_providers metadata: a host without a\n-// service configured just sees an empty optional row — nothing here prompts\n-// anyone to install anything.\n+// ---- MCP web services (settings modal section) --------------------------------\n+// Rendered from GET /api/settings mcp_services records: a host without a\n+// service configured just sees the add button — nothing here prompts anyone to\n+// install anything, and no service name exists anywhere unless this machine's\n+// operator declared it. Rows edit the common fields (name, endpoint, tools);\n+// exotic mappings (args / field templates / list_key) round-trip untouched and\n+// are documented for hand-editing in settings.json.\n (function initMcpServices() {\n   const box = document.getElementById(\"mcp-services\");\n   if (!box) return;\n \n-  function render(providers, statusByProvider) {\n+  let records = []; // last loaded records; a save round-trips fields the form does not show\n+\n+  function statusText(st) {\n+    if (!st || !st.configured) return \"\";\n+    if (st.enabled === false) return \"disabled\";\n+    if (st.reachable === false) return \"unreachable\";\n+    if (st.login === true) return \"connected · logged in\";\n+    if (st.login === false) return \"connected · not logged in\";\n+    return \"connected\";\n+  }\n+\n+  function inputRow(placeholder, value) {\n+    const input = document.createElement(\"input\");\n+    input.type = \"text\";\n+    input.autocomplete = \"off\";\n+    input.placeholder = placeholder;\n+    input.value = value || \"\";\n+    return input;\n+  }\n+\n+  function rowFor(rec) {\n+    rec = rec || {};\n+    const wrap = document.createElement(\"div\");\n+    wrap.className = \"mcp-service\";\n+    wrap.style.marginBottom = \"10px\";\n+    wrap.dataset.rec = JSON.stringify(rec);\n+\n+    const top = document.createElement(\"div\");\n+    top.className = \"fs-conn-row\";\n+    top.style.marginBottom = \"4px\";\n+    const name = inputRow(\"name (a-z 0-9 -)\", rec.name);\n+    name.style.maxWidth = \"150px\";\n+    const url = inputRow(\"http://localhost:port/mcp\", rec.url);\n+    const status = document.createElement(\"span\");\n+    status.className = \"dim\";\n+    const del = document.createElement(\"button\");\n+    del.type = \"button\";\n+    del.title = \"remove this service\";\n+    del.textContent = \"✕\";\n+    del.addEventListener(\"click\", () => wrap.remove());\n+    top.append(name, url, status, del);\n+\n+    const tools = document.createElement(\"div\");\n+    tools.className = \"fs-conn-row\";\n+    tools.append(inputRow(\"search tool name\", rec.search_tool), inputRow(\"status tool (optional)\", rec.status_tool));\n+\n+    wrap.append(top, tools);\n+    return wrap;\n+  }\n+\n+  function render(services) {\n     box.textContent = \"\";\n-    if (!providers.length) return;\n+    records = services || [];\n     const title = document.createElement(\"label\");\n     title.textContent = \"Web services (optional)\";\n     title.style.marginTop = \"16px\";\n     box.appendChild(title);\n-    for (const p of providers) {\n-      const row = document.createElement(\"div\");\n-      row.className = \"fs-conn-row\";\n-      row.style.marginBottom = \"8px\";\n-      const input = document.createElement(\"input\");\n-      input.id = \"mcp-input-\" + p.key;\n-      input.type = \"text\";\n-      input.autocomplete = \"off\";\n-      input.placeholder = p.placeholder || \"http://localhost:port/mcp\";\n-      input.value = p.value || \"\";\n-      const status = document.createElement(\"span\");\n-      status.className = \"dim\";\n-      status.dataset.mcpStatus = p.key;\n-      const st = statusByProvider[p.key];\n-      status.textContent =\n-        st === undefined ? \"\" :\n-        !st.configured ? \"\" :\n-        st.reachable === false ? \"unreachable\" :\n-        st.login === true ? \"connected · logged in\" :\n-        st.login === false ? \"connected · not logged in\" :\n-        \"connected\";\n-      row.append(input, status);\n-      box.appendChild(row);\n-    }\n+    for (const rec of records) box.appendChild(rowFor(rec));\n+\n+    const addRow = document.createElement(\"div\");\n+    addRow.className = \"fs-conn-row\";\n+    const add = document.createElement(\"button\");\n+    add.type = \"button\";\n+    add.textContent = \"＋ Add service\";\n+    add.addEventListener(\"click\", () => {\n+      box.insertBefore(rowFor({}), addRow);\n+      refreshStatus();\n+    });\n+    addRow.appendChild(add);\n+    box.appendChild(addRow);\n+\n     const actions = document.createElement(\"div\");\n     actions.className = \"fs-conn-row\";\n     const save = document.createElement(\"button\");\n@@ -2861,13 +2904,33 @@\n     box.appendChild(actions);\n \n     save.addEventListener(\"click\", async () => {\n-      const payload = {};\n-      for (const p of providers) {\n-        const el = document.getElementById(\"mcp-input-\" + p.key);\n-        if (el) payload[p.key] = el.value.trim();\n+      const payload = [];\n+      let bad = \"\";\n+      box.querySelectorAll(\".mcp-service\").forEach((wrap) => {\n+        const inputs = wrap.querySelectorAll(\"input\");\n+        const name = inputs[0].value.trim();\n+        if (!/^[a-z0-9][a-z0-9_-]{0,63}$/.test(name)) {\n+          bad = \"each service needs a name matching a-z 0-9 -\";\n+          return;\n+        }\n+        // the stored record keeps the fields this form does not show (label,\n+        // args, field mappings, list_key) so a save never silently drops them\n+        const base = JSON.parse(wrap.dataset.rec || \"{}\");\n+        payload.push({\n+          ...base,\n+          name,\n+          url: inputs[1].value.trim().replace(/\\/+$/, \"\"),\n+          search_tool: inputs[2].value.trim(),\n+          status_tool: inputs[3].value.trim(),\n+        });\n+      });\n+      if (bad) {\n+        hint.textContent = bad;\n+        return;\n       }\n       try {\n-        await apiFetch(\"/api/settings\", { method: \"POST\", body: payload });\n+        await apiFetch(\"/api/settings\", { method: \"POST\", body: { mcp_services: payload } });\n+        records = payload;\n         hint.textContent = \"saved\";\n         refreshStatus();\n       } catch (e) {\n@@ -2879,16 +2942,12 @@\n   async function refreshStatus() {\n     try {\n       const st = await apiFetch(\"/api/mcp_status\");\n-      const byKey = {};\n-      for (const row of (st && st.providers) || []) byKey[\"mcp_\" + row.name] = row;\n-      box.querySelectorAll(\"[data-mcp-status]\").forEach((el) => {\n-        const row = byKey[el.dataset.mcpStatus];\n-        el.textContent =\n-          !row || !row.configured ? \"\" :\n-          row.reachable === false ? \"unreachable\" :\n-          row.login === true ? \"connected · logged in\" :\n-          row.login === false ? \"connected · not logged in\" :\n-          \"connected\";\n+      const byName = {};\n+      for (const row of (st && st.services) || []) byName[row.name] = row;\n+      box.querySelectorAll(\".mcp-service\").forEach((wrap) => {\n+        const name = wrap.querySelector(\"input\").value.trim();\n+        const el = wrap.querySelector(\".dim\");\n+        if (el) el.textContent = statusText(byName[name]);\n       });\n     } catch (e) {\n       /* status is best-effort */\n@@ -2899,7 +2958,7 @@\n   $(\"#settings-btn\").addEventListener(\"click\", async () => {\n     try {\n       const s = await apiFetch(\"/api/settings\");\n-      render(s.mcp_providers || [], {});\n+      render(s.mcp_services || []);\n       refreshStatus();\n     } catch (e) {\n       /* settings API down: the section stays empty */\n"}
{"type": "assistant_message", "timestamp": 1789816213.1810737, "id": "b6b4fc7507fc", "content": "UI 完成。重写测试为新模型（引擎单元 + 预设迁移 + JSON-RPC 环回 + 门控 + 端到端 + 动态渲染）：", "tool_calls": [{"id": "call_e1dddf4b4a1a40b49dc5741e", "name": "write_file", "arguments": "{\"path\":\"tests/mcpbackend_test.py\",\"content\":\"\\\"\\\"\\\"Offline checks for the declarative MCP web-search layer (loopback HTTP only).\\n\\nRun: python -m tests.mcpbackend_test\\n\\nCovers: the record engine (parse, args templates, result mapping incl. url\\ntemplates with fallback chains), preset-driven migration of legacy mcp_<name>\\nsettings keys, the JSON-RPC client (handshake, session id, SSE frames,\\nplain-text and error paths) against a real loopback server, backend gating (a\\nservice exists only where it is declared — and is named nowhere otherwise),\\nerror-as-data degradation, and dynamic rendering of prompt + schema.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport json\\nimport threading\\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\\n\\nimport agent.tools.websearch as ws\\nfrom agent.config import Config\\nfrom agent.server import _mcp_keys_from, _services_from\\nfrom agent.tools.mcpprovider import (\\n    normalize_login,\\n    parse_service,\\n    parse_services,\\n    presets,\\n    service_records,\\n)\\nfrom agent.tools.registry import build_default_tools\\nfrom tests.testsupport import check\\n\\n\\n# A generic declarative record used across the engine checks. No real service\\n# is needed to test the machinery: the engine only sees shapes, not names.\\nNOTES = {\\n    \\\"name\\\": \\\"notes\\\",\\n    \\\"url\\\": \\\"http://localhost:18060/mcp\\\",\\n    \\\"search_tool\\\": \\\"search_notes\\\",\\n    \\\"args\\\": {\\\"keyword\\\": \\\"{query}\\\", \\\"limit\\\": \\\"{limit}\\\"},\\n    \\\"fields\\\": {\\\"url\\\": \\\"https://notes.example/n/{id}?t={token}\\\", \\\"snippet\\\": \\\"desc | description\\\"},\\n    \\\"status_tool\\\": \\\"whoami\\\",\\n    \\\"login_field\\\": \\\"logged_in\\\",\\n}\\n\\n\\nclass _Handler(BaseHTTPRequestHandler):\\n    \\\"\\\"\\\"Scripted MCP server: initialize -> initialized -> tools/call.\\\"\\\"\\\"\\n\\n    behavior = \\\"json\\\"  # json | sse | text | error | rpcerror | empty\\n\\n    def log_message(self, *a):  # silence the test run\\n        pass\\n\\n    def do_POST(self):  # noqa: N802 (stdlib naming)\\n        length = int(self.headers.get(\\\"Content-Length\\\", 0))\\n        body = json.loads(self.rfile.read(length) or b\\\"{}\\\")\\n        method = body.get(\\\"method\\\", \\\"\\\")\\n\\n        if method == \\\"initialize\\\":\\n            payload = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 1, \\\"result\\\": {\\\"protocolVersion\\\": ws._MCP_PROTO}}\\n            self.send_response(200)\\n            self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n            self.send_header(\\\"Mcp-Session-Id\\\", \\\"sess-42\\\")\\n            self.end_headers()\\n            self.wfile.write(json.dumps(payload).encode())\\n            return\\n\\n        if method == \\\"notifications/initialized\\\":\\n            self.send_response(202)\\n            self.end_headers()\\n            return\\n\\n        call = self.path.strip(\\\"/\\\") or _Handler.behavior\\n        if call == \\\"error\\\":\\n            self.send_response(500)\\n            self.end_headers()\\n            self.wfile.write(b\\\"boom\\\")\\n            return\\n        if call == \\\"rpcerror\\\":\\n            payload = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 2, \\\"error\\\": {\\\"code\\\": -32602, \\\"message\\\": \\\"bad params\\\"}}\\n        elif call == \\\"text\\\":\\n            payload = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 2, \\\"result\\\": {\\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"just words\\\"}]}}\\n        elif call == \\\"empty\\\":\\n            self.send_response(202)\\n            self.end_headers()\\n            return\\n        else:\\n            rows = json.dumps([{\\\"id\\\": \\\"abc\\\", \\\"title\\\": \\\"Note\\\", \\\"desc\\\": \\\"d\\\", \\\"xsec_token\\\": \\\"T\\\"}])\\n            payload = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 2, \\\"result\\\": {\\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": rows}]}}\\n        text = json.dumps(payload)\\n        if call == \\\"sse\\\":\\n            self.send_response(200)\\n            self.send_header(\\\"Content-Type\\\", \\\"text/event-stream\\\")\\n            self.end_headers()\\n            self.wfile.write(f\\\"event: message\\\\ndata: {text}\\\\n\\\\n\\\".encode())\\n            return\\n        self.send_response(200)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.end_headers()\\n        self.wfile.write(text.encode())\\n\\n\\ndef test_engine() -> None:\\n    \\\"\\\"\\\"Record parsing, call-side templates, read-side mapping.\\\"\\\"\\\"\\n    svc = parse_service(NOTES)\\n    check(svc.complete(), \\\"endpoint + search tool make a record complete\\\")\\n    check(parse_service(svc.record()) == svc, \\\"record() round-trips through parse\\\")\\n    check(svc.fields[\\\"title\\\"] == \\\"title | name\\\", \\\"unset field mappings get the defaults\\\")\\n\\n    args = parse_service({**NOTES, \\\"args\\\": {}})  # defaults: no args templates\\n    check(search_args := __import__(\\\"agent.tools.mcpprovider\\\", fromlist=[\\\"search_args\\\"]).search_args, \\\"import ok\\\")  # noqa: F401\\n\\n    from agent.tools.mcpprovider import search_args\\n\\n    check(search_args(svc, \\\"q\\\", 3) == {\\\"keyword\\\": \\\"q\\\", \\\"limit\\\": 3}, \\\"templates build the tools/call args\\\")\\n    check(isinstance(search_args(svc, \\\"q\\\", 3)[\\\"limit\\\"], int), \\\"a lone placeholder keeps the value's type\\\")\\n    mixed = parse_service({**NOTES, \\\"args\\\": {\\\"q\\\": \\\"page-{limit}\\\"}})\\n    check(search_args(mixed, \\\"q\\\", 3) == {\\\"q\\\": \\\"page-3\\\"}, \\\"mixed text interpolates into a string\\\")\\n\\n    rows = [\\n        {\\\"id\\\": \\\"n1\\\", \\\"title\\\": \\\"Found\\\", \\\"desc\\\": \\\"body\\\", \\\"token\\\": \\\"a b/c\\\"},\\n        {\\\"note_id\\\": \\\"n2\\\", \\\"title\\\": \\\"Second\\\", \\\"desc\\\": \\\"d2\\\"},\\n        {\\\"title\\\": \\\"no id at all\\\"},\\n        \\\"junk\\\",\\n    ]\\n    mapped = ws.map_results(svc, rows) if hasattr(ws, \\\"map_results\\\") else None\\n    from agent.tools.mcpprovider import map_results\\n\\n    mapped = map_results(svc, rows)\\n    check(len(mapped) == 3, \\\"rows survive unless their url mapping yields ''\\\")\\n    check(\\n        mapped[0][\\\"url\\\"] == \\\"https://notes.example/n/n1?t=a%20b%2Fc\\\",\\n        \\\"url templates fill and percent-encode payload\\\",\\n    )\\n    check(mapped[1][\\\"url\\\"] == \\\"https://notes.example/n/n2?t=\\\", \\\"empty placeholders fill, the row stays\\\")\\n    check(mapped[0][\\\"snippet\\\"] == \\\"body\\\" and mapped[0][\\\"title\\\"] == \\\"Found\\\", \\\"field chains read the row\\\")\\n\\n    # template placeholders take the same chains as field mappings\\n    chained = parse_service({**NOTES, \\\"fields\\\": {\\\"url\\\": \\\"https://notes.example/n/{id | note_id}\\\"}})\\n    check(map_results(chained, rows)[0][\\\"url\\\"] == \\\"https://notes.example/n/n1\\\", \\\"chains try alternatives in order\\\")\\n    check(map_results(chained, rows)[1][\\\"url\\\"] == \\\"https://notes.example/n/n2\\\", \\\"chain fallback hits the second name\\\")\\n\\n    check(map_results(svc, {\\\"data\\\": rows}) == mapped, \\\"auto-unwrap lifts a common envelope\\\")\\n    check(map_results(svc, {\\\"nope\\\": 1}) == [], \\\"unknown shapes map to nothing\\\")\\n    check(map_results(svc, [[1, 2]]) == [], \\\"non-object rows are ignored\\\")\\n\\n    plain_url = parse_service({**NOTES, \\\"fields\\\": {\\\"url\\\": \\\"href\\\"}})\\n    check(map_results(plain_url, [{\\\"href\\\": \\\"https://x.example/a\\\"}])[0][\\\"url\\\"] == \\\"https://x.example/a\\\",\\n          \\\"a non-template url mapping is a field chain\\\")\\n\\n    services, errors = parse_services([NOTES, NOTES, \\\"junk\\\", {**NOTES, \\\"name\\\": \\\"Bad Name\\\"}])\\n    check(len(services) == 1 and len(errors) == 2, \\\"broken records are skipped and reported\\\")\\n    check(parse_services(None) == ([], []), \\\"no services configured is not an error\\\")\\n\\n    draft = parse_service({**NOTES, \\\"url\\\": \\\"\\\", \\\"search_tool\\\": \\\"\\\"})\\n    check(not draft.complete(), \\\"a record without endpoint/tool stays incomplete\\\")\\n    off = parse_service({**NOTES, \\\"enabled\\\": \\\"false\\\"})\\n    check(not off.enabled, \\\"enabled parses falsey spellings\\\")\\n\\n\\ndef test_presets_and_migration() -> None:\\n    \\\"\\\"\\\"Legacy mcp_<name> URL keys fold into mcp_services through preset data.\\\"\\\"\\\"\\n    table = presets()\\n    check(isinstance(table, dict), \\\"presets() is a name -> record table (or empty)\\\")\\n    if \\\"xiaohongshu\\\" not in table:\\n        check(True, \\\"preset data file absent/emptied: migration checks skipped (file is editable data)\\\")\\n        return\\n\\n    records = service_records({\\\"mcp_xiaohongshu\\\": \\\" http://localhost:18060/mcp/ \\\"})\\n    check(len(records) == 1 and records[0][\\\"url\\\"] == \\\"http://localhost:18060/mcp\\\",\\n          \\\"a legacy mcp_<name> key converts through its preset, url stripped\\\")\\n    svc = parse_service(records[0])\\n    check(svc.complete(), \\\"the converted record is a complete service\\\")\\n    mapped = svc.map_results_placeholder if False else None  # noqa: F841 (readability guard)\\n    from agent.tools.mcpprovider import map_results\\n\\n    out = map_results(svc, [{\\\"id\\\": \\\"abc\\\", \\\"title\\\": \\\"Note\\\", \\\"desc\\\": \\\"d\\\", \\\"xsec_token\\\": \\\"T0K\\\"}])\\n    check(\\n        out == [{\\\"title\\\": \\\"Note\\\", \\\"url\\\": \\\"https://www.xiaohongshu.com/explore/abc?xsec_token=T0K\\\", \\\"snippet\\\": \\\"d\\\"}],\\n        \\\"the preset record maps real-shaped rows through the generic engine\\\",\\n    )\\n    fallback = map_results(svc, [{\\\"note_id\\\": \\\"n2\\\", \\\"title\\\": \\\"Second\\\", \\\"description\\\": \\\"d2\\\"}])\\n    check(fallback[0][\\\"url\\\"] == \\\"https://www.xiaohongshu.com/explore/n2?xsec_token=\\\",\\n          \\\"the url template's chain falls back to note_id\\\")\\n\\n    declared = {\\\"name\\\": \\\"xiaohongshu\\\", \\\"url\\\": \\\"http://mine/mcp\\\", \\\"search_tool\\\": \\\"t\\\"}\\n    records = service_records({\\\"mcp_services\\\": [declared], \\\"mcp_xiaohongshu\\\": \\\"http://localhost:18060/mcp\\\"})\\n    check(len(records) == 1 and records[0][\\\"url\\\"] == \\\"http://mine/mcp\\\",\\n          \\\"a declared service wins over its legacy key\\\")\\n\\n    check(service_records({\\\"mcp_ghost\\\": \\\"http://x/mcp\\\"}) == [], \\\"preset-less legacy keys convert to nothing\\\")\\n    junk = service_records({\\\"mcp_services\\\": \\\"nope\\\", \\\"mcp_xiaohongshu\\\": \\\"http://h/mcp\\\"})\\n    check(len(junk) == 1, \\\"a junk mcp_services list degrades to the migrated record\\\")\\n\\n\\ndef test_server_helpers() -> None:\\n    \\\"\\\"\\\"Settings-side validation and legacy-key handling.\\\"\\\"\\\"\\n    check(_services_from({}) is None, \\\"no mcp_services in the body means untouched\\\")\\n    try:\\n        _services_from({\\\"mcp_services\\\": \\\"nope\\\"})\\n        check(False, \\\"non-list mcp_services rejected\\\")\\n    except ValueError:\\n        check(True, \\\"non-list mcp_services rejected\\\")\\n    try:\\n        _services_from({\\\"mcp_services\\\": [{**NOTES, \\\"name\\\": \\\"Bad Name\\\"}]})\\n        check(False, \\\"an invalid record fails the save\\\")\\n    except ValueError as e:\\n        check(\\\"name\\\" in str(e), \\\"an invalid record fails the save with the reason\\\")\\n    out = _services_from({\\\"mcp_services\\\": [NOTES]})\\n    check(out and out[0][\\\"fields\\\"][\\\"title\\\"] == \\\"title | name\\\", \\\"valid records save canonicalized\\\")\\n\\n    check(_mcp_keys_from({\\\"mcp_x\\\": \\\"http://h\\\", \\\"base_url\\\": \\\"b\\\"}) == {\\\"mcp_x\\\": \\\"http://h\\\"}, \\\"legacy keys read back\\\")\\n    check(normalize_login({\\\"logged_in\\\": True}, \\\"logged_in\\\") is True, \\\"login state read via the record's field\\\")\\n    check(normalize_login({\\\"status\\\": \\\"logged_in\\\"}) is True, \\\"login state normalized from common shapes\\\")\\n    check(normalize_login(\\\"yes\\\") is True and normalize_login({\\\"whatever\\\": 1}) is None and normalize_login(None) is None,\\n          \\\"unknown login shapes normalize to None\\\")\\n\\n\\ndef test_rpc_client(base: str) -> None:\\n    \\\"\\\"\\\"JSON-RPC over POST against the real loopback server.\\\"\\\"\\\"\\n    data = ws._mcp_call(base + \\\"/\\\", \\\"search_notes\\\", {\\\"keyword\\\": \\\"q\\\"}, 5.0)\\n    check(isinstance(data, list) and data[0][\\\"id\\\"] == \\\"abc\\\", \\\"tools/call result parses as json\\\")\\n\\n    _Handler.behavior = \\\"sse\\\"\\n    data = ws._mcp_call(base + \\\"/sse\\\", \\\"search_notes\\\", {}, 5.0)\\n    check(isinstance(data, list) and data[0][\\\"id\\\"] == \\\"abc\\\", \\\"SSE-framed reply handled\\\")\\n\\n    _Handler.behavior = \\\"text\\\"\\n    check(ws._mcp_call(base + \\\"/text\\\", \\\"t\\\", {}, 5.0) == \\\"just words\\\", \\\"non-json text passes through\\\")\\n\\n    _Handler.behavior = \\\"empty\\\"\\n    check(ws._mcp_call(base + \\\"/empty\\\", \\\"t\\\", {}, 5.0) == \\\"\\\", \\\"empty body (202) tolerated\\\")\\n\\n    _Handler.behavior = \\\"rpcerror\\\"\\n    try:\\n        ws._mcp_call(base + \\\"/rpcerror\\\", \\\"t\\\", {}, 5.0)\\n        check(False, \\\"jsonrpc error raises WebError\\\")\\n    except ws.WebError:\\n        check(True, \\\"jsonrpc error raises WebError\\\")\\n\\n    _Handler.behavior = \\\"error\\\"\\n    try:\\n        ws._mcp_call(base + \\\"/error\\\", \\\"t\\\", {}, 5.0)\\n        check(False, \\\"HTTP 500 raises WebError\\\")\\n    except ws.WebError as e:\\n        check(\\\"500\\\" in str(e), \\\"HTTP 500 raises a factual WebError\\\")\\n\\n    try:\\n        ws._mcp_call(\\\"http://127.0.0.1:1/mcp\\\", \\\"t\\\", {}, 1.0)\\n        check(False, \\\"refused connection raises WebError\\\")\\n    except ws.WebError as e:\\n        check(\\\"unreachable\\\" in str(e) or \\\"timed out\\\" in str(e), \\\"refused connection is a factual status\\\")\\n\\n\\ndef test_gating_and_chain() -> None:\\n    \\\"\\\"\\\"A service exists exactly where it is declared — and nowhere else.\\\"\\\"\\\"\\n    plain = Config()\\n    avail = ws.available_backends(plain)\\n    check(\\\"notes\\\" not in avail, \\\"undeclared service absent from the chain\\\")\\n    check(\\\"bing\\\" in avail and \\\"ddg\\\" in avail, \\\"keyless backends always available\\\")\\n\\n    r = ws.web_search(None, plain, \\\"q\\\", backend=\\\"notes\\\")\\n    check(r.get(\\\"error\\\") and \\\"available: \\\" in r[\\\"content\\\"], \\\"pinning an undeclared backend errors factually\\\")\\n    check(\\\"install\\\" not in r[\\\"content\\\"].lower(), \\\"error never suggests installing anything\\\")\\n    check(\\\"searxng\\\" not in r[\\\"content\\\"] and \\\"tavily\\\" not in r[\\\"content\\\"],\\n          \\\"unconfigured siblings are not named either\\\")\\n    r = ws.web_search(None, plain, \\\"q\\\", backend=\\\"nope\\\")\\n    check(r.get(\\\"error\\\") and \\\"available: \\\" in r[\\\"content\\\"], \\\"unknown backend lists only the real ones\\\")\\n\\n    cfg = Config()\\n    cfg.mcp_services = [NOTES]\\n    avail = ws.available_backends(cfg)\\n    check(\\\"notes\\\" in avail and avail[-1] == \\\"notes\\\", \\\"declared service joins the chain after the native backends\\\")\\n    check(\\\"notes\\\" not in ws.available_backends(Config(mcp_services=[{**NOTES, \\\"enabled\\\": False}])),\\n          \\\"a disabled service does not exist\\\")\\n    check(\\\"notes\\\" not in ws.available_backends(Config(mcp_services=[{**NOTES, \\\"url\\\": \\\"\\\"}])),\\n          \\\"an endpoint-less record does not exist\\\")\\n    check(\\\"notes\\\" in ws.available_backends(Config(mcp_services=[\\\"junk\\\", NOTES])),\\n          \\\"a broken sibling record never takes the healthy one down\\\")\\n\\n    real_rpc = ws._mcp_rpc\\n\\n    def fake_rpc(url, payload, session, timeout, cancel=None):\\n        if payload.get(\\\"method\\\") == \\\"initialize\\\":\\n            return {\\\"result\\\": {}}, \\\"sess-1\\\"\\n        if payload.get(\\\"method\\\") == \\\"notifications/initialized\\\":\\n            return {}, session\\n        rows_json = json.dumps([{\\\"id\\\": \\\"f1\\\", \\\"title\\\": \\\"Found\\\", \\\"desc\\\": \\\"snippet\\\", \\\"token\\\": \\\"tk\\\"}])\\n        return {\\\"result\\\": {\\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": rows_json}]}}, session\\n\\n    ws._mcp_rpc = fake_rpc\\n    try:\\n        r = ws.web_search(None, cfg, \\\"note\\\", backend=\\\"notes\\\")\\n        check(\\n            not r.get(\\\"error\\\") and \\\"Found\\\" in r[\\\"content\\\"] and \\\"t=tk\\\" in r[\\\"content\\\"],\\n            \\\"web_search serves mapped mcp results end to end\\\",\\n        )\\n\\n        def dead_rpc(*a, **k):\\n            raise ws.WebError(\\\"MCP server unreachable (refused): http://localhost:18060/mcp\\\")\\n\\n        ws._mcp_rpc = dead_rpc\\n        r = ws.web_search(None, cfg, \\\"note\\\", backend=\\\"notes\\\")\\n        check(r.get(\\\"error\\\") and \\\"unreachable\\\" in r[\\\"content\\\"], \\\"mcp failure degrades to error-as-data\\\")\\n    finally:\\n        ws._mcp_rpc = real_rpc\\n\\n    tools_plain = {t.name: t for t in build_default_tools(plain)}\\n    tools_cfg = {t.name: t for t in build_default_tools(cfg)}\\n    check(\\\"notes\\\" not in tools_plain[\\\"web_search\\\"].description,\\n          \\\"prompt on an undeclared host never names the service\\\")\\n    check(\\\"notes\\\" in tools_cfg[\\\"web_search\\\"].description,\\n          \\\"prompt on a configured host names the service\\\")\\n    check(\\\"bing | ddg\\\" in tools_plain[\\\"web_search\\\"].parameters[\\\"properties\\\"][\\\"backend\\\"][\\\"description\\\"],\\n          \\\"schema backend param lists the real chain\\\")\\n    check(\\\"notes\\\" in tools_cfg[\\\"web_search\\\"].parameters[\\\"properties\\\"][\\\"backend\\\"][\\\"description\\\"],\\n          \\\"schema backend param includes declared services\\\")\\n\\n\\ndef main() -> None:\\n    test_engine()\\n    test_presets_and_migration()\\n    test_server_helpers()\\n\\n    srv = HTTPServer((\\\"127.0.0.1\\\", 0), _Handler)\\n    threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    try:\\n        test_rpc_client(f\\\"http://127.0.0.1:{srv.server_port}\\\")\\n    finally:\\n        srv.shutdown()\\n        srv.server_close()\\n\\n    test_gating_and_chain()\\n    print(\\\"all passed\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}"}], "reasoning": "UI done. Now rewrite tests/mcpbackend_test.py for the new model. Full rewrite via write_file (it's a test file being redesigned).\n\nTest plan:\n\n```python\n\"\"\"Offline checks for the declarative MCP web-search layer (loopback HTTP only).\n\nRun: python -m tests.mcpbackend_test\n\nCovers: the declarative record engine (parse, args templates, result mapping\nincl. url templates with fallback chains), preset-driven migration of legacy\nmcp_<name> settings keys, the JSON-RPC client (handshake, session id, SSE\nframes, plain-text and error paths) against a real loopback server, backend\ngating (a service exists only when declared — and is named nowhere when it is\nnot), error-as-data degradation, and dynamic rendering of prompt + schema.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport threading\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\n\nimport agent.tools.websearch as ws\nfrom agent.config import Config\nfrom agent.server import _mcp_keys_from, _services_from\nfrom agent.tools.mcpprovider import normalize_login, parse_service, parse_services, presets, service_records\nfrom agent.tools.registry import build_default_tools\nfrom tests.testsupport import check\n\n# a generic declarative record used across the engine checks\nNOTES = {\n    \"name\": \"notes\",\n    \"url\": \"http://localhost:18060/mcp\",\n    \"search_tool\": \"search_notes\",\n    \"args\": {\"keyword\": \"{query}\", \"limit\": \"{limit}\"},\n    \"fields\": {\"url\": \"https://notes.example/n/{id}?t={token}\", \"snippet\": \"desc | description\"},\n    \"status_tool\": \"whoami\",\n    \"login_field\": \"logged_in\",\n}\n```\n\nHandler: same as before (serve rows [ {\"id\": \"abc\", ...} ]).\n\nmain():\n1. parse/args/mapping:\n   - svc = parse_service(NOTES); complete() True; record round-trip: parse_service(svc.record()) == svc? dataclass eq — fields dict equal ✔. check.\n   - search_args: {\"keyword\": \"q\", \"limit\": 3} — limit stays int (type preservation), keyword interpolated.\n   - search_args with mixed template \"page-{limit}\" → string.\n   - map_results: bare list, {\"data\": list} envelope, unknown shape → []; row without id dropped (url empty); note_id fallback via template chain {id | note_id}; percent-encoding of token (e.g. token \"a b/c\" → \"a%20b%2Fc\").\n   - parse_services: junk entries skipped with errors reported, duplicate names reported, healthy ones kept.\n   - incomplete service (no url or no search_tool) → complete() False.\n   - enabled=false parsing.\n\n2. presets + service_records:\n   - legacy conversion: service_records({\"mcp_xiaohongshu\": \" http://localhost:18060/mcp/ \"}) → [record with name xiaohongshu, url stripped]; parse_service of it succeeds; complete() True; map_results via its fields on a realistic row {\"id\":\"abc\",\"title\":\"Note\",\"desc\":\"d\",\"xsec_token\":\"T0K\"} → url \"https://www.xiaohongshu.com/explore/abc?xsec_token=T0K\"; note_id fallback row maps too.\n   - declared precedence: service_records({\"mcp_services\": [{\"name\": \"xiaohongshu\", \"url\": \"http://mine/mcp\", \"search_tool\": \"t\"}], \"mcp_xiaohongshu\": \"http://localhost:18060/mcp\"}) → 1 record, url http://mine/mcp.\n   - preset-less legacy key ignored: service_records({\"mcp_ghost\": \"http://x/mcp\"}) → [].\n   - junk mcp_services tolerated: service_records({\"mcp_services\": \"nope\", \"mcp_xiaohongshu\": \"http://h/mcp\"}) → preset record.\n   - presets() returns a dict containing... check isinstance dict and that values are dicts — do NOT assert which names (the file is operator-editable data; asserting \"xiaohongshu\" in presets() couples the test to data — but this repo SHIPS that data; asserting it exists is fine actually. Hmm — if the user deletes the file (sanctioned!), the test fails. Softer: if presets() is empty, skip migration checks? That makes the test data-dependent. I'll structure: `xhs_table = presets()`; if \"xiaohongshu\" in xhs_table → run migration checks; else skip (check(True, skip-note)). Reasonable for editable data. Actually for shipped repo the file exists; keep it simple and assert it exists, with a comment that the file is data. Hmm — \"shipping zero presets is acceptable\"... If a future release ships zero presets the test would fail. I'll do the conditional skip. Clean.\n\n3. server helpers:\n   - _services_from({}) → None.\n   - _services_from({\"mcp_services\": \"nope\"}) → ValueError.\n   - _services_from({\"mcp_services\": [dict(NOTES, name=\"Bad Name\")]}) → ValueError (invalid name).\n   - _services_from({\"mcp_services\": [NOTES]}) → [canonical record] — canonicalized: fields defaults filled. Check record[\"fields\"][\"title\"] == \"title | name\" (default applied), record[\"name\"] == \"notes\".\n   - _mcp_keys_from carry.\n   - normalize_login: {\"logged_in\": True} w/ login_field, unknown → None, \"yes\" → True, None → None.\n\n4. JSON-RPC client — same as old (uses ws._mcp_call).\n\n5. gating:\n   - plain Config() → no \"notes\"; bing/ddg present.\n   - web_search(None, plain, \"q\", backend=\"notes\") → error factual, no install advice, no sibling names.\n   - unknown backend \"nope\" error.\n   - cfg2 = Config(); cfg2.mcp_services = [NOTES] → \"notes\" in available_backends(cfg2).\n   - disabled/incomplete service absent: cfg3 with enabled False → absent; with search_tool \"\" → absent.\n\n6. end-to-end with fake_rpc:\n   - monkeypatch ws._mcp_rpc; web_search(None, cfg2, \"note\", backend=\"notes\") → contains \"Found\", url with token.\n   - dead rpc → error contains \"unreachable\".\n\n7. prompt/schema dynamic:\n   - tools_plain web_search description lacks \"notes\"; cfg2's description includes \"notes\".\n   - backend param description lists \"bing | ddg\" (plain) and \"bing | ddg | notes\"? order: native first then services → \"bing | ddg | notes\". check \"notes\" in it for cfg2.\n\nAlso check order: services join after native → available tuple ends with \"notes\" ✔ maybe check index.\n\nHandler rows: fake returns rows with id/title/desc/token. For the loopback _mcp_call test the default behavior returns rows JSON [{\"id\": \"abc\", \"title\": \"Note\", \"desc\": \"d\", \"xsec_token\": \"T\"}].\n\nOne thing: old test had `check(len(mcp_providers()) == 1, \"server helper exposes the registry\")` — removed (registry gone).\n\nAlso old test checked env CLUTCH_MCP_<NAME>_URL — dropped (env no longer supported). Maybe add a factual check that env does nothing now? A check that service_records ignores env: trivially true. Skip.\n\nNote: `from agent.server import _services_from` — importing agent.server imports lots (fine, old test did too).\n\nLet me also think about `parse_service` with NOTES record: fields override url + snippet; title default \"title | name\" applies. In NOTES I didn't set fields.title — check record()[\"fields\"][\"title\"] == \"title | name\" ✔.\n\nmap_results NOTES on row {\"id\": \"n1\", \"title\": \"Found\", \"desc\": \"d\", \"token\": \"tk\"} → url \"https://notes.example/n/n1?t=tk\" ✔. Row missing id → url \"https://notes.example/n/?t=tk\" — hmm! Not dropped (empty placeholder fills \"\"). So \"row without id\" is NOT dropped — url non-empty. My earlier decision: keep rows with degenerate urls. For the TEST, assert the note_id fallback works, and for a row missing BOTH id and note_id → url \"https://notes.example/n/?t=tk\" — assert it's kept (documenting the engine's choice)? That bakes in mediocre semantics... Better: make the ENGINE drop rows whose template has an unfilled placeholder? I earlier decided against (would drop token-less xhs rows). Hmm wait — with the xhs preset, token-less rows: {id | note_id} resolves, {xsec_token} empty → row dropped under strict semantics. Old behavior kept it. Real xhs feeds always include xsec_token (since 2024 API change, search results DO include it — that's why the old code kept the token). So strict semantics would be fine in practice for xhs... but for the generic \"notes\" service, \"t={token}\" with optional token — strict drops. Both semantics have costs. Current engine = permissive (fill empty). Keep permissive; the test documents: a row without the id just yields an address without the id (operator's data quality issue), and ONLY rows whose url mapping yields \"\" are dropped (e.g. non-template chain that resolves empty).\n\nHmm, wait. Actually let me reconsider once more: is permissive actually bad for xhs? Token-less row → \"https://...explore/n2?xsec_token=\" → clicking it: xiaohongshu likely redirects or errors, while WITHOUT the param it might work. Both unusable-without-token in practice. Fine. Permissive stays. Document in test.\n\nAlso percent-encoding check: token \"a b\" → \"a%20b\".\n\nLet me now also double check `search_args` type preservation: args {\"limit\": \"{limit}\"} with limit=3 → int 3 ✔ (fullmatch → values[...]). Mixed \"page-{limit}\" → \"page-3\".\n\nparse_services duplicate: two NOTES → services 1, errors 1 ✔.\n\nnormalize_login(state, login_field): from engine — dict {\"logged_in\": True} → True. Also server alias _login_state with login_field — test via engine function (server imports it as alias).\n\nNow the loopback handler: keep identical (it's server-side, no platform dependence). The default \"json\" branch rows: keep [{\"id\": \"abc\", \"title\": \"Note\", \"desc\": \"d\", \"xsec_token\": \"T\"}].\n\nWrite the file."}
{"type": "tool_call", "timestamp": 1789816213.181049, "id": "9c889d17c85d", "name": "write_file", "arguments": "{\"path\":\"tests/mcpbackend_test.py\",\"content\":\"\\\"\\\"\\\"Offline checks for the declarative MCP web-search layer (loopback HTTP only).\\n\\nRun: python -m tests.mcpbackend_test\\n\\nCovers: the record engine (parse, args templates, result mapping incl. url\\ntemplates with fallback chains), preset-driven migration of legacy mcp_<name>\\nsettings keys, the JSON-RPC client (handshake, session id, SSE frames,\\nplain-text and error paths) against a real loopback server, backend gating (a\\nservice exists only where it is declared — and is named nowhere otherwise),\\nerror-as-data degradation, and dynamic rendering of prompt + schema.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport json\\nimport threading\\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\\n\\nimport agent.tools.websearch as ws\\nfrom agent.config import Config\\nfrom agent.server import _mcp_keys_from, _services_from\\nfrom agent.tools.mcpprovider import (\\n    normalize_login,\\n    parse_service,\\n    parse_services,\\n    presets,\\n    service_records,\\n)\\nfrom agent.tools.registry import build_default_tools\\nfrom tests.testsupport import check\\n\\n\\n# A generic declarative record used across the engine checks. No real service\\n# is needed to test the machinery: the engine only sees shapes, not names.\\nNOTES = {\\n    \\\"name\\\": \\\"notes\\\",\\n    \\\"url\\\": \\\"http://localhost:18060/mcp\\\",\\n    \\\"search_tool\\\": \\\"search_notes\\\",\\n    \\\"args\\\": {\\\"keyword\\\": \\\"{query}\\\", \\\"limit\\\": \\\"{limit}\\\"},\\n    \\\"fields\\\": {\\\"url\\\": \\\"https://notes.example/n/{id}?t={token}\\\", \\\"snippet\\\": \\\"desc | description\\\"},\\n    \\\"status_tool\\\": \\\"whoami\\\",\\n    \\\"login_field\\\": \\\"logged_in\\\",\\n}\\n\\n\\nclass _Handler(BaseHTTPRequestHandler):\\n    \\\"\\\"\\\"Scripted MCP server: initialize -> initialized -> tools/call.\\\"\\\"\\\"\\n\\n    behavior = \\\"json\\\"  # json | sse | text | error | rpcerror | empty\\n\\n    def log_message(self, *a):  # silence the test run\\n        pass\\n\\n    def do_POST(self):  # noqa: N802 (stdlib naming)\\n        length = int(self.headers.get(\\\"Content-Length\\\", 0))\\n        body = json.loads(self.rfile.read(length) or b\\\"{}\\\")\\n        method = body.get(\\\"method\\\", \\\"\\\")\\n\\n        if method == \\\"initialize\\\":\\n            payload = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 1, \\\"result\\\": {\\\"protocolVersion\\\": ws._MCP_PROTO}}\\n            self.send_response(200)\\n            self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n            self.send_header(\\\"Mcp-Session-Id\\\", \\\"sess-42\\\")\\n            self.end_headers()\\n            self.wfile.write(json.dumps(payload).encode())\\n            return\\n\\n        if method == \\\"notifications/initialized\\\":\\n            self.send_response(202)\\n            self.end_headers()\\n            return\\n\\n        call = self.path.strip(\\\"/\\\") or _Handler.behavior\\n        if call == \\\"error\\\":\\n            self.send_response(500)\\n            self.end_headers()\\n            self.wfile.write(b\\\"boom\\\")\\n            return\\n        if call == \\\"rpcerror\\\":\\n            payload = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 2, \\\"error\\\": {\\\"code\\\": -32602, \\\"message\\\": \\\"bad params\\\"}}\\n        elif call == \\\"text\\\":\\n            payload = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 2, \\\"result\\\": {\\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"just words\\\"}]}}\\n        elif call == \\\"empty\\\":\\n            self.send_response(202)\\n            self.end_headers()\\n            return\\n        else:\\n            rows = json.dumps([{\\\"id\\\": \\\"abc\\\", \\\"title\\\": \\\"Note\\\", \\\"desc\\\": \\\"d\\\", \\\"xsec_token\\\": \\\"T\\\"}])\\n            payload = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 2, \\\"result\\\": {\\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": rows}]}}\\n        text = json.dumps(payload)\\n        if call == \\\"sse\\\":\\n            self.send_response(200)\\n            self.send_header(\\\"Content-Type\\\", \\\"text/event-stream\\\")\\n            self.end_headers()\\n            self.wfile.write(f\\\"event: message\\\\ndata: {text}\\\\n\\\\n\\\".encode())\\n            return\\n        self.send_response(200)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.end_headers()\\n        self.wfile.write(text.encode())\\n\\n\\ndef test_engine() -> None:\\n    \\\"\\\"\\\"Record parsing, call-side templates, read-side mapping.\\\"\\\"\\\"\\n    svc = parse_service(NOTES)\\n    check(svc.complete(), \\\"endpoint + search tool make a record complete\\\")\\n    check(parse_service(svc.record()) == svc, \\\"record() round-trips through parse\\\")\\n    check(svc.fields[\\\"title\\\"] == \\\"title | name\\\", \\\"unset field mappings get the defaults\\\")\\n\\n    args = parse_service({**NOTES, \\\"args\\\": {}})  # defaults: no args templates\\n    check(search_args := __import__(\\\"agent.tools.mcpprovider\\\", fromlist=[\\\"search_args\\\"]).search_args, \\\"import ok\\\")  # noqa: F401\\n\\n    from agent.tools.mcpprovider import search_args\\n\\n    check(search_args(svc, \\\"q\\\", 3) == {\\\"keyword\\\": \\\"q\\\", \\\"limit\\\": 3}, \\\"templates build the tools/call args\\\")\\n    check(isinstance(search_args(svc, \\\"q\\\", 3)[\\\"limit\\\"], int), \\\"a lone placeholder keeps the value's type\\\")\\n    mixed = parse_service({**NOTES, \\\"args\\\": {\\\"q\\\": \\\"page-{limit}\\\"}})\\n    check(search_args(mixed, \\\"q\\\", 3) == {\\\"q\\\": \\\"page-3\\\"}, \\\"mixed text interpolates into a string\\\")\\n\\n    rows = [\\n        {\\\"id\\\": \\\"n1\\\", \\\"title\\\": \\\"Found\\\", \\\"desc\\\": \\\"body\\\", \\\"token\\\": \\\"a b/c\\\"},\\n        {\\\"note_id\\\": \\\"n2\\\", \\\"title\\\": \\\"Second\\\", \\\"desc\\\": \\\"d2\\\"},\\n        {\\\"title\\\": \\\"no id at all\\\"},\\n        \\\"junk\\\",\\n    ]\\n    mapped = ws.map_results(svc, rows) if hasattr(ws, \\\"map_results\\\") else None\\n    from agent.tools.mcpprovider import map_results\\n\\n    mapped = map_results(svc, rows)\\n    check(len(mapped) == 3, \\\"rows survive unless their url mapping yields ''\\\")\\n    check(\\n        mapped[0][\\\"url\\\"] == \\\"https://notes.example/n/n1?t=a%20b%2Fc\\\",\\n        \\\"url templates fill and percent-encode payload\\\",\\n    )\\n    check(mapped[1][\\\"url\\\"] == \\\"https://notes.example/n/n2?t=\\\", \\\"empty placeholders fill, the row stays\\\")\\n    check(mapped[0][\\\"snippet\\\"] == \\\"body\\\" and mapped[0][\\\"title\\\"] == \\\"Found\\\", \\\"field chains read the row\\\")\\n\\n    # template placeholders take the same chains as field mappings\\n    chained = parse_service({**NOTES, \\\"fields\\\": {\\\"url\\\": \\\"https://notes.example/n/{id | note_id}\\\"}})\\n    check(map_results(chained, rows)[0][\\\"url\\\"] == \\\"https://notes.example/n/n1\\\", \\\"chains try alternatives in order\\\")\\n    check(map_results(chained, rows)[1][\\\"url\\\"] == \\\"https://notes.example/n/n2\\\", \\\"chain fallback hits the second name\\\")\\n\\n    check(map_results(svc, {\\\"data\\\": rows}) == mapped, \\\"auto-unwrap lifts a common envelope\\\")\\n    check(map_results(svc, {\\\"nope\\\": 1}) == [], \\\"unknown shapes map to nothing\\\")\\n    check(map_results(svc, [[1, 2]]) == [], \\\"non-object rows are ignored\\\")\\n\\n    plain_url = parse_service({**NOTES, \\\"fields\\\": {\\\"url\\\": \\\"href\\\"}})\\n    check(map_results(plain_url, [{\\\"href\\\": \\\"https://x.example/a\\\"}])[0][\\\"url\\\"] == \\\"https://x.example/a\\\",\\n          \\\"a non-template url mapping is a field chain\\\")\\n\\n    services, errors = parse_services([NOTES, NOTES, \\\"junk\\\", {**NOTES, \\\"name\\\": \\\"Bad Name\\\"}])\\n    check(len(services) == 1 and len(errors) == 2, \\\"broken records are skipped and reported\\\")\\n    check(parse_services(None) == ([], []), \\\"no services configured is not an error\\\")\\n\\n    draft = parse_service({**NOTES, \\\"url\\\": \\\"\\\", \\\"search_tool\\\": \\\"\\\"})\\n    check(not draft.complete(), \\\"a record without endpoint/tool stays incomplete\\\")\\n    off = parse_service({**NOTES, \\\"enabled\\\": \\\"false\\\"})\\n    check(not off.enabled, \\\"enabled parses falsey spellings\\\")\\n\\n\\ndef test_presets_and_migration() -> None:\\n    \\\"\\\"\\\"Legacy mcp_<name> URL keys fold into mcp_services through preset data.\\\"\\\"\\\"\\n    table = presets()\\n    check(isinstance(table, dict), \\\"presets() is a name -> record table (or empty)\\\")\\n    if \\\"xiaohongshu\\\" not in table:\\n        check(True, \\\"preset data file absent/emptied: migration checks skipped (file is editable data)\\\")\\n        return\\n\\n    records = service_records({\\\"mcp_xiaohongshu\\\": \\\" http://localhost:18060/mcp/ \\\"})\\n    check(len(records) == 1 and records[0][\\\"url\\\"] == \\\"http://localhost:18060/mcp\\\",\\n          \\\"a legacy mcp_<name> key converts through its preset, url stripped\\\")\\n    svc = parse_service(records[0])\\n    check(svc.complete(), \\\"the converted record is a complete service\\\")\\n    mapped = svc.map_results_placeholder if False else None  # noqa: F841 (readability guard)\\n    from agent.tools.mcpprovider import map_results\\n\\n    out = map_results(svc, [{\\\"id\\\": \\\"abc\\\", \\\"title\\\": \\\"Note\\\", \\\"desc\\\": \\\"d\\\", \\\"xsec_token\\\": \\\"T0K\\\"}])\\n    check(\\n        out == [{\\\"title\\\": \\\"Note\\\", \\\"url\\\": \\\"https://www.xiaohongshu.com/explore/abc?xsec_token=T0K\\\", \\\"snippet\\\": \\\"d\\\"}],\\n        \\\"the preset record maps real-shaped rows through the generic engine\\\",\\n    )\\n    fallback = map_results(svc, [{\\\"note_id\\\": \\\"n2\\\", \\\"title\\\": \\\"Second\\\", \\\"description\\\": \\\"d2\\\"}])\\n    check(fallback[0][\\\"url\\\"] == \\\"https://www.xiaohongshu.com/explore/n2?xsec_token=\\\",\\n          \\\"the url template's chain falls back to note_id\\\")\\n\\n    declared = {\\\"name\\\": \\\"xiaohongshu\\\", \\\"url\\\": \\\"http://mine/mcp\\\", \\\"search_tool\\\": \\\"t\\\"}\\n    records = service_records({\\\"mcp_services\\\": [declared], \\\"mcp_xiaohongshu\\\": \\\"http://localhost:18060/mcp\\\"})\\n    check(len(records) == 1 and records[0][\\\"url\\\"] == \\\"http://mine/mcp\\\",\\n          \\\"a declared service wins over its legacy key\\\")\\n\\n    check(service_records({\\\"mcp_ghost\\\": \\\"http://x/mcp\\\"}) == [], \\\"preset-less legacy keys convert to nothing\\\")\\n    junk = service_records({\\\"mcp_services\\\": \\\"nope\\\", \\\"mcp_xiaohongshu\\\": \\\"http://h/mcp\\\"})\\n    check(len(junk) == 1, \\\"a junk mcp_services list degrades to the migrated record\\\")\\n\\n\\ndef test_server_helpers() -> None:\\n    \\\"\\\"\\\"Settings-side validation and legacy-key handling.\\\"\\\"\\\"\\n    check(_services_from({}) is None, \\\"no mcp_services in the body means untouched\\\")\\n    try:\\n        _services_from({\\\"mcp_services\\\": \\\"nope\\\"})\\n        check(False, \\\"non-list mcp_services rejected\\\")\\n    except ValueError:\\n        check(True, \\\"non-list mcp_services rejected\\\")\\n    try:\\n        _services_from({\\\"mcp_services\\\": [{**NOTES, \\\"name\\\": \\\"Bad Name\\\"}]})\\n        check(False, \\\"an invalid record fails the save\\\")\\n    except ValueError as e:\\n        check(\\\"name\\\" in str(e), \\\"an invalid record fails the save with the reason\\\")\\n    out = _services_from({\\\"mcp_services\\\": [NOTES]})\\n    check(out and out[0][\\\"fields\\\"][\\\"title\\\"] == \\\"title | name\\\", \\\"valid records save canonicalized\\\")\\n\\n    check(_mcp_keys_from({\\\"mcp_x\\\": \\\"http://h\\\", \\\"base_url\\\": \\\"b\\\"}) == {\\\"mcp_x\\\": \\\"http://h\\\"}, \\\"legacy keys read back\\\")\\n    check(normalize_login({\\\"logged_in\\\": True}, \\\"logged_in\\\") is True, \\\"login state read via the record's field\\\")\\n    check(normalize_login({\\\"status\\\": \\\"logged_in\\\"}) is True, \\\"login state normalized from common shapes\\\")\\n    check(normalize_login(\\\"yes\\\") is True and normalize_login({\\\"whatever\\\": 1}) is None and normalize_login(None) is None,\\n          \\\"unknown login shapes normalize to None\\\")\\n\\n\\ndef test_rpc_client(base: str) -> None:\\n    \\\"\\\"\\\"JSON-RPC over POST against the real loopback server.\\\"\\\"\\\"\\n    data = ws._mcp_call(base + \\\"/\\\", \\\"search_notes\\\", {\\\"keyword\\\": \\\"q\\\"}, 5.0)\\n    check(isinstance(data, list) and data[0][\\\"id\\\"] == \\\"abc\\\", \\\"tools/call result parses as json\\\")\\n\\n    _Handler.behavior = \\\"sse\\\"\\n    data = ws._mcp_call(base + \\\"/sse\\\", \\\"search_notes\\\", {}, 5.0)\\n    check(isinstance(data, list) and data[0][\\\"id\\\"] == \\\"abc\\\", \\\"SSE-framed reply handled\\\")\\n\\n    _Handler.behavior = \\\"text\\\"\\n    check(ws._mcp_call(base + \\\"/text\\\", \\\"t\\\", {}, 5.0) == \\\"just words\\\", \\\"non-json text passes through\\\")\\n\\n    _Handler.behavior = \\\"empty\\\"\\n    check(ws._mcp_call(base + \\\"/empty\\\", \\\"t\\\", {}, 5.0) == \\\"\\\", \\\"empty body (202) tolerated\\\")\\n\\n    _Handler.behavior = \\\"rpcerror\\\"\\n    try:\\n        ws._mcp_call(base + \\\"/rpcerror\\\", \\\"t\\\", {}, 5.0)\\n        check(False, \\\"jsonrpc error raises WebError\\\")\\n    except ws.WebError:\\n        check(True, \\\"jsonrpc error raises WebError\\\")\\n\\n    _Handler.behavior = \\\"error\\\"\\n    try:\\n        ws._mcp_call(base + \\\"/error\\\", \\\"t\\\", {}, 5.0)\\n        check(False, \\\"HTTP 500 raises WebError\\\")\\n    except ws.WebError as e:\\n        check(\\\"500\\\" in str(e), \\\"HTTP 500 raises a factual WebError\\\")\\n\\n    try:\\n        ws._mcp_call(\\\"http://127.0.0.1:1/mcp\\\", \\\"t\\\", {}, 1.0)\\n        check(False, \\\"refused connection raises WebError\\\")\\n    except ws.WebError as e:\\n        check(\\\"unreachable\\\" in str(e) or \\\"timed out\\\" in str(e), \\\"refused connection is a factual status\\\")\\n\\n\\ndef test_gating_and_chain() -> None:\\n    \\\"\\\"\\\"A service exists exactly where it is declared — and nowhere else.\\\"\\\"\\\"\\n    plain = Config()\\n    avail = ws.available_backends(plain)\\n    check(\\\"notes\\\" not in avail, \\\"undeclared service absent from the chain\\\")\\n    check(\\\"bing\\\" in avail and \\\"ddg\\\" in avail, \\\"keyless backends always available\\\")\\n\\n    r = ws.web_search(None, plain, \\\"q\\\", backend=\\\"notes\\\")\\n    check(r.get(\\\"error\\\") and \\\"available: \\\" in r[\\\"content\\\"], \\\"pinning an undeclared backend errors factually\\\")\\n    check(\\\"install\\\" not in r[\\\"content\\\"].lower(), \\\"error never suggests installing anything\\\")\\n    check(\\\"searxng\\\" not in r[\\\"content\\\"] and \\\"tavily\\\" not in r[\\\"content\\\"],\\n          \\\"unconfigured siblings are not named either\\\")\\n    r = ws.web_search(None, plain, \\\"q\\\", backend=\\\"nope\\\")\\n    check(r.get(\\\"error\\\") and \\\"available: \\\" in r[\\\"content\\\"], \\\"unknown backend lists only the real ones\\\")\\n\\n    cfg = Config()\\n    cfg.mcp_services = [NOTES]\\n    avail = ws.available_backends(cfg)\\n    check(\\\"notes\\\" in avail and avail[-1] == \\\"notes\\\", \\\"declared service joins the chain after the native backends\\\")\\n    check(\\\"notes\\\" not in ws.available_backends(Config(mcp_services=[{**NOTES, \\\"enabled\\\": False}])),\\n          \\\"a disabled service does not exist\\\")\\n    check(\\\"notes\\\" not in ws.available_backends(Config(mcp_services=[{**NOTES, \\\"url\\\": \\\"\\\"}])),\\n          \\\"an endpoint-less record does not exist\\\")\\n    check(\\\"notes\\\" in ws.available_backends(Config(mcp_services=[\\\"junk\\\", NOTES])),\\n          \\\"a broken sibling record never takes the healthy one down\\\")\\n\\n    real_rpc = ws._mcp_rpc\\n\\n    def fake_rpc(url, payload, session, timeout, cancel=None):\\n        if payload.get(\\\"method\\\") == \\\"initialize\\\":\\n            return {\\\"result\\\": {}}, \\\"sess-1\\\"\\n        if payload.get(\\\"method\\\") == \\\"notifications/initialized\\\":\\n            return {}, session\\n        rows_json = json.dumps([{\\\"id\\\": \\\"f1\\\", \\\"title\\\": \\\"Found\\\", \\\"desc\\\": \\\"snippet\\\", \\\"token\\\": \\\"tk\\\"}])\\n        return {\\\"result\\\": {\\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": rows_json}]}}, session\\n\\n    ws._mcp_rpc = fake_rpc\\n    try:\\n        r = ws.web_search(None, cfg, \\\"note\\\", backend=\\\"notes\\\")\\n        check(\\n            not r.get(\\\"error\\\") and \\\"Found\\\" in r[\\\"content\\\"] and \\\"t=tk\\\" in r[\\\"content\\\"],\\n            \\\"web_search serves mapped mcp results end to end\\\",\\n        )\\n\\n        def dead_rpc(*a, **k):\\n            raise ws.WebError(\\\"MCP server unreachable (refused): http://localhost:18060/mcp\\\")\\n\\n        ws._mcp_rpc = dead_rpc\\n        r = ws.web_search(None, cfg, \\\"note\\\", backend=\\\"notes\\\")\\n        check(r.get(\\\"error\\\") and \\\"unreachable\\\" in r[\\\"content\\\"], \\\"mcp failure degrades to error-as-data\\\")\\n    finally:\\n        ws._mcp_rpc = real_rpc\\n\\n    tools_plain = {t.name: t for t in build_default_tools(plain)}\\n    tools_cfg = {t.name: t for t in build_default_tools(cfg)}\\n    check(\\\"notes\\\" not in tools_plain[\\\"web_search\\\"].description,\\n          \\\"prompt on an undeclared host never names the service\\\")\\n    check(\\\"notes\\\" in tools_cfg[\\\"web_search\\\"].description,\\n          \\\"prompt on a configured host names the service\\\")\\n    check(\\\"bing | ddg\\\" in tools_plain[\\\"web_search\\\"].parameters[\\\"properties\\\"][\\\"backend\\\"][\\\"description\\\"],\\n          \\\"schema backend param lists the real chain\\\")\\n    check(\\\"notes\\\" in tools_cfg[\\\"web_search\\\"].parameters[\\\"properties\\\"][\\\"backend\\\"][\\\"description\\\"],\\n          \\\"schema backend param includes declared services\\\")\\n\\n\\ndef main() -> None:\\n    test_engine()\\n    test_presets_and_migration()\\n    test_server_helpers()\\n\\n    srv = HTTPServer((\\\"127.0.0.1\\\", 0), _Handler)\\n    threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    try:\\n        test_rpc_client(f\\\"http://127.0.0.1:{srv.server_port}\\\")\\n    finally:\\n        srv.shutdown()\\n        srv.server_close()\\n\\n    test_gating_and_chain()\\n    print(\\\"all passed\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}", "tool_call_id": "call_e1dddf4b4a1a40b49dc5741e"}
{"type": "tool_result", "timestamp": 1789816213.1957052, "id": "89525625e81a", "tool_call_id": "call_e1dddf4b4a1a40b49dc5741e", "content": "OK: wrote C:\\Users\\12741\\Desktop\\临时文件\\Clutch\\tests\\mcpbackend_test.py (+221 -117 lines)", "is_error": false, "diff": "--- a/tests\\mcpbackend_test.py\n+++ b/tests\\mcpbackend_test.py\n@@ -1,31 +1,47 @@\n-\"\"\"Offline checks for the MCP web-search plugin layer (loopback HTTP only).\n+\"\"\"Offline checks for the declarative MCP web-search layer (loopback HTTP only).\n \n Run: python -m tests.mcpbackend_test\n \n-Covers: provider URL resolution (settings > env), result mapping tolerance,\n-the JSON-RPC client (handshake, session id, SSE frames, plain-text and error\n-paths) against a real loopback server, backend gating (an MCP backend exists\n-only when configured — and is named nowhere when it is not), error-as-data\n-degradation, and dynamic rendering of prompt + schema.\n+Covers: the record engine (parse, args templates, result mapping incl. url\n+templates with fallback chains), preset-driven migration of legacy mcp_<name>\n+settings keys, the JSON-RPC client (handshake, session id, SSE frames,\n+plain-text and error paths) against a real loopback server, backend gating (a\n+service exists only where it is declared — and is named nowhere otherwise),\n+error-as-data degradation, and dynamic rendering of prompt + schema.\n \"\"\"\n \n from __future__ import annotations\n \n import json\n-import os\n-import sys\n import threading\n from http.server import BaseHTTPRequestHandler, HTTPServer\n \n import agent.tools.websearch as ws\n from agent.config import Config\n-from agent.server import _login_state, _mcp_keys_from, _split_mcp_fields, mcp_providers\n-from agent.tools.mcpprovider import MCP_PROVIDERS\n+from agent.server import _mcp_keys_from, _services_from\n+from agent.tools.mcpprovider import (\n+    normalize_login,\n+    parse_service,\n+    parse_services,\n+    presets,\n+    service_records,\n+)\n from agent.tools.registry import build_default_tools\n from tests.testsupport import check\n \n \n-# ---- loopback MCP server ------------------------------------------------------\n+# A generic declarative record used across the engine checks. No real service\n+# is needed to test the machinery: the engine only sees shapes, not names.\n+NOTES = {\n+    \"name\": \"notes\",\n+    \"url\": \"http://localhost:18060/mcp\",\n+    \"search_tool\": \"search_notes\",\n+    \"args\": {\"keyword\": \"{query}\", \"limit\": \"{limit}\"},\n+    \"fields\": {\"url\": \"https://notes.example/n/{id}?t={token}\", \"snippet\": \"desc | description\"},\n+    \"status_tool\": \"whoami\",\n+    \"login_field\": \"logged_in\",\n+}\n+\n \n class _Handler(BaseHTTPRequestHandler):\n     \"\"\"Scripted MCP server: initialize -> initialized -> tools/call.\"\"\"\n@@ -84,110 +100,183 @@\n         self.wfile.write(text.encode())\n \n \n-def main() -> None:\n-    xhs = MCP_PROVIDERS[\"xiaohongshu\"]\n-\n-    # 1. URL resolution: config dict wins over env, trailing / stripped\n-    check(xhs.url_for(Config()) == \"\", \"provider without config resolves to ''\")\n-    os.environ[\"CLUTCH_MCP_XIAOHONGSHU_URL\"] = \"http://env.example/mcp\"\n-    try:\n-        check(xhs.url_for(Config()) == \"http://env.example/mcp\", \"env CLUTCH_MCP_<NAME>_URL is the fallback\")\n-    finally:\n-        del os.environ[\"CLUTCH_MCP_XIAOHONGSHU_URL\"]\n-    cfg = Config()\n-    cfg.mcp_urls[\"xiaohongshu\"] = \"http://localhost:18060/mcp/\"\n-    check(xhs.url_for(cfg) == \"http://localhost:18060/mcp\", \"config beats env; trailing / stripped\")\n-\n-    # 2. result mapping: bare list and envelopes map; junk tolerated; token kept\n-    feeds = [\n-        {\"id\": \"abc\", \"title\": \"Note\", \"desc\": \"body\", \"xsec_token\": \"T0K\"},\n+def test_engine() -> None:\n+    \"\"\"Record parsing, call-side templates, read-side mapping.\"\"\"\n+    svc = parse_service(NOTES)\n+    check(svc.complete(), \"endpoint + search tool make a record complete\")\n+    check(parse_service(svc.record()) == svc, \"record() round-trips through parse\")\n+    check(svc.fields[\"title\"] == \"title | name\", \"unset field mappings get the defaults\")\n+\n+    args = parse_service({**NOTES, \"args\": {}})  # defaults: no args templates\n+    check(search_args := __import__(\"agent.tools.mcpprovider\", fromlist=[\"search_args\"]).search_args, \"import ok\")  # noqa: F401\n+\n+    from agent.tools.mcpprovider import search_args\n+\n+    check(search_args(svc, \"q\", 3) == {\"keyword\": \"q\", \"limit\": 3}, \"templates build the tools/call args\")\n+    check(isinstance(search_args(svc, \"q\", 3)[\"limit\"], int), \"a lone placeholder keeps the value's type\")\n+    mixed = parse_service({**NOTES, \"args\": {\"q\": \"page-{limit}\"}})\n+    check(search_args(mixed, \"q\", 3) == {\"q\": \"page-3\"}, \"mixed text interpolates into a string\")\n+\n+    rows = [\n+        {\"id\": \"n1\", \"title\": \"Found\", \"desc\": \"body\", \"token\": \"a b/c\"},\n         {\"note_id\": \"n2\", \"title\": \"Second\", \"desc\": \"d2\"},\n-        {\"title\": \"no id, dropped\"},\n+        {\"title\": \"no id at all\"},\n         \"junk\",\n     ]\n-    rows = xhs.map_results(feeds)\n-    check(len(rows) == 2, \"mapping keeps only rows with an id\")\n+    mapped = ws.map_results(svc, rows) if hasattr(ws, \"map_results\") else None\n+    from agent.tools.mcpprovider import map_results\n+\n+    mapped = map_results(svc, rows)\n+    check(len(mapped) == 3, \"rows survive unless their url mapping yields ''\")\n     check(\n-        rows[0][\"url\"] == \"https://www.xiaohongshu.com/explore/abc?xsec_token=T0K\",\n-        \"mapping keeps xsec_token in the url\",\n+        mapped[0][\"url\"] == \"https://notes.example/n/n1?t=a%20b%2Fc\",\n+        \"url templates fill and percent-encode payload\",\n     )\n-    check(rows[1][\"url\"] == \"https://www.xiaohongshu.com/explore/n2\", \"mapping works without a token\")\n-    check(xhs.map_r