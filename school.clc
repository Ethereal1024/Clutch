nt LLM endpoint config for the settings modal (no credentials).\"\"\"\n399:         saved = flatten_settings(load_settings())\n400:         services = _parse_mcp_services(self._cfg.mcp_services)[0]\n401:         self._json(\n402:             {\n403:                 \"base_url\": self._cfg.base_url or saved.get(\"base_url\", \"\"),\n404:                 \"model\": self._cfg.model or saved.get(\"model\", \"\"),\n405:                 \"reasoning_effort\": self._cfg.llm_reasoning_effort or saved.get(\"reasoning_effort\", \"\"),\n406:                 \"has_api_key\": bool(self._state.api_key or self._cfg.api_key or saved.get(\"api_key\")),\n407:                 # MCP web-search services: the records this server actually\n408:                 # runs, for the settings UI to render and round-trip\n409:                 \"mcp_services\": [s.record() for s in services],\n410:             }\n411:         )\n412: \n413:     def _mcp_status(self) -> None:\n414:         \"\"\"Per-service MCP reachability + login state, for the settings modal.\n415: \n416:         Purely informational and only about services this machine's user chose\n417:         to configure: unconfigured services report configured=False and the UI\n418:         leaves the row blank — nothing here suggests installing anything.\n419:         \"\"\"\n420:         out = []\n421:         for s in _parse_mcp_services(self._cfg.mcp_services)[0]:\n422:             row: dict[str, Any] = {\n423:                 \"name\": s.name,\n424:                 \"configured\": bool(s.url),\n425:                 \"enabled\": s.enabled,\n426:                 \"reachable\": None,\n427:                 \"login\": None,\n428:             }\n429:             if s.url:\n430:                 try:\n431:                     state = _mcp_status_probe(s.url, s) if s.status_tool else None\n432:                     row[\"reachable\"] = True\n433:                     row[\"login\"] = _login_state(state, s.login_field)\n434:                 except Exception as e:  # noqa: BLE001 — any failure is a status, not a crash\n435:                     row[\"reachable\"] = False\n436:                     row[\"detail\"] = str(e)[:160]\n437:             out.append(row)\n438:         self._json({\"services\": out})\n439: \n... (showing lines 360-439 of 856; use offset=440 to continue)", "is_error": false, "diff": ""}
