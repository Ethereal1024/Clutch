{"type": "tool_result", "timestamp": 1789871270.286895, "id": "6de8153d0315", "tool_call_id": "call_c05011ec781e46ed9c41fc71", "content": "75:     type: str = \"tool_call\"\n76:     name: str = \"\"\n77:     arguments: str = \"\"  # raw JSON string\n78:     tool_call_id: str = \"\"\n79: \n80: \n81: @dataclass\n82: class ToolCallDeltaEvent(Event):\n83:     \"\"\"Streamed tool-call argument chunks (live display only, never persisted).\n84: \n85:     Mirrors text_delta: the model's tool-call arguments arrive as a stream of\n86:     deltas while it generates them; the final ToolCallEvent carries the complete\n87:     arguments. The UI renders these live so the user watches e.g. a write_file\n88:     content being produced instead of waiting for the finished result.\"\"\"\n89: \n90:     type: str = \"tool_call_delta\"\n91:     tool_call_id: str = \"\"\n92:     name: str = \"\"  # set on the first (start) delta only\n93:     delta: str = \"\"\n94: \n95: \n96: @dataclass\n97: class ToolResultEvent(Event):\n98:     type: str = \"tool_result\"\n99:     tool_call_id: str = \"\"\n100:     content: str = \"\"  # model-visible content\n101:     is_error: bool = False\n102:     diff: str = \"\"  # unified diff (UI display only, not model-visible)\n103: \n104: \n... (showing lines 75-104 of 205; use offset=105 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789871270.2950842, "id": "89a6b874a2cb", "tool_call_id": "call_8c417be11a7e4317a8b4bafb", "content": "agent\\server.py:\n  Line 23: import dataclasses\n  Line 60: _SSE_ERR = (BrokenPipeError, ConnectionResetError, ConnectionAbortedError, ValueError)\n  Line 111:     \"\"\"The run-assembly contract for the HTTP host; routing lives in Handler.\"\"\"\n  Line 177:             self._sse(\n  Line 474:     def _project_for_sse(self, project_q: str | None) -> Project | None:\n  Line 494:     def _sse(self, project_q: str | None = None, replay: bool = True) -> None:\n  Line 506:                 self._write_sse(StateUpdateEvent(key=\"execution_status\", value=\"idle\"))\n  Line 510:                     project = self._project_for_sse(project_q)\n  Line 515:                         self._write_sse_raw({\"type\": \"history\", \"older\": max(0, log.cpr_start())})\n  Line 517:                             self._write_sse(ev, offset=off)\n  Line 518:             except _SSE_ERR:\n  Line 527:                     self._write_sse(ev)\n  Line 532:                     except _SSE_ERR:\n  Line 534:                 except _SSE_ERR:\n  Line 539:     def _write_sse(self, ev: Event, offset: int | None = None) -> None:\n  Line 551:     def _write_sse_raw(self, obj: dict) -> None:\n  Line 763:     return dataclasses.replace(config, **kw)", "is_error": false, "diff": ""}
