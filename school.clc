{"type": "tool_result", "timestamp": 1789898118.5830212, "id": "65b435d85aa1", "tool_call_id": "call_8b0c8a3d0f0a4db89d57d844", "content": "271:     # A packaged supervisor is spawned by Electron with windowsHide: it has NO\n272:     # console, so CTRL_BREAK_EVENT cannot be delivered and os.kill raises\n273:     # OSError (WinError 6) instead. That must not escape _kill: /api/session/stop\n274:     # has already unregistered the session by then, so an exception answers\n275:     # nothing AND leaks the child (an orphan keeps the port). _kill_hard must\n276:     # still reap it.\n277:     import agent.supervisor as _sv\n278: \n279:     class _NoConsole:\n280:         \"\"\"A live Popen whose graceful stop is unavailable (rest delegates).\"\"\"\n281: \n282:         def __init__(self, proc) -> None:\n283:             self._p = proc\n284:             self.pid = proc.pid\n285: \n286:         def poll(self):\n287:             return self._p.poll()\n288: \n289:         def wait(self, timeout=None):\n290:             return self._p.wait(timeout)\n291: \n292:         def kill(self):\n293:             return self._p.kill()\n294: \n295:         def send_signal(self, sig):\n296:             if os.name == \"nt\":\n297:                 raise OSError(6, \"The handle is invalid\")  # WinError 6: no console\n298:             return self._p.send_signal(sig)\n299: \n300:     grace = _sp.Popen(\n301:         [sys.executable, \"-c\", \"import time; time.sleep(60)\"],\n302:         stdout=_sp.DEVNULL,\n303:         stderr=_sp.DEVNULL,\n304:         creationflags=getattr(_sp, \"CREATE_NEW_PROCESS_GROUP\", 0),\n305:         start_new_session=(os.name != \"nt\"),  # POSIX: own group, so killpg hits only it\n306:     )\n307:     with _m.patch.object(_sv, \"KILL_GRACE_S\", 0.5):\n308:         t0 = time.time()\n309:         Supervisor._kill(_NoConsole(grace))  # the old code raised here\n310:         took = time.time() - t0\n311:     check(grace.poll() is not None, \"an undeliverable graceful signal still reaps the child\")\n312:     check(took < 5.0, \"kill returns promptly (no unbounded wait on a dead signal)\")\n313:     grace.kill()\n314: \n315:     # ---- 12. the WHOLE tree goes down, not just the direct child (W2) ----\n316:     # A session child runs commands through a shell; stopping only the direct\n317:     # child leaves that shell — and whatever it started — behind as an orphan\n318:     # holding the port. The grandchild's heartbeat is the witness: it must stop\n319:     # beating the moment the session child is stopped.\n320:     with tempfile.TemporaryDirectory() as tdir:\n321:         hb = Path(tdir) / \"beat.txt\"\n322:         hb_py = Path(tdir) / \"beat.py\"\n323:         hb_py.write_text(\n324:             \"import os, sys, time\\n\"\n325:             \"p = sys.argv[1]\\n\"\n326:             \"for _ in range(300):  # never outlives the test, even if leaked\\n\"\n327:             \"    open(p, 'w').write(str(os.getpid()))\\n\"\n328:             \"    time.sleep(0.1)\\n\",\n329:             encoding=\"utf-8\",\n330:             newline=\"\\n\",\n331:         )\n332:         parent_py = Path(tdir) / \"parent.py\"\n333:         parent_py.write_text(\n334:             \"import subprocess, sys, time\\n\"\n335:             \"subprocess.Popen([sys.executable, sys.argv[1], sys.argv[2]])\\n\"\n336:             \"time.sleep(60)\\n\",\n337:             encoding=\"utf-8\",\n338:             newline=\"\\n\",\n339:         )\n340:         tree = _sp.Popen(\n341:             [sys.executable, str(parent_py), str(hb_py), str(hb)],\n342:             stdout=_sp.DEVNULL,\n343:             stderr=_sp.DEVNULL,\n344:             creationflags=getattr(_sp, \"CREATE_NEW_PROCESS_GROUP\", 0),\n345:             start_new_session=(os.name != \"nt\"),\n346:         )\n347:         check(wait_until(hb.exists, 10.0, \"grandchild heartbeat\"), \"the shell's child is running\")\n348:         check(tree.poll() is None, \"the session child is running\")\n349:         Supervisor._kill(tree)\n350:         check(tree.poll() is not None, \"direct session child reaped\")\n351:         time.sleep(0.8)  # let the last in-flight heartbeat land\n352:         first = hb.stat().st_mtime_ns\n353:         time.sleep(1.2)\n354:         check(hb.stat().st_mtime_ns == first, \"the shell's child went down with the tree (no orphan)\")\n355:         # safety net: if a failure above leaked the witness, stop it directly\n356:         try:\n357:             leaked = int(hb.read_text().strip() or \"0\")\n358:             beat = hb.stat().st_mtime_ns\n359:             time.sleep(0.4)\n360:             if leaked and hb.stat().st_mtime_ns != beat:\n361:                 if os.name == \"nt\":\n362:                     _sp.run([\"taskkill\", \"/F\", \"/PID\", str(leaked)], capture_output=True)\n363:                 else:\n364:                     os.kill(leaked, 9)\n365:         except (OSError, ValueError):\n366:             pass\n367: \n368:     # ---- 13. a supervisor that DIES must not orphan the session (Windows Job) ----\n369:     # The reaper only runs while the supervisor lives; a supervisor killed\n370:     # without walking its children (crash, TerminateProcess, Electron's tree\n371:     # going down first) used to leave the session child alive forever — an\n372:     # invisible zombie still holding its .clc write lock, so reopening the\n373:     # project landed read-only with no visible other window. The kill-on-close\n374:     # Job hands that to the kernel: the OS closes a dying process's handles,\n375:     # and the Job's last handle closing terminates every member. The witness\n376:     # here is a grandchild holding a real LISTENING port (the stand-in for the\n377:     # .clc lock): launcher + grandchild must BOTH die when the Job handle does.\n378:     if os.name == \"nt\":\n379:         import ctypes\n380:         import socket as _socket\n381: \n382:         with tempfile.TemporaryDirectory() as tdir:\n383:             grandchild_py = Path(tdir) / \"server.py\"\n384:             grandchild_py.write_text(\n385:                 \"import socket, sys, time\\n\"\n386:                 \"s = socket.socket()\\n\"\n387:                 \"s.bind(('127.0.0.1', 0))\\n\"\n388:                 \"s.listen(1)\\n\"\n389:                 \"print(f'[clutch-server] http://127.0.0.1:{s.getsockname()[1]}', flush=True)\\n\"\n390:                 \"time.sleep(60)\\n\",\n391:                 encoding=\"utf-8\",\n392:                 newline=\"\\n\",\n393:             )\n394:             launcher_py = Path(tdir) / \"launcher.py\"\n395:             launcher_py.write_text(\n396:                 \"import subprocess, sys, time\\n\"\n397:                 \"from pathlib import Path\\n\"\n398:                 \"# the supervisor appends its own CLI (e.g. '--port 0') AFTER the\\n\"\n399:                 \"# command; forward it untouched, like the real agent launcher does\\n\"\n400:                 \"sib = Path(sys.argv[0]).resolve().parent / 'server.py'\\n\"\n401:                 \"subprocess.Popen([sys.executable, str(sib), *sys.argv[1:]])  # stdout inherited\\n\"\n402:                 \"time.sleep(60)\\n\",\n403:                 encoding=\"utf-8\",\n404:                 newline=\"\\n\",\n405:             )\n406:             sup9 = Supervisor(\n407:                 agent_cmd=[sys.executable, str(launcher_py)],\n408:                 cwd=str(ROOT),\n409:                 stale_s=60,\n410:                 idle_timeout_s=60,\n411:             )\n412:             sess9 = sup9.start_session()\n413:             check(sess9 is not None, \"job: session started\")\n414:             check(sess9.job is not None, \"session child assigned to a kill-on-close Job\")\n415:             check(sess9.port and sess9.port > 0, \"job: grandchild banner parsed through the launcher\")\n416: \n417:             # Job membership must already cover the GRANDCHILD (the venv/onefile\n418:             # launcher spawns its real interpreter as a child; a Job missing it\n419:             # is exactly the leak this guards against)\n420:             class _PidList(ctypes.Structure):\n421:                 # JOBOBJECT_BASIC_PROCESS_ID_LIST with headroom for 64 pids.\n422:                 # (Class 1 / accounting is NOT portable for this: its struct\n423:                 # must match the build's exact size — 40 classic, 48 on newer\n424:                 # Win11 — anything else fails with ERROR_BAD_LENGTH.)\n425:                 _fields_ = [\n426:                     (\"NumberOfAssignedProcesses\", ctypes.c_uint32),\n427:                     (\"NumberOfProcessIdsInList\", ctypes.c_uint32),\n428:                     (\"ProcessIdList\", ctypes.c_size_t * 64),\n429:                 ]\n430: \n431:             pids = _PidList()\n432:             k32 = ctypes.windll.kernel32\n433:             k32.QueryInformationJobObject.argtypes = [\n434:                 ctypes.c_void_p,\n435:                 ctypes.c_int,\n436:                 ctypes.POINTER(_PidList),\n437:                 ctypes.c_uint32,\n438:                 ctypes.POINTER(ctypes.c_uint32),\n439:             ]\n440:             rl = ctypes.c_uint32(0)\n441:             ok = k32.QueryInformationJobObject(\n442:                 sess9.job, 3, ctypes.byref(pids), ctypes.sizeof(pids), ctypes.byref(rl)\n443:             )  # 3 = JobObjectBasicProcessIdList\n444:             listed = {pids.ProcessIdList[i] for i in range(pids.NumberOfProcessIdsInList)}\n445:             check(\n446:                 bool(ok) and len(listed) >= 2 and sess9.proc.pid in listed,\n447:                 \"the launcher's child is inside the Job\",\n448:             )\n449: \n450:             def _port_open() -> bool:\n451:                 s = _socket.socket()\n452:                 s.settimeout(0.5)\n453:                 try:\n454:                     s.connect((\"127.0.0.1\", sess9.port))\n455:                     return True\n456:                 except OSError:\n457:                     return False\n458:                 finally:\n459:                     s.close()\n460: \n461:             check(_port_open(), \"the grandchild's port is serving before the supervisor dies\")\n462:             # simulate the supervisor DYING with no cleanup: the OS closes every\n463:             # handle it owns — the Job's (last) handle among them\n464:             k32.CloseHandle(ctypes.c_void_p(sess9.job))\n465:             sess9.job = None  # a double close could hit a recycled handle\n466:             check(\n467:                 wait_until(lambda: sess9.proc.poll() is not None, 10.0, \"launcher death\"),\n468:                 \"the launcher died with the Job\",\n469:             )\n470:             check(\n471:                 wait_until(lambda: not _port_open(), 10.0, \"grandchild port close\"),\n472:                 \"the grandchild went down with the Job (no orphan holding resources)\",\n473:             )\n474: \n475:     # ---- 14. no Job, no session (fail-fast, never a silent orphan) ----\n476:     # The old policy quietly RAN sessions whose kill guarantee was missing —\n477:     # an orphan-in-waiting indistinguishable from a healthy one until the day\n478:     # the .clc stuck read-only. The contract is now absolute: a session is\n479:     # either guaranteed killable (Job) or is never started. _job_assign is\n480:     # stubbed to None to force the refusal path; the child below prints no\n481:     # banner, which also proves start_session returns BEFORE _wait_port.\n482:     if os.name == \"nt\":\n483:         import agent.supervisor as _svmod\n484: \n485:         with tempfile.TemporaryDirectory() as tdir:\n486:             hb = Path(tdir) / \"hb\"\n487:             child_src = (\n488:                 \"import time\\n\"\n489:                 f\"end = time.time() + 120\\n\"\n490:                 \"while time.time() < end:\\n\"\n491:                 f\"    open({str(hb)!r}, 'a').write('x')\\n\"\n492:                 \"    time.sleep(0.2)\\n\"\n493:             )\n494:             sup14 = Supervisor(\n495:                 agent_cmd=[sys.executable, \"-c\", child_src],\n496:                 cwd=str(ROOT),\n497:                 stale_s=60,\n498:                 idle_timeout_s=60,\n499:             )\n500:             orig_assign = _svmod._job_assign\n501:             _svmod._job_assign = lambda pid: None  # simulate an unavailable Job\n502:             try:\n503:                 sess14 = sup14.start_session()\n504:             finally:\n505:                 _svmod._job_assign = orig_assign\n506:             check(sess14 is None, \"a session with no kill guarantee is REFUSED, not run\")\n507:             check(not sup14.sessions, \"the refused session registered nothing\")\n508:             time.sleep(1.0)  # let the refusal's explicit kill land\n509:             beat1 = hb.stat().st_mtime_ns if hb.exists() else 0\n510:             time.sleep(0.8)\n511:             beat2 = hb.stat().st_mtime_ns if hb.exists() else 0\n512:             check(beat1 == beat2, \"the refused session's child was killed (no orphan-in-waiting)\")\n513: \n514:     print(\"\\nSUPERVISOR TESTS PASSED\")\n515:     return 0\n516: \n517: \n518: if __name__ == \"__main__\":\n519:     sys.exit(main())", "is_error": false, "diff": ""}
