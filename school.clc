{"type": "tool_result", "timestamp": 1789619624.9165392, "id": "d41f2bdec8fd", "tool_call_id": "call_c6c7aca8c17c4b9e8a30b2e2", "content": "1: \"\"\"OpenaiLlmClient stream-resilience checks (no network).\n2: \n3: Run: uv run python -m tests.llm_client_test\n4: \n5: Covers the mid-stream transport-error fix: httpx2 read-timeout / connection\n6: errors raised while the SSE *body* is being consumed escape the openai SDK\n7: unwrapped (its Stream.__stream__ only closes the response), so the client must\n8:   (a) classify them as retryable (LlmError.classify),\n9:   (b) restart the request — with a visible {\"type\": \"retry\"} notice — when\n10:       nothing of the attempt reached the caller yet,\n11:   (c) raise immediately instead of re-streaming duplicated content when the\n12:       stream broke AFTER tokens had already been delivered, and\n13:   (d) report exhaustion with a clear \"after N attempts\" message.\n14: \"\"\"\n15: \n16: from __future__ import annotations\n17: \n18: import sys\n19: from types import SimpleNamespace\n20: \n21: import httpx2\n22: \n23: # the client sleeps through backoff via `time.sleep`; swap in a no-op stub so\n24: # the checks never actually wait (scoped to this module, not the global time)\n25: import agent.llm.llm_clients.openai_client as oc_mod\n26: from agent.llm.client import LlmError\n27: from agent.llm.llm_clients.openai_client import OpenaiLlmClient\n28: from tests.testsupport import check\n29: \n30: # ---- fake openai SDK -------------------------------------------------------\n31: \n32: \n33: def _delta(content=None, tool_calls=None, **kw) -> SimpleNamespace:\n34:     \"\"\"Delta-shaped object; the real SDK delta always carries these attributes.\"\"\"\n35:     fields = {\"content\": content, \"tool_calls\": tool_calls}\n36:     fields.update(kw)\n37:     return SimpleNamespace(**fields)\n38: \n39: \n40: def _text_chunk(text: str) -> SimpleNamespace:\n41:     \"\"\"A ChatCompletionChunk-shaped object carrying one content delta. Every\n42:     SDK choice always carries finish_reason (None mid-stream), so the fakes\n43:     mirror that shape — the finish handler reads it on every chunk.\"\"\"\n44:     return SimpleNamespace(choices=[SimpleNamespace(delta=_delta(content=text), finish_reason=None)])\n45: \n46: \n47: def _finish_chunk() -> SimpleNamespace:\n48:     \"\"\"A ChatCompletionChunk-shaped object carrying finish_reason=stop.\"\"\"\n49:     return SimpleNamespace(choices=[SimpleNamespace(delta=_delta(), finish_reason=\"stop\")])\n50: \n51: \n52: def _ok_stream():\n53:     \"\"\"A healthy SSE body: one text token, then the finish chunk.\"\"\"\n54:     yield _text_chunk(\"hi\")\n55:     yield _finish_chunk()\n56: \n57: \n58: def _fail_stream():\n59:     \"\"\"An SSE body that dies (read timeout) before delivering its first chunk.\"\"\"\n60:     raise httpx2.ReadTimeout(\"timed out\")\n61:     yield  # pragma: no cover -- generator by construction\n62: \n63: \n64: def _partial_then_fail():\n65:     \"\"\"An SSE body that delivers one token and then dies mid-stream.\"\"\"\n66:     yield _text_chunk(\"partial\")\n67:     raise httpx2.ReadTimeout(\"timed out\")\n68: \n69: \n70: class _FakeCompletions:\n71:     def __init__(self, streams):\n72:         self._streams = list(streams)\n73:         self.calls = 0\n74: \n75:     def create(self, **kwargs):\n76:         self.calls += 1\n77:         if kwargs.pop(\"stream\", None) is not True:\n78:             raise AssertionError(\"create() must be called with stream=True\")\n79:         if not self._streams:\n80:             raise AssertionError(\"unexpected extra create() call\")\n... (showing lines 1-80 of 158; use offset=81 to continue)", "is_error": false, "diff": ""}
