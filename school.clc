{"type": "tool_result", "timestamp": 1789632866.9454136, "id": "acc28d991a96", "tool_call_id": "call_a3790c53d9f94a26a7633b25", "content": "\"\"\"Prompt templates, kept out of code so wording can be tuned without touching logic.\n\nUses string.Template placeholders ($name). Loaded lazily at call time.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom string import Template\n\n_DIR = Path(__file__).resolve().parent\n\n\ndef load(name: str) -> str:\n    return (_DIR / name).read_text(encoding=\"utf-8\")\n\n\ndef render(name: str, **kw: object) -> str:\n    return Template(load(name)).safe_substitute(**kw)\n", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789632866.9478376, "id": "5c72c9e98fd1", "tool_call_id": "call_c651d9127d4e47059c326d88", "content": "146:         elif path == \"/api/events\":\n147:             params = parse_qs(parsed.query)\n148:             self._sse(\n149:                 (params.get(\"project\") or [None])[0],\n150:                 (params.get(\"replay\") or [\"1\"])[0] != \"0\",\n151:             )\n152:         elif path == \"/api/history\":\n153:             self._history()\n154:         elif path == \"/api/workspace/tree\":\n155:             self._workspace_tree()\n156:         elif path == \"/api/fs/list\":\n157:             self._fs_list()\n158:         elif path == \"/api/settings\":\n159:             self._settings_get()\n160:         else:\n161:             self._json({\"error\": \"not found\"}, status=404)\n162: \n163:     def do_POST(self) -> None:\n164:         parsed = urlparse(self.path)\n165:         if parsed.path == \"/api/project/new\":\n166:             self._project_new()\n167:         elif parsed.path == \"/api/project/open\":\n168:             self._project_open()\n169:         elif parsed.path == \"/api/run\":\n170:             self._run()\n171:         elif parsed.path == \"/api/stop\":\n172:             self._stop()\n173:         elif parsed.path == \"/api/settings\":\n174:             self._settings_post()\n175:         elif parsed.path == \"/api/permission/respond\":\n176:             self._permission_respond()\n177:         elif parsed.path == \"/api/workspace/revert\":\n178:             self._workspace_revert()\n179:         elif parsed.path == \"/api/backend\":\n180:             self._backend()\n181:         else:\n182:             self._json({\"error\": \"not found\"}, status=404)\n183: \n184:     # ---- API implementations ----\n185:     def _read_body(self) -> dict | None:\n186:         try:\n187:             data = json.loads(self.rfile.read(int(self.headers.get(\"Content-Length\", 0))))\n188:         except ValueError:\n189:             # malformed JSON body or Content-Length header: user error -> 400\n190:             return None\n191:         return data if isinstance(data, dict) else None\n192: \n193:     def _project_path(self, raw: str) -> Path:\n194:         \"\"\"Normalize a client-supplied .clc path WITHOUT local filesystem\n195:         semantics in ssh mode: the path lives on the REMOTE host, and\n196:         Path.resolve() here would rewrite it with the app host's view of the\n197:         world (/home -> /System/Volumes/Data/home on macOS autofs) — and a\n198:         Windows host's Path would even re-separator it with backslashes.\n199:         ssh mode therefore normalizes lexically in the PurePosixPath flavor;\n200:         Local mode keeps the OS realpath — it feeds the is_file() existence\n201:         check. Ssh mode leaves existence to the remote open/read itself.\"\"\"\n202:         if self._state.backend_mode == \"ssh\":\n203:             return PurePosixPath(posixpath.normpath(raw.replace(\"\\\\\", \"/\")))\n204:         return Path(raw).resolve()\n205: \n206:     def _run(self) -> None:\n207:         body = self._read_body()\n208:         if body is None:\n209:             return self._json({\"error\": \"bad json body\"}, status=400)\n210:         task = (body.get(\"task\") or \"\").strip()\n211:         config = self._cfg\n212:         mode = body.get(\"mode\")\n213:         if mode in (\"chat\", \"work\"):\n214:             config = _replace(config, mode=mode)\n215: \n... (showing lines 146-215 of 772; use offset=216 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789632866.9503384, "id": "95e7c3f1ffc7", "tool_call_id": "call_13339a1eec5743bf919dbbca", "content": "2755:   closeFsBrowser();\n2756:   createProject(fsPath, name);\n2757: });\n2758: dismissOnOverlayPress(fsModal, closeFsBrowser);\n2759: \n2760: $(\"#new-project-btn\").addEventListener(\"click\", () => openFsBrowser(\"new\"));\n2761: $(\"#open-project-btn\").addEventListener(\"click\", () => openFsBrowser(\"open\"));\n2762: $(\"#welcome-new\").addEventListener(\"click\", () => openFsBrowser(\"new\"));\n2763: $(\"#welcome-open\").addEventListener(\"click\", () => openFsBrowser(\"open\"));\n2764: \n2765: // the flat LLM config this UI would mirror to ~/.clutch/settings.json, read\n2766: // from localStorage (the UI's own source of truth); null when nothing stored.\n2767: // Active profile first, then the legacy clutch_llm + clutch_api_key pair.\n2768: function storedLlmConfig() {\n2769:   try {\n2770:     const active = localStorage.getItem(\"clutch_llm_active\");\n2771:     const profiles = JSON.parse(localStorage.getItem(\"clutch_llm_profiles\") || \"{}\");\n2772:     const p = active && profiles[active];\n2773:     if (p && (p.base_url || p.model || p.api_key)) {\n2774:       return {\n2775:         base_url: p.base_url || \"\",\n2776:         model: p.model || \"\",\n2777:         api_key: p.api_key || \"\",\n2778:         reasoning_effort: p.reasoning_effort || \"\",\n2779:       };\n2780:     }\n2781:   } catch (e) {}\n2782:   try {\n2783:     const legacy = JSON.parse(localStorage.getItem(\"clutch_llm\") || \"null\");\n2784:     const key = localStorage.getItem(\"clutch_api_key\") || \"\";\n2785:     if (legacy && (legacy.base_url || legacy.model || key)) {\n2786:       return { base_url: legacy.base_url || \"\", model: legacy.model || \"\", api_key: key, reasoning_effort: \"\" };\n2787:     }\n2788:   } catch (e) {}\n2789:   return null;\n2790: }\n2791: \n2792: // rebuild the settings.json mirror if it went missing while the UI still has\n2793: // the config (fire-and-forget: the next session spawn / proxy request needs it)\n2794: function healSettingsMirror() {\n2795:   const cfg = storedLlmConfig();\n2796:   if (!cfg) return; // nothing stored: nothing to heal from\n2797:   if (window.clutchSettings && window.clutchSettings.ensure) {\n2798:     window.clutchSettings.ensure(cfg).catch(() => {});\n2799:   }\n2800: }\n2801: \n2802: // settle the stored URL before connecting SSE; connectSSE is idempotent, so a\n2803: // switch inside reconciledBackendUrl (stale-SSH fallback, tunnel target) plus\n2804: // the trailing call still leaves exactly one live stream\n... (showing lines 2755-2804 of 2811; use offset=2805 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789632866.952497, "id": "9589901809af", "tool_call_id": "call_2881d95ca8284d508e4624fd", "content": "240:       try {\n241:         const url = await ensureWindowBackend(e.sender);\n242:         return url || DEFAULT_API_BASE;\n243:       } catch (err) {\n244:         tunnelLog(`[backend] api:base failed: ${err && err.message}`);\n245:         return DEFAULT_API_BASE;\n246:       }\n247:     });\n248: \n249:     // The flat mirror file the backend + LLM proxy read; the UI's localStorage\n250:     // is the source of truth, this file is (re)written on every UI save.\n251:     function writeSettingsFile(data) {\n252:       const p = path.join(os.homedir(), \".clutch\", \"settings.json\");\n253:       let cur = {};\n254:       try {\n255:         cur = JSON.parse(fs.readFileSync(p, \"utf-8\"));\n256:       } catch (e) {\n257:         /* first save: start from an empty file */\n258:       }\n259:       if (cur && cur.profiles) {\n260:         cur = cur.profiles[cur.active] || {}; // legacy map: keep the active profile's values\n261:       }\n262:       const upd = {};\n263:       for (const k of [\"base_url\", \"model\"]) {\n264:         if (data && data[k]) upd[k] = data[k];\n265:       }\n266:       if (data && data.api_key) upd.api_key = data.api_key;\n267:       // empty string clears the knob (provider default), undefined keeps it\n268:       if (data && data.reasoning_effort !== undefined) upd.reasoning_effort = data.reasoning_effort;\n269:       const flat = Object.assign({}, cur, upd);\n270:       fs.mkdirSync(path.dirname(p), { recursive: true });\n271:       fs.writeFileSync(p, JSON.stringify(flat, null, 2), { mode: 0o600 });\n272:     }\n273: \n274:     ipcMain.handle(\"settings:save\", async (_e, data) => {\n275:       try {\n276:         writeSettingsFile(data);\n277:         return { ok: true };\n278:       } catch (e) {\n279:         return { ok: false, error: String((e && e.message) || e) };\n280:       }\n281:     });\n282: \n283:     // Self-heal the mirror: settings.json is derived state that session\n284:     // children (LLM config) and the LLM proxy read, but only a UI save\n285:     // recreates it — if it went missing/corrupt while localStorage still holds\n286:     // the config, the next session spawn silently boots with an EMPTY LLM\n287:     // config. Rebuild from the renderer's copy, but ONLY when the file is\n288:     // missing/blank: an existing file may hold intentional manual edits.\n289:     ipcMain.handle(\"settings:ensure\", async (_e, data) => {\n290:       try {\n291:         let cur = {};\n292:         try {\n293:           cur = JSON.parse(fs.readFileSync(path.join(os.homedir(), \".clutch\", \"settings.json\"), \"utf-8\"));\n294:         } catch (e) {\n295:           /* missing/corrupt: heal below */\n296:         }\n297:         if (cur && (cur.base_url || cur.api_key || cur.model)) return { ok: true, healed: false };\n298:         writeSettingsFile(data);\n299:         tunnelLog(\"[settings] mirror missing — rebuilt ~/.clutch/settings.json from the UI config\");\n300:         return { ok: true, healed: true };\n301:       } catch (e) {\n302:         return { ok: false, error: String((e && e.message) || e) };\n303:       }\n304:     });\n305: \n306:     ipcMain.handle(\"tunnel:connect\", async (e, cfg) =>\n307:       tunnel.connectTunnel(cfg, (stage) => e.sender.send(\"tunnel:progress\", stage))\n308:     );\n309:     ipcMain.handle(\"tunnel:status\", async () => tunnel.tunnelStatus());\n310:     ipcMain.handle(\"tunnel:disconnect\", async () => {\n311:       // stop window backends first, while the tunnel/bridge is still alive\n312:       for (const id of [...windowBackends.keys()]) {\n313:         await releaseWindowBackend(id);\n314:       }\n... (showing lines 240-314 of 338; use offset=315 to continue)", "is_error": false, "diff": ""}
