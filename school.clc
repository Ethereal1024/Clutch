{"type": "tool_result", "timestamp": 1789816862.8292065, "id": "79f5ca5d7b9d", "tool_call_id": "call_350766133fec4b5597195c4d", "content": "2813: // ---- MCP web services (settings modal section) --------------------------------\n2814: // Rendered from GET /api/settings mcp_services records: a host without a\n2815: // service configured just sees the add button — nothing here prompts anyone to\n2816: // install anything, and no service name exists anywhere unless this machine's\n2817: // operator declared it. Rows edit the common fields (name, endpoint, tools);\n2818: // exotic mappings (args / field templates / list_key) round-trip untouched and\n2819: // are documented for hand-editing in settings.json.\n2820: (function initMcpServices() {\n2821:   const box = document.getElementById(\"mcp-services\");\n2822:   if (!box) return;\n2823: \n2824:   let records = []; // last loaded records; a save round-trips fields the form does not show\n2825: \n2826:   function statusText(st) {\n2827:     if (!st || !st.configured) return \"\";\n2828:     if (st.enabled === false) return \"disabled\";\n2829:     if (st.reachable === false) return \"unreachable\";\n2830:     if (st.login === true) return \"connected · logged in\";\n2831:     if (st.login === false) return \"connected · not logged in\";\n2832:     return \"connected\";\n2833:   }\n2834: \n2835:   function inputRow(placeholder, value) {\n2836:     const input = document.createElement(\"input\");\n2837:     input.type = \"text\";\n2838:     input.autocomplete = \"off\";\n2839:     input.placeholder = placeholder;\n2840:     input.value = value || \"\";\n2841:     return input;\n2842:   }\n2843: \n2844:   function rowFor(rec) {\n2845:     rec = rec || {};\n2846:     const wrap = document.createElement(\"div\");\n2847:     wrap.className = \"mcp-service\";\n2848:     wrap.style.marginBottom = \"10px\";\n2849:     wrap.dataset.rec = JSON.stringify(rec);\n2850: \n2851:     const top = document.createElement(\"div\");\n2852:     top.className = \"fs-conn-row\";\n2853:     top.style.marginBottom = \"4px\";\n2854:     const name = inputRow(\"name (a-z 0-9 -)\", rec.name);\n2855:     name.style.maxWidth = \"150px\";\n2856:     const url = inputRow(\"http://localhost:port/mcp\", rec.url);\n2857:     const status = document.createElement(\"span\");\n2858:     status.className = \"dim\";\n2859:     const del = document.createElement(\"button\");\n2860:     del.type = \"button\";\n2861:     del.title = \"remove this service\";\n2862:     del.textContent = \"✕\";\n2863:     del.addEventListener(\"click\", () => wrap.remove());\n2864:     top.append(name, url, status, del);\n2865: \n2866:     const tools = document.createElement(\"div\");\n2867:     tools.className = \"fs-conn-row\";\n2868:     tools.append(inputRow(\"search tool name\", rec.search_tool), inputRow(\"status tool (optional)\", rec.status_tool));\n2869: \n2870:     wrap.append(top, tools);\n2871:     return wrap;\n2872:   }\n2873: \n2874:   function render(services) {\n2875:     box.textContent = \"\";\n2876:     records = services || [];\n2877:     const title = document.createElement(\"label\");\n2878:     title.textContent = \"Web services (optional)\";\n2879:     title.style.marginTop = \"16px\";\n2880:     box.appendChild(title);\n2881:     for (const rec of records) box.appendChild(rowFor(rec));\n2882: \n2883:     const addRow = document.createElement(\"div\");\n2884:     addRow.className = \"fs-conn-row\";\n2885:     const add = document.createElement(\"button\");\n2886:     add.type = \"button\";\n2887:     add.textContent = \"＋ Add service\";\n2888:     add.addEventListener(\"click\", () => {\n2889:       box.insertBefore(rowFor({}), addRow);\n2890:       refreshStatus();\n2891:     });\n2892:     addRow.appendChild(add);\n2893:     box.appendChild(addRow);\n2894: \n2895:     const actions = document.createElement(\"div\");\n2896:     actions.className = \"fs-conn-row\";\n2897:     const save = document.createElement(\"button\");\n2898:     save.id = \"mcp-services-save\";\n2899:     save.className = \"primary\";\n2900:     save.textContent = \"Save web services\";\n2901:     const hint = document.createElement(\"span\");\n2902:     hint.className = \"dim\";\n2903:     actions.append(save, hint);\n2904:     box.appendChild(actions);\n2905: \n2906:     save.addEventListener(\"click\", async () => {\n2907:       const payload = [];\n2908:       let bad = \"\";\n2909:       box.querySelectorAll(\".mcp-service\").forEach((wrap) => {\n2910:         const inputs = wrap.querySelectorAll(\"input\");\n2911:         const name = inputs[0].value.trim();\n2912:         if (!/^[a-z0-9][a-z0-9_-]{0,63}$/.test(name)) {\n2913:           bad = \"each service needs a name matching a-z 0-9 -\";\n2914:           return;\n2915:         }\n2916:         // the stored record keeps the fields this form does not show (label,\n2917:         // args, field mappings, list_key) so a save never silently drops them\n2918:         const base = JSON.parse(wrap.dataset.rec || \"{}\");\n2919:         payload.push({\n2920:           ...base,\n2921:           name,\n2922:           url: inputs[1].value.trim().replace(/\\/+$/, \"\"),\n2923:           search_tool: inputs[2].value.trim(),\n2924:           status_tool: inputs[3].value.trim(),\n2925:         });\n2926:       });\n2927:       if (bad) {\n2928:         hint.textContent = bad;\n2929:         return;\n2930:       }\n2931:       try {\n2932:         await apiFetch(\"/api/settings\", { method: \"POST\", body: { mcp_services: payload } });\n2933:         records = payload;\n2934:         hint.textContent = \"saved\";\n2935:         refreshStatus();\n2936:       } catch (e) {\n2937:         hint.textContent = \"save failed: \" + ((e && e.message) || e);\n2938:       }\n2939:     });\n2940:   }\n2941: \n2942:   async function refreshStatus() {\n2943:     try {\n2944:       const st = await apiFetch(\"/api/mcp_status\");\n2945:       const byName = {};\n2946:       for (const row of (st && st.services) || []) byName[row.name] = row;\n2947:       box.querySelectorAll(\".mcp-service\").forEach((wrap) => {\n2948:         const name = wrap.querySelector(\"input\").value.trim();\n2949:         const el = wrap.querySelector(\".dim\");\n2950:         if (el) el.textContent = statusText(byName[name]);\n2951:       });\n2952:     } catch (e) {\n2953:       /* status is best-effort */\n2954:     }\n2955:   }\n2956: \n2957:   // (re)render every time the settings modal opens, so values stay fresh\n2958:   $(\"#settings-btn\").addEventListener(\"click\", async () => {\n2959:     try {\n2960:       const s = await apiFetch(\"/api/settings\");\n2961:       render(s.mcp_services || []);\n2962:       refreshStatus();\n2963:     } catch (e) {\n2964:       /* settings API down: the section stays empty */\n2965:     }\n2966:   });\n2967: })();", "is_error": false, "diff": ""}
