ystem += \"\\n\\n\" + catalog\n174:     if workspace is not None:\n175:         # local shell the model's commands will execute under: on a Windows\n176:         # host say so up front so the first command already speaks the right\n177:         # dialect. posix-sh (POSIX hosts, and remote/SSH workspaces whose\n178:         # exec_shell is the POSIX constant) adds nothing — zero prompt diff.\n179:         sh = workspace.exec_shell()\n180:         if sh.name == \"bash\":\n181:             system += \"\\n\\n\" + render(\"env_windows_bash.md\")\n182:         elif sh.name == \"cmd\":\n183:             system += \"\\n\\n\" + render(\"env_windows_cmd.md\")\n184:     if memories is not None:\n185:         items = memories.items()\n186:         if items:\n187:             # complete title list up front; search stays as content-recall fallback\n188:             titles = [m.title for m in sorted(items.values(), key=lambda m: -m.updated)]\n189:             system += (\n190:                 \"\\n\\nProject memories from earlier sessions (complete set, newest first) — \"\n191:                 \"load_memory with the exact title for its content; only search_memory \"\n192:                 \"when no listed title matches:\\n\"\n193:                 + \"\\n\".join(f\"- {t}\" for t in titles)\n194:             )\n195:         else:\n196:             # empty store stated explicitly, so the model skips probing\n197:             system += \"\\n\\nProject memories from earlier sessions: none stored yet.\"\n198: \n199:     return (\n200:         [\n201:             {\"role\": \"system\", \"content\": system},\n202:             {\"role\": \"user\", \"content\": render(\"task.md\", task=task)},\n203:         ]\n204:         + head_msgs\n205:         + msgs\n206:     )", "is_error": false, "diff": ""}
