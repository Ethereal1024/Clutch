{"type": "tool_result", "timestamp": 1789815033.7859013, "id": "3799103b190d", "tool_call_id": "call_4905d5432c2141c986fd01d0", "content": "15: # Persisted settings fields: flat, no provider presets\n16: _SETTING_FIELDS = (\"base_url\", \"model\", \"api_key\", \"reasoning_effort\")\n17: \n18: \n19: def flatten_settings(saved: dict) -> dict:\n20:     \"\"\"Normalize a settings file into the flat field map (known fields only);\n21:     legacy {profiles, active} maps collapse to the active profile.\"\"\"\n22:     if isinstance(saved, dict) and isinstance(saved.get(\"profiles\"), dict):\n23:         saved = saved.get(\"profiles\", {}).get(saved.get(\"active\") or \"\", {}) or {}\n24:     return {k: saved[k] for k in _SETTING_FIELDS if isinstance(saved, dict) and saved.get(k)}\n25: \n26: \n27: @dataclass\n28: class Config:\n29:     # LLM endpoint: settings modal / env (CLUTCH_*) / CLI; empty = not configured yet\n30:     model: str = field(default_factory=lambda: os.environ.get(\"CLUTCH_MODEL\", \"\"))\n31:     base_url: str = field(default_factory=lambda: os.environ.get(\"CLUTCH_BASE_URL\", \"\"))\n32:     api_key: str | None = field(default_factory=lambda: os.environ.get(\"CLUTCH_API_KEY\"))\n33:     # LLM request tuning\n34:     llm_request_timeout: float = 60.0\n35:     # Streaming read budget. httpx's read timeout bounds the GAP between two\n36:     # chunks, not the total response time, so reusing request_timeout for it\n37:     # kills any stream whose provider stalls (or whose buffering relay flushes\n38:     # only at the end) for over 60s — the classic \"network is fine yet request\n39:     # timed out\". Connect stays tight (fail fast on dead routes) and reads get\n40:     # their own generous budget; see llm_clients/openai_client.py.\n41:     llm_read_timeout: float = 240.0\n42:     llm_max_retries: int = 3\n... (showing lines 15-42 of 123; use offset=43 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789815033.7911913, "id": "8b26a1f41878", "tool_call_id": "call_92db23f453b54d7aa7e9bcd0", "content": "110: def _login_state(state: Any) -> bool | None:\n111:     \"\"\"Best-effort normalization of a provider's login-status payload.\"\"\"\n112:     truthy = (\"logged_in\", \"logged in\", \"true\", \"yes\", \"ok\", \"success\")\n113:     if isinstance(state, bool):\n114:         return state\n115:     if isinstance(state, str):\n116:         return state.strip().lower() in truthy\n117:     if isinstance(state, dict):\n118:         for key in (\"login\", \"logged_in\", \"is_logged_in\", \"logged_in_status\", \"status\"):\n119:             v = state.get(key)\n120:             if isinstance(v, bool):\n121:                 return v\n122:             if isinstance(v, str):\n123:                 return v.strip().lower() in truthy\n124:     return None\n125: \n126: \n127: class HttpAgentServer(BaseServer):\n... (showing lines 110-127 of 884; use offset=128 to continue)", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1789815033.8009288, "id": "8e78e7a20b28", "tool_call_id": "call_66891d379384416194385639", "content": "1: \"\"\"Offline checks for the MCP web-search plugin layer (loopback HTTP only).\n2: \n3: Run: python -m tests.mcpbackend_test\n4: \n5: Covers: provider URL resolution (settings > env), result mapping tolerance,\n6: the JSON-RPC client (handshake, session id, SSE frames, plain-text and error\n7: paths) against a real loopback server, backend gating (an MCP backend exists\n8: only when configured — and is named nowhere when it is not), error-as-data\n9: degradation, and dynamic rendering of prompt + schema.\n10: \"\"\"\n11: \n12: from __future__ import annotations\n13: \n14: import json\n15: import os\n16: import sys\n17: import threading\n18: from http.server import BaseHTTPRequestHandler, HTTPServer\n19: \n20: import agent.tools.websearch as ws\n21: from agent.config import Config\n22: from agent.server import _login_state, _mcp_keys_from, _split_mcp_fields, mcp_providers\n23: from agent.tools.mcpprovider import MCP_PROVIDERS\n24: from agent.tools.registry import build_default_tools\n25: from tests.testsupport import check\n26: \n27: \n28: # ---- loopback MCP server ------------------------------------------------------\n29: \n30: class _Handler(BaseHTTPRequestHandler):\n31:     \"\"\"Scripted MCP server: initialize -> initialized -> tools/call.\"\"\"\n32: \n33:     behavior = \"json\"  # json | sse | text | error | rpcerror | empty\n34: \n35:     def log_message(self, *a):  # silence the test run\n36:         pass\n37: \n38:     def do_POST(self):  # noqa: N802 (stdlib naming)\n39:         length = int(self.headers.get(\"Content-Length\", 0))\n40:         body = json.loads(self.rfile.read(length) or b\"{}\")\n41:         method = body.get(\"method\", \"\")\n42: \n43:         if method == \"initialize\":\n44:             payload = {\"jsonrpc\": \"2.0\", \"id\": 1, \"result\": {\"protocolVersion\": ws._MCP_PROTO}}\n45:             self.send_response(200)\n46:             self.send_header(\"Content-Type\", \"application/json\")\n47:             self.send_header(\"Mcp-Session-Id\", \"sess-42\")\n48:             self.end_headers()\n49:             self.wfile.write(json.dumps(payload).encode())\n50:             return\n51: \n52:         if method == \"notifications/initialized\":\n53:             self.send_response(202)\n54:             self.end_headers()\n55:             return\n56: \n57:         call = self.path.strip(\"/\") or _Handler.behavior\n58:         if call == \"error\":\n59:             self.send_response(500)\n60:             self.end_headers()\n61:             self.wfile.write(b\"boom\")\n62:             return\n63:         if call == \"rpcerror\":\n64:             payload = {\"jsonrpc\": \"2.0\", \"id\": 2, \"error\": {\"code\": -32602, \"message\": \"bad params\"}}\n65:         elif call == \"text\":\n66:             payload = {\"jsonrpc\": \"2.0\", \"id\": 2, \"result\": {\"content\": [{\"type\": \"text\", \"text\": \"just words\"}]}}\n67:         elif call == \"empty\":\n68:             self.send_response(202)\n69:             self.end_headers()\n70:             return\n71:         else:\n72:             rows = json.dumps([{\"id\": \"abc\", \"title\": \"Note\", \"desc\": \"d\", \"xsec_token\": \"T\"}])\n73:             payload = {\"jsonrpc\": \"2.0\", \"id\": 2, \"result\": {\"content\": [{\"type\": \"text\", \"text\": rows}]}}\n74:         text = json.dumps(payload)\n75:         if call == \"sse\":\n76:             self.send_response(200)\n77:             self.send_header(\"Content-Type\", \"text/event-stream\")\n78:             self.end_headers()\n79:             self.wfile.write(f\"event: message\\ndata: {text}\\n\\n\".encode())\n80:             return\n81:         self.send_response(200)\n82:         self.send_header(\"Content-Type\", \"application/json\")\n83:         self.end_headers()\n84:         self.wfile.write(text.encode())\n85: \n86: \n87: def main() -> None:\n88:     xhs = MCP_PROVIDERS[\"xiaohongshu\"]\n89: \n90:     # 1. URL resolution: config dict wins over env, trailing / stripped\n91:     check(xhs.url_for(Config()) == \"\", \"provider without config resolves to ''\")\n92:     os.environ[\"CLUTCH_MCP_XIAOHONGSHU_URL\"] = \"http://env.example/mcp\"\n93:     try:\n94:         check(xhs.url_for(Config()) == \"http://env.example/mcp\", \"env CLUTCH_MCP_<NAME>_URL is the fallback\")\n95:     finally:\n96:         del os.environ[\"CLUTCH_MCP_XIAOHONGSHU_URL\"]\n97:     cfg = Config()\n98:     cfg.mcp_urls[\"xiaohongshu\"] = \"http://localhost:18060/mcp/\"\n99:     check(xhs.url_for(cfg) == \"http://localhost:18060/mcp\", \"config beats env; trailing / stripped\")\n100: \n101:     # 2. result mapping: bare list and envelopes map; junk tolerated; token kept\n102:     feeds = [\n103:         {\"id\": \"abc\", \"title\": \"Note\", \"desc\": \"body\", \"xsec_token\": \"T0K\"},\n104:         {\"note_id\": \"n2\", \"title\": \"Second\", \"desc\": \"d2\"},\n105:         {\"title\": \"no id, dropped\"},\n106:         \"junk\",\n107:     ]\n108:     rows = xhs.map_results(feeds)\n109:     check(len(rows) == 2, \"mapping keeps only rows with an id\")\n110:     check(\n111:         rows[0][\"url\"] == \"https://www.xiaohongshu.com/explore/abc?xsec_token=T0K\",\n112:         \"mapping keeps xsec_token in the url\",\n113:     )\n114:     check(rows[1][\"url\"] == \"https://www.xiaohongshu.com/explore/n2\", \"mapping works without a token\")\n115:     check(xhs.map_results({\"data\": feeds}) == rows, \"mapping unwraps a data envelope\")\n116:     check(xhs.map_results({\"nope\": 1}) == [], \"mapping yields nothing on unknown shapes\")\n117: \n118:     # 3. settings-field helpers (server side)\n119:     body = {\"mcp_xiaohongshu\": \" http://localhost:18060/mcp/ \", \"mcp_bad\": \"ftp://x\", \"model\": \"m\"}\n120:     try:\n121:         _split_mcp_fields(body)\n122:         check(False, \"non-http mcp url rejected\")\n123:     except ValueError:\n124:         check(True, \"non-http mcp url rejected\")\n125:     clean = _split_mcp_fields({\"mcp_xiaohongshu\": \" http://h/mcp/ \", \"mcp_off\": \"\", \"api_key\": \"k\"})\n126:     check(clean == {\"mcp_xiaohongshu\": \"http://h/mcp\", \"mcp_off\": \"\"}, \"mcp fields normalized ('' clears)\")\n127:     check(_mcp_keys_from({\"mcp_x\": \"http://h\", \"base_url\": \"b\"}) == {\"mcp_x\": \"http://h\"}, \"mcp keys read back\")\n128:     check(_login_state({\"login\": True}) is True and _login_state({\"status\": \"logged_in\"}) is True,\n129:           \"login state normalized from common shapes\")\n130:     check(_login_state({\"whatever\": 1}) is None and _login_state(None) is None, \"unknown login shape -> None\")\n131: \n132:     # 4. JSON-RPC client against a real loopback server\n133:     srv = HTTPServer((\"127.0.0.1\", 0), _Handler)\n134:     threading.Thread(target=srv.serve_forever, daemon=True).start()\n135:     base = f\"http://127.0.0.1:{srv.server_port}\"\n136:     try:\n137:         data = ws._mcp_call(base + \"/\", \"search_feeds\", {\"keyword\": \"q\"}, 5.0)\n138:         check(isinstance(data, list) and data[0][\"id\"] == \"abc\", \"tools/call result parses as json\")\n139: \n140:         _Handler.behavior = \"sse\"\n141:         data = ws._mcp_call(base + \"/sse\", \"search_feeds\", {}, 5.0)\n142:         check(isinstance(data, list) and data[0][\"id\"] == \"abc\", \"SSE-framed reply handled\")\n143: \n144:         _Handler.behavior = \"text\"\n145:         check(ws._mcp_call(base + \"/text\", \"t\", {}, 5.0) == \"just words\", \"non-json text passes through\")\n146: \n147:         _Handler.behavior = \"empty\"\n148:         check(ws._mcp_call(base + \"/empty\", \"t\", {}, 5.0) == \"\", \"empty body (202) tolerated\")\n149: \n150:         _Handler.behavior = \"rpcerror\"\n151:         try:\n152:             ws._mcp_call(base + \"/rpcerror\", \"t\", {}, 5.0)\n153:             check(False, \"jsonrpc error raises WebError\")\n154:         except ws.WebError:\n155:             check(True, \"jsonrpc error raises WebError\")\n156: \n157:         _Handler.behavior = \"error\"\n158:         try:\n159:             ws._mcp_call(base + \"/error\", \"t\", {}, 5.0)\n160:             check(False, \"HTTP 500 raises WebError\")\n161:         except ws.WebError as e:\n162:             check(\"500\" in str(e), \"HTTP 500 raises a factual WebError\")\n163: \n164:         try:\n165:             ws._mcp_call(\"http://127.0.0.1:1/mcp\", \"t\", {}, 1.0)\n166:             check(False, \"refused connection raises WebError\")\n167:         except ws.WebError as e:\n168:             check(\"unreachable\" in str(e) or \"timed out\" in str(e), \"refused connection is a factual status\")\n169:     finally:\n170:         srv.shutdown()\n171:         srv.server_close()\n172: \n173:     # 5. gating: unconfigured -> the backend does not exist anywhere\n174:     plain = Config()\n175:     avail = ws.available_backends(plain)\n176:     check(\"xiaohongshu\" not in avail, \"unconfigured mcp backend absent from the chain\")\n177:     check(\"bing\" in avail and \"ddg\" in avail, \"keyless backends always available\")\n178:     r = ws.web_search(None, plain, \"q\", backend=\"xiaohongshu\")\n179:     check(r.get(\"error\") and \"available: \" in r[\"content\"], \"pinning an unconfigured backend errors factually\")\n180:     check(\"install\" not in r[\"content\"].lower() and \"needs CLUTCH_\" not in r[\"content\"],\n181:           \"error never suggests installing or setting env vars\")\n182:     check(\"searxng\" not in r[\"content\"], \"unconfigured siblings are not named either\")\n183:     r = ws.web_search(None, plain, \"q\", backend=\"nope\")\n184:     check(r.get(\"error\") and \"available: \" in r[\"content\"] and \"needs CLUTCH_\" not in r[\"content\"],\n185:           \"unknown backend lists only the real ones, no setup advice\")\n186: \n187:     # 6. configured -> the backend joins the chain and serves mapped results\n188:     cfg2 = Config()\n189:     cfg2.mcp_urls[\"xiaohongshu\"] = base  # server is shut down: status-only impact below\n190:     check(\"xiaohongshu\" in ws.available_backends(cfg2), \"configured mcp backend joins the chain\")\n191: \n192:     real_rpc = ws._mcp_rpc\n193: \n194:     def fake_rpc(url, payload, session, timeout, cancel=None):\n195:         if payload.get(\"method\") == \"initialize\":\n196:             return {\"result\": {}}, \"sess-1\"\n197:         if payload.get(\"method\") == \"notifications/initialized\":\n198:             return {}, session\n199:         rows_json = json.dumps([{\"id\": \"f1\", \"title\": \"Found\", \"desc\": \"snippet\", \"xsec_token\": \"tk\"}])\n200:         return {\"result\": {\"content\": [{\"type\": \"text\", \"text\": rows_json}]}}, session\n201: \n202:     ws._mcp_rpc = fake_rpc\n203:     try:\n204:         r = ws.web_search(None, cfg2, \"note\", backend=\"xiaohongshu\")\n205:         check(\n206:             not r.get(\"error\") and \"Found\" in r[\"content\"] and \"xsec_token=tk\" in r[\"content\"],\n207:             \"web_search serves mapped mcp results end to end\",\n208:         )\n209: \n210:         def dead_rpc(*a, **k):\n211:             raise ws.WebError(\"MCP server unreachable (refused): http://localhost:18060/mcp\")\n212: \n213:         ws._mcp_rpc = dead_rpc\n214:         r = ws.web_search(None, cfg2, \"note\", backend=\"xiaohongshu\")\n215:         check(r.get(\"error\") and \"unreachable\" in r[\"content\"], \"mcp failure degrades to error-as-data\")\n216:     finally:\n217:         ws._mcp_rpc = real_rpc\n218: \n219:     # 7. prompt + schema render dynamically from the configured set\n220:     tools_plain = {t.name: t for t in build_default_tools(plain)}\n221:     tools_xhs = {t.name: t for t in build_default_tools(cfg2)}\n222:     check(\"xiaohongshu\" not in tools_plain[\"web_search\"].description,\n223:           \"prompt on an unconfigured host never names the mcp backend\")\n224:     check(\"xiaohongshu\" in tools_xhs[\"web_search\"].description,\n225:           \"prompt on a configured host names the mcp backend\")\n226:     check(\"bing | ddg\" in tools_plain[\"web_search\"].parameters[\"properties\"][\"backend\"][\"description\"],\n227:           \"schema backend param lists the real chain\")\n228:     check(len(mcp_providers()) == 1, \"server helper exposes the registry\")\n229: \n230:     print(\"all passed\")\n231: \n232: \n233: if __name__ == \"__main__\":\n234:     main()", "is_error": false, "diff": ""}
{"type": "assistant_message", "timestamp": 1789815228.1577067, "id": "e0df070f826d", "content": "区域全部读准。开始重写——第一步：`mcpprovider.py` 从\"平台注册表\"变成纯声明式引擎（零平台名）：", "tool_calls": [{"id": "call_e8025ff008ff45cd9ae41dce", "name": "write_file", "arguments": "{\"path\":\"agent/tools/mcpprovider.py\",\"content\":\"\\\"\\\"\\\"Operator-configured MCP tool servers that extend web search.\\n\\nThe agent core carries NO opinions about which services exist: every MCP\\nsource is a declarative record from the settings file (Config.mcp_services),\\nsaying how to CALL a search tool and how to READ its reply:\\n\\n    {\\\"name\\\": \\\"notes\\\", \\\"url\\\": \\\"http://localhost:18060/mcp\\\",\\n     \\\"search_tool\\\": \\\"search_feeds\\\",\\n     \\\"args\\\": {\\\"keyword\\\": \\\"{query}\\\", \\\"limit\\\": \\\"{limit}\\\"},\\n     \\\"fields\\\": {\\\"title\\\": \\\"title\\\",\\n                \\\"url\\\": \\\"https://example.com/n/{id}?t={token}\\\",\\n                \\\"snippet\\\": \\\"desc | description\\\"},\\n     \\\"list_key\\\": \\\"\\\",                       # \\\"\\\" = auto-unwrap common envelopes\\n     \\\"status_tool\\\": \\\"check_login_status\\\", \\\"login_field\\\": \\\"logged_in\\\"}\\n\\nNo platform is ever named in code: a service the operator did not declare\\nsimply does not exist — it is named nowhere, suggested nowhere, rendered\\nnowhere. Adding a source is editing config, not shipping a build.\\n\\nField mappings: \\\"a | b\\\" tries alternatives, \\\"a.b\\\" descends into nesting,\\nand a url value containing \\\"{\\\" is a template whose {placeholders} are filled\\nfrom the result row (percent-encoded). One generic engine serves every\\nwell-formed service; only genuinely exotic payloads would ever need code.\\n\\nImport-safe from anywhere: stdlib only, no agent-package imports.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport re\\nimport urllib.parse\\nfrom dataclasses import asdict, dataclass, field\\nfrom typing import Any\\n\\n_NAME_RE = re.compile(r\\\"^[a-z0-9][a-z0-9_-]{0,63}$\\\")\\n_PLACEHOLDER_RE = re.compile(r\\\"\\\\{([a-z_][a-z0-9_]*)\\\\}\\\")\\n\\n# Mappings used when a record overrides nothing: probe the usual suspects.\\nDEFAULT_FIELDS = {\\n    \\\"title\\\": \\\"title | name\\\",\\n    \\\"url\\\": \\\"url | link | href\\\",\\n    \\\"snippet\\\": \\\"desc | description | snippet | summary | content\\\",\\n}\\n# Envelope keys the auto-unwrap checks when list_key is \\\"\\\".\\n_LIST_WRAP_KEYS = (\\\"data\\\", \\\"items\\\", \\\"feeds\\\", \\\"results\\\", \\\"notes\\\")\\n\\n\\n@dataclass(frozen=True)\\nclass McpService:\\n    \\\"\\\"\\\"One operator-declared MCP tool server usable as a search backend.\\\"\\\"\\\"\\n\\n    name: str                                        # backend name (backend=<name>)\\n    url: str                                         # MCP endpoint; \\\"\\\" = not configured\\n    search_tool: str = \\\"\\\"                            # tool invoked for searches\\n    enabled: bool = True\\n    label: str = \\\"\\\"                                  # settings-UI display name; defaults to name\\n    args: dict[str, Any] = field(default_factory=dict)    # {query}/{limit} templates\\n    fields: dict[str, str] = field(default_factory=dict)  # title/url/snippet mapping\\n    list_key: str = \\\"\\\"                               # dotted path to the result list; \\\"\\\" = auto\\n    status_tool: str = \\\"\\\"                            # optional tool reporting login state\\n    login_field: str = \\\"\\\"                            # its boolean-ish key; \\\"\\\" = probe common keys\\n\\n    def complete(self) -> bool:\\n        \\\"\\\"\\\"Ready to join the chain: endpoint + tool known. Field mappings always\\n        have defaults, so they alone cannot make a record incomplete.\\\"\\\"\\\"\\n        return bool(self.url and self.search_tool)\\n\\n    def record(self) -> dict[str, Any]:\\n        \\\"\\\"\\\"Canonical JSON shape — what settings.json stores, what the UI prefills.\\\"\\\"\\\"\\n        return asdict(self)\\n\\n\\ndef parse_service(raw: Any) -> McpService:\\n    \\\"\\\"\\\"Validate one settings record into an McpService; ValueError on junk.\\\"\\\"\\\"\\n    if not isinstance(raw, dict):\\n        raise ValueError(\\\"service entry must be an object\\\")\\n    name = str(raw.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n    if not _NAME_RE.match(name):\\n        raise ValueError(\\\"name must match [a-z0-9][a-z0-9_-]{0,63}\\\")\\n    url = str(raw.get(\\\"url\\\", \\\"\\\")).strip().rstrip(\\\"/\\\")\\n    if url and not url.startswith((\\\"http://\\\", \\\"https://\\\")):\\n        raise ValueError(f\\\"{name}: url must be an http(s) URL\\\")\\n    fields_in = raw.get(\\\"fields\\\") if isinstance(raw.get(\\\"fields\\\"), dict) else {}\\n    fields = dict(DEFAULT_FIELDS)\\n    for key in DEFAULT_FIELDS:\\n        override = str(fields_in.get(key, \\\"\\\")).strip()\\n        if override:\\n            fields[key] = override\\n    args_in = raw.get(\\\"args\\\") if isinstance(raw.get(\\\"args\\\"), dict) else {}\\n    enabled = str(raw.get(\\\"enabled\\\", True)).strip().lower() not in (\\\"false\\\", \\\"0\\\", \\\"no\\\", \\\"off\\\")\\n    return McpService(\\n        name=name,\\n        url=url,\\n        search_tool=str(raw.get(\\\"search_tool\\\", \\\"\\\")).strip(),\\n        enabled=enabled,\\n        label=str(raw.get(\\\"label\\\", \\\"\\\")).strip(),\\n        args={str(k): v for k, v in args_in.items()},\\n        fields=fields,\\n        list_key=str(raw.get(\\\"list_key\\\", \\\"\\\")).strip(),\\n        status_tool=str(raw.get(\\\"status_tool\\\", \\\"\\\")).strip(),\\n        login_field=str(raw.get(\\\"login_field\\\", \\\"\\\")).strip(),\\n    )\\n\\n\\ndef parse_services(raw: Any) -> tuple[list[McpService], list[str]]:\\n    \\\"\\\"\\\"Parse a whole settings list; bad entries are skipped and reported, so a\\n    single broken record never takes the healthy ones down.\\\"\\\"\\\"\\n    if raw is None:\\n        return [], []\\n    if not isinstance(raw, list):\\n        return [], [\\\"mcp_services must be a list\\\"]\\n    services: list[McpService] = []\\n    errors: list[str] = []\\n    seen: set[str] = set()\\n    for i, item in enumerate(raw):\\n        try:\\n            service = parse_service(item)\\n        except ValueError as e:\\n            errors.append(f\\\"service[{i}]: {e}\\\")\\n            continue\\n        if service.name in seen:\\n            errors.append(f\\\"service[{i}]: duplicate name {service.name!r}\\\")\\n            continue\\n        seen.add(service.name)\\n        services.append(service)\\n    return services, errors\\n\\n\\n# ---- call side: templates ----------------------------------------------------\\n\\n\\ndef search_args(service: McpService, query: str, limit: int) -> dict[str, Any]:\\n    \\\"\\\"\\\"Build the tools/call arguments from the record's templates. A lone\\n    \\\"{placeholder}\\\" keeps the value's type ({limit} stays an int); mixed text\\n    interpolates into a string.\\\"\\\"\\\"\\n    values: dict[str, Any] = {\\\"query\\\": query, \\\"limit\\\": limit}\\n    return {key: _interpolate_value(val, values) for key, val in service.args.items()}\\n\\n\\ndef _interpolate_value(template: Any, values: dict[str, Any]) -> Any:\\n    if not isinstance(template, str):\\n        return template\\n    exact = _PLACEHOLDER_RE.fullmatch(template.strip())\\n    if exact:\\n        return values.get(exact.group(1), \\\"\\\")\\n    return _PLACEHOLDER_RE.sub(lambda m: str(values.get(m.group(1), \\\"\\\")), template)\\n\\n\\n# ---- read side: results ------------------------------------------------------\\n\\n\\ndef result_rows(service: McpService, data: Any) -> list[dict]:\\n    \\\"\\\"\\\"The list of result objects inside a tool reply: the record's list_key\\n    when given, else auto-unwrap a bare list or a common envelope key.\\\"\\\"\\\"\\n    if not isinstance(data, (list, dict)):\\n        return []\\n    if service.list_key:\\n        node: Any = data\\n        for part in service.list_key.split(\\\".\\\"):\\n            node = node.get(part) if isinstance(node, dict) else None\\n        rows = node if isinstance(node, list) else []\\n    elif isinstance(data, list):\\n        rows = data\\n    else:\\n        rows = next((data[k] for k in _LIST_WRAP_KEYS if isinstance(data.get(k), list)), [])\\n    return [row for row in rows if isinstance(row, dict)]\\n\\n\\ndef _field(row: dict, chain: str) -> Any:\\n    \\\"\\\"\\\"First non-empty hit in an \\\"a.b | alt\\\" chain; '' when nothing matches.\\\"\\\"\\\"\\n    for path in (p.strip() for p in chain.split(\\\"|\\\")):\\n        if not path:\\n            continue\\n        node: Any = row\\n        for part in path.split(\\\".\\\"):\\n            if isinstance(node, dict) and part in node:\\n                node = node[part]\\n            else:\\n                node = None\\n                break\\n        if node not in (None, \\\"\\\"):\\n            return node\\n    return \\\"\\\"\\n\\n\\ndef _map_url(spec: str, row: dict) -> str:\\n    \\\"\\\"\\\"A url mapping is a template (placeholders filled from the row,\\n    percent-encoded: ids and tokens are payload, never structure) or a field\\n    chain naming where the ready-made url lives.\\\"\\\"\\\"\\n    if \\\"{\\\" in spec:\\n        return _PLACEHOLDER_RE.sub(\\n            lambda m: urllib.parse.quote(str(row.get(m.group(1), \\\"\\\")), safe=\\\"\\\"), spec\\n        )\\n    return str(_field(row, spec))\\n\\n\\ndef map_results(service: McpService, data: Any) -> list[dict[str, str]]:\\n    \\\"\\\"\\\"Tool reply -> uniform [{title, url, snippet}] rows.\\\"\\\"\\\"\\n    out: list[dict[str, str]] = []\\n    for row in result_rows(service, data):\\n        url = _map_url(service.fields.get(\\\"url\\\", \\\"\\\"), row)\\n        if not url:\\n            continue  # a row with no address is not a result\\n        out.append(\\n            {\\n                \\\"title\\\": str(_field(row, service.fields.get(\\\"title\\\", \\\"\\\"))).strip(),\\n                \\\"url\\\": url,\\n                \\\"snippet\\\": str(_field(row, service.fields.get(\\\"snippet\\\", \\\"\\\"))).strip(),\\n            }\\n        )\\n    return out\\n\\n\\ndef normalize_login(state: Any, login_field: str = \\\"\\\") -> bool | None:\\n    \\\"\\\"\\\"Best-effort boolean from a status-tool payload (dict, string or bool);\\n    None when the shape says nothing recognizable.\\\"\\\"\\\"\\n    truthy = (\\\"logged_in\\\", \\\"logged in\\\", \\\"true\\\", \\\"yes\\\", \\\"ok\\\", \\\"success\\\")\\n    if isinstance(state, bool):\\n        return state\\n    if isinstance(state, str):\\n        return state.strip().lower() in truthy\\n    if isinstance(state, dict):\\n        keys = ([login_field] if login_field else []) + [\\n            \\\"login\\\",\\n            \\\"logged_in\\\",\\n            \\\"is_logged_in\\\",\\n            \\\"logged_in_status\\\",\\n            \\\"status\\\",\\n        ]\\n        for key in keys:\\n            if not key:\\n                continue\\n            v = state.get(key)\\n            if isinstance(v, bool):\\n                return v\\n            if isinstance(v, str):\\n                return v.strip().lower() in truthy\\n    return None\\n\"}"}], "reasoning": "I have everything. Now write the code. Order:\n\n1. **`agent/tools/mcpprovider.py`** — full rewrite (the declarative engine)\n2. **`agent/config.py`** — mcp_urls → mcp_services\n3. **`agent/tools/websearch.py`** — edits: import, _mcp_open helper + tools/list, _mcp_backend(service), _service_backends, _available_backends, web_search dict source, probe_service replacing mcp_status, module docstring line, error sanitization\n4. **`agent/server.py`** — edits: imports, helpers, _settings_post, _settings_get, _mcp_status, main()\n5. **`ui/app.js`** — rewrite the initMcpServices block\n6. **`README.md`** — update MCP paragraph\n7. **`tests/mcpbackend_test.py`** — full rewrite\n8. Run tests, fix, commit, push.\n\nLet me design the engine file carefully.\n\n```python\n\"\"\"User-configured MCP tool servers that extend web search.\n\nThe agent core carries NO opinions about which services exist: every MCP\nsource is a declarative record from the operator's settings\n(Config.mcp_services in ~/.clutch/settings.json), saying how to CALL a\nsearch tool and how to READ its reply:\n\n  {\"name\": \"xhs\", \"url\": \"http://localhost:18060/mcp\",\n   \"search_tool\": \"search_feeds\",\n   \"args\": {\"keyword\": \"{query}\", \"limit\": \"{limit}\"},\n   \"fields\": {\"title\": \"title\",\n              \"url\": \"https://example.com/n/{id}?t={token}\",\n              \"snippet\": \"desc | description\"},\n   \"list_key\": \"\",              # \"\" = auto-unwrap common envelopes\n   \"status_tool\": \"check_login_status\", \"login_field\": \"logged_in\"}\n\nNo platform names appear anywhere in this module or anywhere else in the\nagent: a service the operator never configured simply does not exist —\nit is named nowhere, suggested nowhere, rendered nowhere.\n\nImport-safe from anywhere: stdlib only, no agent-package imports.\n\"\"\"\n```\n\nWait — \"No platform names\" — the example in the docstring uses \"xhs\" and example.com — good, neutral.\n\nDataclass:\n\n```python\nfrom __future__ import annotations\n\nimport re\nimport urllib.parse\nfrom dataclasses import asdict, dataclass, field\nfrom typing import Any\n\n_NAME_RE = re.compile(r\"^[a-z0-9][a-z0-9_-]{0,63}$\")\n_PLACEHOLDER_RE = re.compile(r\"\\{([a-z_][a-z0-9_]*)\\}\")\n\n# Field chains when the record overrides nothing: probe the usual suspects\n# (first hit wins, \"|\" separates alternatives, \".\" descends into nesting).\nDEFAULT_FIELDS = {\n    \"title\": \"title | name\",\n    \"url\": \"url | link | href\",\n    \"snippet\": \"desc | description | snippet | summary | content\",\n}\n_LIST_WRAP_KEYS = (\"data\", \"items\", \"feeds\", \"results\", \"notes\")\n\n\n@dataclass(frozen=True)\nclass McpService:\n    \"\"\"One operator-declared MCP tool server usable as a search backend.\"\"\"\n\n    name: str                      # backend name (web_search backend=<name>)\n    url: str                       # MCP endpoint; \"\" = not configured\n    search_tool: str = \"\"          # tool invoked for searches\n    enabled: bool = True\n    label: str = \"\"                # settings-UI display name; defaults to name\n    args: dict[str, Any] = field(default_factory=dict)   # {query}/{limit} templates\n    fields: dict[str, str] = field(default_factory=dict) # title/url/snippet mapping\n    list_key: str = \"\"             # dotted path to the result list; \"\" = auto\n    status_tool: str = \"\"          # optional tool reporting login state\n    login_field: str = \"\"          # its boolean-ish key; \"\" = probe common keys\n\n    def complete(self) -> bool:\n        \"\"\"Ready to join the chain: endpoint + tool known. Fields always have\n        usable defaults, so they cannot make a record incomplete.\"\"\"\n        return bool(self.url and self.search_tool)\n\n    def record(self) -> dict[str, Any]:\n        \"\"\"Canonical JSON-shaped dict (what settings.json stores, what the UI\n        prefills with).\"\"\"\n        return asdict(self)\n```\n\nparse_service:\n\n```python\ndef parse_service(raw: Any) -> McpService:\n    \"\"\"Validate one settings record into an McpService; ValueError on junk.\"\"\"\n    if not isinstance(raw, dict):\n        raise ValueError(\"service entry must be an object\")\n    name = str(raw.get(\"name\", \"\")).strip().lower()\n    if not _NAME_RE.match(name):\n        raise ValueError(\"name must match [a-z0-9][a-z0-9_-]{0,63}\")\n    url = str(raw.get(\"url\", \"\")).strip().rstrip(\"/\")\n    if url and not url.startswith((\"http://\", \"https://\")):\n        raise ValueError(f\"{name}: url must be an http(s) URL\")\n    fields_in = raw.get(\"fields\") if isinstance(raw.get(\"fields\"), dict) else {}\n    fields = dict(DEFAULT_FIELDS)\n    for key in DEFAULT_FIELDS:\n        override = str(fields_in.get(key, \"\")).strip()\n        if override:\n            fields[key] = override\n    args_in = raw.get(\"args\") if isinstance(raw.get(\"args\"), dict) else {}\n    enabled_raw = raw.get(\"enabled\", True)\n    enabled = str(enabled_raw).strip().lower() not in (\"false\", \"0\", \"no\", \"off\")\n    return McpService(\n        name=name,\n        url=url,\n        search_tool=str(raw.get(\"search_tool\", \"\")).strip(),\n        enabled=enabled,\n        label=str(raw.get(\"label\", \"\")).strip(),\n        args={str(k): v for k, v in args_in.items()},\n        fields=fields,\n        list_key=str(raw.get(\"list_key\", \"\")).strip(),\n        status_tool=str(raw.get(\"status_tool\", \"\")).strip(),\n        login_field=str(raw.get(\"login_field\", \"\")).strip(),\n    )\n\n\ndef parse_services(raw: Any) -> tuple[list[McpService], list[str]]:\n    \"\"\"Parse a whole settings list; bad entries are skipped and reported, so\n    one broken record never takes down the healthy ones.\"\"\"\n    if not isinstance(raw, list):\n        return [], ([] if raw is None else [\"mcp_services must be a list\"])\n    services: list[McpService] = []\n    errors: list[str] = []\n    seen: set[str] = set()\n    for i, item in enumerate(raw):\n        try:\n            service = parse_service(item)\n        except ValueError as e:\n            errors.append(f\"service[{i}]: {e}\")\n            continue\n        if service.name in seen:\n            errors.append(f\"service[{i}]: duplicate name {service.name!r}\")\n            continue\n        seen.add(service.name)\n        services.append(service)\n    return services, errors\n```\n\ntemplates:\n\n```python\ndef search_args(service: McpService, query: str, limit: int) -> dict[str, Any]:\n    \"\"\"Build the tools/call arguments from the record's templates. A lone\n    \"{placeholder}\" keeps the value's type ({limit} stays an int); mixed\n    text interpolates as a string.\"\"\"\n    values: dict[str, Any] = {\"query\": query, \"limit\": limit}\n    return {key: _interpolate_value(val, values) for key, val in (service.args or {}).items()}\n\n\ndef _interpolate_value(template: Any, values: dict[str, Any]) -> Any:\n    if not isinstance(template, str):\n        return template\n    exact = _PLACEHOLDER_RE.fullmatch(template.strip())\n    if exact:\n        return values.get(exact.group(1), \"\")\n    return _PLACEHOLDER_RE.sub(lambda m: str(values.get(m.group(1), \"\")), template)\n\n\ndef _interpolate_url(template: str, row: dict) -> str:\n    # URL templates percent-encode each placeholder: ids and tokens are path/\n    # query payload, never structure.\n    return _PLACEHOLDER_RE.sub(\n        lambda m: urllib.parse.quote(str(row.get(m.group(1), \"\")), safe=\"\"), template\n    )\n\n\ndef _field(row: dict, chain: str) -> Any:\n    \"\"\"First non-empty hit in a \"a.b | alt\" chain; '' when nothing matches.\"\"\"\n    for path in (p.strip() for p in chain.split(\"|\")):\n        if not path:\n            continue\n        node: Any = row\n        for part in path.split(\".\"):\n            if isinstance(node, dict) and part in node:\n                node = node[part]\n            else:\n                node = None\n                break\n        if node not in (None, \"\"):\n            return node\n    return \"\"\n\n\ndef result_rows(service: McpService, data: Any) -> list[dict]:\n    \"\"\"The list of result objects inside a tool reply: the record's list_key\n    when given, else auto-unwrap a bare list or a common envelope key.\"\"\"\n    if not isinstance(data, (list, dict)):\n        return []\n    if service.list_key:\n        node: Any = data\n        for part in service.list_key.split(\".\"):\n            node = node.get(part) if isinstance(node, dict) else None\n        rows = node if isinstance(node, list) else []\n    elif isinstance(data, list):\n        rows = data\n    else:\n        rows = next((data[k] for k in _LIST_WRAP_KEYS if isinstance(data.get(k), list)), [])\n    return [row for row in rows if isinstance(row, dict)]\n\n\ndef map_results(service: McpService, data: Any) -> list[dict[str, str]]:\n    \"\"\"Tool reply -> uniform [{title, url, snippet}] rows.\"\"\"\n    out: list[dict[str, str]] = []\n    for row in result_rows(service, data):\n        url_spec = service.fields.get(\"url\", \"\")\n        url = _interpolate_url(url_spec, row) if \"{\" in url_spec else str(_field(row, url_spec))\n        if not url:\n            continue  # a row with no address is not a result\n        out.append(\n            {\n                \"title\": str(_field(row, service.fields.get(\"title\", \"title\"))).strip(),\n                \"url\": url,\n                \"snippet\": str(_field(row, service.fields.get(\"snippet\", \"\"))).strip(),\n            }\n        )\n    return out\n\n\ndef normalize_login(state: Any, login_field: str = \"\") -> bool | None:\n    \"\"\"Best-effort boolean from a status-tool payload (dict, string or bool).\"\"\"\n    truthy = (\"logged_in\", \"logged in\", \"true\", \"yes\", \"ok\", \"success\")\n    if isinstance(state, bool):\n        return state\n    if isinstance(state, str):\n        return state.strip().lower() in truthy\n    if isinstance(state, dict):\n        keys = ([login_field] if login_field else []) + [\n            \"login\", \"logged_in\", \"is_logged_in\", \"logged_in_status\", \"status\",\n        ]\n        for key in keys:\n            if not key:\n                continue\n            v = state.get(key)\n            if isinstance(v, bool):\n                return v\n            if isinstance(v, str):\n                return v.strip().lower() in truthy\n    return None\n```\n\nOld _xhs_map also had `note_id` fallback and skipped rows without id — generic engine drops rows without URL. Fine — the record's url field decides. \n\nNote about asdict on frozen dataclass with dict fields — works.\n\nNow **config.py** edit: replace lines ~84-88:\n\n```python\n    # Optional MCP tool servers doubling as search backends, keyed by provider\n    # name (see tools/mcpprovider.py), e.g. {\"xiaohongshu\": \"http://localhost:18060/mcp\"}.\n    # Populated from settings.json keys mcp_<name> or CLUTCH_MCP_<NAME>_URL;\n    # empty means the backend does not exist on this machine at all.\n    mcp_urls: dict[str, str] = field(default_factory=dict)\n```\n→\n```python\n    # Operator-declared MCP tool servers usable as search backends: declarative\n    # records from settings.json (shape in tools/mcpprovider.py). Empty means\n    # this machine has no such service — the backend then does not exist and is\n    # named nowhere (prompts, errors, UI all stay neutral).\n    mcp_services: list[dict] = field(default_factory=list)\n```\n\n**websearch.py** edits:\n\n(a) module docstring backend list: after ddg line add:\n```\n   mcp      operator-declared MCP tool servers (settings.json \"mcp_services\",\n            shape in tools/mcpprovider.py) — appended after the native chain\n```\n\n(b) import: `from .mcpprovider import McpProvider, MCP_PROVIDERS` →\n```python\nfrom .mcpprovider import McpService\nfrom .mcpprovider import map_results as _service_results\nfrom .mcpprovider import normalize_login as _normalize_login\nfrom .mcpprovider import parse_services as _parse_services\nfrom .mcpprovider import search_args as _service_args\n```\nIsort-ish; simpler single block. Fine.\n\n(c) error sanitization in _mcp_rpc: messages:\n- `f\"HTTP {e.code} from MCP server {url}\"` → origin\n- `f\"MCP server timed out after {timeout:.0f}s: {url}\"` → origin\n- `f\"MCP server unreachable ({reason}): {url}\"` → origin\nAdd helper before _mcp_rpc:\n```python\ndef _origin(url: str) -> str:\n    \"\"\"scheme://host[:port] of an endpoint — error text carries this instead of\n    the full URL, whose path/query can hold tokens (same redaction stance as\n    the settings UI).\"\"\"\n    parts = urllib.parse.urlsplit(url)\n    return urllib.parse.urlunsplit((parts.scheme, parts.netloc, \"\", \"\", \"\")) or url\n```\nEdit three f-strings. HTTP 500 case: test expects \"500\" in str(e) — keep \"HTTP {e.code} from MCP server {origin}\". Test \"refused connection raises WebError\" expects \"unreachable\" or \"timed out\" — kept.\n\n(d) _mcp_open + tools/list:\n\n```python\ndef _mcp_open(url: str, timeout: float, cancel: Any = None) -> str | None:\n    \"\"\"initialize -> notifications/initialized; returns the session id.\"\"\"\n    hello = {...}\n    _, session = _mcp_rpc(url, hello, None, timeout, cancel)\n    if session:\n        _mcp_rpc(url, {\"jsonrpc\": \"2.0\", \"method\": \"notifications/initialized\"}, session, timeout, cancel)\n    return session\n```\nThen _mcp_call uses it:\n```python\ndef _mcp_call(url, tool, args, timeout, cancel=None):\n    \"\"\"initialize -> tools/call ...\"\"\"\n    session = _mcp_open(url, timeout, cancel)\n    resp, _ = _mcp_rpc(url, {...tools/call...}, session, timeout, cancel)\n    ...\n```\n\nAnd:\n```python\ndef _mcp_tools_list(url: str, timeout: float, cancel: Any = None) -> list[dict]:\n    \"\"\"tools/list — the generic capability probe behind /api/mcp_status.\"\"\"\n    session = _mcp_open(url, timeout, cancel)\n    resp, _ = _mcp_rpc(\n        url,\n        {\"jsonrpc\": \"2.0\", \"id\": 2, \"method\": \"tools/list\", \"params\": {}},\n        session,\n        timeout,\n        cancel,\n    )\n    tools = (resp.get(\"result\") or {}).get(\"tools\") or []\n    return [t for t in tools if isinstance(t, dict)]\n```\n\n(e) backend section replacement (lines 549-570):\n\n```python\ndef _mcp_backend(service: McpService) -> Backend:\n    \"\"\"Adapt an operator-declared MCP service to the uniform Backend shape.\"\"\"\n\n    def search(q: str, limit: int, config: Config, get: Callable[..., HttpResp]) -> list[dict[str, str]]:\n        cancel = (getattr(get, \"keywords\", None) or {}).get(\"cancel\")\n        data = _mcp_call(\n            service.url,\n            service.search_tool,\n            _service_args(service, q, limit),\n            config.web_search_timeout,\n            cancel=cancel,\n        )\n        rows = _service_results(service, data)\n        if not rows:\n            raise BackendError(f\"no results for {q!r} (empty feed or unmapped payload)\")\n        return rows[:limit]\n\n    return Backend(service.name, search, lambda _c, s=service: s.enabled and s.complete())\n\n\ndef _service_backends(config: Config) -> dict[str, Backend]:\n    \"\"\"Backends for the services declared in settings, in declaration order,\n    appended after the native ones.\"\"\"\n    services, _errors = _parse_services(getattr(config, \"mcp_services\", None))\n    return {s.name: _mcp_backend(s) for s in services}\n```\n\n_available_backends:\n```python\ndef _available_backends(config: Config) -> tuple[str, ...]:\n    \"\"\"The usable subset of the chain: registered AND configured on this machine.\n\n    Rendered into prompts and error texts, so an unconfigured service simply\n    does not exist here — no name, no install advice.\n    \"\"\"\n    backends = {**_BACKENDS, **_service_backends(config)}\n    return tuple(name for name, backend in backends.items() if backend.available(config))\n```\n\nweb_search: `results = _BACKENDS[name].search(q, limit, config, get)` →\n```python\n    backends = {**_BACKENDS, **_service_backends(config)}\n```\nplaced before the loop (after `get = functools...`), and `results = backends[name].search(q, limit, config, get)`.\n\n(f) probe_service replacing mcp_status (586-594):\n\n```python\ndef probe_service(service: McpService, timeout: float = 3.0) -> dict[str, Any]:\n    \"\"\"Reachability + capability + login for one declared service — the data\n    behind /api/mcp_status. Purely informational: a service the operator never\n    configured reports configured=False and is named nowhere else.\"\"\"\n    info: dict[str, Any] = {\n        \"name\": service.name,\n        \"label\": service.label or service.name,\n        \"configured\": bool(service.url),\n        \"complete\": service.complete(),\n        \"enabled\": service.enabled,\n        \"reachable\": None,\n        \"has_search_tool\": None,\n        \"login\": None,\n    }\n    if not service.url:\n        return info\n    try:\n        tools = _mcp_tools_list(service.url, timeout)\n    except WebError as e:\n        info[\"reachable\"] = False\n        info[\"detail\"] = _short(e)\n        return info\n    info[\"reachable\"] = True\n    if service.search_tool:\n        info[\"has_search_tool\"] = any(t.get(\"name\") == service.search_tool for t in tools)\n    if service.status_tool:\n        try:\n            payload = _mcp_call(service.url, service.status_tool, {}, timeout)\n            info[\"login\"] = _normalize_login(payload if isinstance(payload, (dict, str, bool)) else None, service.login_field)\n        except WebError as e:\n            info[\"detail\"] = _short(e)\n    return info\n```\n\nHmm — old server code called _mcp_status_probe(url, p) only when p.status_tool, and reachable=True if no exception OR when no status_tool (no connection attempted → reachable None?). Old: `state = _mcp_status_probe(url, p) if p.status_tool else None; row[\"reachable\"] = True` — so without status_tool it claimed reachable=True without checking! Now tools/list actually probes. Better. But note: status payload — _mcp_call returns parsed JSON (dict) or text. normalize_login handles dict/str/bool. If payload is list → pass None. OK as written; simplify: `info[\"login\"] = _normalize_login(payload, service.login_field) if isinstance(payload, (dict, str, bool)) else None`.\n\n**server.py** edits:\n\n(1) imports L46-47:\n```python\nfrom .tools.mcpprovider import parse_service, parse_services\nfrom .tools.websearch import probe_service as _probe_service\n```\n\n(2) helpers L83-124 replace with:\n\n```python\ndef _load_raw_settings() -> dict:\n    \"\"\"Settings file with one legacy shim applied: the pre-0.1.15 flat\n    `mcp_<name>: URL` keys become service records (url only — the operator\n    completes tool/mapping in the UI). A record the user already declared\n    wins; migrated-away keys are dropped so the file self-heals on save.\"\"\"\n    raw = dict(load_settings())\n    legacy = {\n        k: str(v).strip().rstrip(\"/\")\n        for k, v in raw.items()\n        if k.startswith(\"mcp_\") and isinstance(v, str) and v.strip()\n    }\n    if not legacy:\n        return raw\n    services = [s for s in raw.get(\"mcp_services\") or [] if isinstance(s, dict)]\n    have = {str(s.get(\"name\", \"\")).strip().lower() for s in services}\n    for key, url in legacy.items():\n        name = key[4:].strip().lower()\n        if name and name not in have:\n            services.append({\"name\": name, \"url\": url})\n            have.add(name)\n    raw[\"mcp_services\"] = services\n    for key in legacy:\n        raw.pop(key, None)\n    return raw\n\n\ndef _configured_services(cfg: Any) -> list:\n    \"\"\"Parsed McpService records for the live config; broken entries are\n    reported to stderr but never fatal — one bad record cannot take the\n    healthy ones down.\"\"\"\n    services, errors = parse_services(getattr(cfg, \"mcp_services\", None))\n    for message in errors:\n        print(f\"[clutch-server] mcp service ignored: {message}\", file=sys.stderr)\n    return services\n```\n\nWait — order matters: parse_services skips invalid; but duplicate names across... parse_services dedups. cfg entries may be non-dict junk — handled.\n\nNote: _load_raw_settings is called on every settings GET/POST/boot — fine.\n\n(3) _settings_post:\n\nReplace L367-370:\n```python\n        try:\n            mcp_updates = _split_mcp_fields(body)\n        except ValueError as e:\n            return self._json({\"error\": str(e)}, status=400)\n```\n→\n```python\n        mcp_updates: list | None = None\n        if \"mcp_services\" in body:\n            if not isinstance(body[\"mcp_services\"], list):\n                return self._json({\"error\": \"mcp_services must be a list\"}, status=400)\n            try:\n                mcp_updates = [parse_service(entry) for entry in body[\"mcp_services\"]]\n            except ValueError as e:\n                return self._json({\"error\": f\"mcp_services: {e}\"}, status=400)\n```\n\nGuard L371-376: `and not mcp_updates` → `and mcp_updates is None`.\n\nHot-apply L388-392:\n```python\n            for key, value in mcp_updates.items():\n                if value:\n                    self._cfg.mcp_urls[key[4:]] = value\n                else:\n                    self._cfg.mcp_urls.pop(key[4:], None)\n```\n→\n```python\n            if mcp_updates is not None:\n                self._cfg.mcp_services = [s.record() for s in mcp_updates]\n```\n\nPersist L393-412:\n```python\n        # flatten migrates legacy profile maps but only knows the LLM fields;\n        # carry the mcp_<provider> keys across so a settings save never wipes\n        # configured web services\n        saved = {**_mcp_keys_from(load_settings()), **flatten_settings(load_settings())}\n```\n→\n```python\n        # flatten only knows the LLM fields; carry the declarative mcp_services\n        # list across (via the legacy-shim loader) so a settings save never\n        # wipes configured web services\n        saved = {**flatten_settings(load_settings()), \"mcp_services\": _load_raw_settings().get(\"mcp_services\", [])}\n```\nAnd the per-key persist loop L408-412:\n```python\n        for key, value in mcp_updates.items():\n            if value:\n                saved[key] = value\n            else:\n                saved.pop(key, None)  # empty = clear the service\n```\n→\n```python\n        if mcp_updates is not None:\n            saved[\"mcp_services\"] = [s.record() for s in mcp_updates]\n```\n\nHmm wait: flatten_settings then \"mcp_services\" merge — but flatten returns only known fields so no clobber order issue. And base_url etc follow. OK. But subtle: `_load_raw_settings()` reads load_settings() again — fine.\n\n(4) _settings_get L416-438:\n```python\n    def _settings_get(self) -> None:\n        \"\"\"Current LLM endpoint config for the settings modal (no credentials).\"\"\"\n        saved = flatten_settings(load_settings())\n        self._json(\n            {\n                \"base_url\": self._cfg.base_url or saved.get(\"base_url\", \"\"),\n                \"model\": self._cfg.model or saved.get(\"model\", \"\"),\n                \"reasoning_effort\": self._cfg.llm_reasoning_effort or saved.get(\"reasoning_effort\", \"\"),\n                \"has_api_key\": bool(self._state.api_key or self._cfg.api_key or saved.get(\"api_key\")),\n                # declarative web services: the UI renders one editable row per\n                # record; a host without services simply gets an empty list\n                \"mcp_services\": [s.record() for s in _configured_services(self._cfg)],\n            }\n        )\n```\nNote: echo parsed records (canonicalized) — UI prefills from live config. raw var no longer needed.\n\nHmm — but GET should reflect SAVED settings when config not yet loaded? cfg.mcp_services is loaded at boot and hot-applied on POST — good enough.\n\n(5) _mcp_status L440-465:\n```python\n    def _mcp_status(self) -> None:\n        \"\"\"Per-service MCP reachability + login state, for the settings modal.\n\n        Purely informational and only about services this machine's operator\n        declared: nothing here suggests installing anything, and a service\n        that is not configured exists nowhere else in the product.\n        \"\"\"\n        out = [_probe_service(s) for s in _configured_services(self._cfg)]\n        self._json({\"services\": out})\n```\n\n(6) main() L845-848:\n```python\n    # MCP web-search services (settings.json keys mcp_<provider>); the env-only\n    # CLUTCH_MCP_<NAME>_URL is resolved by the provider itself at call time\n    for _key, _value in _mcp_keys_from(load_settings()).items():\n        config.mcp_urls[_key[4:]] = _value.rstrip(\"/\")\n```\n→\n```python\n    # MCP web-search services: declarative records in settings.json\n    # (legacy flat mcp_<name> URL keys migrate through _load_raw_settings)\n    config.mcp_services = _load_raw_settings().get(\"mcp_services\", [])\n```\n\n**ui/app.js** — rewrite block 2813-2908. New implementation:\n\n```js\n// ---- MCP web services (settings modal section) -------------------------------\n// Fully operator-driven: rows render from the declarative mcp_services records\n// in settings.json. The agent core ships none — a host without services sees\n// just the add button, and nothing anywhere suggests services to install.\n\n(function initMcpServices() {\n  const box = document.getElementById(\"mcp-services\");\n  if (!box) return;\n\n  const NAME_RE = /^[a-z0-9][a-z0-9_-]{0,63}$/;\n\n  function el(tag, cls, text) {\n    const e = document.createElement(tag);\n    if (cls) e.className = cls;\n    if (text !== undefined) e.textContent = text;\n    return e;\n  }\n\n  function input(value, placeholder) {\n    const i = document.createElement(\"input\");\n    i.type = \"text\";\n    i.autocomplete = \"off\";\n    i.value = value || \"\";\n    if (placeholder) i.placeholder = placeholder;\n    return i;\n  }\n\n  // one editable row per declared service; spec = {} for a fresh row\n  function rowEl(spec) {\n    const row = el(\"div\", \"fs-conn-row\");\n    row.style.cssText = \"display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:8px\";\n    row.dataset.mcpRow = spec.name || \"\";\n\n    const enabled = document.createElement(\"input\");\n    enabled.type = \"checkbox\";\n    enabled.checked = spec.enabled !== false;\n    enabled.title = \"enabled\";\n    row.append(enabled);\n\n    const name = input(spec.name, \"name\");\n    name.style.cssText = \"width:110px;flex:none\";\n    const url = input(spec.url, \"http://localhost:port/mcp\");\n    url.style.cssText = \"flex:1 1 180px;min-width:150px\";\n    const tool = input(spec.search_tool, \"search_tool\");\n    tool.style.cssText = \"width:130px;flex:none\";\n    row.append(name, url, tool);\n\n    const status = el(\"span\", \"dim\", \"\");\n    status.style.cssText = \"flex:none\";\n    status.dataset.mcpStatus = spec.name || \"\";\n    row.append(status);\n\n    const del = el(\"button\", \"ghost\", \"✕\");\n    del.type = \"button\";\n    del.title = \"remove this service\";\n    del.style.cssText = \"flex:none;padding:1px 7px\";\n    del.addEventListener(\"click\", () => row.remove());\n    row.append(del);\n\n    // advanced mapping, second line — everything the generic engine accepts\n    const adv = el(\"div\");\n    adv.style.cssText = \"display:flex;flex-wrap:wrap;gap:6px;flex-basis:100%;padding-left:22px\";\n    const fTitle = input((spec.fields || {}).title, \"title field chain\");\n    const fUrl = input((spec.fields || {}).url, \"url template https://x/n/{id}\");\n    const fSnippet = input((spec.fields || {}).snippet, \"snippet field chain\");\n    const fStatus = input(spec.status_tool, \"status_tool (optional)\");\n    [fTitle, fUrl, fSnippet, fStatus].forEach((i) => {\n      i.style.cssText = \"flex:1 1 130px;min-width:120px;font-size:0.92em\";\n      adv.append(i);\n    });\n    row.append(adv);\n    row._fields = { fTitle, fUrl, fSnippet, fStatus };\n    return row;\n  }\n\n  function collect() {\n    const services = [];\n    for (const row of box.querySelectorAll(\"[data-mcp-row]\")) {\n      const name = row.children[1].value.trim().toLowerCase();\n      if (!name && !row.children[2].value.trim()) continue; // skip fully blank rows\n      const spec = {\n        name: name,\n        url: row.children[2].value.trim().replace(/\\/+$/, \"\"),\n        enabled: row.children[0].checked,\n        search_tool: row.children[3].value.trim(),\n      };\n      const f = row._fields;\n      const fields = {};\n      if (f.fTitle.value.trim()) fields.title = f.fTitle.value.trim();\n      if (f.fUrl.value.trim()) fields.url = f.fUrl.value.trim();\n      if (f.fSnippet.value.trim()) fields.snippet = f.fSnippet.value.trim();\n      if (Object.keys(fields).length) spec.fields = fields;\n      if (f.fStatus.value.trim()) spec.status_tool = f.fStatus.value.trim();\n      services.push(spec);\n    }\n    return services;\n  }\n\n  function render(services) {\n    box.textContent = \"\";\n    const title = el(\"label\", \"\", \"Web services (optional)\");\n    title.style.marginTop = \"16px\";\n    box.appendChild(title);\n    for (const s of services || []) box.appendChild(rowEl(s));\n\n    const actions = el(\"div\", \"fs-conn-row\");\n    actions.style.cssText = \"display:flex;gap:8px;align-items:center;margin:6px 0 8px\";\n    const add = el(\"button\", \"ghost\", \"＋ Add service\");\n    add.type = \"button\";\n    const save = el(\"button\", \"primary\", \"Save web services\");\n    save.id = \"mcp-services-save\";\n    const hint = el(\"span\", \"dim\", \"\");\n    add.addEventListener(\"click\", () => {\n      box.insertBefore(rowEl({}), actions);\n    });\n    save.addEventListener(\"click\", async () => {\n      const servicesToSave = collect();\n      const names = servicesToSave.map((s) => s.name);\n      if (names.some((n) => !NAME_RE.test(n))) {\n        hint.textContent = \"bad name (a-z 0-9 - _)\";\n        return;\n      }\n      try {\n        await apiFetch(\"/api/settings\", { method: \"POST\", body: { mcp_services: servicesToSave } });\n        hint.textContent = \"saved\";\n        refreshStatus();\n      } catch (e) {\n        hint.textContent = \"save failed: \" + ((e && e.message) || e);\n      }\n    });\n    actions.append(add, save, hint);\n    box.appendChild(actions);\n  }\n\n  async function refreshStatus() {\n    let st;\n    try {\n      st = await apiFetch(\"/api/mcp_status\");\n    } catch (e) {\n      return; // status is best-effort\n    }\n    const byName = {};\n    for (const row of (st && st.services) || []) byName[row.name] = row;\n    box.querySelectorAll(\"[data-mcp-status]\").forEach((sEl) => {\n      const row = byName[sEl.dataset.mcpStatus];\n      if (!row) return;\n      const bits = [];\n      if (!row.configured) sEl.textContent = \"\";\n      else {\n        if (row.reachable === false) bits.push(\"unreachable\");\n        else if (row.reachable) {\n          bits.push(\"connected\");\n          if (row.has_search_tool === false) bits.push(\"search tool not found\");\n          if (row.login === true) bits.push(\"logged in\");\n          else if (row.login === false) bits.push(\"not logged in\");\n        } else if (row.complete === false) bits.push(\"incomplete\");\n        sEl.textContent = bits.join(\" · \");\n      }\n    });\n  }\n\n  // (re)render every time the settings modal opens, so values stay fresh\n  $(\"#settings-btn\").addEventListener(\"click\", async () => {\n    try {\n      const s = await apiFetch(\"/api/settings\");\n      render(s.mcp_services || []);\n      refreshStatus();\n    } catch (e) {\n      /* settings API down: the section stays empty */\n    }\n  });\n})();\n```\n\nWait — collect() uses row.children indices [0..3]: enabled checkbox, name, url, tool — children order: enabled, name, url, tool, status span, del button, adv div. children[1]=name input, [2]=url, [3]=tool. OK but fragile — acceptable for this codebase style. Hmm, `row.children[2]` for url in the skip-blank check too. OK.\n\nOne issue: `collect()` name empty but url present → name \"\" → NAME_RE fails → error shown. Good (\"bad name\").\n\nEmpty rows skipped only when both name+url blank — fine.\n\napiFetch POST body {mcp_services: [...]} — server: body[\"mcp_services\"] list ✓. But NOTE: the server's \"nothing to save\" guard: any(base_url, model, api_key) false, \"reasoning_effort\" not in body, mcp_updates is not None → passes. ✓\n\nStatus refresh after save: server hot-applies cfg.mcp_services before responding, so /api/mcp_status probes new set. ✓\n\nBut — refreshStatus matches `sEl.dataset.mcpStatus` set at row creation from spec.name; after editing name without re-render, dataset stale → status won't match new name. Fix: update dataset on name input change? Simpler: in collect/save success, update each row's dataset: after save, re-render from GET? Cleaner: after successful save, re-fetch settings and re-render (loses focus but save is explicit). Let me do: on save success → `render(servicesToSave)` + refreshStatus(). That re-renders rows with saved spec (and updates status anchors). \n\nAlso render() re-created on every settings open — fresh values ✓.\n\nCSS classes: uses existing dim/ghost/primary/fs-conn-row — consistent with old block.\n\n**README.md** edit — current paragraph (lines 39-44):\n```\n外部 MCP 服务也可以接入为搜索后端（如 xiaohongshu-mcp）：在设置弹窗的\nWeb services 区填入服务地址即可（存于 `~/.clutch/settings.json` 的 `mcp_<名字>`\n键，或环境变量 `CLUTCH_MCP_<名字>_URL`）。没配置的机器上对应后端不存在——\n工具、提示词、报错信息里都不会出现它的名字，也不会出现任何\"请安装\"的提示。\n```\n→ new:\n```\n外部 MCP 服务也能接入为搜索后端：设置弹窗的 Web services 区里自己添加\n（名称、地址、工具名，可选的字段映射和状态工具），持久化为\n`~/.clutch/settings.json` 里的 `mcp_services` 列表。代理本体不带任何预置\n服务——没配置的机器上对应后端不存在，工具、提示词、报错信息里都不会出现\n它的名字，也不会出现任何\"请安装\"的提示。\n```\nREADME is Chinese, naming xiaohongshu-mcp as doc example is fine (docs ≠ code), keep it as example mention. I'll keep \"（如 xiaohongshu-mcp）\" as example. Let me write:\n\n```\n外部 MCP 服务也能接入为搜索后端（如 xiaohongshu-mcp）：设置弹窗的\nWeb services 区自行添加——名称、地址、搜索工具名，可选字段映射与状态\n工具，持久化为 `~/.clutch/settings.json` 的 `mcp_services` 列表。程序本体\n不带任何预置服务：没配置的机器上对应后端不存在，工具、提示词、报错信息\n里都不会出现它的名字，也不会出现任何\"请安装\"的提示。\n```\n\nAlso update the reference to `mcp_urls`? grep said README only has these lines + tests list line. Also websearch_test mentions? No mcp hits in websearch_test. Good.\n\n**tests/mcpbackend_test.py** — rewrite fully:\n\n```python\n\"\"\"Offline checks for the config-driven MCP web-search layer (loopback only).\n\nRun: python -m tests.mcpbackend_test\n\nCovers: declarative record parsing/validation, argument templates (typed\nsingle placeholder), result-list location + field chains + URL templates,\nthe JSON-RPC client (handshake, session id, SSE frames, plain-text and error\npaths) against a real loopback server, capability probing (tools/list,\nstatus tool, login normalization), backend gating (a service exists only\nwhen declared and complete — and is named nowhere when it is not),\nerror-as-data degradation, dynamic prompt/schema rendering, and the legacy\nmcp_<name> settings migration.\n\"\"\"\n```\n\nTests:\n1. parse_service: valid minimal {name,url,search_tool} → defaults fields merged; enabled parsing; name validation errors; url scheme validation; duplicate names via parse_services; non-dict junk.\n2. args templates: {\"keyword\": \"{query}\", \"limit\": \"{limit}\"} → (\"q\", 8) → {\"keyword\": \"q\", \"limit\": 8} (int preserved); mixed template \"page={limit}\" → string \"page=8\"; missing placeholders → \"\".\n3. result_rows: bare list / data envelope / items / dotted list_key / junk rows filtered.\n4. map_results: field chains with fallbacks (\"desc | description\"), dotted, url template interpolation with quoting (token with special char & → %26), rows without url dropped, defaults (minimal record maps title/url/desc automatically).\n5. normalize_login: shapes.\n6. loopback JSON-RPC (same handler, reuse structure): _mcp_call json/sse/text/202/rpcerror/500/refused + _mcp_tools_list returns tool names.\n7. probe_service against loopback: reachable True, has_search_tool True (tool exists) / False (wrong name); status_tool login True; dead port → reachable False + detail; url-sanitization check: detail doesn't contain full path? my loopback base has path \"/\" only... Use a path-carrying URL: base + \"/secret/path\" → error detail contains origin but not \"secret/path\"? WebError for unreachable: f\"MCP server unreachable ({reason}): {origin}\". Test: dead URL \"http://127.0.0.1:1/hidden/path/mcp\" → \"hidden\" not in str(e). \n8. gating: plain Config → no service backends; bing/ddg present; pinned unknown errors factually without install advice. Config with mcp_services=[{name,url,search_tool}] (incomplete: missing search_tool) → not in available; complete → joins chain. web_search pinned with fake _mcp_rpc → mapped results end-to-end; dead rpc → error-as-data.\n9. prompt/schema rendering: description doesn't name service on plain; names it when configured. build_default_tools.\n10. server helpers: _load_raw_settings migration: {\"mcp_xhs\": \" http://h/mcp/ \", \"mcp_x2\": \"http://y\", \"mcp_services\": [{\"name\":\"x2\",\"url\":\"http://z\"}]} → services contains xhs(url http://h/mcp), keeps x2 as-is (existing record wins), legacy keys dropped; load_settings monkeypatch needed — _load_raw_settings calls load_settings imported in server module: patch server.load_settings. Import from agent.server import _load_raw_settings, _configured_services.\n\nFor gate 8 web_search with service — note backend.available lambda ignores config: s.enabled and s.complete(). Config with record {\"name\":\"notes\",\"url\":base,\"search_tool\":\"search_feeds\"} — loopback default behavior returns rows [{id,title,desc,xsec_token}] — with DEFAULT fields url=\"url|link|href\" — row has NO url field! → rows dropped → BackendError. So use fields override: {\"url\": \"https://ex.com/n/{id}?t={xsec_token}\", \"snippet\": \"desc\"} in cfg record. End-to-end: content contains \"Found\" and \"t=tk\". Good — also proves template mapping works over the wire.\n\nHandler needs \"tools/list\" support: method tools/list → payload {\"result\": {\"tools\": [{\"name\":\"search_feeds\"},{\"name\":\"check_login_status\"}]}}. And status path: _mcp_call(url, \"check_login_status\", {}, ...) → response content text json {\"logged_in\": true} → normalize_login → True. Handler: reuse existing structure; add:\n\n```python\n        if method == \"tools/list\":\n            payload = {\"jsonrpc\": \"2.0\", \"id\": 2, \"result\": {\"tools\": [{\"name\": \"search_feeds\"}, {\"name\": \"check_login_status\"}]}}\n        elif call == \"status\":\n            payload = {\"jsonrpc\": \"2.0\", \"id\": 2, \"result\": {\"content\": [{\"type\": \"text\", \"text\": json.dumps({\"logged_in\": True})}]}}\n```\n\npath-based behavior: `call = self.path.strip(\"/\") or behavior` — existing pattern; keep.\n\nCareful: old test monkeypatches ws._mcp_rpc — with new _mcp_open, _mcp_call still routes through _mcp_rpc → fake works (it handles initialize/initialized/else). But _mcp_tools_list via fake_rpc would return result {\"content\": [...]} → .get(\"tools\") → [] → has_search_tool False — only in probe; fine, probe tests use real loopback.\n\nAlso fake_rpc signature (url, payload, session, timeout, cancel=None) — new calls: _mcp_rpc(url, hello, None, timeout, cancel) — positional: _mcp_open passes (url, hello, None, timeout, cancel) ✓ matches.\n\nNumber the checks and keep style. Aim ~250 lines.\n\nOne more consideration — `tests/websearch_test.py` and `tests/server_test.py`: no mcp references (grep showed none) → untouched. perm-args-test.js unrelated.\n\nAlso check registry.py uses `websearch.available_backends(config)` — unchanged public alias ✓. web_search description render uses max_results/backends ✓ no changes.\n\nEnv var support removal: CLUTCH_MCP_<NAME>_URL gone (was in mcpprovider.url_for). README mentioned it — updating README anyway. Any other reference? grep earlier showed only config.py comment + README + old test. Clean.\n\nOne subtlety — server `_settings_get` previously echoed raw values even when cfg not hot-loaded... now GET echoes from cfg only. cfg.mcp_services set at boot from _load_raw_settings and hot-applied on POST ✓.\n\n`asdict` import in mcpprovider: from dataclasses import asdict, dataclass, field. Note: `field` name clashes with nothing there ✓.\n\ndataclasses.asdict deep-copies dicts — fine.\n\nEdge: parse_service enabled default True; record() returns enabled bool ✓.\n\nLet me also double check websearch `web_search` uses `available` from _available_backends for pin gate; and chain lookups `backends[name]` — I must ensure `backends` var defined before loop and used; the failure list references name ✓.\n\nPotential circular import: mcpprovider imports nothing from agent ✓.\n\nNow — write files. mcpprovider.py full rewrite via write_file. Then edits. Then app.js block replace via edit_file (old block is 95 lines; replace whole block with new). The old block text I have exactly (lines 2813-2908). Use edit_file with the full old block as old_string — it's unique. That's long but safe. Alternatively replace in two chunks. I'll do one edit with the full block.\n\nCareful: the old block contains `$(\"#settings-btn\")` etc. Copy exactly from read output (lines 2813-2908). I have it.\n\nAlso mustn't forget: `git rm` nothing — all edits in place. Version: leave VERSION/package.json alone for now (release decision later; user said \"开始\" for the refactor; I'll commit+push, and bump release only if... Actually the flow expectation from this project: ship. But release creates CI builds; the user has been driving releases explicitly. I'll commit + push and at the end offer release. Hmm — earlier when they said 开始 for the release task I did everything. Here 开始 = start the refactor per my proposed plan ① (\"切到 work 模式我就按 ① 开工\"). Plan ① didn't include release. I'll implement + test + commit + push, then report and offer release.\n\nWrite mcpprovider.py now."}
{"type": "tool_call", "timestamp": 1789815228.1576838, "id": "e044c1630e7d", "name": "write_file", "arguments": "{\"path\":\"agent/tools/mcpprovider.py\",\"content\":\"\\\"\\\"\\\"Operator-configured MCP tool servers that extend web search.\\n\\nThe agent core carries NO opinions about which services exist: every MCP\\nsource is a declarative record from the settings file (Config.mcp_services),\\nsaying how to CALL a search tool and how to READ its reply:\\n\\n    {\\\"name\\\": \\\"notes\\\", \\\"url\\\": \\\"http://localhost:18060/mcp\\\",\\n     \\\"search_tool\\\": \\\"search_feeds\\\",\\n     \\\"args\\\": {\\\"keyword\\\": \\\"{query}\\\", \\\"limit\\\": \\\"{limit}\\\"},\\n     \\\"fields\\\": {\\\"title\\\": \\\"title\\\",\\n                \\\"url\\\": \\\"https://example.com/n/{id}?t={token}\\\",\\n                \\\"snippet\\\": \\\"desc | description\\\"},\\n     \\\"list_key\\\": \\\"\\\",                       # \\\"\\\" = auto-unwrap common envelopes\\n     \\\"status_tool\\\": \\\"check_login_status\\\", \\\"login_field\\\": \\\"logged_in\\\"}\\n\\nNo platform is ever named in code: a service the operator did not declare\\nsimply does not exist — it is named nowhere, suggested nowhere, rendered\\nnowhere. Adding a source is editing config, not shipping a build.\\n\\nField mappings: \\\"a | b\\\" tries alternatives, \\\"a.b\\\" descends into nesting,\\nand a url value containing \\\"{\\\" is a template whose {placeholders} are filled\\nfrom the result row (percent-encoded). One generic engine serves every\\nwell-formed service; only genuinely exotic payloads would ever need code.\\n\\nImport-safe from anywhere: stdlib only, no agent-package imports.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport re\\nimport urllib.parse\\nfrom dataclasses import asdict, dataclass, field\\nfrom typing import Any\\n\\n_NAME_RE = re.compile(r\\\"^[a-z0-9][a-z0-9_-]{0,63}$\\\")\\n_PLACEHOLDER_RE = re.compile(r\\\"\\\\{([a-z_][a-z0-9_]*)\\\\}\\\")\\n\\n# Mappings used when a record overrides nothing: probe the usual suspects.\\nDEFAULT_FIELDS = {\\n    \\\"title\\\": \\\"title | name\\\",\\n    \\\"url\\\": \\\"url | link | href\\\",\\n    \\\"snippet\\\": \\\"desc | description | snippet | summary | content\\\",\\n}\\n# Envelope keys the auto-unwrap checks when list_key is \\\"\\\".\\n_LIST_WRAP_KEYS = (\\\"data\\\", \\\"items\\\", \\\"feeds\\\", \\\"results\\\", \\\"notes\\\")\\n\\n\\n@dataclass(frozen=True)\\nclass McpService:\\n    \\\"\\\"\\\"One operator-declared MCP tool server usable as a search backend.\\\"\\\"\\\"\\n\\n    name: str                                        # backend name (backend=<name>)\\n    url: str                                         # MCP endpoint; \\\"\\\" = not configured\\n    search_tool: str = \\\"\\\"                            # tool invoked for searches\\n    enabled: bool = True\\n    label: str = \\\"\\\"                                  # settings-UI display name; defaults to name\\n    args: dict[str, Any] = field(default_factory=dict)    # {query}/{limit} templates\\n    fields: dict[str, str] = field(default_factory=dict)  # title/url/snippet mapping\\n    list_key: str = \\\"\\\"                               # dotted path to the result list; \\\"\\\" = auto\\n    status_tool: str = \\\"\\\"                            # optional tool reporting login state\\n    login_field: str = \\\"\\\"                            # its boolean-ish key; \\\"\\\" = probe common keys\\n\\n    def complete(self) -> bool:\\n        \\\"\\\"\\\"Ready to join the chain: endpoint + tool known. Field mappings always\\n        have defaults, so they alone cannot make a record incomplete.\\\"\\\"\\\"\\n        return bool(self.url and self.search_tool)\\n\\n    def record(self) -> dict[str, Any]:\\n        \\\"\\\"\\\"Canonical JSON shape — what settings.json stores, what the UI prefills.\\\"\\\"\\\"\\n        return asdict(self)\\n\\n\\ndef parse_service(raw: Any) -> McpService:\\n    \\\"\\\"\\\"Validate one settings record into an McpService; ValueError on junk.\\\"\\\"\\\"\\n    if not isinstance(raw, dict):\\n        raise ValueError(\\\"service entry must be an object\\\")\\n    name = str(raw.get(\\\"name\\\", \\\"\\\")).strip().lower()\\n    if not _NAME_RE.match(name):\\n        raise ValueError(\\\"name must match [a-z0-9][a-z0-9_-]{0,63}\\\")\\n    url = str(raw.get(\\\"url\\\", \\\"\\\")).strip().rstrip(\\\"/\\\")\\n    if url and not url.startswith((\\\"http://\\\", \\\"https://\\\")):\\n        raise ValueError(f\\\"{name}: url must be an http(s) URL\\\")\\n    fields_in = raw.get(\\\"fields\\\") if isinstance(raw.get(\\\"fields\\\"), dict) else {}\\n    fields = dict(DEFAULT_FIELDS)\\n    for key in DEFAULT_FIELDS:\\n        override = str(fields_in.get(key, \\\"\\\")).strip()\\n        if override:\\n            fields[key] = override\\n    args_in = raw.get(\\\"args\\\") if isinstance(raw.get(\\\"args\\\"), dict) else {}\\n    enabled = str(raw.get(\\\"enabled\\\", True)).strip().lower() not in (\\\"false\\\", \\\"0\\\", \\\"no\\\", \\\"off\\\")\\n    return McpService(\\n        name=name,\\n        url=url,\\n        search_tool=str(raw.get(\\\"search_tool\\\", \\\"\\\")).strip(),\\n        enabled=enabled,\\n        label=str(raw.get(\\\"label\\\", \\\"\\\")).strip(),\\n        args={str(k): v for k, v in args_in.items()},\\n        fields=fields,\\n        list_key=str(raw.get(\\\"list_key\\\", \\\"\\\")).strip(),\\n        status_tool=str(raw.get(\\\"status_tool\\\", \\\"\\\")).strip(),\\n        login_field=str(raw.get(\\\"login_field\\\", \\\"\\\")).strip(),\\n    )\\n\\n\\ndef parse_services(raw: Any) -> tuple[list[McpService], list[str]]:\\n    \\\"\\\"\\\"Parse a whole settings list; bad entries are skipped and reported, so a\\n    single broken record never takes the healthy ones down.\\\"\\\"\\\"\\n    if raw is None:\\n        return [], []\\n    if not isinstance(raw, list):\\n        return [], [\\\"mcp_services must be a list\\\"]\\n    services: list[McpService] = []\\n    errors: list[str] = []\\n    seen: set[str] = set()\\n    for i, item in enumerate(raw):\\n        try:\\n            service = parse_service(item)\\n        except ValueError as e:\\n            errors.append(f\\\"service[{i}]: {e}\\\")\\n            continue\\n        if service.name in seen:\\n            errors.append(f\\\"service[{i}]: duplicate name {service.name!r}\\\")\\n            continue\\n        seen.add(service.name)\\n        services.append(service)\\n    return services, errors\\n\\n\\n# ---- call side: templates ----------------------------------------------------\\n\\n\\ndef search_args(service: McpService, query: str, limit: int) -> dict[str, Any]:\\n    \\\"\\\"\\\"Build the tools/call arguments from the record's templates. A lone\\n    \\\"{placeholder}\\\" keeps the value's type ({limit} stays an int); mixed text\\n    interpolates into a string.\\\"\\\"\\\"\\n    values: dict[str, Any] = {\\\"query\\\": query, \\\"limit\\\": limit}\\n    return {key: _interpolate_value(val, values) for key, val in service.args.items()}\\n\\n\\ndef _interpolate_value(template: Any, values: dict[str, Any]) -> Any:\\n    if not isinstance(template, str):\\n        return template\\n    exact = _PLACEHOLDER_RE.fullmatch(template.strip())\\n    if exact:\\n        return values.get(exact.group(1), \\\"\\\")\\n    return _PLACEHOLDER_RE.sub(lambda m: str(values.get(m.group(1), \\\"\\\")), template)\\n\\n\\n# ---- read side: results ------------------------------------------------------\\n\\n\\ndef result_rows(service: McpService, data: Any) -> list[dict]:\\n    \\\"\\\"\\\"The list of result objects inside a tool reply: the record's list_key\\n    when given, else auto-unwrap a bare list or a common envelope key.\\\"\\\"\\\"\\n    if not isinstance(data, (list, dict)):\\n        return []\\n    if service.list_key:\\n        node: Any = data\\n        for part in service.list_key.split(\\\".\\\"):\\n            node = node.get(part) if isinstance(node, dict) else None\\n        rows = node if isinstance(node, list) else []\\n    elif isinstance(data, list):\\n        rows = data\\n    else:\\n        rows = next((data[k] for k in _LIST_WRAP_KEYS if isinstance(data.get(k), list)), [])\\n    return [row for row in rows if isinstance(row, dict)]\\n\\n\\ndef _field(row: dict, chain: str) -> Any:\\n    \\\"\\\"\\\"First non-empty hit in an \\\"a.b | alt\\\" chain; '' when nothing matches.\\\"\\\"\\\"\\n    for path in (p.strip() for p in chain.split(\\\"|\\\")):\\n        if not path:\\n            continue\\n        node: Any = row\\n        for part in path.split(\\\".\\\"):\\n            if isinstance(node, dict) and part in node:\\n                node = node[part]\\n            else:\\n                node = None\\n                break\\n        if node not in (None, \\\"\\\"):\\n            return node\\n    return \\\"\\\"\\n\\n\\ndef _map_url(spec: str, row: dict) -> str:\\n    \\\"\\\"\\\"A url mapping is a template (placeholders filled from the row,\\n    percent-encoded: ids and tokens are payload, never structure) or a field\\n    chain naming where the ready-made url lives.\\\"\\\"\\\"\\n    if \\\"{\\\" in spec:\\n        return _PLACEHOLDER_RE.sub(\\n            lambda m: urllib.parse.quote(str(row.get(m.group(1), \\\"\\\")), safe=\\\"\\\"), spec\\n        )\\n    return str(_field(row, spec))\\n\\n\\ndef map_results(service: McpService, data: Any) -> list[dict[str, str]]:\\n    \\\"\\\"\\\"Tool reply -> uniform [{title, url, snippet}] rows.\\\"\\\"\\\"\\n    out: list[dict[str, str]] = []\\n    for row in result_rows(service, data):\\n        url = _map_url(service.fields.get(\\\"url\\\", \\\"\\\"), row)\\n        if not url:\\n            continue  # a row with no address is not a result\\n        out.append(\\n            {\\n                \\\"title\\\": str(_field(row, service.fields.get(\\\"title\\\", \\\"\\\"))).strip(),\\n                \\\"url\\\": url,\\n                \\\"snippet\\\": str(_field(row, service.fields.get(\\\"snippet\\\", \\\"\\\"))).strip(),\\n            }\\n        )\\n    return out\\n\\n\\ndef normalize_login(state: Any, login_field: str = \\\"\\\") -> bool | None:\\n    \\\"\\\"\\\"Best-effort boolean from a status-tool payload (dict, string or bool);\\n    None when the shape says nothing recognizable.\\\"\\\"\\\"\\n    truthy = (\\\"logged_in\\\", \\\"logged in\\\", \\\"true\\\", \\\"yes\\\", \\\"ok\\\", \\\"success\\\")\\n    if isinstance(state, bool):\\n        return state\\n    if isinstance(state, str):\\n        return state.strip().lower() in truthy\\n    if isinstance(state, dict):\\n        keys = ([login_field] if login_field else []) + [\\n            \\\"login\\\",\\n            \\\"logged_in\\\",\\n            \\\"is_logged_in\\\",\\n            \\\"logged_in_status\\\",\\n            \\\"status\\\",\\n        ]\\n        for key in keys:\\n            if not key:\\n                continue\\n            v = state.get(key)\\n            if isinstance(v, bool):\\n                return v\\n            if isinstance(v, str):\\n                return v.strip().lower() in truthy\\n    return None\\n\"}", "tool_call_id": "call_e8025ff008ff45cd9ae41dce"}
{"type": "tool_result", "timestamp": 1789815228.1722074, "id": "f4ebe30078a8", "tool_call_id": "call_e8025ff008ff45cd9ae41dce", "content": "OK: wrote C:\\Users\\12741\\Desktop\\临时文件\\Clutch\\agent\\tools\\mcpprovider.py (+223 -90 lines)", "is_error": false, "diff": "--- a/agent\\tools\\mcpprovider.py\n+++ b/agent\\tools\\mcpprovider.py\n@@ -1,105 +1,238 @@\n-\"\"\"Registry of external MCP tool servers that extend web search.\n-\n-One entry here turns a generic HTTP MCP server into a web_search backend: the\n-provider names its config key, the tool to call, and how to map its results\n-onto the uniform {title, url, snippet} shape. Adding a platform means adding\n-one McpProvider to MCP_PROVIDERS — the search chain, the rendered prompt and\n-the settings UI all pick it up without further changes.\n-\n-Hosts without a given service configured simply leave the URL empty: the\n-backend is then absent from the chain, and nothing in the prompts, the error\n-texts or the UI mentions it (no \"please install X\" advice, ever).\n+\"\"\"Operator-configured MCP tool servers that extend web search.\n+\n+The agent core carries NO opinions about which services exist: every MCP\n+source is a declarative record from the settings file (Config.mcp_services),\n+saying how to CALL a search tool and how to READ its reply:\n+\n+    {\"name\": \"notes\", \"url\": \"http://localhost:18060/mcp\",\n+     \"search_tool\": \"search_feeds\",\n+     \"args\": {\"keyword\": \"{query}\", \"limit\": \"{limit}\"},\n+     \"fields\": {\"title\": \"title\",\n+                \"url\": \"https://example.com/n/{id}?t={token}\",\n+                \"snippet\": \"desc | description\"},\n+     \"list_key\": \"\",                       # \"\" = auto-unwrap common envelopes\n+     \"status_tool\": \"check_login_status\", \"login_field\": \"logged_in\"}\n+\n+No platform is ever named in code: a service the operator did not declare\n+simply does not exist — it is named nowhere, suggested nowhere, rendered\n+nowhere. Adding a source is editing config, not shipping a build.\n+\n+Field mappings: \"a | b\" tries alternatives, \"a.b\" descends into nesting,\n+and a url value containing \"{\" is a template whose {placeholders} are filled\n+from the result row (percent-encoded). One generic engine serves every\n+well-formed service; only genuinely exotic payloads would ever need code.\n \n Import-safe from anywhere: stdlib only, no agent-package imports.\n \"\"\"\n \n from __future__ import annotations\n \n-import os\n+import re\n import urllib.parse\n-from dataclasses import dataclass\n-from typing import Any, Callable\n+from dataclasses import asdict, dataclass, field\n+from typing import Any\n+\n+_NAME_RE = re.compile(r\"^[a-z0-9][a-z0-9_-]{0,63}$\")\n+_PLACEHOLDER_RE = re.compile(r\"\\{([a-z_][a-z0-9_]*)\\}\")\n+\n+# Mappings used when a record overrides nothing: probe the usual suspects.\n+DEFAULT_FIELDS = {\n+    \"title\": \"title | name\",\n+    \"url\": \"url | link | href\",\n+    \"snippet\": \"desc | description | snippet | summary | content\",\n+}\n+# Envelope keys the auto-unwrap checks when list_key is \"\".\n+_LIST_WRAP_KEYS = (\"data\", \"items\", \"feeds\", \"results\", \"notes\")\n \n \n @dataclass(frozen=True)\n-class McpProvider:\n-    \"\"\"Declarative spec for one MCP-backed search source.\"\"\"\n-\n-    name: str                                # backend name (web_search backend=<name>)\n-    label: str                               # human label for the settings modal\n-    search_tool: str                         # MCP tool invoked for searches\n-    search_args: Callable[[str, int], dict]  # (query, limit) -> tool arguments\n-    map_results: Callable[[Any], list[dict]]  # parsed tool result -> [{title,url,snippet}]\n-    placeholder: str = \"\"                    # example URL shown in the settings modal\n-    status_tool: str = \"\"                    # optional MCP tool reporting login state\n-\n-    def url_for(self, config: Any) -> str:\n-        \"\"\"Configured endpoint ('' = not configured on this machine).\n-\n-        Settings-modal values land in Config.mcp_urls under the provider name;\n-        CLUTCH_MCP_<NAME>_URL is the env-only equivalent.\n-        \"\"\"\n-        urls = getattr(config, \"mcp_urls\", None) or {}\n-        value = urls.get(self.name) or os.environ.get(\n-            f\"CLUTCH_MCP_{self.name.upper()}_URL\", \"\"\n+class McpService:\n+    \"\"\"One operator-declared MCP tool server usable as a search backend.\"\"\"\n+\n+    name: str                                        # backend name (backend=<name>)\n+    url: str                                         # MCP endpoint; \"\" = not configured\n+    search_tool: str = \"\"                            # tool invoked for searches\n+    enabled: bool = True\n+    label: str = \"\"                                  # settings-UI display name; defaults to name\n+    args: dict[str, Any] = field(default_factory=dict)    # {query}/{limit} templates\n+    fields: dict[str, str] = field(default_factory=dict)  # title/url/snippet mapping\n+    list_key: str = \"\"                               # dotted path to the result list; \"\" = auto\n+    status_tool: str = \"\"                            # optional tool reporting login state\n+    login_field: str = \"\"                            # its boolean-ish key; \"\" = probe common keys\n+\n+    def complete(self) -> bool:\n+        \"\"\"Ready to join the chain: endpoint + tool known. Field mappings always\n+        have defaults, so they alone cannot make a record incomplete.\"\"\"\n+        return bool(self.url and self.search_tool)\n+\n+    def record(self) -> dict[str, Any]:\n+        \"\"\"Canonical JSON shape — what settings.json stores, what the UI prefills.\"\"\"\n+        return asdict(self)\n+\n+\n+def parse_service(raw: Any) -> McpService:\n+    \"\"\"Validate one settings record into an McpService; ValueError on junk.\"\"\"\n+    if not isinstance(raw, dict):\n+        raise ValueError(\"service entry must be an object\")\n+    name = str(raw.get(\"name\", \"\")).strip().lower()\n+    if not _NAME_RE.match(name):\n+        raise ValueError(\"name must match [a-z0-9][a-z0-9_-]{0,63}\")\n+    url = str(raw.get(\"url\", \"\")).strip().rstrip(\"/\")\n+    if url and not url.startswith((\"http://\", \"https://\")):\n+        raise ValueError(f\"{name}: url must be an http(s) URL\")\n+    fields_in = raw.get(\"fields\") if isinstance(raw.get(\"fields\"), dict) else {}\n+    fields = dict(DEFAULT_FIELDS)\n+    for key in DEFAULT_FIELDS:\n+        override = str(fields_in.get(key, \"\")).strip()\n+        if override:\n+            fields[key] = override\n+    args_in = raw.get(\"args\") if isinstance(raw.get(\"args\"), dict) else {}\n+    enabled = str(raw.get(\"enabled\", True)).strip().lower() not in (\"false\", \"0\", \"no\", \"off\")\n+    return McpService(\n+        name=name,\n+        url=url,\n+        search_tool=str(raw.get(\"search_tool\", \"\")).strip(),\n+        enabled=enabled,\n+        label=str(raw.get(\"label\", \"\")).strip(),\n+        args={str(k): v for k, v in args_in.items()},\n+        fields=fields,\n+        list_key=str(raw.get(\"list_key\", \"\")).strip(),\n+        status_tool=str(raw.get(\"status_tool\", \"\")).strip(),\n+        login_field=str(raw.get(\"login_field\", \"\")).strip(),\n+    )\n+\n+\n+def parse_services(raw: Any) -> tuple[list[McpService], list[str]]:\n+    \"\"\"Parse a whole settings list; bad entries are skipped and reported, so a\n+    single broken record never takes the healthy ones down.\"\"\"\n+    if raw is None:\n+        return [], []\n+    if not isinstance(raw, list):\n+        return [], [\"mcp_services must be a list\"]\n+    services: list[McpService] = []\n+    errors: list[str] = []\n+    seen: set[str] = set()\n+    for i, item in enumerate(raw):\n+        try:\n+            service = parse_service(item)\n+        except ValueError as e:\n+            errors.append(f\"service[{i}]: {e}\")\n+            continue\n+        if service.name in seen:\n+            errors.append(f\"service[{i}]: duplicate name {service.name!r}\")\n+            continue\n+        seen.add(service.name)\n+        services.append(service)\n+    return services, errors\n+\n+\n+# ---- call side: templates ----------------------------------------------------\n+\n+\n+def search_args(service: McpService, query: str, limit: int) -> dict[str, Any]:\n+    \"\"\"Build the tools/call arguments from the record's templates. A lone\n+    \"{placeholder}\" keeps the value's type ({limit} stays an int); mixed text\n+    interpolates into a string.\"\"\"\n+    values: dict[str, Any] = {\"query\": query, \"limit\": limit}\n+    return {key: _interpolate_value(val, values) for key, val in service.args.items()}\n+\n+\n+def _interpolate_value(template: Any, values: dict[str, Any]) -> Any:\n+    if not isinstance(template, str):\n+        return template\n+    exact = _PLACEHOLDER_RE.fullmatch(template.strip())\n+    if exact:\n+        return values.get(exact.group(1), \"\")\n+    return _PLACEHOLDER_RE.sub(lambda m: str(values.get(m.group(1), \"\")), template)\n+\n+\n+# ---- read side: results ------------------------------------------------------\n+\n+\n+def result_rows(service: McpService, data: Any) -> list[dict]:\n+    \"\"\"The list of result objects inside a tool reply: the record's list_key\n+    when given, else auto-unwrap a bare list or a common envelope key.\"\"\"\n+    if not isinstance(data, (list, dict)):\n+        return []\n+    if service.list_key:\n+        node: Any = data\n+        for part in service.list_key.split(\".\"):\n+            node = node.get(part) if isinstance(node, dict) else None\n+        rows = node if isinstance(node, list) else []\n+    elif isinstance(data, list):\n+        rows = data\n+    else:\n+        rows = next((data[k] for k in _LIST_WRAP_KEYS if isinstance(data.get(k), list)), [])\n+    return [row for row in rows if isinstance(row, dict)]\n+\n+\n+def _field(row: dict, chain: str) -> Any:\n+    \"\"\"First non-empty hit in an \"a.b | alt\" chain; '' when nothing matches.\"\"\"\n+    for path in (p.strip() for p in chain.split(\"|\")):\n+        if not path:\n+            continue\n+        node: Any = row\n+        for part in path.split(\".\"):\n+            if isinstance(node, dict) and part in node:\n+                node = node[part]\n+            else:\n+                node = None\n+                break\n+        if node not in (None, \"\"):\n+            return node\n+    return \"\"\n+\n+\n+def _map_url(spec: str, row: dict) -> str:\n+    \"\"\"A url mapping is a template (placeholders filled from the row,\n+    percent-encoded: ids and tokens are payload, never structure) or a field\n+    chain naming where the ready-made url lives.\"\"\"\n+    if \"{\" in spec:\n+        return _PLACEHOLDER_RE.sub(\n+            lambda m: urllib.parse.quote(str(row.get(m.group(1), \"\")), safe=\"\"), spec\n         )\n-        return str(value).strip().rstrip(\"/\")\n-\n-\n-def _first_list(data: Any) -> list:\n-    \"\"\"Pull the first list value out of a tool result (bare list or wrapped).\"\"\"\n-    if isinstance(data, list):\n-        return data\n-    if isinstance(data, dict):\n-        for key in (\"data\", \"items\", \"feeds\", \"results\", \"notes\"):\n-            if isinstance(data.get(key), list):\n-                return data[key]\n-    return []\n-\n-\n-# ---- concrete providers ------------------------------------------------------\n-\n-\n-def _xhs_args(query: str, limit: int) -> dict:\n-    return {\"keyword\": query, \"limit\": limit}\n-\n-\n-def _xhs_map(data: Any) -> list[dict]:\n-    \"\"\"search_feeds rows -> uniform rows. Keeps xsec_token in the URL:\n-    follow-up detail calls (and the site itself) require it.\"\"\"\n-    rows: list[dict] = []\n-    for it in _first_list(data):\n-        if not isinstance(it, dict):\n-            continue\n-        note_id = str(it.get(\"id\") or it.get(\"note_id\") or \"\").strip()\n-        if not note_id:\n-            continue\n-        url = f\"https://www.xiaohongshu.com/explore/{note_id}\"\n-        token = str(it.get(\"xsec_token\") or \"\").strip()\n-        if token:\n-            url += \"?\" + urllib.parse.urlencode({\"xsec_token\": token})\n-        rows.append(\n+    return str(_field(row, spec))\n+\n+\n+def map_results(service: McpService, data: Any) -> list[dict[str, str]]:\n+    \"\"\"Tool reply -> uniform [{title, url, snippet}] rows.\"\"\"\n+    out: list[dict[str, str]] = []\n+    for row in result_rows(service, data):\n+        url = _map_url(service.fields.get(\"url\", \"\"), row)\n+        if not url:\n+            continue  # a row with no address is not a result\n+        out.append(\n             {\n-                \"title\": str(it.get(\"title\") or \"\").strip(),\n+                \"title\": str(_field(row, service.fields.get(\"title\", \"\"))).strip(),\n                 \"url\": url,\n-                \"snippet\": str(it.get(\"desc\") or it.get(\"description\") or \"\").strip(),\n+                \"snippet\": str(_field(row, service.fields.get(\"snippet\", \"\"))).strip(),\n             }\n         )\n-    return rows\n-\n-\n-XIAOHONGSHU = McpProvider(\n-    name=\"xiaohongshu\",\n-    label=\"Xiaohongshu MCP\",\n-    search_tool=\"search_feeds\",\n-    search_args=_xhs_args,\n-    map_results=_xhs_map,\n-    placeholder=\"http://localhost:18060/mcp\",\n-    status_tool=\"check_login_status\",\n-)\n-\n-# The registry. Extension point: add one entry, everything else follows\n-# (search chain, rendered prompt, settings modal rows).\n-MCP_PROVIDERS: dict[str, McpProvider] = {\n-    \"xiaohongshu\": XIAOHONGSHU,\n-}\n+    return out\n+\n+\n+def normalize_login(state: Any, login_field: str = \"\") -> bool | None:\n+    \"\"\"Best-effort boolean from a status-tool payload (dict, string or bool);\n+    None when the shape says nothing recognizable.\"\"\"\n+    truthy = (\"logged_in\", \"logged in\", \"true\", \"yes\", \"ok\", \"success\")\n+    if isinstance(state, bool):\n+        return state\n+    if isinstance(state, str):\n+        return state.strip().lower() in truthy\n+    if isinstance(state, dict):\n+        keys = ([login_field] if login_field else []) + [\n+            \"login\",\n+            \"logged_in\",\n+            \"is_logged_in\",\n+            \"logged_in_status\",\n+            \"status\",\n+        ]\n+        for key in keys:\n+            if not key:\n+                continue\n+            v = state.get(key)\n+            if isinstance(v, bool):\n+                return v\n+            if isinstance(v, str):\n+                return v.strip().lower() in truthy\n+    return None\n"}
