<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Loopback HTTP + SSH outbound = INTERNET. N5 (M3): the tunnel/engine
         live in a foreground service so Android does not freeze the process
         the moment the activity is backgrounded (targetSdk 34 kills cached
         processes aggressively). dataSync is the closest declared type to
         "long-lived SSH tunnel"; POST_NOTIFICATIONS is what makes that
         service's mandatory notification visible on API 33+. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- M4: the screen-off half of the same report. A foreground service keeps
         the PROCESS alive, not the PROCESSOR: with the screen off the device
         suspends the CPU and a JS setTimeout that was going to redial simply does
         not run until something wakes the phone. WAKE_LOCK is what lets the
         engine's own ladder fire on time; ACCESS_WIFI_STATE is for the paired
         WifiLock that keeps the radio out of power save between attempts.

         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is the other half of it and the
         reason it is requested directly: in Doze the platform suspends network
         access and IGNORES wake locks — no FGS type and no lock survives it — so
         the user's exemption is the only thing that makes the two locks above
         mean anything for a phone in a pocket. This is a side-loaded build with
         no store listing (android/README.md), which is exactly why the direct
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS dialog is offered and no
         hidden stand-in is claimed; MainActivity asks ONCE, from a screen the
         user is looking at, and only when a tunnel is actually wanted. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The launcher icon. Two shapes for two platform eras, both generated from
         the desktop's ▣ by scripts/make-icon.py so phone and desktop cannot
         drift: mipmap-anydpi-v26/ic_launcher.xml is the adaptive icon API 26+
         composites and masks itself, and the mipmap-<density>/ic_launcher.png
         rasters are the pre-26 fallback, which no launcher masks — so those
         bring their own rounded tile.

         No android:roundIcon: on API 26+ the launcher already masks the adaptive
         icon into whatever shape the device draws, and a second raster set, only
         reachable on API 25, would be one more thing to keep in sync. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- singleTask = the desktop's requestSingleInstanceLock (§3);
             adjustResize = the soft keyboard must not cover the input line.

             configChanges (device report #1): rotating the phone must NOT
             recreate the activity. A recreate tears the WebView down and the
             page reloads — the stream DOM, the current session view, the input
             text and the live SSE stream all reset, which reads as "my
             conversation was thrown away". Handled here, the WebView survives
             the rotation and only re-lays-out; the page's own JS re-flows
             (mobile.css is a max-width media query, so it follows the width). -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- N5: holds NodeEngine alive across activity teardown. Not exported:
             only this app may drive the engine. -->
        <service
            android:name=".TunnelService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
