{
  "config": {
    "port": 51234,
    "command_timeout": 30.0
  },
  "host_vars": [
    {
      "name": "no vars",
      "vars": {},
      "expect": {}
    },
    {
      "name": "one fact",
      "vars": {
        "base": "host.port_url"
      },
      "expect": {
        "base": "http://127.0.0.1:51234"
      }
    },
    {
      "name": "unknown fact skipped",
      "vars": {
        "other": "host.nothing",
        "base": "host.port_url"
      },
      "expect": {
        "base": "http://127.0.0.1:51234"
      }
    },
    {
      "name": "two names, one fact",
      "vars": {
        "a": "host.port_url",
        "b": "host.port_url"
      },
      "expect": {
        "a": "http://127.0.0.1:51234",
        "b": "http://127.0.0.1:51234"
      }
    },
    {
      "name": "all unknown",
      "vars": {
        "x": "host.nope"
      },
      "expect": {}
    }
  ],
  "launch_prefix": [
    {
      "name": "a service answers with no prefix",
      "service": true,
      "resolved": {
        "argv": [
          "python3",
          "-m",
          "clutch_probe"
        ],
        "directory": "/opt/other dir",
        "importable": true
      },
      "unavailable": "",
      "expect": {
        "prefix": ""
      }
    },
    {
      "name": "an installed onefile is one word",
      "service": false,
      "resolved": {
        "argv": [
          "/usr/local/bin/clutch-probe"
        ],
        "directory": "/opt/clutch/components/probe",
        "importable": false
      },
      "unavailable": "",
      "expect": {
        "prefix": "'/usr/local/bin/clutch-probe'"
      }
    },
    {
      "name": "a checkout is interpreter + entry",
      "service": false,
      "resolved": {
        "argv": [
          "python3",
          "/home/u/proj/clutch-probe/main.py"
        ],
        "directory": "/opt/clutch/components/probe",
        "importable": false
      },
      "unavailable": "",
      "expect": {
        "prefix": "'python3' '/home/u/proj/clutch-probe/main.py'"
      }
    },
    {
      "name": "a package goes on PYTHONPATH",
      "service": false,
      "resolved": {
        "argv": [
          "python3",
          "-m",
          "clutch_probe"
        ],
        "directory": "/opt/other dir",
        "importable": true
      },
      "unavailable": "",
      "expect": {
        "prefix": "PYTHONPATH='/opt/other dir' 'python3' '-m' 'clutch_probe'"
      }
    },
    {
      "name": "quoting survives the prefix",
      "service": false,
      "resolved": {
        "argv": [
          "python3",
          "/opt/it's here/main.py"
        ],
        "directory": "/opt/it's here",
        "importable": false
      },
      "unavailable": "",
      "expect": {
        "prefix": "'python3' '/opt/it'\\''s here/main.py'"
      }
    },
    {
      "name": "no artifact",
      "service": false,
      "unavailable": "clutch-probe is not installed on this host",
      "expect": {
        "error": "clutch-probe is not installed on this host"
      }
    }
  ],
  "fence_globs": [
    {
      "name": "one protected file",
      "protected": [
        "/home/u/proj/demo.clc"
      ],
      "root": "/home/u/proj",
      "expect": [
        "/home/u/proj/demo.clc",
        "demo.clc"
      ]
    },
    {
      "name": "several",
      "protected": [
        "/home/u/proj/demo.clc",
        "/home/u/proj/notes.clc"
      ],
      "root": "/home/u/proj",
      "expect": [
        "/home/u/proj/demo.clc",
        "/home/u/proj/notes.clc",
        "demo.clc",
        "notes.clc"
      ]
    },
    {
      "name": "outside the root",
      "protected": [
        "/etc/clutch/clutch.clc"
      ],
      "root": "/home/u/proj",
      "expect": [
        "/etc/clutch/clutch.clc",
        "clutch.clc"
      ]
    },
    {
      "name": "the root itself",
      "protected": [
        "/home/u/proj"
      ],
      "root": "/home/u/proj",
      "expect": [
        "/home/u/proj",
        "proj"
      ]
    },
    {
      "name": "duplicates collapse",
      "protected": [
        "/home/u/proj/demo.clc",
        "/home/u/proj/demo.clc",
        "/home/u/proj/demo.clc"
      ],
      "root": "/home/u/proj",
      "expect": [
        "/home/u/proj/demo.clc",
        "demo.clc"
      ]
    },
    {
      "name": "none",
      "protected": [],
      "root": "/home/u/proj",
      "expect": []
    },
    {
      "name": "relative entries",
      "protected": [
        "demo.clc",
        "./demo.clc"
      ],
      "root": "/home/u/proj",
      "expect": [
        "demo.clc"
      ]
    }
  ],
  "line": [
    {
      "name": "plain",
      "prefix": "",
      "vars": {},
      "module": "clutch-probe",
      "template": "--json read {path}",
      "args": {
        "path": "a.txt"
      },
      "defaults": {},
      "expect": {
        "line": "--json read 'a.txt'"
      }
    },
    {
      "name": "behind a launch",
      "prefix": "'python3' '-m' 'clutch_probe'",
      "vars": {
        "root": "/home/u/proj"
      },
      "module": "clutch-probe",
      "template": "--workspace {root} read {path}",
      "args": {
        "path": "a.txt"
      },
      "defaults": {},
      "expect": {
        "line": "'python3' '-m' 'clutch_probe' --workspace '/home/u/proj' read 'a.txt'"
      }
    },
    {
      "name": "a host value wins",
      "prefix": "",
      "vars": {
        "root": "/host/root"
      },
      "module": "clutch-probe",
      "template": "read {root}",
      "args": {
        "root": "/model/root"
      },
      "defaults": {},
      "expect": {
        "line": "read '/host/root'"
      }
    },
    {
      "name": "defaults fill what the model omitted",
      "prefix": "",
      "vars": {},
      "module": "clutch-probe",
      "template": "read {max_chars} {*}",
      "args": {
        "path": "a.txt"
      },
      "defaults": {
        "max_chars": 20000
      },
      "expect": {
        "line": "read '20000' '{\"max_chars\":20000,\"path\":\"a.txt\"}'"
      }
    },
    {
      "name": "an optional group drops",
      "prefix": "",
      "vars": {},
      "module": "clutch-probe",
      "template": "curl [--data {body}] http://127.0.0.1:{port}/x",
      "args": {},
      "defaults": {
        "port": "51234"
      },
      "expect": {
        "line": "curl http://127.0.0.1:'51234'/x"
      }
    },
    {
      "name": "a missing value is a sentence",
      "prefix": "",
      "vars": {},
      "module": "clutch-probe",
      "template": "read {path}",
      "args": {},
      "defaults": {},
      "expect": {
        "error": "missing value for {path} (tool arguments: [])"
      }
    }
  ],
  "run": [
    {
      "name": "an envelope passes through",
      "template": "read {path}",
      "args": {
        "path": "a.txt"
      },
      "prefix": "",
      "module": "clutch-probe",
      "timeout": 30.0,
      "answer": {
        "code": 0,
        "stdout": "{\"content\":\"hi\",\"error\":false,\"diff\":\"\"}",
        "stderr": ""
      },
      "expect": {
        "content": "hi",
        "error": false
      },
      "trace": [
        "run read 'a.txt'"
      ]
    },
    {
      "name": "a non-zero exit is framed",
      "template": "read {path}",
      "args": {
        "path": "a.txt"
      },
      "prefix": "",
      "module": "clutch-probe",
      "timeout": 30.0,
      "answer": {
        "code": 2,
        "stdout": "",
        "stderr": "ls: nope"
      },
      "expect": {
        "content": "ERROR: the clutch-probe service failed (exit 2): ls: nope",
        "error": true
      },
      "trace": [
        "run read 'a.txt'"
      ]
    },
    {
      "name": "a timeout is the transport's",
      "template": "read {path}",
      "args": {
        "path": "a.txt"
      },
      "prefix": "",
      "module": "clutch-probe",
      "timeout": 30.0,
      "answer": {
        "error": {
          "message": "timed out",
          "timeout": true
        }
      },
      "expect": {
        "raises": "TransportError: timed out"
      },
      "trace": [
        "run read 'a.txt'"
      ]
    },
    {
      "name": "a stop is the transport's",
      "template": "read {path}",
      "args": {
        "path": "a.txt"
      },
      "prefix": "",
      "module": "clutch-probe",
      "timeout": 30.0,
      "answer": {
        "error": {
          "message": "aborted",
          "aborted": true
        }
      },
      "expect": {
        "raises": "TransportError: aborted"
      },
      "trace": [
        "run read 'a.txt'"
      ]
    },
    {
      "name": "an unreachable transport keeps its words",
      "template": "read {path}",
      "args": {
        "path": "a.txt"
      },
      "prefix": "",
      "module": "clutch-probe",
      "timeout": 30.0,
      "answer": {
        "error": {
          "message": "the bridge is not answering"
        }
      },
      "expect": {
        "raises": "TransportError: the bridge is not answering"
      },
      "trace": [
        "run read 'a.txt'"
      ]
    },
    {
      "name": "a missing argument raises before the runner",
      "template": "read {path}",
      "args": {},
      "prefix": "",
      "module": "clutch-probe",
      "timeout": 30.0,
      "answer": {},
      "expect": {
        "raises": "InstError: missing value for {path} (tool arguments: [])"
      },
      "trace": []
    }
  ],
  "resident": {
    "service_call": [
      [
        "/home/u/proj",
        "clutch-probe",
        [
          "/home/u/proj/demo.clc"
        ]
      ]
    ],
    "vars": {
      "port": "51234",
      "token": "abc",
      "pid": "77"
    },
    "prefix": "",
    "module": "clutch-probe",
    "runner": "the workspace",
    "template": "curl -H X-Token:{token} http://127.0.0.1:{port}/read {*}",
    "args": {
      "path": "a.txt"
    },
    "line": "curl -H X-Token:'abc' http://127.0.0.1:'51234'/read '{\"path\":\"a.txt\"}'"
  },
  "per_call": {
    "vars": {
      "base": "http://127.0.0.1:51234"
    },
    "prefix": "PYTHONPATH='/opt/clutch/components/probe' 'python3' '-m' 'clutch_probe'",
    "module": "clutch-probe",
    "template": "--base {base} read {*}",
    "args": {
      "path": "a.txt"
    },
    "line": "PYTHONPATH='/opt/clutch/components/probe' 'python3' '-m' 'clutch_probe' --base 'http://127.0.0.1:51234' read '{\"path\":\"a.txt\"}'"
  },
  "client": [
    {
      "name": "a live channel holds it",
      "reason": "",
      "protected": [
        "/home/u/proj/demo.clc"
      ],
      "root": "/home/u/proj",
      "expect": {
        "module": "clutch-probe",
        "local": false
      }
    },
    {
      "name": "no channel",
      "reason": "clutch-probe runs on the client that calls it and this host has no channel to that client",
      "protected": [
        "/home/u/proj/demo.clc"
      ],
      "root": "/home/u/proj",
      "expect": {
        "error": "clutch-probe runs on the client that calls it and this host has no channel to that client"
      }
    },
    {
      "name": "a stopped client",
      "reason": "clutch-probe is stopped on this client — start it before calling it",
      "protected": [],
      "root": "/home/u/proj",
      "expect": {
        "error": "clutch-probe is stopped on this client — start it before calling it"
      }
    },
    {
      "name": "no root",
      "reason": "",
      "protected": [],
      "root": ".",
      "expect": {
        "module": "clutch-probe",
        "local": false
      }
    }
  ],
  "client_run": [
    {
      "name": "the client answers",
      "module": "clutch-probe",
      "local": false,
      "template": "read_file {*}",
      "args": {
        "path": "a.txt"
      },
      "defaults": {
        "max_bytes": 100
      },
      "timeout": 30.0,
      "reply": {
        "content": "file contents",
        "error": false
      },
      "expect": {
        "content": "file contents",
        "error": false
      },
      "calls": [
        [
          "clutch-probe",
          "read_file {*}",
          {
            "path": "a.txt"
          },
          30.0
        ]
      ]
    },
    {
      "name": "the client reports an error",
      "module": "clutch-probe",
      "local": false,
      "template": "read_file {*}",
      "args": {
        "path": "a.txt"
      },
      "defaults": {
        "max_bytes": 100
      },
      "timeout": 30.0,
      "reply": {
        "content": "no such file",
        "error": true
      },
      "expect": {
        "content": "no such file",
        "error": true
      },
      "calls": [
        [
          "clutch-probe",
          "read_file {*}",
          {
            "path": "a.txt"
          },
          30.0
        ]
      ]
    },
    {
      "name": "the channel refuses",
      "module": "clutch-probe",
      "local": false,
      "template": "read_file {*}",
      "args": {
        "path": "a.txt"
      },
      "defaults": {
        "max_bytes": 100
      },
      "timeout": 30.0,
      "reply": {
        "channel_error": "clutch-probe is not installed for this client"
      },
      "expect": {
        "content": "ERROR: clutch-probe is not installed for this client",
        "error": true
      },
      "calls": [
        [
          "clutch-probe",
          "read_file {*}",
          {
            "path": "a.txt"
          },
          30.0
        ]
      ]
    }
  ],
