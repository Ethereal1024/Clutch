      "name": "a client cannot serve a local root",
      "local": true,
      "unavailable": "",
      "serves_here": false,
      "serves_channel": true,
      "far_root": false,
      "expect": "clutch-probe serves the filesystem of another machine over a channel, and this workspace root is a local one"
    },
    {
      "name": "drivable locally",
      "local": true,
      "unavailable": "",
      "serves_here": true,
      "serves_channel": false,
      "far_root": false,
      "expect": ""
    }
