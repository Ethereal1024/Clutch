  "unwrap": [
    {
      "name": "envelope passes through",
      "code": 0,
      "stdout": "{\"content\": \"hello\", \"error\": false, \"diff\": \"\"}",
      "stderr": "",
      "service": null,
      "expect": {
        "content": "hello",
        "error": false,
        "diff": ""
      }
    },
    {
      "name": "error envelope",
      "code": 66,
      "stdout": "{\"content\": \"file not found: x\", \"error\": true, \"diff\": \"\", \"code\": 66}",
